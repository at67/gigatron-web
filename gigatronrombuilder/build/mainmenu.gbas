_runtimePath_ "../tools/runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMvX0
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "SymbolTable.m"
const NUM_APPS = 5
const dim menuText$(NUM_APPS-1) = "bowling", "Eliza", "HelloWorld", "slots", "tinymaze"
dim symbols(NUM_APPS-1) = bowling, Eliza, HelloWorld, slots, tinymaze
const maxX = 1
const maxY = 5
x = 0 : y = x
curIndex = -1 : newIndex = 0
dim menuX%(NUM_APPS-1) = 56, 56, 56, 56, 56
dim menuY%(NUM_APPS-1) = 24, 40, 56, 72, 88
dim textColors%(NUM_APPS-1) = &h0C, &h0C, &h0C, &h0C, &h0C
tscroll off
tclip on
set BG_COLOUR, &h00 : mode 2 : cls
for i = 0 to NUM_APPS - 1
    set FG_COLOUR, textColors(i) : at menuX(i), menuY(i) : print menuText$(i)
next i
play music, &h75a0, 3
gosub resetAudio
call initSnow
repeat
   gosub get("BUTTON_STATE")
   if newIndex <> curIndex
      call drawCursor, curIndex, 0
      call drawCursor, newIndex, 1
      curIndex = newIndex
   endif
call updateSnow
forever
const NUM_SNOW_PARTICLES = 80
const SNOW_ORG_X = 80
const SNOW_ORG_Y = 60 + 8
const GROUND_Y = 59
dim snowColour%(3) = &h95, &hAA, &hBF, &hBF
dim jitterOffset(7) = 0, 1, 0, -1, 0, -1, 0, 1
dim xPos(NUM_SNOW_PARTICLES-1) = 0
dim yPos(NUM_SNOW_PARTICLES-1) = 0
dim yVel(NUM_SNOW_PARTICLES-1) = 0
dim colour%(NUM_SNOW_PARTICLES-1) = 0
proc initSnow
    local i
    snowTimer = -1
    for i=0 &to NUM_SNOW_PARTICLES-1
        call respawnSnowParticle, i
    next i
endproc
proc updateSnow
    local i, xp, yp, yv, col, pxy
    for i=0 to NUM_SNOW_PARTICLES-1
        xp = xPos(i)
        yp = yPos(i)
        yv = yVel(i)
        rxy.lo = xp.hi + SNOW_ORG_X
        rxy.hi = yp.hi + SNOW_ORG_Y
        if peek(rxy) AND &h80
            poke rxy, get("BG_COLOUR")
        endif
        yp = yp + yv
        if yp > 59*256
            if rxy.hi < 127 then poke rxy, &h3F
            call respawnSnowParticle, i
            goto nextParticle
        endif
        pxy.hi = yp.hi + SNOW_ORG_Y
        if pxy.hi > rxy.hi
            xp.hi = xp.hi + jitterOffset(rxy.hi AND 7)
        endif
        pxy.lo = xp.hi + SNOW_ORG_X
        pixel = peek(pxy)
        if (pixel <> get("BG_COLOUR"))
            if (pixel AND &hC0) = 0
                if peek(rxy + &h0100) <> get("BG_COLOUR")
                    poke rxy, &h3F
                    call respawnSnowParticle, i
                    goto nextParticle
                else
                    xp.hi = xp.hi - jitterOffset(rxy.hi AND 7)
                    pxy.lo = xp.hi + SNOW_ORG_X
                endif
            endif
        endif
        if abs(xp) > 78*256
            call respawnSnowParticle, i
            goto nextParticle
        endif
        if (peek(pxy) AND &h40) == 0 then poke pxy, colour(i)
        xPos(i) = xp : yPos(i) = yp
        yVel(i) = yv
nextParticle:
    next i
    snowTimer = snowTimer + 1
endproc
proc respawnSnowParticle, i
    local y
    xPos(i).hi = rnd(144) - 72
    if snowTimer = -1
        y.hi = -rnd(20) - 39
    else
        y.hi = -59
    endif
    yPos(i) = y
    yVel(i) = (rnd(0) AND 127) + 128
    colour(i) = snowColour(rnd(0) AND 3)
endproc
execApp:
    cls
    exec symbols(curIndex.lo), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    inc x.lo
        if x = maxX then x = 0
        gosub beep
        return
'left
253:    x = x - 1
        if x < 0 then x = maxX - 1
        gosub beep
        return
'down
251:    inc y.lo
        if y = maxY then y = 0
        gosub beep
        return
'up
247:    y = y - 1
        if y < 0 then y = maxY - 1
        gosub beep
        return
proc drawCursor, index, active
    local x, y, w
    if index &&= -1 then return
    x = menuX(index)
    y = menuY(index)
    w = peek(addr(menuText$(index)))
    w = (w LSL 2) + w + w
    if active
        set BG_COLOUR, &h21 OR &h40
        set FG_COLOUR, &h1F
        at x, y : print menuText$(index)
        set BG_COLOUR, &h00
    else
        set FG_COLOUR, textColors(index)
        at x, y : print menuText$(index)
    endif
endproc
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    newIndex = y * maxX + x
    if newIndex >= NUM_APPS then newIndex = NUM_APPS-1
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
