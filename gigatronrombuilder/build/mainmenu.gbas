_runtimePath_ "../tools/runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMvX0
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "SymbolTable.m"
const NUM_APPS = 5
const dim menuText$(NUM_APPS-1) = "bowling", "Eliza", "Hello", "slots", "tinymaze"
dim symbols(NUM_APPS-1) = bowling, Eliza, HelloWorld, slots, tinymaze
const maxX = 2
const maxY = 3
x = 0 : y = x
curIndex = -1 : newIndex = 0
dim menuX%(NUM_APPS-1) = 38, 92, 38, 92, 38
dim menuY%(NUM_APPS-1) = 40, 40, 56, 56, 72
dim textColors%(NUM_APPS-1) = &h0F, &h0F, &h0F, &h0F, &h0F
tscroll off
tclip on
set BG_COLOUR, &h10 : mode 2 : cls
for i = 0 to NUM_APPS - 1
    set FG_COLOUR, textColors(i) : at menuX(i), menuY(i) : print menuText$(i)
next i
play music, &h75a0, 3
gosub resetAudio
call initFireworks
repeat
   gosub get("BUTTON_STATE")
   if newIndex <> curIndex
      call drawCursor, curIndex, 0
      call drawCursor, newIndex, 1
      curIndex = newIndex
   endif
call updateFireworks
forever
const NUM_FIREWORKS = 60
const FIREWORKS_ORG_X = 80
const FIREWORKS_ORG_Y = 60 + 8
const GRAVITY = 40
dim xPos(NUM_FIREWORKS-1) = 0
dim yPos(NUM_FIREWORKS-1) = 0
dim xVel(NUM_FIREWORKS-1) = 0
dim yVel(NUM_FIREWORKS-1) = 0
dim life%(NUM_FIREWORKS-1) = 0
dim colour%(NUM_FIREWORKS-1) = 0
proc initFireworks
    local i
    fireworkTimer = 0
    for i=0 &to NUM_FIREWORKS-1
        life(i) = 0
    next i
endproc
proc updateFireworks
    local i, lf, xp, yp, pxy
    for i=0 to NUM_FIREWORKS-1
        lf = life(i)
        if lf > 0
            xp = xPos(i) : xr = xp : xv = xVel(i)
            yp = yPos(i) : yr = yp : yv = yVel(i)
            yv = yv + GRAVITY
            xp = xp + xv
            yp = yp + yv
            if yp < -59*256
                if yr >= -59*256 then gosub clearParticle
                goto nextParticle
            endif
            if yp > 59*256
                lf = 0
                gosub clearParticle
                goto skipParticle
            endif
            if abs(xp) > 79*256
                lf = 0
                gosub clearParticle
                goto skipParticle
            endif
            gosub clearParticle
            pxy.lo = xp.hi + FIREWORKS_ORG_X
            pxy.hi = yp.hi + FIREWORKS_ORG_Y
            if peek(pxy) = get("BG_COLOUR")
                poke pxy, colour(i)
            endif
nextParticle:
            lf = lf - 1
            if lf = 0
                if peek(pxy) AND &h80
                    poke pxy, get("BG_COLOUR")
                endif
            endif
            xPos(i) = xp : yPos(i) = yp
            yVel(i) = yv
        endif
skipParticle:
        life(i) = lf
    next i
    inc fireworkTimer.lo
    if fireworkTimer > 20
        fireworkTimer = 0
        centerX = (rnd(0) AND 127) - 64
        centerY = (rnd(0) AND 63) - 48
        call createFirework, centerX, centerY
    endif
endproc
clearParticle:
    pxy.lo = xr.hi + FIREWORKS_ORG_X
    pxy.hi = yr.hi + FIREWORKS_ORG_Y
    if peek(pxy) AND &h80
        poke pxy, get("BG_COLOUR")
    endif
return
proc createFirework, centerX, centerY
    local i, c, count
    count = 0
    c = rnd(0) AND &h3f OR &h80
    for i=0 to NUM_FIREWORKS-1
        if life(i) = 0
            xv = (rnd(0) AND 1023) - 512
            yv = (rnd(0) AND 1023) - 768
            xPos(i).hi = centerX
            yPos(i).hi = centerY
            xVel(i) = xv
            yVel(i) = yv
            life(i) = 64 + (rnd(0) AND 31)
            colour(i) = c
            inc count.lo
            if count = 20 then return
        endif
    next i
endproc
execApp:
    cls
    exec symbols(curIndex.lo), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    inc x.lo
        if x = maxX then x = 0
        gosub beep
        return
'left
253:    x = x - 1
        if x < 0 then x = maxX - 1
        gosub beep
        return
'down
251:    inc y.lo
        if y = maxY then y = 0
        gosub beep
        return
'up
247:    y = y - 1
        if y < 0 then y = maxY - 1
        gosub beep
        return
proc drawCursor, index, active
    local x, y, w
    if index &&= -1 then return
    x = menuX(index)
    y = menuY(index)
    w = peek(addr(menuText$(index)))
    w = (w LSL 2) + w + w
    if active
        set FG_COLOUR, &h3D OR &h40
    else
        set FG_COLOUR, &h10
    endif
    line x-1, y-1, x+w, y-1
    line x-1, y+8, x+w, y+8
    line x-1, y-1, x-1, y+8
    line x+w, y-1, x+w, y+8
endproc
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    newIndex = y * maxX + x
    if newIndex >= NUM_APPS then newIndex = NUM_APPS-1
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
