_runtimePath_ "../tools/runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMvX0
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "SymbolTable.m"
const NUM_APPS = 5
const dim apps$(NUM_APPS-1) = "bowling", "Eliza", "Hello", "slots", "tinymaze"
dim execs(NUM_APPS-1) = bowling, Eliza, HelloWorld, slots, tinymaze
const maxX = 2
const maxY = 3
x = 0 : y = x
curIndex = -1 : newIndex = 0
dim textX%(NUM_APPS-1) = 38, 92, 38, 92, 38
dim textY%(NUM_APPS-1) = 40, 40, 56, 56, 72
dim textColors%(NUM_APPS-1) = &h07, &h07, &h07, &h07, &h07
tscroll off
tclip on
set BG_COLOUR, &h00 : mode 2 : cls
for i = 0 to NUM_APPS - 1
    set FG_COLOUR, textColors(i) : at textX(i), textY(i) : print apps$(i)
next i
play music, &h75a0, 3
gosub resetAudio
call initFountain
repeat
   gosub get("BUTTON_STATE")
   if newIndex <> curIndex
      call drawCursor, curIndex, 0
      call drawCursor, newIndex, 1
      curIndex = newIndex
   endif
call updateFountain
forever
const NUM_PARTICLES = 40
const FOUNTAIN_ORG_X = 80
const FOUNTAIN_ORG_Y = 60 + 8
const GRAVITY = 64
const SPAWN_Y = 59
dim xPos(NUM_PARTICLES-1) = 0
dim yPos(NUM_PARTICLES-1) = 0
dim xVel(NUM_PARTICLES-1) = 0
dim yVel(NUM_PARTICLES-1) = 0
dim age%(NUM_PARTICLES-1) = 0
dim colour%(31) = {&hB0, &hB0, &hB0, &hB0, &hB0, &hB0, &hB0, &hB0, &hB0, &hB0,
                   &hB5, &hB5, &hB5, &hB5, &hB5, &hB5, &hB5, &hB5, &hB5, &hB5,
                   &hBA, &hBA, &hBA, &hBA, &hBA, &hBA, &hBA, &hBA, &hBA, &hBA,
                   &hBF, &hBF}
proc initFountain
    local i
    pxy = 0 : xr = pxy : yr = xr
    for i=0 to NUM_PARTICLES-1
        call respawnParticle, i
        age(i) = 1
    next i
endproc
proc updateFountain
    local i, xp, yp, life
    for i=0 to NUM_PARTICLES-1
        life = age(i)
        if life > 0
            xp = xPos(i) : xr = xp : xv = xVel(i)
            yp = yPos(i) : yr = yp : yv = yVel(i)
            yv = yv + GRAVITY
            xp = xp + xv
            yp = yp + yv
            if yp < -59*256
                if yr >= -59*256 then gosub clearParticle
                goto nextParticle
            endif
            if yp > 59*256
                gosub clearParticle
                call respawnParticle, i
                goto skipParticle
            endif
            if abs(xp) > 79*256
                gosub clearParticle
                call respawnParticle, i
                goto skipParticle
            endif
            gosub clearParticle
            pxy.lo = xp.hi + FOUNTAIN_ORG_X
            pxy.hi = yp.hi + FOUNTAIN_ORG_Y
            if peek(pxy) = get("BG_COLOUR")
                poke pxy, colour(min(life, 31))
            endif
nextParticle:
            inc life.lo
            age(i) = life
            xPos(i) = xp : yPos(i) = yp
            yVel(i) = yv
        endif
skipParticle:
    next i
endproc
clearParticle:
    pxy.lo = xr.hi + FOUNTAIN_ORG_X
    pxy.hi = yr.hi + FOUNTAIN_ORG_Y
    if peek(pxy) AND &h80
        poke pxy, get("BG_COLOUR")
    endif
return
proc respawnParticle, i
    xPos(i).hi = 0
    yPos(i).hi = SPAWN_Y
    xVel(i) = (rnd(0) AND 1023) - 500
    yVel(i) = -((rnd(0) AND 1023) + 1000)
    age(i) = 1
endproc
execApp:
    cls
    exec execs(curIndex.lo), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    inc x.lo
        if x = maxX then x = 0
        gosub beep
        return
'left
253:    x = x - 1
        if x < 0 then x = maxX - 1
        gosub beep
        return
'down
251:    inc y.lo
        if y = maxY then y = 0
        gosub beep
        return
'up
247:    y = y - 1
        if y < 0 then y = maxY - 1
        gosub beep
        return
proc drawCursor, index, active
    local x, y, w
    if index &&= -1 then return
    x = textX(index)
    y = textY(index)
    w = peek(addr(apps$(index)))
    w = (w LSL 2) + w + w
    if active
        set FG_COLOUR, &h3F
    else
        set FG_COLOUR, &h00
    endif
    line x-1, y-1, x+w, y-1
    line x-1, y+8, x+w, y+8
    line x-1, y-1, x-1, y+8
    line x+w, y-1, x+w, y+8
endproc
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    newIndex = y * maxX + x
    if newIndex >= NUM_APPS then newIndex = NUM_APPS-1
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
