_runtimePath_ "../tools/runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMv6
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "SymbolTable.m"
const NUM_APPS = 8
const dim menuText$(NUM_APPS-1) = "Apple-1_v3", "Credits_v4", "gtForth", "gtmine_v1", "Horizon_c_v2", "Invader_vX0", "MainMenu_v6", "PucMon_ROMv5a"
dim symbols(NUM_APPS-1) = Apple-1_v3, Credits_v4, gtForth, gtmine_v1, Horizon_c_v2, Invader_vX0, MainMenu_v6, PucMon_ROMv5a
const maxX = 1
const maxY = 8
x = 0 : y = x
curIndex = -1 : newIndex = 0
dim menuX%(NUM_APPS-1) = 2, 2, 2, 2, 2, 2, 2, 2
dim menuY%(NUM_APPS-1) = 32, 48, 56, 64, 72, 80, 88, 40
dim textColors%(NUM_APPS-1) = &h0C, &h0C, &h0C, &h0C, &h0C, &h0C, &h0C, &h0C
tscroll off
tclip on
set BG_COLOUR, &h00 : mode 2 : cls
for i = 0 to NUM_APPS - 1
    set FG_COLOUR, textColors(i) : at menuX(i), menuY(i) : print menuText$(i)
next i
play music, &h75a0, 3
gosub resetAudio
call initStars
repeat
   gosub get("BUTTON_STATE")
   if newIndex <> curIndex
      call drawCursor, curIndex, 0
      call drawCursor, newIndex, 1
      curIndex = newIndex
   endif
call updateStars
forever
const NUM_STARS = 48
const STARS_ORG_X = 80
const STARS_ORG_Y = 60 + 8
dim xPos(NUM_STARS-1) = 0
dim yPos(NUM_STARS-1) = 0
dim xVel(NUM_STARS-1) = 0
dim yVel(NUM_STARS-1) = 0
dim star%(NUM_STARS-1) = 0
dim colour%(31) = {&h00, &h00, &h00, &h00, &h00, &h00, &h00, &h00, &h95,
                   &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95,
                   &hAA, &hAA, &hAA, &hAA, &hAA, &hAA, &hAA, &hAA,
                   &hBF, &hBF, &hBF, &hBF, &hBF, &hBF, &hBF}
proc initStars
    local i
    for i=0 to NUM_STARS-1
        call newStar, i
    next i
endproc
proc newStar, i
    star(i) = 0
    xPos(i) = 0
    yPos(i) = 0
    repeat
        xv = (rnd(0) AND 2047) - 1024
        yv = (rnd(0) AND 2047) - 1024
    until abs(xv) > 200  OR  abs(yv) > 200
    xVel(i) = xv : xp = xv
    yVel(i) = yv : yp = yv
endproc
proc updateStars
    local i, ss, pxy
    for i=0 to NUM_STARS-1
        xp = xPos(i) : xv = xVel(i)
        yp = yPos(i) : yv = yVel(i)
        pxy.lo = xp.hi + STARS_ORG_X
        pxy.hi = yp.hi + STARS_ORG_Y
        if (peek(pxy) AND &h80)
            poke pxy, get("BG_COLOUR")
        endif
        xp = xp + xv
        yp = yp + yv
        if abs(yp) > 59*256
            call newStar, i
        endif
        if abs(xp) > 79*256
            call newStar, i
        endif
        ss = star(i)
        pxy.lo = xp.hi + STARS_ORG_X
        pxy.hi = yp.hi + STARS_ORG_Y
        if peek(pxy) = get("BG_COLOUR")
            if ss > 7 then poke pxy, colour(min(ss, 31))
            star(i) = ss + 1
        endif
        xPos(i) = xp : yPos(i) = yp
    next i
endproc
execApp:
    cls
    exec symbols(curIndex.lo), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    inc x.lo
        if x = maxX then x = 0
        gosub beep
        return
'left
253:    x = x - 1
        if x < 0 then x = maxX - 1
        gosub beep
        return
'down
251:    inc y.lo
        if y = maxY then y = 0
        gosub beep
        return
'up
247:    y = y - 1
        if y < 0 then y = maxY - 1
        gosub beep
        return
proc drawCursor, index, active
    local x, y, w
    if index &&= -1 then return
    x = menuX(index)
    y = menuY(index)
    w = peek(addr(menuText$(index)))
    w = (w LSL 2) + w + w
    if active
        set FG_COLOUR, &h0F OR &h40
    else
        set FG_COLOUR, get("BG_COLOUR")
    endif
    line x-1, y-1, x+w, y-1
    line x-1, y+8, x+w, y+8
    line x-1, y-1, x-1, y+8
    line x+w, y-1, x+w, y+8
endproc
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    newIndex = y * maxX + x
    if newIndex >= NUM_APPS then newIndex = NUM_APPS-1
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
