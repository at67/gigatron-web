_runtimePath_ "../tools/runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMvX0
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "SymbolTable.m"
const NUM_APPS = 5
const NUM_DECO = 1
const dim decoText$(NUM_DECO-1) = "Gigatron TTL ROMvX0"
const dim menuText$(NUM_APPS-1) = "bowling", "Eliza", "Hello", "slots", "tinymaze"
dim symbols(NUM_APPS-1) = bowling, Eliza, HelloWorld, slots, tinymaze
const maxX = 2
const maxY = 3
x = 0 : y = x
curIndex = -1 : newIndex = 0
dim menuX%(NUM_APPS-1) = 38, 92, 38, 92, 38
dim menuY%(NUM_APPS-1) = 48, 48, 64, 64, 80
dim textColors%(NUM_APPS-1) = &h0C, &h0C, &h0C, &h0C, &h0C
dim decoX%(NUM_DECO-1) = 20
dim decoY%(NUM_DECO-1) = 8
dim decoColors%(NUM_DECO-1) = &h0F
tscroll off
tclip on
set BG_COLOUR, &h00 : mode 2 : cls
for i = 0 to NUM_DECO - 1
    set FG_COLOUR, decoColors(i) : at decoX(i), decoY(i) : print decoText$(i)
next i
for i = 0 to NUM_APPS - 1
    set FG_COLOUR, textColors(i) : at menuX(i), menuY(i) : print menuText$(i)
next i
play music, &h75a0, 3
gosub resetAudio
call initFire
repeat
   gosub get("BUTTON_STATE")
   if newIndex <> curIndex
      call drawCursor, curIndex, 0
      call drawCursor, newIndex, 1
      curIndex = newIndex
   endif
call updateFire
forever
const NUM_FIRE_PARTICLES = 64
const FIRE_ORG_X = 80
const FIRE_ORG_Y = 60 + 8
dim xPos(NUM_FIRE_PARTICLES-1) = 0
dim yPos(NUM_FIRE_PARTICLES-1) = 0
dim xVel(NUM_FIRE_PARTICLES-1) = 0
dim yVel(NUM_FIRE_PARTICLES-1) = 0
dim life%(NUM_FIRE_PARTICLES-1) = 0
dim colour%(63) = {&h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95, &h95,
                   &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86, &h86,
                   &h83, &h83, &h83, &h83, &h83, &h83, &h83, &h83, &h83, &h83,
                   &h87, &h87, &h87, &h87, &h87, &h87, &h87, &h87, &h87, &h87,
                   &h8F, &h8F, &h8F, &h8F, &h8B, &h8B, &h8B, &h8B, &h8B, &h8B, &h8B, &h8B, &h8B}
proc initFire
    local i
    for i=0 to NUM_FIRE_PARTICLES-1
        call respawnFireParticle, i
    next i
endproc
proc respawnFireParticle, i
    xPos(i).hi = (rnd(0) AND 63) - 32
    yPos(i).hi = 59
    xVel(i) = (rnd(0) AND 511) - 256
    yVel(i) = -((rnd(0) AND 511) + 256)
    life(i) = (rnd(0) AND 31) + 40
endproc
proc updateFire
    local i, xp, yp, yv, lf, pxy
    for i=0 to NUM_FIRE_PARTICLES-1
        lf = life(i)
        if lf > 0
            xp = xPos(i)
            yp = yPos(i)
            yv = yVel(i)
            pxy.lo = xp.hi + FIRE_ORG_X
            pxy.hi = yp.hi + FIRE_ORG_Y
            if peek(pxy) AND &h80
                poke pxy, get("BG_COLOUR")
            endif
            xp = xp + xVel(i)
            yp = yp + yv
            yv = yv + 8
            lf = lf - 1
            if lf = 0
                call respawnFireParticle, i
                goto nextParticle
            endif
            if abs(yp) > 59*256
                call respawnFireParticle, i
                goto nextParticle
            endif
            if abs(xp) > 79*256
                call respawnFireParticle, i
                goto nextParticle
            endif
            pxy.lo = xp.hi + FIRE_ORG_X
            pxy.hi = yp.hi + FIRE_ORG_Y
            if peek(pxy) = get("BG_COLOUR")
                poke pxy, colour(lf AND 63)
            endif
            xPos(i) = xp : yPos(i) = yp
            yVel(i) = yv
            life(i) = lf
        endif
nextParticle:
    next i
endproc
execApp:
    cls
    exec symbols(curIndex.lo), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    inc x.lo
        if x = maxX then x = 0
        gosub beep
        return
'left
253:    x = x - 1
        if x < 0 then x = maxX - 1
        gosub beep
        return
'down
251:    inc y.lo
        if y = maxY then y = 0
        gosub beep
        return
'up
247:    y = y - 1
        if y < 0 then y = maxY - 1
        gosub beep
        return
proc drawCursor, index, active
    local x, y, w
    if index &&= -1 then return
    x = menuX(index)
    y = menuY(index)
    w = peek(addr(menuText$(index)))
    w = (w LSL 2) + w + w
    if active
        set FG_COLOUR, &h0F OR &h40
    else
        set FG_COLOUR, &h00
    endif
    line x-1, y-1, x+w, y-1
    line x-1, y+8, x+w, y+8
    line x-1, y-1, x-1, y+8
    line x+w, y-1, x+w, y+8
endproc
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    newIndex = y * maxX + x
    if newIndex >= NUM_APPS then newIndex = NUM_APPS-1
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
