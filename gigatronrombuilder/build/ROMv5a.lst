                                          1660  label('BRA')
BRA:          0390 c216  st   [$16]       1661  st([vPC])                       #10
              0391 fc00  bra  NEXTY       1662  bra('NEXTY')                    #11
              0392 00f9  ld   $f9         1663  ld(-14/2)                       #12
                                          1664
                                          1665  # Instruction INC: Increment zero page byte ([D]++), 20 cycles
                                          1666  label('INC')
INC:          0393 1200  ld   ac,x        1667  ld(AC,X)                        #10,13
              0394 1404  ld   $04,y       1668  ld(hi('inc#14'),Y)              #11
              0395 e0e4  jmp  y,$e4       1669  jmp(Y,'inc#14')                 #12
              0396 0001  ld   $01         1670  ld(1)                           #13
                                          1671
                                          1672  # Instruction CMPHU: Adjust high byte for unsigned compare (vACH=XXX), 28 cycles
                                          1673  label('CMPHU_v5')
CMPHU_v5:     0397 140b  ld   $0b,y       1674  ld(hi('cmphu#13'),Y)            #10
              0398 e0c8  jmp  y,$c8       1675  jmp(Y,'cmphu#13')               #11
                                          1676  #ld(AC,X)                       #12 Overlap
                                          1677  #
                                          1678  # Instruction ADDW: Word addition with zero page (vAC+=[D]+256*[D+1]), 28 cycles
                                          1679  label('ADDW')
                                          1680  # The non-carry paths could be 26 cycles at the expense of (much) more code.
                                          1681  # But a smaller size is better so more instructions fit in this code page.
                                          1682  # 28 cycles is still 4.5 usec. The 6502 equivalent takes 20 cycles or 20 usec.
ADDW:         0399 1200  ld   ac,x        1683  ld(AC,X)                        #10,12 Address of low byte to be added
              039a 8001  adda $01         1684  adda(1)                         #11
              039b c21d  st   [$1d]       1685  st([vTmp])                      #12 Address of high byte to be added
              039c 0118  ld   [$18]       1686  ld([vAC])                       #13 Add the low bytes
              039d 8500  adda [x]         1687  adda([X])                       #14
              039e c218  st   [$18]       1688  st([vAC])                       #15 Store low result
              039f e8a3  blt  .addw#18    1689  bmi('.addw#18')                 #16 Now figure out if there was a carry
              03a0 a500  suba [x]         1690  suba([X])                       #17 Gets back the initial value of vAC
              03a1 fca5  bra  .addw#20    1691  bra('.addw#20')                 #18
              03a2 4500  ora  [x]         1692  ora([X])                        #19 Carry in bit 7
                                          1693  label('.addw#18')
.addw#18:     03a3 2500  anda [x]         1694  anda([X])                       #18 Carry in bit 7
              03a4 0200  nop              1695  nop()                           #19
                                          1696  label('.addw#20')
.addw#20:     03a5 3080  anda $80,x       1697  anda(0x80,X)                    #20 Move carry to bit 0
              03a6 0500  ld   [x]         1698  ld([X])                         #21
              03a7 8119  adda [$19]       1699  adda([vAC+1])                   #22 Add the high bytes with carry
              03a8 111d  ld   [$1d],x     1700  ld([vTmp],X)                    #23
              03a9 8500  adda [x]         1701  adda([X])                       #24
              03aa c219  st   [$19]       1702  st([vAC+1])                     #25 Store high result
              03ab fc01  bra  NEXT        1703  bra('NEXT')                     #26
              03ac 00f2  ld   $f2         1704  ld(-28/2)                       #27
                                          1705
                                          1706  # Instruction PEEK: Read byte from memory (vAC=[vAC]), 26 cycles
                                          1707  label('PEEK')
PEEK:         03ad 1404  ld   $04,y       1708  ld(hi('peek'),Y)                #10
              03ae e062  jmp  y,$62       1709  jmp(Y,'peek')                   #11
                                          1710  #ld([vPC])                      #12 Overlap
                                          1711  #
                                          1712  # Instruction SYS: Native call, <=256 cycles (<=128 ticks, in reality less)
                                          1713  #
                                          1714  # The 'SYS' vCPU instruction first checks the number of desired ticks given by
                                          1715  # the operand. As long as there are insufficient ticks available in the current
                                          1716  # time slice, the instruction will be retried. This will effectively wait for
                                          1717  # the next scan line if the current slice is almost out of time. Then a jump to
                                          1718  # native code is made. This code can do whatever it wants, but it must return
                                          1719  # to the 'REENTER' label when done. When returning, AC must hold (the negative
                                          1720  # of) the actual consumed number of whole ticks for the entire virtual
                                          1721  # instruction cycle (from NEXT to NEXT). This duration may not exceed the prior
                                          1722  # declared duration in the operand + 28 (or maxTicks). The operand specifies the
                                          1723  # (negative) of the maximum number of *extra* ticks that the native call will
                                          1724  # need. The GCL compiler automatically makes this calculation from gross number
                                          1725  # of cycles to excess number of ticks.
                                          1726  # SYS functions can modify vPC to implement repetition. For example to split
                                          1727  # up work into multiple chucks.
                                          1728  label('.sys#13')
.sys#13:      03af 0116  ld   [$16]       1729  ld([vPC])                       #13,12 Retry until sufficient time
              03b0 a002  suba $02         1730  suba(2)                         #14
              03b1 c216  st   [$16]       1731  st([vPC])                       #15
              03b2 fccb  bra  REENTER     1732  bra('REENTER')                  #16
              03b3 00f6  ld   $f6         1733  ld(-20/2)                       #17
                                          1734  label('SYS')
SYS:          03b4 8115  adda [$15]       1735  adda([vTicks])                  #10
              03b5 e8af  blt  .sys#13     1736  blt('.sys#13')                  #11
              03b6 1523  ld   [$23],y     1737  ld([sysFn+1],Y)                 #12
              03b7 e122  jmp  y,[$22]     1738  jmp(Y,[sysFn])                  #13
                                          1739  #dummy()                        #14 Overlap
                                          1740  #
                                          1741  # Instruction SUBW: Word subtract with zero page (AC-=[D]+256*[D+1]), 28 cycles
                                          1742  # All cases can be done in 26 cycles, but the code will become much larger
                                          1743  label('SUBW')
SUBW:         03b8 1200  ld   ac,x        1744  ld(AC,X)                        #10,14 Address of low byte to be subtracted
              03b9 8001  adda $01         1745  adda(1)                         #11
              03ba c21d  st   [$1d]       1746  st([vTmp])                      #12 Address of high byte to be subtracted
              03bb 0118  ld   [$18]       1747  ld([vAC])                       #13
              03bc e8c1  blt  .subw#16    1748  bmi('.subw#16')                 #14
              03bd a500  suba [x]         1749  suba([X])                       #15
              03be c218  st   [$18]       1750  st([vAC])                       #16 Store low result
              03bf fcc4  bra  .subw#19    1751  bra('.subw#19')                 #17
              03c0 4500  ora  [x]         1752  ora([X])                        #18 Carry in bit 7
                                          1753  label('.subw#16')
.subw#16:     03c1 c218  st   [$18]       1754  st([vAC])                       #16 Store low result
              03c2 2500  anda [x]         1755  anda([X])                       #17 Carry in bit 7
              03c3 0200  nop              1756  nop()                           #18
                                          1757  label('.subw#19')
.subw#19:     03c4 3080  anda $80,x       1758  anda(0x80,X)                    #19 Move carry to bit 0
              03c5 0119  ld   [$19]       1759  ld([vAC+1])                     #20
              03c6 a500  suba [x]         1760  suba([X])                       #21
              03c7 111d  ld   [$1d],x     1761  ld([vTmp],X)                    #22
              03c8 a500  suba [x]         1762  suba([X])                       #23
              03c9 c219  st   [$19]       1763  st([vAC+1])                     #24
                                          1764  label('REENTER_28')
REENTER_28:   03ca 00f2  ld   $f2         1765  ld(-28/2)                       #25
                                          1766  label('REENTER')
REENTER:      03cb fc01  bra  NEXT        1767  bra('NEXT')                     #26 Return from SYS calls
              03cc 1517  ld   [$17],y     1768  ld([vPC+1],Y)                   #27
                                          1769
                                          1770  # Instruction DEF: Define data or code (vAC,vPC=vPC+2,(vPC&0xff00)+D), 24 cycles
                                          1771  label('DEF')
DEF:          03cd 1404  ld   $04,y       1772  ld(hi('def#13'),Y)              #10
              03ce e007  jmp  y,$07       1773  jmp(Y,'def#13')                 #11
                                          1774  #st([vTmp])                     #12 Overlap
                                          1775  #
                                          1776  # Instruction CALL: Goto address and remember vPC (vLR,vPC=vPC+2,[D]+256*[D+1]-2), 26 cycles
                                          1777  label('CALL')
CALL:         03cf c21d  st   [$1d]       1778  st([vTmp])                      #10,12
              03d0 0116  ld   [$16]       1779  ld([vPC])                       #11
              03d1 8002  adda $02         1780  adda(2)                         #12 Point to instruction after CALL
              03d2 c21a  st   [$1a]       1781  st([vLR])                       #13
              03d3 0117  ld   [$17]       1782  ld([vPC+1])                     #14
              03d4 c21b  st   [$1b]       1783  st([vLR+1])                     #15
              03d5 111d  ld   [$1d],x     1784  ld([vTmp],X)                    #16
              03d6 0500  ld   [x]         1785  ld([X])                         #17
              03d7 a002  suba $02         1786  suba(2)                         #18 Because NEXT will add 2
              03d8 c216  st   [$16]       1787  st([vPC])                       #19
              03d9 011d  ld   [$1d]       1788  ld([vTmp])                      #20
              03da 9001  adda $01,x       1789  adda(1,X)                       #21
              03db 0500  ld   [x]         1790  ld([X])                         #22
              03dc d617  st   [$17],y     1791  st([vPC+1],Y)                   #23
              03dd fc01  bra  NEXT        1792  bra('NEXT')                     #24
              03de 00f3  ld   $f3         1793  ld(-26/2)                       #25
                                          1794
                                          1795  # Instruction ALLOC: Create or destroy stack frame (vSP+=D), 14 cycles
                                          1796  label('ALLOC')
ALLOC:        03df 811c  adda [$1c]       1797  adda([vSP])                     #10
              03e0 c21c  st   [$1c]       1798  st([vSP])                       #11
              03e1 fc01  bra  NEXT        1799  bra('NEXT')                     #12
              03e2 00f9  ld   $f9         1800  ld(-14/2)                       #13
                                          1801
                                          1802  # The instructions below are all implemented in the second code page. Jumping
                                          1803  # back and forth makes each 6 cycles slower, but it also saves space in the
                                          1804  # primary page for the instructions above. Most of them are in fact not very
                                          1805  # critical, as evidenced by the fact that they weren't needed for the first
                                          1806  # Gigatron applications (Snake, Racer, Mandelbrot, Loader). By providing them
                                          1807  # in this way, at least they don't need to be implemented as a SYS extension.
                                          1808
                                          1809  # Instruction ADDI: Add small positive constant (vAC+=D), 28 cycles
                                          1810  label('ADDI')
ADDI:         03e3 1404  ld   $04,y       1811  ld(hi('addi'),Y)                #10
              03e4 e018  jmp  y,$18       1812  jmp(Y,'addi')                   #11
              03e5 c21d  st   [$1d]       1813  st([vTmp])                      #12
                                          1814
                                          1815  # Instruction SUBI: Subtract small positive constant (vAC+=D), 28 cycles
                                          1816  label('SUBI')
SUBI:         03e6 1404  ld   $04,y       1817  ld(hi('subi'),Y)                #10
              03e7 e026  jmp  y,$26       1818  jmp(Y,'subi')                   #11
              03e8 c21d  st   [$1d]       1819  st([vTmp])                      #12
                                          1820
                                          1821  # Instruction LSLW: Logical shift left (vAC<<=1), 28 cycles
                                          1822  # Useful, because ADDW can't add vAC to itself. Also more compact.
                                          1823  label('LSLW')
LSLW:         03e9 1404  ld   $04,y       1824  ld(hi('lslw'),Y)                #10
              03ea e035  jmp  y,$35       1825  jmp(Y,'lslw')                   #11
              03eb 0118  ld   [$18]       1826  ld([vAC])                       #12
                                          1827
                                          1828  # Instruction STLW: Store word in stack frame ([vSP+D],[vSP+D+1]=vAC&255,vAC>>8), 26 cycles
                                          1829  label('STLW')
STLW:         03ec 1404  ld   $04,y       1830  ld(hi('stlw'),Y)                #10
              03ed e041  jmp  y,$41       1831  jmp(Y,'stlw')                   #11
                                          1832  #dummy()                        #12 Overlap
                                          1833  #
                                          1834  # Instruction LDLW: Load word from stack frame (vAC=[vSP+D]+256*[vSP+D+1]), 26 cycles
                                          1835  label('LDLW')
LDLW:         03ee 1404  ld   $04,y       1836  ld(hi('ldlw'),Y)                #10,12
              03ef e04c  jmp  y,$4c       1837  jmp(Y,'ldlw')                   #11
                                          1838  #dummy()                        #12 Overlap
                                          1839  #
                                          1840  # Instruction POKE: Write byte in memory ([[D+1],[D]]=vAC&255), 28 cycles
                                          1841  label('POKE')
POKE:         03f0 1404  ld   $04,y       1842  ld(hi('poke'),Y)                #10,12
              03f1 e057  jmp  y,$57       1843  jmp(Y,'poke')                   #11
              03f2 c21d  st   [$1d]       1844  st([vTmp])                      #12
                                          1845
                                          1846  # Instruction DOKE: Write word in memory ([[D+1],[D]],[[D+1],[D]+1]=vAC&255,vAC>>8), 28 cycles
                                          1847  label('DOKE')
DOKE:         03f3 1404  ld   $04,y       1848  ld(hi('doke'),Y)                #10
              03f4 e06d  jmp  y,$6d       1849  jmp(Y,'doke')                   #11
              03f5 c21d  st   [$1d]       1850  st([vTmp])                      #12
                                          1851
                                          1852  # Instruction DEEK: Read word from memory (vAC=[vAC]+256*[vAC+1]), 28 cycles
                                          1853  label('DEEK')
DEEK:         03f6 1404  ld   $04,y       1854  ld(hi('deek'),Y)                #10
              03f7 e07a  jmp  y,$7a       1855  jmp(Y,'deek')                   #11
                                          1856  #dummy()                        #12 Overlap
                                          1857  #
                                          1858  # Instruction ANDW: Word logical-AND with zero page (vAC&=[D]+256*[D+1]), 28 cycles
                                          1859  label('ANDW')
ANDW:         03f8 1404  ld   $04,y       1860  ld(hi('andw'),Y)                #10,12
              03f9 e086  jmp  y,$86       1861  jmp(Y,'andw')                   #11
                                          1862  #dummy()                        #12 Overlap
                                          1863  #
                                          1864  # Instruction ORW: Word logical-OR with zero page (vAC|=[D]+256*[D+1]), 28 cycles
                                          1865  label('ORW')
ORW:          03fa 1404  ld   $04,y       1866  ld(hi('orw'),Y)                 #10,12
              03fb e091  jmp  y,$91       1867  jmp(Y,'orw')                    #11
                                          1868  #dummy()                        #12 Overlap
                                          1869  #
                                          1870  # Instruction XORW: Word logical-XOR with zero page (vAC^=[D]+256*[D+1]), 26 cycles
                                          1871  label('XORW')
XORW:         03fc 1404  ld   $04,y       1872  ld(hi('xorw'),Y)                #10,12
              03fd e09c  jmp  y,$9c       1873  jmp(Y,'xorw')                   #11
              03fe c21d  st   [$1d]       1874  st([vTmp])                      #12
