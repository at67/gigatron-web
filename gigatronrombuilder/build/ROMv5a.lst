SUBI:         03e6 1404  ld   $04,y       1874  ld(hi('subi'),Y)                #10
              03e7 e026  jmp  y,$26       1875  jmp(Y,'subi')                   #11
              03e8 c21d  st   [$1d]       1876  st([vTmp])                      #12
