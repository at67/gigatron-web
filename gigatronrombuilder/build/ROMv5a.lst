              0208 0d00  ld   [y,x]       1330  ld([Y,X])                       #36
              0209 911f  adda [$1f],x     1331  adda([frameX],X)                #37
                                          1332  label('pixels')
pixels:       020a 1520  ld   [$20],y     1333  ld([frameY],Y)                  #38
              020b 00c0  ld   $c0         1334  ld(syncBits)                    #39
                                          1335
                                          1336  # Stream 160 pixels from memory location <Yi,Xi> onwards
                                          1337  # Superimpose the sync signal bits to be robust against misprogramming
                                          1338  for i in range(qqVgaWidth):
              020c 5d00  ora  [y,x++],out 1339    ora([Y,Xpp],OUT)              #40-199 Pixel burst
              020d 5d00  ora  [y,x++],out
              020e 5d00  ora  [y,x++],out
              * 160 times
              02ac 18c0  ld   $c0,out     1340  ld(syncBits,OUT)                #0 <New scan line start> Back to black
                                          1341
                                          1342  # Front porch
              02ad 0102  ld   [$02]       1343  ld([channel])                   #1 Advance to next sound channel
                                          1344  label('sound3')                 # Return from vCPU interpreter
sound3:       02ae 2121  anda [$21]       1345  anda([channelMask])             #2
              02af 8001  adda $01         1346  adda(1)                         #3
              02b0 1880  ld   $80,out     1347  ld(syncBits^hSync,OUT)          #4 Start horizontal pulse
                                          1348
                                          1349  # Horizontal sync and sound channel update for scanlines outside vBlank
                                          1350  label('sound2')
sound2:       02b1 d602  st   [$02],y     1351  st([channel],Y)                 #5
              02b2 007f  ld   $7f         1352  ld(0x7f)                        #6
              02b3 29fe  anda [y,$fe]     1353  anda([Y,oscL])                  #7
              02b4 89fc  adda [y,$fc]     1354  adda([Y,keyL])                  #8
              02b5 cafe  st   [y,$fe]     1355  st([Y,oscL])                    #9
              02b6 3080  anda $80,x       1356  anda(0x80,X)                    #10
              02b7 0500  ld   [x]         1357  ld([X])                         #11
              02b8 89ff  adda [y,$ff]     1358  adda([Y,oscH])                  #12
              02b9 89fd  adda [y,$fd]     1359  adda([Y,keyH])                  #13
              02ba caff  st   [y,$ff]     1360  st([Y,oscH] )                   #14
              02bb 20fc  anda $fc         1361  anda(0xfc)                      #15
              02bc 69fb  xora [y,$fb]     1362  xora([Y,wavX])                  #16
              02bd 1200  ld   ac,x        1363  ld(AC,X)                        #17
              02be 09fa  ld   [y,$fa]     1364  ld([Y,wavA])                    #18
              02bf 1407  ld   $07,y       1365  ld(soundTable>>8,Y)             #19
              02c0 8d00  adda [y,x]       1366  adda([Y,X])                     #20
              02c1 e8c4  blt  $02c4       1367  bmi(pc()+3)                     #21
              02c2 fcc5  bra  $02c5       1368  bra(pc()+3)                     #22
              02c3 203f  anda $3f         1369  anda(63)                        #23
              02c4 003f  ld   $3f         1370  ld(63)                          #23(!)
              02c5 8103  adda [$03]       1371  adda([sample])                  #24
              02c6 c203  st   [$03]       1372  st([sample])                    #25
                                          1373
              02c7 0113  ld   [$13]       1374  ld([xout])                      #26 Gets copied to XOUT
              02c8 fd0d  bra  [$0d]       1375  bra([nextVideo])                #27
              02c9 18c0  ld   $c0,out     1376  ld(syncBits,OUT)                #28 End horizontal pulse
                                          1377
                                          1378  # Back porch B: second of 4 repeated scan lines
                                          1379  # - Recompute Xi from dXi and store for retrieval in the next scan lines
                                          1380  label('videoB')
videoB:       02ca 00d3  ld   $d3         1381  ld('videoC')                    #29 2nd scanline of 4
              02cb c20d  st   [$0d]       1382  st([nextVideo])                 #30
              02cc 1401  ld   $01,y       1383  ld(videoTable>>8,Y)             #31
              02cd 0109  ld   [$09]       1384  ld([videoY])                    #32
              02ce 9001  adda $01,x       1385  adda(1,X)                       #33
              02cf 011f  ld   [$1f]       1386  ld([frameX])                    #34
              02d0 8d00  adda [y,x]       1387  adda([Y,X])                     #35
              02d1 fd0a  bra  [$0a]       1388  bra([videoModeB])               #36
              02d2 d21f  st   [$1f],x     1389  st([frameX],X)                  #37 Store in RAM and X
                                          1390
                                          1391  # Back porch C: third of 4 repeated scan lines
                                          1392  # - Nothing new to for video do as Yi and Xi are known,
                                          1393  # - This is the time to emit and reset the next sound sample
                                          1394  label('videoC')
videoC:       02d3 00dc  ld   $dc         1395  ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1396  st([nextVideo])                 #30
              02d5 0103  ld   [$03]       1397  ld([sample])                    #31 New sound sample is ready (didn't fit in the audio loop)
              02d6 400f  ora  $0f         1398  ora(0x0f)                       #32
              02d7 2114  anda [$14]       1399  anda([xoutMask])                #33
              02d8 c213  st   [$13]       1400  st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
              02d9 c003  st   $03,[$03]   1401  st(sample, [sample])            #35 Reset for next sample
              02da fd0b  bra  [$0b]       1402  bra([videoModeC])               #36
              02db 111f  ld   [$1f],x     1403  ld([frameX],X)                  #37
                                          1404
                                          1405  # Back porch D: last of 4 repeated scan lines
                                          1406  # - Calculate the next frame index
                                          1407  # - Decide if this is the last line or not
                                          1408  label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1409  ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1410  ld([videoY])                    #30
              02de a0ee  suba $ee         1411  suba((120-1)*2)                 #31
                                          1412  beq('.lastpixels#34')           #32
              02df f0e5  beq  .lastpixels#34
              02e0 80f0  adda $f0         1413  adda(120*2)                     #33 More pixel lines to go
              02e1 c209  st   [$09]       1414  st([videoY])                    #34
              02e2 0001  ld   $01         1415  ld('videoA')                    #35
              02e3 fd0c  bra  [$0c]       1416  bra([videoModeD])               #36
              02e4 c20d  st   [$0d]       1417  st([nextVideo])                 #37
                                          1418
                                          1419  label('.lastpixels#34')
                                          1420  if soundDiscontinuity == 1:
.lastpixels#34:
              02e5 c003  st   $03,[$03]   1421    st(sample, [sample])          #34 Sound continuity
                                          1422  else:
                                          1423    nop()                         #34
              02e6 00e9  ld   $e9         1424  ld('videoE')                    #35 No more pixel lines to go
              02e7 fd0c  bra  [$0c]       1425  bra([videoModeD])               #36
              02e8 c20d  st   [$0d]       1426  st([nextVideo])                 #37
                                          1427
                                          1428  # Back porch "E": after the last line
                                          1429  # - Go back and and enter vertical blank (program page 2)
                                          1430  label('videoE') # Exit visible area
videoE:       02e9 1401  ld   $01,y       1431  ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
              02ea e004  jmp  y,$04       1432  jmp(Y,'vBlankStart')            #30
              02eb 00c0  ld   $c0         1433  ld(syncBits)                    #31
                                          1434
                                          1435  # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1436  # This yields some speed, but also frees up screen memory for other purposes.
                                          1437  # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1438  # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1439  label('videoF')
videoF:       02ec 0120  ld   [$20]       1440  ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1441  adda(0x80)                      #30
              02ee d220  st   [$20],x     1442  st([videoSync1],X)              #31
              02ef 011f  ld   [$1f]       1443  ld([frameX])                    #32
              02f0 a500  suba [x]         1444  suba([X])                       #33 Decrements every two VGA scanlines
              02f1 f0f4  beq  .videoF#36  1445  beq('.videoF#36')               #34
              02f2 c21f  st   [$1f]       1446  st([frameX])                    #35
              02f3 fcf6  bra  nopixels    1447  bra('nopixels')                 #36
                                          1448  label('.videoF#36')
.videoF#36:   02f4 0001  ld   $01         1449  ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1450  st([nextVideo])                 #37
                                          1451  #
                                          1452  # Alternative for pixel burst: faster application mode
                                          1453  label('nopixels')
nopixels:     02f6 00ff  ld   $ff         1454  runVcpu(200-38, 'ABCD line 40-520',
              02f7 c21e  st   [$1e]
              02f8 1505  ld   [$05],y
              02f9 e0ff  jmp  y,$ff
              02fa 003c  ld   $3c
                                          1455    returnTo=0x1ff)               #38 Application interpreter (black scanlines)
                                          1456
                                          1457  #-----------------------------------------------------------------------
                                          1458  #
                                          1459  #  $0300 ROM page 3: Application interpreter primary page
                                          1460  #
                                          1461  #-----------------------------------------------------------------------
                                          1462
                                          1463  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1464  #
                                          1465  # This routine will execute as many as possible instructions in the
                                          1466  # allotted time. When time runs out, it synchronizes such that the total
                                          1467  # duration matches the caller's request. Durations are counted in `ticks',
                                          1468  # which are multiples of 2 clock cycles.
                                          1469  #
                                          1470  # Synopsis: Use the runVcpu() macro as entry point
                                          1471
                                          1472  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1473  # precious space in the packed interpreter code page. Although ENTER's
                                          1474  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1475  # in this case it will still jump into the right space, because branches
                                          1476  # from $xxFF land in the next page anyway.
                                          1477  while pc()&255 < 255:
              02fb 0200  nop              1478    nop()
              02fc 0200  nop
              02fd 0200  nop
              02fe 0200  nop
                                          1479  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1480  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1481  # --- Page boundary ---
                                          1482  align(0x100,size=0x100)
                                          1483  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1484  ld([vPC+1],Y)                   #1
                                          1485
                                          1486  # Fetch next instruction and execute it, but only if there are sufficient
                                          1487  # ticks left for the slowest instruction.
                                          1488  label('NEXT')
NEXT:         0301 8115  adda [$15]       1489  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        1490  blt('EXIT')                     #1 Escape near time out
                                          1491  label('.next2')
.next2:       0303 c215  st   [$15]       1492  st([vTicks])                    #2
              0304 0116  ld   [$16]       1493  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         1494  adda(2)                         #4
              0306 d216  st   [$16],x     1495  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       1496  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     1497  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          1498  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       1499  ld([Y,X])                       #9 Prefetch operand
                                          1500
                                          1501  # Resync with video driver and transfer control
                                          1502  label('EXIT')
EXIT:         030b 800e  adda $0e         1503  adda(maxTicks)                  #3
                                          1504  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      1505  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         1506  suba(1)                         #5
              030e 1401  ld   $01,y       1507  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     1508  jmp(Y,[vReturn])                #7 To video driver
              0310 0000  ld   $00         1509  ld(0)                           #8 AC should be 0 already. Still..
                                          1510  assert vCPU_overhead ==          9
                                          1511
                                          1512  # Instruction LDWI: Load immediate word constant (vAC=D), 20 cycles
                                          1513  label('LDWI')
LDWI:         0311 c218  st   [$18]       1514  st([vAC])                       #10
              0312 de00  st   [y,x++]     1515  st([Y,Xpp])                     #11 Just X++
              0313 0d00  ld   [y,x]       1516  ld([Y,X])                       #12 Fetch second operand
              0314 c219  st   [$19]       1517  st([vAC+1])                     #13
              0315 0116  ld   [$16]       1518  ld([vPC])                       #14 Advance vPC one more
              0316 8001  adda $01         1519  adda(1)                         #15
              0317 c216  st   [$16]       1520  st([vPC])                       #16
              0318 00f6  ld   $f6         1521  ld(-20/2)                       #17
              0319 fc01  bra  NEXT        1522  bra('NEXT')                     #18
                                          1523  #dummy()                        #19 Overlap
                                          1524  #
                                          1525  # Instruction LD: Load byte from zero page (vAC=[D]), 22 cycles
                                          1526  label('LD')
LD:           031a 1200  ld   ac,x        1527  ld(AC,X)                        #10,19
              031b 0500  ld   [x]         1528  ld([X])                         #11
              031c 1404  ld   $04,y       1529  ld(hi('ld#15'),Y)               #12
              031d e013  jmp  y,$13       1530  jmp(Y,'ld#15')                  #13
              031e c218  st   [$18]       1531  st([vAC])                       #14
                                          1532
                                          1533  # Instruction CMPHS: Adjust high byte for signed compare (vACH=XXX), 28 cycles
                                          1534  label('CMPHS_v5')
CMPHS_v5:     031f 140b  ld   $0b,y       1535  ld(hi('cmphs#13'),Y)            #10
              0320 e0bc  jmp  y,$bc       1536  jmp(Y,'cmphs#13')               #11
                                          1537  #ld(AC,X)                       #12 Overlap
                                          1538  #
                                          1539  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 20 cycles
                                          1540  label('LDW')
LDW:          0321 1200  ld   ac,x        1541  ld(AC,X)                        #10,12
              0322 8001  adda $01         1542  adda(1)                         #11
              0323 c21d  st   [$1d]       1543  st([vTmp])                      #12 Address of high byte
              0324 0500  ld   [x]         1544  ld([X])                         #13
              0325 c218  st   [$18]       1545  st([vAC])                       #14
              0326 111d  ld   [$1d],x     1546  ld([vTmp],X)                    #15
              0327 0500  ld   [x]         1547  ld([X])                         #16
              0328 c219  st   [$19]       1548  st([vAC+1])                     #17
              0329 fc01  bra  NEXT        1549  bra('NEXT')                     #18
              032a 00f6  ld   $f6         1550  ld(-20/2)                       #19
                                          1551
                                          1552  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 20 cycles
                                          1553  label('STW')
STW:          032b 1200  ld   ac,x        1554  ld(AC,X)                        #10,20
              032c 8001  adda $01         1555  adda(1)                         #11
              032d c21d  st   [$1d]       1556  st([vTmp])                      #12 Address of high byte
              032e 0118  ld   [$18]       1557  ld([vAC])                       #13
              032f c600  st   [x]         1558  st([X])                         #14
              0330 111d  ld   [$1d],x     1559  ld([vTmp],X)                    #15
              0331 0119  ld   [$19]       1560  ld([vAC+1])                     #16
              0332 c600  st   [x]         1561  st([X])                         #17
              0333 fc01  bra  NEXT        1562  bra('NEXT')                     #18
              0334 00f6  ld   $f6         1563  ld(-20/2)                       #19
                                          1564
                                          1565  # Instruction BCC: Test AC sign and branch conditionally, 28 cycles
                                          1566  label('BCC')
BCC:          0335 0119  ld   [$19]       1567  ld([vAC+1])                     #10 First inspect high byte of vAC
              0336 ec40  bne  .bcc#13     1568  bne('.bcc#13')                  #11
              0337 c21d  st   [$1d]       1569  st([vTmp])                      #12
              0338 0118  ld   [$18]       1570  ld([vAC])                       #13 Additionally inspect low byte of vAC
              0339 f043  beq  .bcc#16     1571  beq('.bcc#16')                  #14
              033a 0001  ld   $01         1572  ld(1)                           #15
              033b c21d  st   [$1d]       1573  st([vTmp])                      #16
              033c 0d00  ld   [y,x]       1574  ld([Y,X])                       #17 Operand is the conditional
                                          1575  label('.bcc#18')
.bcc#18:      033d fe00  bra  ac          1576  bra(AC)                         #18
              033e 011d  ld   [$1d]       1577  ld([vTmp])                      #19
                                          1578
                                          1579  # Conditional EQ: Branch if zero (if(vACL==0)vPCL=D)
                                          1580  label('EQ')
EQ:           033f ec45  bne  .bcc#22     1581  bne('.bcc#22')                  #20
                                          1582  label('.bcc#13')
.bcc#13:      0340 f048  beq  .bcc#23     1583  beq('.bcc#23')                  #21,13 AC=0 in EQ, AC!=0 from BCC... Overlap with BCC
              0341 0d00  ld   [y,x]       1584  ld([Y,X])                       #22,14 Overlap with BCC
                                          1585  #
                                          1586  # (continue BCC)
                                          1587  #label('.bcc#13')
                                          1588  #dummy()                        #13
                                          1589  #dummy()                        #14
              0342 0200  nop              1590  nop()                           #15
                                          1591  label('.bcc#16')
.bcc#16:      0343 fc3d  bra  .bcc#18     1592  bra('.bcc#18')                  #16
              0344 0d00  ld   [y,x]       1593  ld([Y,X])                       #17 Operand is the conditional
                                          1594  label('.bcc#22')
.bcc#22:      0345 0116  ld   [$16]       1595  ld([vPC])                       #22 False condition
              0346 fc4a  bra  .bcc#25     1596  bra('.bcc#25')                  #23
              0347 8001  adda $01         1597  adda(1)                         #24
                                          1598  label('.bcc#23')
.bcc#23:      0348 de00  st   [y,x++]     1599  st([Y,Xpp])                     #23 Just X++ True condition
              0349 0d00  ld   [y,x]       1600  ld([Y,X])                       #24
                                          1601  label('.bcc#25')
.bcc#25:      034a c216  st   [$16]       1602  st([vPC])                       #25
              034b fc01  bra  NEXT        1603  bra('NEXT')                     #26
              034c 00f2  ld   $f2         1604  ld(-28/2)                       #27
                                          1605
                                          1606  # Conditional GT: Branch if positive (if(vACL>0)vPCL=D)
                                          1607  label('GT')
GT:           034d f845  ble  .bcc#22     1608  ble('.bcc#22')                  #20
              034e e448  bgt  .bcc#23     1609  bgt('.bcc#23')                  #21
              034f 0d00  ld   [y,x]       1610  ld([Y,X])                       #22
                                          1611
                                          1612  # Conditional LT: Branch if negative (if(vACL<0)vPCL=D)
                                          1613  label('LT')
LT:           0350 f445  bge  .bcc#22     1614  bge('.bcc#22')                  #20
              0351 e848  blt  .bcc#23     1615  blt('.bcc#23')                  #21
              0352 0d00  ld   [y,x]       1616  ld([Y,X])                       #22
                                          1617
                                          1618  # Conditional GE: Branch if positive or zero (if(vACL>=0)vPCL=D)
                                          1619  label('GE')
GE:           0353 e845  blt  .bcc#22     1620  blt('.bcc#22')                  #20
              0354 f448  bge  .bcc#23     1621  bge('.bcc#23')                  #21
              0355 0d00  ld   [y,x]       1622  ld([Y,X])                       #22
                                          1623
                                          1624  # Conditional LE: Branch if negative or zero (if(vACL<=0)vPCL=D)
                                          1625  label('LE')
LE:           0356 e445  bgt  .bcc#22     1626  bgt('.bcc#22')                  #20
              0357 f848  ble  .bcc#23     1627  ble('.bcc#23')                  #21
              0358 0d00  ld   [y,x]       1628  ld([Y,X])                       #22
                                          1629
                                          1630  # Instruction LDI: Load immediate small positive constant (vAC=D), 16 cycles
                                          1631  label('LDI')
LDI:          0359 c218  st   [$18]       1632  st([vAC])                       #10
              035a 0000  ld   $00         1633  ld(0)                           #11
              035b c219  st   [$19]       1634  st([vAC+1])                     #12
              035c fc00  bra  NEXTY       1635  bra('NEXTY')                    #13
              035d 00f8  ld   $f8         1636  ld(-16/2)                       #14
