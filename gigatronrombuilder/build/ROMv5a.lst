                                          1735  # Instruction ADDW: Word addition with zero page (vAC+=[D]+256*[D+1]), 28 cycles
                                          1736  label('ADDW')
                                          1737  # The non-carry paths could be 26 cycles at the expense of (much) more code.
                                          1738  # But a smaller size is better so more instructions fit in this code page.
                                          1739  # 28 cycles is still 4.5 usec. The 6502 equivalent takes 20 cycles or 20 usec.
ADDW:         0399 1200  ld   ac,x        1740  ld(AC,X)                        #10,12 Address of low byte to be added
              039a 8001  adda $01         1741  adda(1)                         #11
              039b c21d  st   [$1d]       1742  st([vTmp])                      #12 Address of high byte to be added
              039c 0118  ld   [$18]       1743  ld([vAC])                       #13 Add the low bytes
              039d 8500  adda [x]         1744  adda([X])                       #14
              039e c218  st   [$18]       1745  st([vAC])                       #15 Store low result
              039f e8a3  blt  .addw#18    1746  bmi('.addw#18')                 #16 Now figure out if there was a carry
              03a0 a500  suba [x]         1747  suba([X])                       #17 Gets back the initial value of vAC
              03a1 fca5  bra  .addw#20    1748  bra('.addw#20')                 #18
              03a2 4500  ora  [x]         1749  ora([X])                        #19 Carry in bit 7
                                          1750  label('.addw#18')
.addw#18:     03a3 2500  anda [x]         1751  anda([X])                       #18 Carry in bit 7
