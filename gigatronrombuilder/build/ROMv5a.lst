                                          3843  # SYS_ShuffleNoise_v4_46 implementation
                                          3844  label('sys_ShuffleNoise')
sys_ShuffleNoise:
              0ecf 1118  ld   [$18],x     3845  ld([vAC+0],X)                   #18 tmp = T[4j]
              0ed0 0d00  ld   [y,x]       3846  ld([Y,X])                       #19
              0ed1 c21d  st   [$1d]       3847  st([vTmp])                      #20
              0ed2 1119  ld   [$19],x     3848  ld([vAC+1],X)                   #21 T[4j] = T[4i]
              0ed3 0d00  ld   [y,x]       3849  ld([Y,X])                       #22
              0ed4 1118  ld   [$18],x     3850  ld([vAC+0],X)                   #23
              0ed5 ce00  st   [y,x]       3851  st([Y,X])                       #24
              0ed6 8200  adda ac          3852  adda(AC)                        #25 j += T[4i]
              0ed7 8200  adda ac          3853  adda(AC,)                       #26
              0ed8 8118  adda [$18]       3854  adda([vAC+0])                   #27
              0ed9 c218  st   [$18]       3855  st([vAC+0])                     #28
              0eda 1119  ld   [$19],x     3856  ld([vAC+1],X)                   #29 T[4i] = tmp
              0edb 011d  ld   [$1d]       3857  ld([vTmp])                      #30
              0edc ce00  st   [y,x]       3858  st([Y,X])                       #31
              0edd 0119  ld   [$19]       3859  ld([vAC+1])                     #32 i += 1
              0ede 8004  adda $04         3860  adda(4)                         #33
              0edf c219  st   [$19]       3861  st([vAC+1])                     #34
              0ee0 f0e3  beq  $0ee3       3862  beq(pc()+3)                     #35 For 64 iterations
              0ee1 fce4  bra  $0ee4       3863  bra(pc()+3)                     #36
