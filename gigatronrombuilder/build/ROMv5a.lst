                                          2715  #-----------------------------------------------------------------------
                                          2716  #
                                          2717  #  $0d00 ROM page 11: More SYS functions
                                          2718  #
                                          2719  #-----------------------------------------------------------------------
                                          2720
                                          2721  align(0x100, size=0x100)
                                          2722
                                          2723  #-----------------------------------------------------------------------
                                          2724  # Extension SYS_SetMode_v2_80
                                          2725  #-----------------------------------------------------------------------
                                          2726
                                          2727  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          2728  #
                                          2729  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          2730  # the user can experiment. It's adviced to refrain from using
                                          2731  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          2732  # personal preference, and the programmer shouldn't overrule the user
                                          2733  # in that choice. The Gigatron philisophy is that the end user has
                                          2734  # the final say on what happens on the system, not the application,
                                          2735  # even if that implies a degraded performance. This doesn't mean that
                                          2736  # all applications must work well in all video modes: mode 1 is still
                                          2737  # the default. If an application really doesn't work at all in that
                                          2738  # mode, it's acceptable to change mode once after loading.
                                          2739  #
                                          2740  # There's no "SYS_GetMode" function.
                                          2741  #
                                          2742  # Variables:
                                          2743  #       vAC bit 0:1     Mode:
                                          2744  #                         0      "ABCD" -> Full mode (slowest)
                                          2745  #                         1      "ABC-" -> Default mode after reset
                                          2746  #                         2      "A-C-" -> at67's mode
                                          2747  #                         3      "A---" -> HGM's mode
                                          2748  #       vAC bit 2:15    Ignored bits and should be 0
                                          2749  #
                                          2750  # Special values (ROM v4):
                                          2751  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          2752  #                        no blinkenlights).
                                          2753  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          2754
                                          2755  # Actual duration is <80 cycles, but keep some room for future extensions
                                          2756  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       2757  ld(hi('sys_SetMode'),Y)         #15
              0b01 e054  jmp  y,$54       2758  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       2759  ld([vReturn])                   #17
                                          2760
                                          2761  #-----------------------------------------------------------------------
                                          2762  # Extension SYS_SetMemory_v2_54
                                          2763  #-----------------------------------------------------------------------
                                          2764
                                          2765  # SYS function for setting 1..256 bytes
                                          2766  #
                                          2767  # sysArgs[0]   Copy count (in, changed)
                                          2768  # sysArgs[1]   Copy value (in)
                                          2769  # sysArgs[2:3] Destination address (in, changed)
                                          2770  #
                                          2771  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          2772  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          2773  # All combined that gives a 300% speedup over ROMv4 and before.
                                          2774
                                          2775  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       2776  ld([sysArgs+0])                 #15
                                          2777  bra('sys_SetMemory#18')         #16
              0b04 fc18  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     2778  ld([sysArgs+2],X)               #17
                                          2779
                                          2780  #-----------------------------------------------------------------------
                                          2781  # Extension SYS_SendSerial1_v3_80
                                          2782  #-----------------------------------------------------------------------
                                          2783
                                          2784  # SYS function for sending data over serial controller port using
                                          2785  # pulse width modulation of the vertical sync signal.
                                          2786  #
                                          2787  # Variables:
                                          2788  #       sysArgs[0:1]    Source address               (in, changed)
                                          2789  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          2790  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          2791  #
                                          2792  # The sending will abort if input data is detected on the serial port.
                                          2793  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          2794  #
                                          2795  # This modulates the next upcoming X vertical pulses with the supplied
                                          2796  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          2797  # After that, the vPulse width falls back to 8 lines (idle).
                                          2798
                                          2799  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       2800  ld([videoY])                    #15
                                          2801  bra('sys_SendSerial1')          #16
              0b07 fc83  bra  sys_SendSerial1
              0b08 60b3  xora $b3         2802  xora(videoYline0)               #17 First line of vertical blank
                                          2803
                                          2804  #-----------------------------------------------------------------------
                                          2805  # Extension SYS_ExpanderControl_v4_40
                                          2806  #-----------------------------------------------------------------------
                                          2807
                                          2808  # Sets the I/O and RAM expander's control register
                                          2809  #
                                          2810  # Variables:
                                          2811  #       vAC bit 2       Device enable /SS0
                                          2812  #           bit 3       Device enable /SS1
                                          2813  #           bit 4       Device enable /SS2
                                          2814  #           bit 5       Device enable /SS3
                                          2815  #           bit 6       Banking B0
                                          2816  #           bit 7       Banking B1
                                          2817  #           bit 15      Data out MOSI
                                          2818  #       sysArgs[7]      Cache for control state (written to)
                                          2819  #
                                          2820  # Intended for prototyping, and probably too low-level for most applications
                                          2821  # Still there's a safeguard: it's not possible to disable RAM using this
                                          2822
                                          2823  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140c  ld   $0c,y       2824  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e0fb  jmp  y,$fb       2825  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 00fc  ld   $fc         2826  ld(0b11111100)                  #17 Safety (SCLK=0)
                                          2827  #    ^^^^^^^^
                                          2828  #    |||||||`-- SCLK
                                          2829  #    ||||||`--- Not connected
                                          2830  #    |||||`---- /SS0
                                          2831  #    ||||`----- /SS1
                                          2832  #    |||`------ /SS2
                                          2833  #    ||`------- /SS3
                                          2834  #    |`-------- B0
                                          2835  #    `--------- B1
                                          2836
                                          2837
                                          2838  label('SYS_SPARE0')
SYS_SPARE0:   0b0c 140b  ld   $0b,y       2839  ld(hi('SYS_SPARE0'),Y)           #15
              0b0d e00c  jmp  y,$0c       2840  jmp(Y,'SYS_SPARE0')              #16
              0b0e 0000  ld   $00         2841  ld(0)                            #17
                                          2842
                                          2843  #-----------------------------------------------------------------------
                                          2844  # Extension SYS_ResetWaveforms_v4_50
                                          2845  #-----------------------------------------------------------------------
                                          2846
                                          2847  # soundTable[4x+0] = sawtooth, to be modified into metallic/noise
                                          2848  # soundTable[4x+1] = pulse
                                          2849  # soundTable[4x+2] = triangle
                                          2850  # soundTable[4x+3] = sawtooth, also useful to right shift 2 bits
                                          2851
                                          2852  label('SYS_ResetWaveforms_v4_50')
SYS_ResetWaveforms_v4_50:
              0b0f 140e  ld   $0e,y       2853  ld(hi('sys_ResetWaveforms'),Y)  #15 Initial setup of waveforms. [vAC+0]=i
              0b10 e0ae  jmp  y,$ae       2854  jmp(Y,'sys_ResetWaveforms')     #16
              0b11 1407  ld   $07,y       2855  ld(soundTable>>8,Y)             #17
                                          2856
                                          2857  #-----------------------------------------------------------------------
                                          2858  # Extension SYS_ShuffleNoise_v4_46
                                          2859  #-----------------------------------------------------------------------
                                          2860
                                          2861  # Use simple 6-bits variation of RC4 to permutate waveform 0 in soundTable
                                          2862
                                          2863  label('SYS_ShuffleNoise_v4_46')
SYS_ShuffleNoise_v4_46:
              0b12 140e  ld   $0e,y       2864  ld(hi('sys_ShuffleNoise'),Y)    #15 Shuffle soundTable[4i+0]. [vAC+0]=4j, [vAC+1]=4i
              0b13 e0cf  jmp  y,$cf       2865  jmp(Y,'sys_ShuffleNoise')       #16
              0b14 1407  ld   $07,y       2866  ld(soundTable>>8,Y)             #17
