                                          3321
                                          3322  #-----------------------------------------------------------------------
                                          3323  # Extension SYS_Sprite6_v3_64
                                          3324  # Extension SYS_Sprite6x_v3_64
                                          3325  # Extension SYS_Sprite6y_v3_64
                                          3326  # Extension SYS_Sprite6xy_v3_64
                                          3327  #-----------------------------------------------------------------------
                                          3328
                                          3329  # Blit sprite in screen memory
                                          3330  #
                                          3331  # Variables
                                          3332  #       vAC             Destination address in screen
                                          3333  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          3334  #                       by negative byte value N (typically N = -Y)
                                          3335  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          3336  #
                                          3337  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          3338  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          3339  # of 6 pixels at a time, and then written to the screen through the
                                          3340  # destination pointer (each chunk underneath the previous), thus
                                          3341  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          3342  # negative byte N after a chunk signals the end of the sprite data.
                                          3343  # So the sprite's height Y is determined by the source data and is
                                          3344  # therefore flexible. This negative byte value, typically N == -Y,
                                          3345  # is then used to adjust the destination pointer's high byte, to make
                                          3346  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          3347  # call for as many 6-pixel wide stripes you need. All arguments are
                                          3348  # already left in place to facilitate this. After one call, the source
                                          3349  # pointer will point past that source data, effectively:
                                          3350  #       src += Y * 6 + 1
                                          3351  # The destination pointer will have been adjusted as:
                                          3352  #       dst += (Y + N) * 256 + 6
                                          3353  # (With arithmetic wrapping around on the same memory page)
                                          3354  #
                                          3355  # Y is only limited by source memory, not by CPU cycles. The
                                          3356  # implementation is such that the SYS function self-repeats, each
                                          3357  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          3358  # pixels per scanline this way.
                                          3359
                                          3360  label('SYS_Sprite6_v3_64')
                                          3361
