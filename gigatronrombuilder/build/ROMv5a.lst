* source: /var/www/html/phpbb/ext/at67/gigatronrombuilder/romsrc/ROMv5a.asm.py
                                          178   enableListing()
                                          179   #-----------------------------------------------------------------------
                                          180   #
                                          181   #  Start of core
                                          182   #
                                          183   #-----------------------------------------------------------------------
                                          184
                                          185   # Pre-loading the formal interface as a way to get warnings when
                                          186   # accidentally redefined with a different value
                                          187   loadBindings('interface.json')
                                          188   loadBindings('Core/interface-dev.json') # Provisional values for DEVROM
                                          189
                                          190   # Gigatron clock
                                          191   cpuClock = 6.250e+06
                                          192
                                          193   # Output pin assignment for VGA
                                          194   R, G, B, hSync, vSync = 1, 4, 16, 64, 128
                                          195   syncBits = hSync+vSync # Both pulses negative
                                          196
                                          197   # When the XOUT register is in the circuit, the rising edge triggers its update.
                                          198   # The loop can therefore not be agnostic to the horizontal pulse polarity.
                                          199   assert syncBits & hSync != 0
                                          200
                                          201   # VGA 640x480 defaults (to be adjusted below!)
                                          202   vFront = 10     # Vertical front porch
                                          203   vPulse = 2      # Vertical sync pulse
                                          204   vBack  = 33     # Vertical back porch
                                          205   vgaLines = vFront + vPulse + vBack + 480
                                          206   vgaClock = 25.175e+06
                                          207
                                          208   # Video adjustments for Gigatron
                                          209   # 1. Our clock is (slightly) slower than 1/4th VGA clock. Not all monitors will
                                          210   #    accept the decreased frame rate, so we restore the frame rate to above
                                          211   #    minimum 59.94 Hz by cutting some lines from the vertical front porch.
                                          212   vFrontAdjust = vgaLines - int(4 * cpuClock / vgaClock * vgaLines)
                                          213   vFront -= vFrontAdjust
                                          214   # 2. Extend vertical sync pulse so we can feed the game controller the same
                                          215   #    signal. This is needed for controllers based on the 4021 instead of 74165
                                          216   vPulseExtension = max(0, 8-vPulse)
                                          217   vPulse += vPulseExtension
                                          218   # 3. Borrow these lines from the back porch so the refresh rate remains
                                          219   #    unaffected
                                          220   vBack -= vPulseExtension
                                          221
                                          222   # Start value of vertical blank counter
                                          223   videoYline0 = 1-2*(vFront+vPulse+vBack-2)
                                          224
                                          225   # Mismatch between video lines and sound channels
                                          226   soundDiscontinuity = (vFront+vPulse+vBack) % 4
                                          227
                                          228   # QQVGA resolution
                                          229   qqVgaWidth      = 160
                                          230   qqVgaHeight     = 120
                                          231
                                          232   # Game controller bits (actual controllers in kit have negative output)
                                          233   # +----------------------------------------+
                                          234   # |       Up                        B*     |
                                          235   # |  Left    Right               B     A*  |
                                          236   # |      Down      Select Start     A      |
                                          237   # +----------------------------------------+ *=Auto fire
                                          238   buttonRight     = 1
                                          239   buttonLeft      = 2
                                          240   buttonDown      = 4
                                          241   buttonUp        = 8
                                          242   buttonStart     = 16
                                          243   buttonSelect    = 32
                                          244   buttonB         = 64
                                          245   buttonA         = 128
                                          246
                                          247   #-----------------------------------------------------------------------
                                          248   #
                                          249   #  RAM page 0: zero-page variables
                                          250   #
                                          251   #-----------------------------------------------------------------------
                                          252
                                          253   # Memory size in pages from auto-detect
                                          254   memSize         = zpByte()
                                          255
                                          256   # The current channel number for sound generation. Advanced every scan line
                                          257   # and independent of the vertical refresh to maintain constant oscillation.
                                          258   channel         = zpByte()
                                          259
                                          260   # Next sound sample being synthesized
                                          261   sample          = zpByte()
                                          262   # To save one instruction in the critical inner loop, `sample' is always
                                          263   # reset with its own address instead of, for example, the value 0. Compare:
                                          264   # 1 instruction reset
                                          265   #       st sample,[sample]
                                          266   # 2 instruction reset:
                                          267   #       ld 0
                                          268   #       st [sample]
                                          269   # The difference is not audible. This is fine when the reset/address
                                          270   # value is low and doesn't overflow with 4 channels added to it.
                                          271   # There is an alternative, but it requires pull-down diodes on the data bus:
                                          272   #       st [sample],[sample]
                                          273   assert 4*63 + sample < 256
                                          274   # We pin this reset/address value to 3, so `sample' swings from 3 to 255
                                          275   assert sample == 3
                                          276
                                          277   # Former bootCount and bootCheck (<= ROMv3)
                                          278   zpReserved      = zpByte() # Recycled and still unused. Candidate future uses:
                                          279                              # - Video driver high address (for alternative video modes)
                                          280                              # - v6502: ADH offset ("MMU")
                                          281                              # - v8080: ???
                                          282   vCpuSelect      = zpByte() # Active interpreter page
                                          283
                                          284   # Entropy harvested from SRAM startup and controller input
                                          285   entropy         = zpByte(3)
                                          286
                                          287   # Visible video
                                          288   videoY          = zpByte() # Counts up from 0 to 238 in steps of 2
                                          289                              # Counts up (and is odd) during vertical blank
                                          290   videoModeB      = zpByte() # Handler for every 2nd line (pixel burst or vCPU)
                                          291   videoModeC      = zpByte() # Handler for every 3rd line (pixel burst or vCPU)
                                          292   videoModeD      = zpByte() # Handler for every 4th line (pixel burst or vCPU)
                                          293
                                          294   nextVideo       = zpByte() # Jump offset to scan line handler (videoA, B, C...)
                                          295   videoPulse      = nextVideo # Used for pulse width modulation
                                          296
                                          297   # Frame counter is good enough as system clock
                                          298   frameCount      = zpByte(1)
                                          299
                                          300   # Serial input (game controller)
                                          301   serialRaw       = zpByte() # New raw serial read
                                          302   serialLast      = zpByte() # Previous serial read
                                          303   buttonState     = zpByte() # Clearable button state
                                          304   resetTimer      = zpByte() # After 2 seconds of holding 'Start', do a soft reset
                                          305                              # XXX move to page 1 to free up space
                                          306
                                          307   # Extended output (blinkenlights in bit 0:3 and audio in bit 4:7). This
                                          308   # value must be present in AC during a rising hSync edge. It then gets
                                          309   # copied to the XOUT register by the hardware. The XOUT register is only
                                          310   # accessible in this indirect manner because it isn't part of the core
                                          311   # CPU architecture.
                                          312   xout            = zpByte()
                                          313   xoutMask        = zpByte() # The blinkenlights and sound on/off state
                                          314
                                          315   # vCPU interpreter
                                          316   vTicks          = zpByte()  # Interpreter ticks are units of 2 clocks
                                          317   vPC             = zpByte(2) # Interpreter program counter, points into RAM
                                          318   vAC             = zpByte(2) # Interpreter accumulator, 16-bits
                                          319   vLR             = zpByte(2) # Return address, for returning after CALL
                                          320   vSP             = zpByte(1) # Stack pointer
                                          321   vTmp            = zpByte()
                                          322   vReturn         = zpByte()  # Return into video loop (in page of vBlankStart)
                                          323
                                          324   # Scratch
                                          325   frameX          = zpByte() # Starting byte within page
                                          326   frameY          = zpByte() # Page of current pixel line (updated by videoA)
                                          327
                                          328   # Vertical blank (reuse some variables used in the visible part)
                                          329   videoSync0      = frameX   # Vertical sync type on current line (0xc0 or 0x40)
                                          330   videoSync1      = frameY   # Same during horizontal pulse (0x80 or 0x00)
                                          331
                                          332   # Versioning for GT1 compatibility
                                          333   # Please refer to Docs/GT1-files.txt for interpreting this variable
                                          334   romType         = zpByte(1)
                                          335
                                          336   # The low 3 bits are repurposed to select the actively updated sound channels.
                                          337   # Valid bit combinations are:
                                          338   #  xxxxx011     Default after reset: 4 channels (page 1,2,3,4)
                                          339   #  xxxxx001     2 channels at double update rate (page 1,2)
                                          340   #  xxxxx000     1 channel at quadruple update rate (page 1)
                                          341   # The main application for this is to free up the high bytes of page 2,3,4.
                                          342   channelMask = symbol('channelMask_v4')
                                          343   assert romType == channelMask
                                          344
                                          345   # SYS function arguments and results/scratch
                                          346   sysFn           = zpByte(2)
                                          347   sysArgs         = zpByte(8)
                                          348
                                          349   # Play sound if non-zero, count down and stop sound when zero
                                          350   soundTimer      = zpByte()
                                          351
                                          352   # Fow now the LED state machine itself is hard-coded in the program ROM
                                          353   ledTimer        = zpByte() # Number of ticks until next LED change
                                          354   ledState_v2     = zpByte() # Current LED state
                                          355   ledTempo        = zpByte() # Next value for ledTimer after LED state change
                                          356
                                          357   # All bytes above, except 0x80, are free for temporary/scratch/stacks etc
                                          358   userVars        = zpByte(0)
                                          359
                                          360   #-----------------------------------------------------------------------
                                          361   #
                                          362   #  RAM page 1: video line table
                                          363   #
                                          364   #-----------------------------------------------------------------------
                                          365
                                          366   # Byte 0-239 define the video lines
                                          367   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          368
                                          369   vReset          = 0x01f0
                                          370   vIRQ_v5         = 0x01f6
                                          371   ctrlBits        = 0x01f8
                                          372   videoTop_v5     = 0x01f9 # Number of skip lines
                                          373
                                          374   # Highest bytes are for sound channel variables
                                          375   wavA = 250      # Waveform modulation with `adda'
                                          376   wavX = 251      # Waveform modulation with `xora'
                                          377   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          378   keyH = 253      # Frequency high 8 bits
                                          379   oscL = 254      # Phase low 7 bits
                                          380   oscH = 255      # Phase high 8 bits
                                          381
                                          382   #-----------------------------------------------------------------------
                                          383   #  Memory layout
                                          384   #-----------------------------------------------------------------------
                                          385
                                          386   userCode = 0x0200       # Application vCPU code
                                          387   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          388   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          389
                                          390   #-----------------------------------------------------------------------
                                          391   #  Application definitions
                                          392   #-----------------------------------------------------------------------
                                          393
                                          394   maxTicks = 28//2                 # Duration of vCPU's slowest virtual opcode (ticks)
                                          395   minTicks = 14//2                 # vcPU's fastest instruction
                                          396
                                          397   runVcpu_overhead = 5            # Caller overhead (cycles)
                                          398   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          399
                                          400   def runVcpu(n, ref=None, returnTo=None):
                                          401     """Macro to run interpreter for exactly n cycles. Returns 0 in AC.
                                          402
                                          403     - `n' is the number of available Gigatron cycles including overhead.
                                          404       This is converted into interpreter ticks and takes into account
                                          405       the vCPU calling overheads. A `nop' is inserted when necessary
                                          406       for alignment between cycles and ticks.
                                          407     - `returnTo' is where program flow continues after return. If not set
                                          408        explicitely, it will be the first instruction behind the expansion.
                                          409     - If another interpreter than vCPU is active (v6502...), that one
                                          410       must adjust for the timing differences, because runVcpu wouldn't know."""
                                          411
                                          412     overhead = runVcpu_overhead + vCPU_overhead
                                          413     if returnTo == 0x100:         # Special case for videoZ
                                          414       overhead -= 2
                                          415
                                          416     if n is None:
                                          417       # (Clumsily) create a maximum time slice, corresponding to a vTicks
                                          418       # value of 127 (giving 282 cycles). A higher value doesn't work because
                                          419       # then SYS functions that just need 28 cycles (0 excess) won't start.
                                          420       n = (127 + maxTicks) * 2 + overhead
                                          421
                                          422     n -= overhead
                                          423     assert n > 0
                                          424
                                          425     if n % 2 == 1:
                                          426       nop()                       # Tick alignment
                                          427       n -= 1
                                          428     assert n % 2 == 0
                                          429
                                          430     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), n, ref))
                                          431
                                          432     if returnTo != 0x100:
                                          433       if returnTo is None:
                                          434         returnTo = pc() + 5       # Next instruction
                                          435       ld(lo(returnTo))            #0
                                          436       st([vReturn])               #1
                                          437
                                          438     n //= 2
                                          439     n -= maxTicks                 # First instruction always runs
                                          440     assert n < 128
                                          441
                                          442     ld([vCpuSelect],Y)            #2
                                          443     jmp(Y,'ENTER')                #3
                                          444     ld(n)                         #4
                                          445   assert runVcpu_overhead ==       5
                                          446
                                          447   #-----------------------------------------------------------------------
                                          448   #
                                          449   #  $0000 ROM page 0: Boot
                                          450   #
                                          451   #-----------------------------------------------------------------------
                                          452
                                          453   align(0x100, size=0x80)
                                          454
                                          455   # Give a first sign of life that can be checked with a voltmeter
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0000  ld   $00         456   ld(0b0000)                      # LEDs |OOOO|
              0001 1880  ld   $80,out     457   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0002 18c0  ld   $c0,out     458   ld(syncBits,OUT)                # hSync goes up, updating XOUT
                                          459
                                          460   # Setup I/O and RAM expander
              0003 c17c  rand $7c         461   ctrl(0b01111100)                # Disable SPI slaves, enable RAM, bank 1
                                          462   #      ^^^^^^^^
                                          463   #      |||||||`-- SCLK
                                          464   #      ||||||`--- Not connected
                                          465   #      |||||`---- /SS0
                                          466   #      ||||`----- /SS1
                                          467   #      |||`------ /SS2
                                          468   #      ||`------- /SS3
                                          469   #      |`-------- B0
                                          470   #      `--------- B1
                                          471   # bit15 --------- MOSI = 0
                                          472
                                          473   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0004 0001  ld   $01         474   ld(1)                           # Quick RAM test and count
                                          475   label('.countMem0')
.countMem0:   0005 d601  st   [$01],y     476   st([memSize],Y)                 # Store in RAM and load AC in Y
              0006 00ff  ld   $ff         477   ld(255)
              0007 6900  xora [y,$00]     478   xora([Y,0])                     # Invert value from memory
              0008 ca00  st   [y,$00]     479   st([Y,0])                       # Test RAM by writing the new value
              0009 c200  st   [$00]       480   st([0])                         # Copy result in [0]
              000a 6900  xora [y,$00]     481   xora([Y,0])                     # Read back and compare if written ok
              000b ec0b  bne  $000b       482   bne(pc())                       # Loop forever on RAM failure here
              000c 00ff  ld   $ff         483   ld(255)
              000d 6900  xora [y,$00]     484   xora([Y,0])                     # Invert memory value again
              000e ca00  st   [y,$00]     485   st([Y,0])                       # To restore original value
              000f 6100  xora [$00]       486   xora([0])                       # Compare with inverted copy
              0010 f014  beq  .countMem1  487   beq('.countMem1')               # If equal, we wrapped around
              0011 0101  ld   [$01]       488   ld([memSize])
              0012 fc05  bra  .countMem0  489   bra('.countMem0')               # Loop to test next address line
              0013 8200  adda ac          490   adda(AC)                        # Executes in the branch delay slot!
                                          491   label('.countMem1')
                                          492
                                          493   # Momentarily wait to allow for debouncing of the reset switch by spinning
                                          494   # roughly 2^15 times at 2 clocks per loop: 6.5ms@10MHz to 10ms@6.3MHz
                                          495   # Real-world switches normally bounce shorter than that.
                                          496   # "[...] 16 switches exhibited an average 1557 usec of bouncing, with,
                                          497   #  as I said, a max of 6200 usec" (From: http://www.ganssle.com/debouncing.htm)
                                          498   # Relevant for the breadboard version, as the kit doesn't have a reset switch.
                                          499
.countMem1:   0014 00ff  ld   $ff         500   ld(255)                         # Debounce reset button
                                          501   label('.debounce')
.debounce:    0015 c200  st   [$00]       502   st([0])
              0016 ec16  bne  $0016       503   bne(pc())
              0017 a001  suba $01         504   suba(1)                         # Branch delay slot
              0018 0100  ld   [$00]       505   ld([0])
              0019 ec15  bne  .debounce   506   bne('.debounce')
              001a a001  suba $01         507   suba(1)                         # Branch delay slot
                                          508
                                          509   # Update LEDs (memory is present and counted, reset is stable)
              001b 0001  ld   $01         510   ld(0b0001)                      # LEDs |*OOO|
              001c 1880  ld   $80,out     511   ld(syncBits^hSync,OUT)
              001d 18c0  ld   $c0,out     512   ld(syncBits,OUT)
                                          513
                                          514   # Scan the entire RAM space to collect entropy for a random number generator.
                                          515   # The 16-bit address space is scanned, even if less RAM was detected.
              001e 0000  ld   $00         516   ld(0)                           # Collect entropy from RAM
              001f d218  st   [$18],x     517   st([vAC+0],X)
              0020 d619  st   [$19],y     518   st([vAC+1],Y)
                                          519   label('.initEnt0')
.initEnt0:    0021 0106  ld   [$06]       520   ld([entropy+0])
              0022 f425  bge  .initEnt1   521   bpl('.initEnt1')
              0023 8d00  adda [y,x]       522   adda([Y,X])
              0024 60bf  xora $bf         523   xora(191)
                                          524   label('.initEnt1')
.initEnt1:    0025 c206  st   [$06]       525   st([entropy+0])
              0026 0107  ld   [$07]       526   ld([entropy+1])
              0027 f42a  bge  .initEnt2   527   bpl('.initEnt2')
              0028 8106  adda [$06]       528   adda([entropy+0])
              0029 60c1  xora $c1         529   xora(193)
                                          530   label('.initEnt2')
.initEnt2:    002a c207  st   [$07]       531   st([entropy+1])
              002b 8108  adda [$08]       532   adda([entropy+2])
              002c c208  st   [$08]       533   st([entropy+2])
              002d 0118  ld   [$18]       534   ld([vAC+0])
              002e 8001  adda $01         535   adda(1)
              002f ec21  bne  .initEnt0   536   bne('.initEnt0')
              0030 d218  st   [$18],x     537   st([vAC+0],X)
              0031 0119  ld   [$19]       538   ld([vAC+1])
              0032 8001  adda $01         539   adda(1)
              0033 ec21  bne  .initEnt0   540   bne('.initEnt0')
              0034 d619  st   [$19],y     541   st([vAC+1],Y)
                                          542
                                          543   # Update LEDs
              0035 0003  ld   $03         544   ld(0b0011)                      # LEDs |**OO|
              0036 1880  ld   $80,out     545   ld(syncBits^hSync,OUT)
              0037 18c0  ld   $c0,out     546   ld(syncBits,OUT)
                                          547
                                          548   # vCPU reset handler
              0038 00ee  ld   $ee         549   ld((vReset&255)-2)              # Setup vCPU reset handler
              0039 c216  st   [$16]       550   st([vPC])
              003a 9002  adda $02,x       551   adda(2,X)
              003b 0001  ld   $01         552   ld(vReset>>8)
              003c d617  st   [$17],y     553   st([vPC+1],Y)
              003d dc59  st   $59,[y,x++] 554   st('LDI',             [Y,Xpp])
              003e dc5e  st   $5e,[y,x++] 555   st('SYS_Reset_88',    [Y,Xpp])
              003f dc2b  st   $2b,[y,x++] 556   st('STW',             [Y,Xpp])
              0040 dc22  st   $22,[y,x++] 557   st(sysFn,             [Y,Xpp])
              0041 dcb4  st   $b4,[y,x++] 558   st('SYS',             [Y,Xpp])  # SYS -> SYS_Reset_88 -> SYS_Exec_88
              0042 dce2  st   $e2,[y,x++] 559   st(256-88//2+maxTicks,[Y,Xpp])
              0043 dc00  st   $00,[y,x++] 560   st(0,                 [Y,Xpp])  # vIRQ_v5: Disable interrupts
              0044 dc00  st   $00,[y,x++] 561   st(0,                 [Y,Xpp])  # vIRQ_v5
              0045 dcfc  st   $fc,[y,x++] 562   st(0b11111100,        [Y,Xpp])  # Control register
              0046 dc00  st   $00,[y,x++] 563   st(0,                 [Y,Xpp])  # videoTop
                                          564
              0047 0002  ld   $02         565   ld(hi('ENTER'))                 # Active interpreter vCPU
              0048 c205  st   [$05]       566   st([vCpuSelect])
                                          567
              0049 00ff  ld   $ff         568   ld(255)                         # Setup serial input
              004a c20e  st   [$0e]       569   st([frameCount])
              004b c20f  st   [$0f]       570   st([serialRaw])
              004c c210  st   [$10]       571   st([serialLast])
              004d c211  st   [$11]       572   st([buttonState])
              004e c212  st   [$12]       573   st([resetTimer])                # resetTimer<0 when entering Main.gcl
                                          574
              004f 0007  ld   $07         575   ld(0b0111)                      # LEDs |***O|
              0050 1880  ld   $80,out     576   ld(syncBits^hSync,OUT)
              0051 18c0  ld   $c0,out     577   ld(syncBits,OUT)
                                          578
              0052 0000  ld   $00         579   ld(0)
              0053 c200  st   [$00]       580   st([0])                         # Carry lookup ([0x80] in 1st line of vBlank)
              0054 c202  st   [$02]       581   st([channel])
              0055 c22c  st   [$2c]       582   st([soundTimer])
                                          583
              0056 000f  ld   $0f         584   ld(0b1111)                      # LEDs |****|
              0057 1880  ld   $80,out     585   ld(syncBits^hSync,OUT)
              0058 18c0  ld   $c0,out     586   ld(syncBits,OUT)
              0059 c213  st   [$13]       587   st([xout])                      # Setup for control by video loop
              005a c214  st   [$14]       588   st([xoutMask])
                                          589
              005b 1401  ld   $01,y       590   ld(hi('startVideo'),Y)          # Enter video loop at vertical blank
              005c e003  jmp  y,$03       591   jmp(Y,'startVideo')
              005d c22e  st   [$2e]       592   st([ledState_v2])               # Setting to 1..126 means "stopped"
