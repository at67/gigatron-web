              0e12 c216  st   [$16]       3585  st([vPC])                       #91
              0e13 09f7  ld   [y,$f7]     3586  ld([Y,vIRQ_v5+1])               #92
              0e14 c217  st   [$17]       3587  st([vPC+1])                     #93
              0e15 0105  ld   [$05]       3588  ld([vCpuSelect])                #94 Handler must save this if needed
              0e16 c219  st   [$19]       3589  st([vAC+1])                     #95
              0e17 0000  ld   $00         3590  ld(0)                           #96
              0e18 c218  st   [$18]       3591  st([vAC])                       #97
              0e19 0002  ld   $02         3592  ld(hi('ENTER'))                 #98 Set vCpuSelect to ENTER (=regular vCPU)
              0e1a c205  st   [$05]       3593  st([vCpuSelect])                #99
              0e1b 0055  ld   $55         3594  runVcpu(186-100-extra,          #100 Application cycles (scan line 0)
              0e1c c21e  st   [$1e]
              0e1d 1505  ld   [$05],y
              0e1e e0ff  jmp  y,$ff
              0e1f 0016  ld   $16
                                          3595      '---D line 0 timeout with irq',
                                          3596      returnTo='vBlankFirst#186')
