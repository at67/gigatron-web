              0378 c600  st   [x]         1594  st([X])                         #13
              0379 011c  ld   [$1c]       1595  ld([vSP])                       #14
              037a a002  suba $02         1596  suba(2)                         #15
              037b d21c  st   [$1c],x     1597  st([vSP],X)                     #16
