                                          651   #-----------------------------------------------------------------------
                                          652   # Extension SYS_Reset_88: Soft reset
                                          653   #-----------------------------------------------------------------------
                                          654
                                          655   # SYS_Reset_88 initiates an immediate Gigatron reset from within the vCPU.
                                          656   # The reset sequence itself is mostly implemented in GCL by Reset.gcl,
                                          657   # which must first be loaded into RAM. But as that takes more than 1 scanline,
                                          658   # some vCPU bootstrapping code gets loaded with SYS_Exec_88.
                                          659   # !!! This function was REMOVED from interface.json
                                          660   # !!! Better use vReset as generic entry point for soft reset
                                          661
                                          662   # ROM type (see also Docs/GT1-files.txt)
                                          663   romTypeValue = symbol('romTypeValue_ROMv5')
                                          664
                                          665   label('SYS_Reset_88')
                                          666   assert pc()>>8 == 0
                                          667   assert (romTypeValue & 7) == 0
SYS_Reset_88: 005e 0040  ld   $40         668   ld(romTypeValue)                #15 Set ROM type/version and clear channel mask
              005f c221  st   [$21]       669   st([romType])                   #16
              0060 0000  ld   $00         670   ld(0)                           #17
              0061 c21c  st   [$1c]       671   st([vSP])                       #18 vSP
              0062 1401  ld   $01,y       672   ld(hi('videoTop_v5'),Y)         #19
              0063 caf9  st   [y,$f9]     673   st([Y,lo('videoTop_v5')])       #20 Show all 120 pixel lines
              0064 caf6  st   [y,$f6]     674   st([Y,vIRQ_v5])                 #21 Disable vIRQ dispatch
              0065 caf7  st   [y,$f7]     675   st([Y,vIRQ_v5+1])               #22
              0066 c22c  st   [$2c]       676   st([soundTimer])                #23 soundTimer
                                          677   assert userCode&255 == 0
              0067 c21a  st   [$1a]       678   st([vLR])                       #24 vLR
              0068 0002  ld   $02         679   ld(userCode>>8)                 #25
              0069 c21b  st   [$1b]       680   st([vLR+1])                     #26
              006a 00f6  ld   $f6         681   ld('nopixels')                  #27 Video mode 3 (fast)
              006b c20a  st   [$0a]       682   st([videoModeB])                #28
              006c c20b  st   [$0b]       683   st([videoModeC])                #29
              006d c20c  st   [$0c]       684   st([videoModeD])                #30
              006e 00ad  ld   $ad         685   ld('SYS_Exec_88')               #31 SYS_Exec_88
              006f c222  st   [$22]       686   st([sysFn])                     #32 High byte (remains) 0
              0070 000e  ld   $0e         687   ld('Reset')                     #33 Reset.gt1 from EPROM
              0071 c224  st   [$24]       688   st([sysArgs+0])                 #34
              0072 0013  ld   $13         689   ld(hi('Reset'))                 #35
              0073 c225  st   [$25]       690   st([sysArgs+1])                 #36
              0074 0116  ld   [$16]       691   ld([vPC])                       #37 Force second SYS call
              0075 a002  suba $02         692   suba(2)                         #38
              0076 c216  st   [$16]       693   st([vPC])                       #39
                                          694   # Return to interpreter
              0077 1403  ld   $03,y       695   ld(hi('NEXTY'),Y)               #40
              0078 e000  jmp  y,$00       696   jmp(Y,'NEXTY')                  #41
              0079 00ea  ld   $ea         697   ld(-44/2)                       #42
