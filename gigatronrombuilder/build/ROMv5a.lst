              02c7 0113  ld   [$13]       1317  ld([xout])                      #26 Gets copied to XOUT
              02c8 fd0d  bra  [$0d]       1318  bra([nextVideo])                #27
              02c9 18c0  ld   $c0,out     1319  ld(syncBits,OUT)                #28 End horizontal pulse
                                          1320
                                          1321  # Back porch B: second of 4 repeated scan lines
                                          1322  # - Recompute Xi from dXi and store for retrieval in the next scan lines
                                          1323  label('videoB')
videoB:       02ca 00d3  ld   $d3         1324  ld('videoC')                    #29 2nd scanline of 4
              02cb c20d  st   [$0d]       1325  st([nextVideo])                 #30
              02cc 1401  ld   $01,y       1326  ld(videoTable>>8,Y)             #31
              02cd 0109  ld   [$09]       1327  ld([videoY])                    #32
              02ce 9001  adda $01,x       1328  adda(1,X)                       #33
              02cf 011f  ld   [$1f]       1329  ld([frameX])                    #34
              02d0 8d00  adda [y,x]       1330  adda([Y,X])                     #35
              02d1 fd0a  bra  [$0a]       1331  bra([videoModeB])               #36
              02d2 d21f  st   [$1f],x     1332  st([frameX],X)                  #37 Store in RAM and X
                                          1333
                                          1334  # Back porch C: third of 4 repeated scan lines
                                          1335  # - Nothing new to for video do as Yi and Xi are known,
                                          1336  # - This is the time to emit and reset the next sound sample
                                          1337  label('videoC')
videoC:       02d3 00dc  ld   $dc         1338  ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1339  st([nextVideo])                 #30
              02d5 0103  ld   [$03]       1340  ld([sample])                    #31 New sound sample is ready (didn't fit in the audio loop)
              02d6 400f  ora  $0f         1341  ora(0x0f)                       #32
              02d7 2114  anda [$14]       1342  anda([xoutMask])                #33
              02d8 c213  st   [$13]       1343  st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
              02d9 c003  st   $03,[$03]   1344  st(sample, [sample])            #35 Reset for next sample
              02da fd0b  bra  [$0b]       1345  bra([videoModeC])               #36
              02db 111f  ld   [$1f],x     1346  ld([frameX],X)                  #37
                                          1347
                                          1348  # Back porch D: last of 4 repeated scan lines
                                          1349  # - Calculate the next frame index
                                          1350  # - Decide if this is the last line or not
                                          1351  label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1352  ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1353  ld([videoY])                    #30
              02de a0ee  suba $ee         1354  suba((120-1)*2)                 #31
                                          1355  beq('.lastpixels#34')           #32
              02df f0e5  beq  .lastpixels#34
              02e0 80f0  adda $f0         1356  adda(120*2)                     #33 More pixel lines to go
              02e1 c209  st   [$09]       1357  st([videoY])                    #34
              02e2 0001  ld   $01         1358  ld('videoA')                    #35
              02e3 fd0c  bra  [$0c]       1359  bra([videoModeD])               #36
              02e4 c20d  st   [$0d]       1360  st([nextVideo])                 #37
                                          1361
                                          1362  label('.lastpixels#34')
                                          1363  if soundDiscontinuity == 1:
.lastpixels#34:
              02e5 c003  st   $03,[$03]   1364    st(sample, [sample])          #34 Sound continuity
                                          1365  else:
                                          1366    nop()                         #34
              02e6 00e9  ld   $e9         1367  ld('videoE')                    #35 No more pixel lines to go
              02e7 fd0c  bra  [$0c]       1368  bra([videoModeD])               #36
              02e8 c20d  st   [$0d]       1369  st([nextVideo])                 #37
                                          1370
                                          1371  # Back porch "E": after the last line
                                          1372  # - Go back and and enter vertical blank (program page 2)
                                          1373  label('videoE') # Exit visible area
videoE:       02e9 1401  ld   $01,y       1374  ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
              02ea e004  jmp  y,$04       1375  jmp(Y,'vBlankStart')            #30
              02eb 00c0  ld   $c0         1376  ld(syncBits)                    #31
                                          1377
                                          1378  # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1379  # This yields some speed, but also frees up screen memory for other purposes.
                                          1380  # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1381  # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1382  label('videoF')
videoF:       02ec 0120  ld   [$20]       1383  ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1384  adda(0x80)                      #30
              02ee d220  st   [$20],x     1385  st([videoSync1],X)              #31
              02ef 011f  ld   [$1f]       1386  ld([frameX])                    #32
              02f0 a500  suba [x]         1387  suba([X])                       #33 Decrements every two VGA scanlines
              02f1 f0f4  beq  .videoF#36  1388  beq('.videoF#36')               #34
              02f2 c21f  st   [$1f]       1389  st([frameX])                    #35
              02f3 fcf6  bra  nopixels    1390  bra('nopixels')                 #36
                                          1391  label('.videoF#36')
.videoF#36:   02f4 0001  ld   $01         1392  ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1393  st([nextVideo])                 #37
                                          1394  #
                                          1395  # Alternative for pixel burst: faster application mode
                                          1396  label('nopixels')
nopixels:     02f6 00ff  ld   $ff         1397  runVcpu(200-38, 'ABCD line 40-520',
              02f7 c21e  st   [$1e]
              02f8 1505  ld   [$05],y
              02f9 e0ff  jmp  y,$ff
              02fa 003c  ld   $3c
                                          1398    returnTo=0x1ff)               #38 Application interpreter (black scanlines)
                                          1399
                                          1400  #-----------------------------------------------------------------------
                                          1401  #
                                          1402  #  $0300 ROM page 3: Application interpreter primary page
                                          1403  #
                                          1404  #-----------------------------------------------------------------------
                                          1405
                                          1406  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1407  #
                                          1408  # This routine will execute as many as possible instructions in the
                                          1409  # allotted time. When time runs out, it synchronizes such that the total
                                          1410  # duration matches the caller's request. Durations are counted in `ticks',
                                          1411  # which are multiples of 2 clock cycles.
                                          1412  #
                                          1413  # Synopsis: Use the runVcpu() macro as entry point
                                          1414
                                          1415  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1416  # precious space in the packed interpreter code page. Although ENTER's
                                          1417  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1418  # in this case it will still jump into the right space, because branches
                                          1419  # from $xxFF land in the next page anyway.
                                          1420  while pc()&255 < 255:
              02fb 0200  nop              1421    nop()
              02fc 0200  nop
              02fd 0200  nop
              02fe 0200  nop
                                          1422  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1423  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1424  # --- Page boundary ---
                                          1425  align(0x100,size=0x100)
                                          1426  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1427  ld([vPC+1],Y)                   #1
                                          1428
                                          1429  # Fetch next instruction and execute it, but only if there are sufficient
                                          1430  # ticks left for the slowest instruction.
                                          1431  label('NEXT')
NEXT:         0301 8115  adda [$15]       1432  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        1433  blt('EXIT')                     #1 Escape near time out
                                          1434  label('.next2')
.next2:       0303 c215  st   [$15]       1435  st([vTicks])                    #2
              0304 0116  ld   [$16]       1436  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         1437  adda(2)                         #4
              0306 d216  st   [$16],x     1438  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       1439  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     1440  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          1441  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       1442  ld([Y,X])                       #9 Prefetch operand
                                          1443
                                          1444  # Resync with video driver and transfer control
                                          1445  label('EXIT')
EXIT:         030b 800e  adda $0e         1446  adda(maxTicks)                  #3
                                          1447  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      1448  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         1449  suba(1)                         #5
              030e 1401  ld   $01,y       1450  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     1451  jmp(Y,[vReturn])                #7 To video driver
              0310 0000  ld   $00         1452  ld(0)                           #8 AC should be 0 already. Still..
                                          1453  assert vCPU_overhead ==          9
                                          1454
                                          1455  # Instruction LDWI: Load immediate word constant (vAC=D), 20 cycles
                                          1456  label('LDWI')
LDWI:         0311 c218  st   [$18]       1457  st([vAC])                       #10
              0312 de00  st   [y,x++]     1458  st([Y,Xpp])                     #11 Just X++
              0313 0d00  ld   [y,x]       1459  ld([Y,X])                       #12 Fetch second operand
              0314 c219  st   [$19]       1460  st([vAC+1])                     #13
              0315 0116  ld   [$16]       1461  ld([vPC])                       #14 Advance vPC one more
              0316 8001  adda $01         1462  adda(1)                         #15
              0317 c216  st   [$16]       1463  st([vPC])                       #16
              0318 00f6  ld   $f6         1464  ld(-20/2)                       #17
              0319 fc01  bra  NEXT        1465  bra('NEXT')                     #18
                                          1466  #dummy()                        #19 Overlap
                                          1467  #
                                          1468  # Instruction LD: Load byte from zero page (vAC=[D]), 22 cycles
                                          1469  label('LD')
LD:           031a 1200  ld   ac,x        1470  ld(AC,X)                        #10,19
              031b 0500  ld   [x]         1471  ld([X])                         #11
              031c 1404  ld   $04,y       1472  ld(hi('ld#15'),Y)               #12
              031d e013  jmp  y,$13       1473  jmp(Y,'ld#15')                  #13
              031e c218  st   [$18]       1474  st([vAC])                       #14
                                          1475
                                          1476  # Instruction CMPHS: Adjust high byte for signed compare (vACH=XXX), 28 cycles
                                          1477  label('CMPHS_v5')
CMPHS_v5:     031f 140b  ld   $0b,y       1478  ld(hi('cmphs#13'),Y)            #10
              0320 e0bc  jmp  y,$bc       1479  jmp(Y,'cmphs#13')               #11
                                          1480  #ld(AC,X)                       #12 Overlap
                                          1481  #
                                          1482  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 20 cycles
                                          1483  label('LDW')
LDW:          0321 1200  ld   ac,x        1484  ld(AC,X)                        #10,12
              0322 8001  adda $01         1485  adda(1)                         #11
              0323 c21d  st   [$1d]       1486  st([vTmp])                      #12 Address of high byte
              0324 0500  ld   [x]         1487  ld([X])                         #13
              0325 c218  st   [$18]       1488  st([vAC])                       #14
              0326 111d  ld   [$1d],x     1489  ld([vTmp],X)                    #15
              0327 0500  ld   [x]         1490  ld([X])                         #16
              0328 c219  st   [$19]       1491  st([vAC+1])                     #17
              0329 fc01  bra  NEXT        1492  bra('NEXT')                     #18
              032a 00f6  ld   $f6         1493  ld(-20/2)                       #19
                                          1494
                                          1495  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 20 cycles
                                          1496  label('STW')
STW:          032b 1200  ld   ac,x        1497  ld(AC,X)                        #10,20
              032c 8001  adda $01         1498  adda(1)                         #11
              032d c21d  st   [$1d]       1499  st([vTmp])                      #12 Address of high byte
              032e 0118  ld   [$18]       1500  ld([vAC])                       #13
              032f c600  st   [x]         1501  st([X])                         #14
              0330 111d  ld   [$1d],x     1502  ld([vTmp],X)                    #15
              0331 0119  ld   [$19]       1503  ld([vAC+1])                     #16
              0332 c600  st   [x]         1504  st([X])                         #17
              0333 fc01  bra  NEXT        1505  bra('NEXT')                     #18
              0334 00f6  ld   $f6         1506  ld(-20/2)                       #19
                                          1507
                                          1508  # Instruction BCC: Test AC sign and branch conditionally, 28 cycles
                                          1509  label('BCC')
BCC:          0335 0119  ld   [$19]       1510  ld([vAC+1])                     #10 First inspect high byte of vAC
              0336 ec40  bne  .bcc#13     1511  bne('.bcc#13')                  #11
              0337 c21d  st   [$1d]       1512  st([vTmp])                      #12
              0338 0118  ld   [$18]       1513  ld([vAC])                       #13 Additionally inspect low byte of vAC
              0339 f043  beq  .bcc#16     1514  beq('.bcc#16')                  #14
              033a 0001  ld   $01         1515  ld(1)                           #15
              033b c21d  st   [$1d]       1516  st([vTmp])                      #16
              033c 0d00  ld   [y,x]       1517  ld([Y,X])                       #17 Operand is the conditional
                                          1518  label('.bcc#18')
.bcc#18:      033d fe00  bra  ac          1519  bra(AC)                         #18
              033e 011d  ld   [$1d]       1520  ld([vTmp])                      #19
                                          1521
                                          1522  # Conditional EQ: Branch if zero (if(vACL==0)vPCL=D)
                                          1523  label('EQ')
EQ:           033f ec45  bne  .bcc#22     1524  bne('.bcc#22')                  #20
                                          1525  label('.bcc#13')
.bcc#13:      0340 f048  beq  .bcc#23     1526  beq('.bcc#23')                  #21,13 AC=0 in EQ, AC!=0 from BCC... Overlap with BCC
              0341 0d00  ld   [y,x]       1527  ld([Y,X])                       #22,14 Overlap with BCC
                                          1528  #
                                          1529  # (continue BCC)
                                          1530  #label('.bcc#13')
                                          1531  #dummy()                        #13
                                          1532  #dummy()                        #14
              0342 0200  nop              1533  nop()                           #15
                                          1534  label('.bcc#16')
.bcc#16:      0343 fc3d  bra  .bcc#18     1535  bra('.bcc#18')                  #16
              0344 0d00  ld   [y,x]       1536  ld([Y,X])                       #17 Operand is the conditional
                                          1537  label('.bcc#22')
.bcc#22:      0345 0116  ld   [$16]       1538  ld([vPC])                       #22 False condition
              0346 fc4a  bra  .bcc#25     1539  bra('.bcc#25')                  #23
              0347 8001  adda $01         1540  adda(1)                         #24
                                          1541  label('.bcc#23')
.bcc#23:      0348 de00  st   [y,x++]     1542  st([Y,Xpp])                     #23 Just X++ True condition
              0349 0d00  ld   [y,x]       1543  ld([Y,X])                       #24
                                          1544  label('.bcc#25')
.bcc#25:      034a c216  st   [$16]       1545  st([vPC])                       #25
              034b fc01  bra  NEXT        1546  bra('NEXT')                     #26
              034c 00f2  ld   $f2         1547  ld(-28/2)                       #27
                                          1548
                                          1549  # Conditional GT: Branch if positive (if(vACL>0)vPCL=D)
                                          1550  label('GT')
GT:           034d f845  ble  .bcc#22     1551  ble('.bcc#22')                  #20
              034e e448  bgt  .bcc#23     1552  bgt('.bcc#23')                  #21
              034f 0d00  ld   [y,x]       1553  ld([Y,X])                       #22
                                          1554
                                          1555  # Conditional LT: Branch if negative (if(vACL<0)vPCL=D)
                                          1556  label('LT')
LT:           0350 f445  bge  .bcc#22     1557  bge('.bcc#22')                  #20
              0351 e848  blt  .bcc#23     1558  blt('.bcc#23')                  #21
              0352 0d00  ld   [y,x]       1559  ld([Y,X])                       #22
                                          1560
                                          1561  # Conditional GE: Branch if positive or zero (if(vACL>=0)vPCL=D)
                                          1562  label('GE')
GE:           0353 e845  blt  .bcc#22     1563  blt('.bcc#22')                  #20
              0354 f448  bge  .bcc#23     1564  bge('.bcc#23')                  #21
              0355 0d00  ld   [y,x]       1565  ld([Y,X])                       #22
                                          1566
                                          1567  # Conditional LE: Branch if negative or zero (if(vACL<=0)vPCL=D)
                                          1568  label('LE')
LE:           0356 e445  bgt  .bcc#22     1569  bgt('.bcc#22')                  #20
              0357 f848  ble  .bcc#23     1570  ble('.bcc#23')                  #21
              0358 0d00  ld   [y,x]       1571  ld([Y,X])                       #22
                                          1572
                                          1573  # Instruction LDI: Load immediate small positive constant (vAC=D), 16 cycles
                                          1574  label('LDI')
LDI:          0359 c218  st   [$18]       1575  st([vAC])                       #10
              035a 0000  ld   $00         1576  ld(0)                           #11
              035b c219  st   [$19]       1577  st([vAC+1])                     #12
              035c fc00  bra  NEXTY       1578  bra('NEXTY')                    #13
              035d 00f8  ld   $f8         1579  ld(-16/2)                       #14
                                          1580
                                          1581  # Instruction ST: Store byte in zero page ([D]=vAC&255), 16 cycles
                                          1582  label('ST')
ST:           035e 1200  ld   ac,x        1583  ld(AC,X)                        #10,15
              035f 0118  ld   [$18]       1584  ld([vAC])                       #11
              0360 c600  st   [x]         1585  st([X])                         #12
              0361 fc00  bra  NEXTY       1586  bra('NEXTY')                    #13
              0362 00f8  ld   $f8         1587  ld(-16/2)                       #14
                                          1588
                                          1589  # Instruction POP: Pop address from stack (vLR,vSP==[vSP]+256*[vSP+1],vSP+2), 26 cycles
                                          1590  label('POP')
POP:          0363 111c  ld   [$1c],x     1591  ld([vSP],X)                     #10,15
              0364 0500  ld   [x]         1592  ld([X])                         #11
              0365 c21a  st   [$1a]       1593  st([vLR])                       #12
              0366 011c  ld   [$1c]       1594  ld([vSP])                       #13
              0367 9001  adda $01,x       1595  adda(1,X)                       #14
              0368 0500  ld   [x]         1596  ld([X])                         #15
              0369 c21b  st   [$1b]       1597  st([vLR+1])                     #16
              036a 011c  ld   [$1c]       1598  ld([vSP])                       #17
              036b 8002  adda $02         1599  adda(2)                         #18
              036c c21c  st   [$1c]       1600  st([vSP])                       #19
                                          1601  label('.pop#20')
.pop#20:      036d 0116  ld   [$16]       1602  ld([vPC])                       #20
              036e a001  suba $01         1603  suba(1)                         #21
              036f c216  st   [$16]       1604  st([vPC])                       #22
              0370 fc00  bra  NEXTY       1605  bra('NEXTY')                    #23
              0371 00f3  ld   $f3         1606  ld(-26/2)                       #24
                                          1607
                                          1608  # Conditional NE: Branch if not zero (if(vACL!=0)vPCL=D)
                                          1609  label('NE')
NE:           0372 f045  beq  .bcc#22     1610  beq('.bcc#22')                  #20,25
              0373 ec48  bne  .bcc#23     1611  bne('.bcc#23')                  #21
              0374 0d00  ld   [y,x]       1612  ld([Y,X])                       #22
                                          1613
                                          1614  # Instruction PUSH: Push vLR on stack ([vSP-2],v[vSP-1],vSP=vLR&255,vLR>>8,vLR-2), 26 cycles
                                          1615  label('PUSH')
PUSH:         0375 011c  ld   [$1c]       1616  ld([vSP])                       #10
              0376 b001  suba $01,x       1617  suba(1,X)                       #11
              0377 011b  ld   [$1b]       1618  ld([vLR+1])                     #12
              0378 c600  st   [x]         1619  st([X])                         #13
              0379 011c  ld   [$1c]       1620  ld([vSP])                       #14
              037a a002  suba $02         1621  suba(2)                         #15
              037b d21c  st   [$1c],x     1622  st([vSP],X)                     #16
              037c 011a  ld   [$1a]       1623  ld([vLR])                       #17
              037d fc6d  bra  .pop#20     1624  bra('.pop#20')                  #18
              037e c600  st   [x]         1625  st([X])                         #19
