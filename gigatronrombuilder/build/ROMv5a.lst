                                          2246  # Interrupt handler:
                                          2247  #       ST   $xx        -> optionally store vCpuSelect
                                          2248  #       ... IRQ payload ...
                                          2249  # either:
                                          2250  #       LDWI $400
                                          2251  #       LUP  0          -> vRTI and don't switch interpreter (immediate resume)
                                          2252  # or:
                                          2253  #       LDWI $400
                                          2254  #       LUP  $xx        -> vRTI and switch interpreter type as stored in [$xx]
              04e9 0200  nop              2255  fillers(until=251-11)
              04ea 0200  nop
              04eb 0200  nop
              * 7 times
