                                          1638  # Instruction ST: Store byte in zero page ([D]=vAC&255), 16 cycles
                                          1639  label('ST')
ST:           035e 1200  ld   ac,x        1640  ld(AC,X)                        #10,15
              035f 0118  ld   [$18]       1641  ld([vAC])                       #11
              0360 c600  st   [x]         1642  st([X])                         #12
              0361 fc00  bra  NEXTY       1643  bra('NEXTY')                    #13
              0362 00f8  ld   $f8         1644  ld(-16/2)                       #14
                                          1645
                                          1646  # Instruction POP: Pop address from stack (vLR,vSP==[vSP]+256*[vSP+1],vSP+2), 26 cycles
                                          1647  label('POP')
POP:          0363 111c  ld   [$1c],x     1648  ld([vSP],X)                     #10,15
              0364 0500  ld   [x]         1649  ld([X])                         #11
              0365 c21a  st   [$1a]       1650  st([vLR])                       #12
              0366 011c  ld   [$1c]       1651  ld([vSP])                       #13
              0367 9001  adda $01,x       1652  adda(1,X)                       #14
              0368 0500  ld   [x]         1653  ld([X])                         #15
              0369 c21b  st   [$1b]       1654  st([vLR+1])                     #16
              036a 011c  ld   [$1c]       1655  ld([vSP])                       #17
              036b 8002  adda $02         1656  adda(2)                         #18
              036c c21c  st   [$1c]       1657  st([vSP])                       #19
