                                          2277  #
                                          2278  #  $0500 ROM page 5-6: Shift table and code
                                          2279  #
                                          2280  #-----------------------------------------------------------------------
                                          2281
                                          2282  align(0x100, size=0x200)
                                          2283
                                          2284  # Lookup table for i>>n, with n in 1..6
                                          2285  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          2286  #       ...
                                          2287  #       ld   <.ret
                                          2288  #       st   [vTmp]
                                          2289  #       ld   >shiftTable,y
                                          2290  #       <calculate ix>
                                          2291  #       jmp  y,ac
                                          2292  #       bra  $ff
                                          2293  # .ret: ...
                                          2294  #
                                          2295  # i >> 7 can be always be done with RAM: [i&128]
                                          2296  #       ...
                                          2297  #       anda $80,x
                                          2298  #       ld   [x]
                                          2299  #       ...
                                          2300
                                          2301  label('shiftTable')
                                          2302  shiftTable = pc()
                                          2303
                                          2304  for ix in range(255):
                                          2305    for n in range(1,7): # Find first zero
                                          2306      if ~ix & (1 << (n-1)):
                                          2307        break
                                          2308    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          2309    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
