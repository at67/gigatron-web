                                          1639  # Instruction CALLI: Goto immediate address and remember vPC (vLR,vPC=vPC+3,$HHLL-2), 28 cycles
                                          1640  label('CALLI_v5')
CALLI_v5:     0385 140b  ld   $0b,y       1641  ld(hi('calli#13'),Y)            #10
              0386 e0b0  jmp  y,$b0       1642  jmp(Y,'calli#13')               #11
              0387 0116  ld   [$16]       1643  ld([vPC])                       #12
