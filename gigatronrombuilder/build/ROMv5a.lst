                                          5175  label('sys_Exec')
sys_Exec:     124b d617  st   [$17],y     5176  st([vPC+1],Y)                   #18 Clear vPCH and Y
              124c 011c  ld   [$1c]       5177  ld([vSP])                       #19 Place ROM loader below current stack pointer
              124d a037  suba $37         5178  suba(53+2)                      #20 (AC -> *+0) One extra word for PUSH
              124e d21d  st   [$1d],x     5179  st([vTmp],X)                    #21
              124f 80fe  adda $fe         5180  adda(-2)                        #22 (AC -> *-2)
              1250 c216  st   [$16]       5181  st([vPC])                       #23
                                          5182  # Start of manually compiled vCPU section
              1251 dc75  st   $75,[y,x++] 5183  st('PUSH',    [Y,Xpp])          #24 *+0
              1252 dccf  st   $cf,[y,x++] 5184  st('CALL',    [Y,Xpp])          #25 *+26 Fetch first byte
              1253 8023  adda $23         5185  adda(33-(-2))                   #26 (AC -> *+33)
              1254 de00  st   [y,x++]     5186  st(           [Y,Xpp])          #27 *+27
              1255 dc5e  st   $5e,[y,x++] 5187  st('ST',      [Y,Xpp])          #28 *+3 Chunk copy loop
              1256 dc27  st   $27,[y,x++] 5188  st(sysArgs+3, [Y,Xpp])          #29 *+4 High-address comes first
              1257 dccf  st   $cf,[y,x++] 5189  st('CALL',    [Y,Xpp])          #30 *+5
              1258 de00  st   [y,x++]     5190  st(           [Y,Xpp])          #31 *+6
              1259 dc5e  st   $5e,[y,x++] 5191  st('ST',      [Y,Xpp])          #32 *+7
              125a dc26  st   $26,[y,x++] 5192  st(sysArgs+2, [Y,Xpp])          #33 *+8 Then the low address
              125b dccf  st   $cf,[y,x++] 5193  st('CALL',    [Y,Xpp])          #34 *+9
              125c de00  st   [y,x++]     5194  st(           [Y,Xpp])          #35 *+10
              125d dc5e  st   $5e,[y,x++] 5195  st('ST',      [Y,Xpp])          #36 *+11 Byte copy loop
              125e dc28  st   $28,[y,x++] 5196  st(sysArgs+4, [Y,Xpp])          #37 *+12 Byte count (0 means 256)
              125f dccf  st   $cf,[y,x++] 5197  st('CALL',    [Y,Xpp])          #38 *+13
              1260 de00  st   [y,x++]     5198  st(           [Y,Xpp])          #39 *+14
              1261 dcf0  st   $f0,[y,x++] 5199  st('POKE',    [Y,Xpp])          #40 *+15
              1262 dc26  st   $26,[y,x++] 5200  st(sysArgs+2, [Y,Xpp])          #41 *+16
              1263 dc93  st   $93,[y,x++] 5201  st('INC',     [Y,Xpp])          #42 *+17
              1264 dc26  st   $26,[y,x++] 5202  st(sysArgs+2, [Y,Xpp])          #43 *+18
              1265 dc1a  st   $1a,[y,x++] 5203  st('LD',      [Y,Xpp])          #44 *+19
              1266 dc28  st   $28,[y,x++] 5204  st(sysArgs+4, [Y,Xpp])          #45 *+20
              1267 dce6  st   $e6,[y,x++] 5205  st('SUBI',    [Y,Xpp])          #46 *+21
              1268 dc01  st   $01,[y,x++] 5206  st(1,         [Y,Xpp])          #47 *+22
              1269 dc35  st   $35,[y,x++] 5207  st('BCC',     [Y,Xpp])          #48 *+23
              126a dc72  st   $72,[y,x++] 5208  st('NE',      [Y,Xpp])          #49 *+24
              126b 80e8  adda $e8         5209  adda(11-2-33)                   #50 (AC -> *+9)
              126c de00  st   [y,x++]     5210  st(           [Y,Xpp])          #51 *+25
              126d dccf  st   $cf,[y,x++] 5211  st('CALL',    [Y,Xpp])          #52 *+26 Go to next block
              126e 8018  adda $18         5212  adda(33-9)                      #53 (AC -> *+33)
              126f de00  st   [y,x++]     5213  st(           [Y,Xpp])          #54 *+27
              1270 dc35  st   $35,[y,x++] 5214  st('BCC',     [Y,Xpp])          #55 *+28
              1271 dc72  st   $72,[y,x++] 5215  st('NE',      [Y,Xpp])          #56 *+29
              1272 80e0  adda $e0         5216  adda(3-2-33)                    #57 (AC -> *+1)
              1273 de00  st   [y,x++]     5217  st(           [Y,Xpp])          #58 *+30
              1274 dc63  st   $63,[y,x++] 5218  st('POP',     [Y,Xpp])          #59 *+31 End
              1275 dcff  st   $ff,[y,x++] 5219  st('RET',     [Y,Xpp])          #60 *+32
                                          5220  # Pointer constant pointing to the routine below (for use by CALL)
              1276 8022  adda $22         5221  adda(35-1)                      #61 (AC -> *+35)
              1277 de00  st   [y,x++]     5222  st(           [Y,Xpp])          #62 *+33
              1278 dc00  st   $00,[y,x++] 5223  st(0,         [Y,Xpp])          #63 *+34
                                          5224  # Routine to read next byte from ROM and advance read pointer
              1279 dc1a  st   $1a,[y,x++] 5225  st('LD',      [Y,Xpp])          #64 *+35 Test for end of ROM table
              127a dc24  st   $24,[y,x++] 5226  st(sysArgs+0, [Y,Xpp])          #65 *+36
              127b dc8c  st   $8c,[y,x++] 5227  st('XORI',    [Y,Xpp])          #66 *+37
              127c dcfb  st   $fb,[y,x++] 5228  st(251,       [Y,Xpp])          #67 *+38
              127d dc35  st   $35,[y,x++] 5229  st('BCC',     [Y,Xpp])          #68 *+39
              127e dc72  st   $72,[y,x++] 5230  st('NE',      [Y,Xpp])          #69 *+40
              127f 8009  adda $09         5231  adda(46-2-35)                   #70 (AC -> *+44)
              1280 de00  st   [y,x++]     5232  st(           [Y,Xpp])          #71 *+41
              1281 dc5e  st   $5e,[y,x++] 5233  st('ST',      [Y,Xpp])          #72 *+42 Wrap to next ROM page
              1282 dc24  st   $24,[y,x++] 5234  st(sysArgs+0, [Y,Xpp])          #73 *+43
              1283 dc93  st   $93,[y,x++] 5235  st('INC',     [Y,Xpp])          #74 *+44
              1284 dc25  st   $25,[y,x++] 5236  st(sysArgs+1, [Y,Xpp])          #75 *+45
              1285 dc21  st   $21,[y,x++] 5237  st('LDW',     [Y,Xpp])          #76 *+46 Read next byte from ROM table
              1286 dc24  st   $24,[y,x++] 5238  st(sysArgs+0, [Y,Xpp])          #77 *+47
              1287 dc7f  st   $7f,[y,x++] 5239  st('LUP',     [Y,Xpp])          #78 *+48
              1288 dc00  st   $00,[y,x++] 5240  st(0,         [Y,Xpp])          #79 *+49
              1289 dc93  st   $93,[y,x++] 5241  st('INC',     [Y,Xpp])          #80 *+50 Increment read pointer
              128a dc24  st   $24,[y,x++] 5242  st(sysArgs+0, [Y,Xpp])          #81 *+51
              128b dcff  st   $ff,[y,x++] 5243  st('RET',     [Y,Xpp])          #82 *+52 Return
