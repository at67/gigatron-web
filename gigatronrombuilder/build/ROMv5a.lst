              0400 a002  suba $02         1892  suba(2)                         #11
              0401 c216  st   [$16]       1893  st([vPC])                       #12
              0402 011b  ld   [$1b]       1894  ld([vLR+1])                     #13
              0403 c217  st   [$17]       1895  st([vPC+1])                     #14
              0404 1403  ld   $03,y       1896  ld(hi('REENTER'),Y)             #15
              0405 e0cb  jmp  y,$cb       1897  jmp(Y,'REENTER')                #16
              0406 00f6  ld   $f6         1898  ld(-20/2)                       #17
