def#13:       0407 0116  ld   [$16]       1902  ld([vPC])                       #13
              0408 8002  adda $02         1903  adda(2)                         #14
              0409 c218  st   [$18]       1904  st([vAC])                       #15
              040a 0117  ld   [$17]       1905  ld([vPC+1])                     #16
