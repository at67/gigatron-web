                                          3171  #-----------------------------------------------------------------------
                                          3172  # Extension SYS_Sprite6_v3_64
                                          3173  # Extension SYS_Sprite6x_v3_64
                                          3174  # Extension SYS_Sprite6y_v3_64
                                          3175  # Extension SYS_Sprite6xy_v3_64
                                          3176  #-----------------------------------------------------------------------
                                          3177
                                          3178  # Blit sprite in screen memory
                                          3179  #
                                          3180  # Variables
                                          3181  #       vAC             Destination address in screen
                                          3182  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          3183  #                       by negative byte value N (typically N = -Y)
                                          3184  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          3185  #
                                          3186  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          3187  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          3188  # of 6 pixels at a time, and then written to the screen through the
                                          3189  # destination pointer (each chunk underneath the previous), thus
                                          3190  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          3191  # negative byte N after a chunk signals the end of the sprite data.
                                          3192  # So the sprite's height Y is determined by the source data and is
                                          3193  # therefore flexible. This negative byte value, typically N == -Y,
                                          3194  # is then used to adjust the destination pointer's high byte, to make
                                          3195  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          3196  # call for as many 6-pixel wide stripes you need. All arguments are
                                          3197  # already left in place to facilitate this. After one call, the source
                                          3198  # pointer will point past that source data, effectively:
                                          3199  #       src += Y * 6 + 1
                                          3200  # The destination pointer will have been adjusted as:
                                          3201  #       dst += (Y + N) * 256 + 6
                                          3202  # (With arithmetic wrapping around on the same memory page)
                                          3203  #
                                          3204  # Y is only limited by source memory, not by CPU cycles. The
                                          3205  # implementation is such that the SYS function self-repeats, each
                                          3206  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          3207  # pixels per scanline this way.
                                          3208
                                          3209  label('SYS_Sprite6_v3_64')
                                          3210
SYS_Sprite6_v3_64:
              0c00 1124  ld   [$24],x     3211  ld([sysArgs+0],X)               #15 Pixel data source address
              0c01 1525  ld   [$25],y     3212  ld([sysArgs+1],Y)               #16
              0c02 0d00  ld   [y,x]       3213  ld([Y,X])                       #17 Next pixel or stop
              0c03 f411  bge  .sysDpx0    3214  bpl('.sysDpx0')                 #18
              0c04 de00  st   [y,x++]     3215  st([Y,Xpp])                     #19 Just X++
                                          3216
              0c05 8119  adda [$19]       3217  adda([vAC+1])                   #20 Adjust dst for convenience
              0c06 c219  st   [$19]       3218  st([vAC+1])                     #21
              0c07 0118  ld   [$18]       3219  ld([vAC])                       #22
              0c08 8006  adda $06         3220  adda(6)                         #23
              0c09 c218  st   [$18]       3221  st([vAC])                       #24
              0c0a 0124  ld   [$24]       3222  ld([sysArgs+0])                 #25 Adjust src for convenience
              0c0b 8001  adda $01         3223  adda(1)                         #26
