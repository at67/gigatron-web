.pop#20:      036d 0116  ld   [$16]       1659  ld([vPC])                       #20
              036e a001  suba $01         1660  suba(1)                         #21
              036f c216  st   [$16]       1661  st([vPC])                       #22
              0370 fc00  bra  NEXTY       1662  bra('NEXTY')                    #23
              0371 00f3  ld   $f3         1663  ld(-26/2)                       #24
                                          1664
                                          1665  # Conditional NE: Branch if not zero (if(vACL!=0)vPCL=D)
                                          1666  label('NE')
