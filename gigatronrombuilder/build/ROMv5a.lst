                                          972   label('startVideo')             # (Re)start of video signal from idle state
startVideo:   0103 00c0  ld   $c0         973   ld(syncBits)
                                          974
                                          975   # Start of vertical blank interval
                                          976   label('vBlankStart')
vBlankStart:  0104 c21f  st   [$1f]       977   st([videoSync0])                #32 Start of vertical blank interval
              0105 0080  ld   $80         978   ld(syncBits^hSync)              #33
