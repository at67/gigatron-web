                                          1753  label('.addw#20')
.addw#20:     03a5 3080  anda $80,x       1754  anda(0x80,X)                    #20 Move carry to bit 0
              03a6 0500  ld   [x]         1755  ld([X])                         #21
              03a7 8119  adda [$19]       1756  adda([vAC+1])                   #22 Add the high bytes with carry
              03a8 111d  ld   [$1d],x     1757  ld([vTmp],X)                    #23
              03a9 8500  adda [x]         1758  adda([X])                       #24
              03aa c219  st   [$19]       1759  st([vAC+1])                     #25 Store high result
              03ab fc01  bra  NEXT        1760  bra('NEXT')                     #26
              03ac 00f2  ld   $f2         1761  ld(-28/2)                       #27
