* source: /var/www/html/phpbb/ext/at67/gigatronrombuilder/romsrc/ROMv5a.asm.py
                                          179   enableListing()
                                          180   #-----------------------------------------------------------------------
                                          181   #
                                          182   #  Start of core
                                          183   #
                                          184   #-----------------------------------------------------------------------
                                          185
                                          186   # Pre-loading the formal interface as a way to get warnings when
                                          187   # accidentally redefined with a different value
                                          188   loadBindings('interface.json')
                                          189   loadBindings('Core/interface-dev.json') # Provisional values for DEVROM
                                          190
                                          191   # Gigatron clock
                                          192   cpuClock = 6.250e+06
                                          193
                                          194   # Output pin assignment for VGA
                                          195   R, G, B, hSync, vSync = 1, 4, 16, 64, 128
                                          196   syncBits = hSync+vSync # Both pulses negative
                                          197
                                          198   # When the XOUT register is in the circuit, the rising edge triggers its update.
                                          199   # The loop can therefore not be agnostic to the horizontal pulse polarity.
                                          200   assert syncBits & hSync != 0
                                          201
                                          202   # VGA 640x480 defaults (to be adjusted below!)
                                          203   vFront = 10     # Vertical front porch
                                          204   vPulse = 2      # Vertical sync pulse
                                          205   vBack  = 33     # Vertical back porch
                                          206   vgaLines = vFront + vPulse + vBack + 480
                                          207   vgaClock = 25.175e+06
                                          208
                                          209   # Video adjustments for Gigatron
                                          210   # 1. Our clock is (slightly) slower than 1/4th VGA clock. Not all monitors will
                                          211   #    accept the decreased frame rate, so we restore the frame rate to above
                                          212   #    minimum 59.94 Hz by cutting some lines from the vertical front porch.
                                          213   vFrontAdjust = vgaLines - int(4 * cpuClock / vgaClock * vgaLines)
                                          214   vFront -= vFrontAdjust
                                          215   # 2. Extend vertical sync pulse so we can feed the game controller the same
                                          216   #    signal. This is needed for controllers based on the 4021 instead of 74165
                                          217   vPulseExtension = max(0, 8-vPulse)
                                          218   vPulse += vPulseExtension
                                          219   # 3. Borrow these lines from the back porch so the refresh rate remains
                                          220   #    unaffected
                                          221   vBack -= vPulseExtension
                                          222
                                          223   # Start value of vertical blank counter
                                          224   videoYline0 = 1-2*(vFront+vPulse+vBack-2)
                                          225
                                          226   # Mismatch between video lines and sound channels
                                          227   soundDiscontinuity = (vFront+vPulse+vBack) % 4
                                          228
                                          229   # QQVGA resolution
                                          230   qqVgaWidth      = 160
                                          231   qqVgaHeight     = 120
                                          232
                                          233   # Game controller bits (actual controllers in kit have negative output)
                                          234   # +----------------------------------------+
                                          235   # |       Up                        B*     |
                                          236   # |  Left    Right               B     A*  |
                                          237   # |      Down      Select Start     A      |
                                          238   # +----------------------------------------+ *=Auto fire
                                          239   buttonRight     = 1
                                          240   buttonLeft      = 2
                                          241   buttonDown      = 4
                                          242   buttonUp        = 8
                                          243   buttonStart     = 16
                                          244   buttonSelect    = 32
                                          245   buttonB         = 64
                                          246   buttonA         = 128
                                          247
                                          248   #-----------------------------------------------------------------------
                                          249   #
                                          250   #  RAM page 0: zero-page variables
                                          251   #
                                          252   #-----------------------------------------------------------------------
                                          253
                                          254   # Memory size in pages from auto-detect
                                          255   memSize         = zpByte()
                                          256
                                          257   # The current channel number for sound generation. Advanced every scan line
                                          258   # and independent of the vertical refresh to maintain constant oscillation.
                                          259   channel         = zpByte()
                                          260
                                          261   # Next sound sample being synthesized
                                          262   sample          = zpByte()
                                          263   # To save one instruction in the critical inner loop, `sample' is always
                                          264   # reset with its own address instead of, for example, the value 0. Compare:
                                          265   # 1 instruction reset
                                          266   #       st sample,[sample]
                                          267   # 2 instruction reset:
                                          268   #       ld 0
                                          269   #       st [sample]
                                          270   # The difference is not audible. This is fine when the reset/address
                                          271   # value is low and doesn't overflow with 4 channels added to it.
                                          272   # There is an alternative, but it requires pull-down diodes on the data bus:
                                          273   #       st [sample],[sample]
                                          274   assert 4*63 + sample < 256
                                          275   # We pin this reset/address value to 3, so `sample' swings from 3 to 255
                                          276   assert sample == 3
                                          277
                                          278   # Former bootCount and bootCheck (<= ROMv3)
                                          279   zpReserved      = zpByte() # Recycled and still unused. Candidate future uses:
                                          280                              # - Video driver high address (for alternative video modes)
                                          281                              # - v6502: ADH offset ("MMU")
                                          282                              # - v8080: ???
                                          283   vCpuSelect      = zpByte() # Active interpreter page
                                          284
                                          285   # Entropy harvested from SRAM startup and controller input
                                          286   entropy         = zpByte(3)
                                          287
                                          288   # Visible video
                                          289   videoY          = zpByte() # Counts up from 0 to 238 in steps of 2
                                          290                              # Counts up (and is odd) during vertical blank
                                          291   videoModeB      = zpByte() # Handler for every 2nd line (pixel burst or vCPU)
                                          292   videoModeC      = zpByte() # Handler for every 3rd line (pixel burst or vCPU)
                                          293   videoModeD      = zpByte() # Handler for every 4th line (pixel burst or vCPU)
                                          294
                                          295   nextVideo       = zpByte() # Jump offset to scan line handler (videoA, B, C...)
                                          296   videoPulse      = nextVideo # Used for pulse width modulation
                                          297
                                          298   # Frame counter is good enough as system clock
                                          299   frameCount      = zpByte(1)
                                          300
                                          301   # Serial input (game controller)
                                          302   serialRaw       = zpByte() # New raw serial read
                                          303   serialLast      = zpByte() # Previous serial read
                                          304   buttonState     = zpByte() # Clearable button state
                                          305   resetTimer      = zpByte() # After 2 seconds of holding 'Start', do a soft reset
                                          306                              # XXX move to page 1 to free up space
                                          307
                                          308   # Extended output (blinkenlights in bit 0:3 and audio in bit 4:7). This
                                          309   # value must be present in AC during a rising hSync edge. It then gets
                                          310   # copied to the XOUT register by the hardware. The XOUT register is only
                                          311   # accessible in this indirect manner because it isn't part of the core
                                          312   # CPU architecture.
                                          313   xout            = zpByte()
                                          314   xoutMask        = zpByte() # The blinkenlights and sound on/off state
                                          315
                                          316   # vCPU interpreter
                                          317   vTicks          = zpByte()  # Interpreter ticks are units of 2 clocks
                                          318   vPC             = zpByte(2) # Interpreter program counter, points into RAM
                                          319   vAC             = zpByte(2) # Interpreter accumulator, 16-bits
                                          320   vLR             = zpByte(2) # Return address, for returning after CALL
                                          321   vSP             = zpByte(1) # Stack pointer
                                          322   vTmp            = zpByte()
                                          323   vReturn         = zpByte()  # Return into video loop (in page of vBlankStart)
                                          324
                                          325   # Scratch
                                          326   frameX          = zpByte() # Starting byte within page
                                          327   frameY          = zpByte() # Page of current pixel line (updated by videoA)
                                          328
                                          329   # Vertical blank (reuse some variables used in the visible part)
                                          330   videoSync0      = frameX   # Vertical sync type on current line (0xc0 or 0x40)
                                          331   videoSync1      = frameY   # Same during horizontal pulse (0x80 or 0x00)
                                          332
                                          333   # Versioning for GT1 compatibility
                                          334   # Please refer to Docs/GT1-files.txt for interpreting this variable
                                          335   romType         = zpByte(1)
                                          336
                                          337   # The low 3 bits are repurposed to select the actively updated sound channels.
                                          338   # Valid bit combinations are:
                                          339   #  xxxxx011     Default after reset: 4 channels (page 1,2,3,4)
                                          340   #  xxxxx001     2 channels at double update rate (page 1,2)
                                          341   #  xxxxx000     1 channel at quadruple update rate (page 1)
                                          342   # The main application for this is to free up the high bytes of page 2,3,4.
                                          343   channelMask = symbol('channelMask_v4')
                                          344   assert romType == channelMask
                                          345
                                          346   # SYS function arguments and results/scratch
                                          347   sysFn           = zpByte(2)
                                          348   sysArgs         = zpByte(8)
                                          349
                                          350   # Play sound if non-zero, count down and stop sound when zero
                                          351   soundTimer      = zpByte()
                                          352
                                          353   # Fow now the LED state machine itself is hard-coded in the program ROM
                                          354   ledTimer        = zpByte() # Number of ticks until next LED change
                                          355   ledState_v2     = zpByte() # Current LED state
                                          356   ledTempo        = zpByte() # Next value for ledTimer after LED state change
                                          357
                                          358   # All bytes above, except 0x80, are free for temporary/scratch/stacks etc
                                          359   userVars        = zpByte(0)
                                          360
                                          361   #-----------------------------------------------------------------------
                                          362   #
                                          363   #  RAM page 1: video line table
                                          364   #
                                          365   #-----------------------------------------------------------------------
                                          366
                                          367   # Byte 0-239 define the video lines
                                          368   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          369
                                          370   vReset          = 0x01f0
                                          371   vIRQ_v5         = 0x01f6
                                          372   ctrlBits        = 0x01f8
                                          373   videoTop_v5     = 0x01f9 # Number of skip lines
                                          374
                                          375   # Highest bytes are for sound channel variables
                                          376   wavA = 250      # Waveform modulation with `adda'
                                          377   wavX = 251      # Waveform modulation with `xora'
                                          378   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          379   keyH = 253      # Frequency high 8 bits
                                          380   oscL = 254      # Phase low 7 bits
                                          381   oscH = 255      # Phase high 8 bits
                                          382
                                          383   #-----------------------------------------------------------------------
                                          384   #  Memory layout
                                          385   #-----------------------------------------------------------------------
                                          386
                                          387   userCode = 0x0200       # Application vCPU code
                                          388   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          389   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          390
                                          391   #-----------------------------------------------------------------------
                                          392   #  Application definitions
                                          393   #-----------------------------------------------------------------------
                                          394
                                          395   maxTicks = 28//2                 # Duration of vCPU's slowest virtual opcode (ticks)
                                          396   minTicks = 14//2                 # vcPU's fastest instruction
                                          397   v6502_maxTicks = 38//2           # Max duration of v6502 processing phase (ticks)
                                          398
                                          399   runVcpu_overhead = 5            # Caller overhead (cycles)
                                          400   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          401   v6502_overhead = 11             # Callee overhead for v6502 (cycles)
                                          402
                                          403   v6502_adjust = (v6502_maxTicks - maxTicks) + (v6502_overhead - vCPU_overhead)//2
                                          404   assert v6502_adjust >= 0        # v6502's overhead is a bit more than vCPU
                                          405
                                          406   def runVcpu(n, ref=None, returnTo=None):
                                          407     """Macro to run interpreter for exactly n cycles. Returns 0 in AC.
                                          408
                                          409     - `n' is the number of available Gigatron cycles including overhead.
                                          410       This is converted into interpreter ticks and takes into account
                                          411       the vCPU calling overheads. A `nop' is inserted when necessary
                                          412       for alignment between cycles and ticks.
                                          413     - `returnTo' is where program flow continues after return. If not set
                                          414        explicitely, it will be the first instruction behind the expansion.
                                          415     - If another interpreter than vCPU is active (v6502...), that one
                                          416       must adjust for the timing differences, because runVcpu wouldn't know."""
                                          417
                                          418     overhead = runVcpu_overhead + vCPU_overhead
                                          419     if returnTo == 0x100:         # Special case for videoZ
                                          420       overhead -= 2
                                          421
                                          422     if n is None:
                                          423       # (Clumsily) create a maximum time slice, corresponding to a vTicks
                                          424       # value of 127 (giving 282 cycles). A higher value doesn't work because
                                          425       # then SYS functions that just need 28 cycles (0 excess) won't start.
                                          426       n = (127 + maxTicks) * 2 + overhead
                                          427
                                          428     n -= overhead
                                          429     assert n > 0
                                          430
                                          431     if n % 2 == 1:
                                          432       nop()                       # Tick alignment
                                          433       n -= 1
                                          434     assert n % 2 == 0
                                          435
                                          436     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), n, ref))
                                          437
                                          438     if returnTo != 0x100:
                                          439       if returnTo is None:
                                          440         returnTo = pc() + 5       # Next instruction
                                          441       ld(lo(returnTo))            #0
                                          442       st([vReturn])               #1
                                          443
                                          444     n //= 2
                                          445     n -= maxTicks                 # First instruction always runs
                                          446     assert n < 128
                                          447     assert n >= v6502_adjust
                                          448
                                          449     ld([vCpuSelect],Y)            #2
                                          450     jmp(Y,'ENTER')                #3
                                          451     ld(n)                         #4
                                          452   assert runVcpu_overhead ==       5
                                          453
                                          454   #-----------------------------------------------------------------------
                                          455   #       v6502 definitions
                                          456   #-----------------------------------------------------------------------
                                          457
                                          458   # Registers are zero page variables
                                          459   v6502_PC        = vLR           # Program Counter
                                          460   v6502_PCL       = vLR+0         # Program Counter Low
                                          461   v6502_PCH       = vLR+1         # Program Counter High
                                          462   v6502_S         = vSP           # Stack Pointer (kept as "S+1")
                                          463   v6502_A         = vAC+0         # Accumulator
                                          464   v6502_BI        = vAC+1         # B Input Register (used by SBC)
                                          465   v6502_ADL       = sysArgs+0     # Low Address Register
                                          466   v6502_ADH       = sysArgs+1     # High Address Register
                                          467   v6502_IR        = sysArgs+2     # Instruction Register
                                          468   v6502_P         = sysArgs+3     # Processor Status Register (V flag in bit 7)
                                          469   v6502_Qz        = sysArgs+4     # Quick Status Register for Z flag
                                          470   v6502_Qn        = sysArgs+5     # Quick Status Register for N flag
                                          471   v6502_X         = sysArgs+6     # Index Register X
                                          472   v6502_Y         = sysArgs+7     # Index Register Y
                                          473   v6502_Tmp       = vTmp          # Scratch (may be clobbered outside v6502)
                                          474
                                          475   # MOS 6502 definitions for P register
                                          476   v6502_Cflag = 1                 # Carry Flag (unsigned overflow)
                                          477   v6502_Zflag = 2                 # Zero Flag (all bits zero)
                                          478   v6502_Iflag = 4                 # Interrupt Enable Flag (1=Disable)
                                          479   v6502_Dflag = 8                 # Decimal Enable Flag (aka BCD mode, 1=Enable)
                                          480   v6502_Bflag = 16                # Break (or PHP) Instruction Flag
                                          481   v6502_Uflag = 32                # Unused (always 1)
                                          482   v6502_Vflag = 64                # Overflow Flag (signed overflow)
                                          483   v6502_Nflag = 128               # Negative Flag (bit 7 of result)
                                          484
                                          485   # In emulation it is much faster to keep the V flag in bit 7
                                          486   # This can be corrected when importing/exporting with PHP, PLP, etc
                                          487   v6502_Vemu = 128
                                          488
                                          489   # On overflow:
                                          490   #       """Overflow is set if two inputs with the same sign produce
                                          491   #          a result with a different sign. Otherwise it is clear."""
                                          492   # Formula (without carry/borrow in!):
                                          493   #       (A ^ (A+B)) & (B ^ (A+B)) & 0x80
                                          494   # References:
                                          495   #       http://www.righto.com/2012/12/the-6502-overflow-flag-explained.html
                                          496   #       http://6502.org/tutorials/vflag.html
                                          497
                                          498   # Memory layout
                                          499   v6502_Stack     = 0x0000        # 0x0100 is already used in the Gigatron
                                          500   #v6502_NMI      = 0xfffa
                                          501   #v6502_RESET    = 0xfffc
                                          502   #v6502_IRQ      = 0xfffe
                                          503
                                          504   #-----------------------------------------------------------------------
                                          505   #
                                          506   #  $0000 ROM page 0: Boot
                                          507   #
                                          508   #-----------------------------------------------------------------------
                                          509
                                          510   align(0x100, size=0x80)
                                          511
                                          512   # Give a first sign of life that can be checked with a voltmeter
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0000  ld   $00         513   ld(0b0000)                      # LEDs |OOOO|
              0001 1880  ld   $80,out     514   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0002 18c0  ld   $c0,out     515   ld(syncBits,OUT)                # hSync goes up, updating XOUT
                                          516
                                          517   # Setup I/O and RAM expander
              0003 c17c  rand $7c         518   ctrl(0b01111100)                # Disable SPI slaves, enable RAM, bank 1
                                          519   #      ^^^^^^^^
                                          520   #      |||||||`-- SCLK
                                          521   #      ||||||`--- Not connected
                                          522   #      |||||`---- /SS0
                                          523   #      ||||`----- /SS1
                                          524   #      |||`------ /SS2
                                          525   #      ||`------- /SS3
                                          526   #      |`-------- B0
                                          527   #      `--------- B1
                                          528   # bit15 --------- MOSI = 0
                                          529
                                          530   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0004 0001  ld   $01         531   ld(1)                           # Quick RAM test and count
                                          532   label('.countMem0')
.countMem0:   0005 d601  st   [$01],y     533   st([memSize],Y)                 # Store in RAM and load AC in Y
              0006 00ff  ld   $ff         534   ld(255)
              0007 6900  xora [y,$00]     535   xora([Y,0])                     # Invert value from memory
              0008 ca00  st   [y,$00]     536   st([Y,0])                       # Test RAM by writing the new value
              0009 c200  st   [$00]       537   st([0])                         # Copy result in [0]
              000a 6900  xora [y,$00]     538   xora([Y,0])                     # Read back and compare if written ok
              000b ec0b  bne  $000b       539   bne(pc())                       # Loop forever on RAM failure here
              000c 00ff  ld   $ff         540   ld(255)
              000d 6900  xora [y,$00]     541   xora([Y,0])                     # Invert memory value again
              000e ca00  st   [y,$00]     542   st([Y,0])                       # To restore original value
              000f 6100  xora [$00]       543   xora([0])                       # Compare with inverted copy
              0010 f014  beq  .countMem1  544   beq('.countMem1')               # If equal, we wrapped around
              0011 0101  ld   [$01]       545   ld([memSize])
              0012 fc05  bra  .countMem0  546   bra('.countMem0')               # Loop to test next address line
              0013 8200  adda ac          547   adda(AC)                        # Executes in the branch delay slot!
                                          548   label('.countMem1')
                                          549
                                          550   # Momentarily wait to allow for debouncing of the reset switch by spinning
                                          551   # roughly 2^15 times at 2 clocks per loop: 6.5ms@10MHz to 10ms@6.3MHz
                                          552   # Real-world switches normally bounce shorter than that.
                                          553   # "[...] 16 switches exhibited an average 1557 usec of bouncing, with,
                                          554   #  as I said, a max of 6200 usec" (From: http://www.ganssle.com/debouncing.htm)
                                          555   # Relevant for the breadboard version, as the kit doesn't have a reset switch.
                                          556
.countMem1:   0014 00ff  ld   $ff         557   ld(255)                         # Debounce reset button
                                          558   label('.debounce')
.debounce:    0015 c200  st   [$00]       559   st([0])
              0016 ec16  bne  $0016       560   bne(pc())
              0017 a001  suba $01         561   suba(1)                         # Branch delay slot
              0018 0100  ld   [$00]       562   ld([0])
              0019 ec15  bne  .debounce   563   bne('.debounce')
              001a a001  suba $01         564   suba(1)                         # Branch delay slot
                                          565
                                          566   # Update LEDs (memory is present and counted, reset is stable)
              001b 0001  ld   $01         567   ld(0b0001)                      # LEDs |*OOO|
              001c 1880  ld   $80,out     568   ld(syncBits^hSync,OUT)
              001d 18c0  ld   $c0,out     569   ld(syncBits,OUT)
                                          570
                                          571   # Scan the entire RAM space to collect entropy for a random number generator.
                                          572   # The 16-bit address space is scanned, even if less RAM was detected.
              001e 0000  ld   $00         573   ld(0)                           # Collect entropy from RAM
              001f d218  st   [$18],x     574   st([vAC+0],X)
              0020 d619  st   [$19],y     575   st([vAC+1],Y)
                                          576   label('.initEnt0')
.initEnt0:    0021 0106  ld   [$06]       577   ld([entropy+0])
              0022 f425  bge  .initEnt1   578   bpl('.initEnt1')
              0023 8d00  adda [y,x]       579   adda([Y,X])
              0024 60bf  xora $bf         580   xora(191)
                                          581   label('.initEnt1')
.initEnt1:    0025 c206  st   [$06]       582   st([entropy+0])
              0026 0107  ld   [$07]       583   ld([entropy+1])
              0027 f42a  bge  .initEnt2   584   bpl('.initEnt2')
              0028 8106  adda [$06]       585   adda([entropy+0])
              0029 60c1  xora $c1         586   xora(193)
                                          587   label('.initEnt2')
.initEnt2:    002a c207  st   [$07]       588   st([entropy+1])
              002b 8108  adda [$08]       589   adda([entropy+2])
              002c c208  st   [$08]       590   st([entropy+2])
              002d 0118  ld   [$18]       591   ld([vAC+0])
              002e 8001  adda $01         592   adda(1)
              002f ec21  bne  .initEnt0   593   bne('.initEnt0')
              0030 d218  st   [$18],x     594   st([vAC+0],X)
              0031 0119  ld   [$19]       595   ld([vAC+1])
              0032 8001  adda $01         596   adda(1)
              0033 ec21  bne  .initEnt0   597   bne('.initEnt0')
              0034 d619  st   [$19],y     598   st([vAC+1],Y)
                                          599
                                          600   # Update LEDs
              0035 0003  ld   $03         601   ld(0b0011)                      # LEDs |**OO|
              0036 1880  ld   $80,out     602   ld(syncBits^hSync,OUT)
              0037 18c0  ld   $c0,out     603   ld(syncBits,OUT)
                                          604
                                          605   # vCPU reset handler
              0038 00ee  ld   $ee         606   ld((vReset&255)-2)              # Setup vCPU reset handler
              0039 c216  st   [$16]       607   st([vPC])
              003a 9002  adda $02,x       608   adda(2,X)
              003b 0001  ld   $01         609   ld(vReset>>8)
              003c d617  st   [$17],y     610   st([vPC+1],Y)
              003d dc59  st   $59,[y,x++] 611   st('LDI',             [Y,Xpp])
              003e dc5e  st   $5e,[y,x++] 612   st('SYS_Reset_88',    [Y,Xpp])
              003f dc2b  st   $2b,[y,x++] 613   st('STW',             [Y,Xpp])
              0040 dc22  st   $22,[y,x++] 614   st(sysFn,             [Y,Xpp])
              0041 dcb4  st   $b4,[y,x++] 615   st('SYS',             [Y,Xpp])  # SYS -> SYS_Reset_88 -> SYS_Exec_88
              0042 dce2  st   $e2,[y,x++] 616   st(256-88//2+maxTicks,[Y,Xpp])
              0043 dc00  st   $00,[y,x++] 617   st(0,                 [Y,Xpp])  # vIRQ_v5: Disable interrupts
              0044 dc00  st   $00,[y,x++] 618   st(0,                 [Y,Xpp])  # vIRQ_v5
              0045 dcfc  st   $fc,[y,x++] 619   st(0b11111100,        [Y,Xpp])  # Control register
              0046 dc00  st   $00,[y,x++] 620   st(0,                 [Y,Xpp])  # videoTop
                                          621
              0047 0002  ld   $02         622   ld(hi('ENTER'))                 # Active interpreter (vCPU,v6502) = vCPU
              0048 c205  st   [$05]       623   st([vCpuSelect])
                                          624
              0049 00ff  ld   $ff         625   ld(255)                         # Setup serial input
              004a c20e  st   [$0e]       626   st([frameCount])
              004b c20f  st   [$0f]       627   st([serialRaw])
              004c c210  st   [$10]       628   st([serialLast])
              004d c211  st   [$11]       629   st([buttonState])
              004e c212  st   [$12]       630   st([resetTimer])                # resetTimer<0 when entering Main.gcl
                                          631
              004f 0007  ld   $07         632   ld(0b0111)                      # LEDs |***O|
              0050 1880  ld   $80,out     633   ld(syncBits^hSync,OUT)
              0051 18c0  ld   $c0,out     634   ld(syncBits,OUT)
