                                          1627  # Instruction LUP: ROM lookup (vAC=ROM[vAC+D]), 26 cycles
                                          1628  label('LUP')
LUP:          037f 1519  ld   [$19],y     1629  ld([vAC+1],Y)                   #10
              0380 e0fb  jmp  y,$fb       1630  jmp(Y,251)                      #11 Trampoline offset
              0381 8118  adda [$18]       1631  adda([vAC])                     #12
