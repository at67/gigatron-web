                                          1151
                                          1152  # Respond to reset button (14 cycles)
                                          1153  # - ResetTimer decrements as long as just [Start] is pressed down
                                          1154  # - Reaching 0 (normal) or 128 (extended) triggers the soft reset sequence
                                          1155  # - Initial value is 128 (or 255 at boot), first decrement, then check
                                          1156  # - This starts vReset -> SYS_Reset_88 -> SYS_Exec_88 -> Reset.gcl -> Main.gcl
                                          1157  # - Main.gcl then recognizes extended presses if resetTimer is 0..127 ("paasei")
                                          1158  # - This requires a full cycle (4s) in the warm boot scenario
                                          1159  # - Or a half cycle (2s) when pressing [Select] down during hard reset
                                          1160  # - This furthermore requires >=1 frame (and <=128) to have passed between
                                          1161  #   reaching 128 and getting through Reset and the start of Main, while [Start]
                                          1162  #   was still pressed so the count reaches <128. Two reasonable expectations.
                                          1163  # - The unintended power-up scenarios of ROMv1 (pulling SER_DATA low, or
                                          1164  #   pressing [Select] together with another button) now don't trigger anymore.
                                          1165
vBlankLast#52:
              01b3 0111  ld   [$11]       1166  ld([buttonState])               #52 Check [Start] for soft reset
              01b4 60ef  xora $ef         1167  xora(~buttonStart)              #53
              01b5 ecbe  bne  .restart#56 1168  bne('.restart#56')              #54
              01b6 0112  ld   [$12]       1169  ld([resetTimer])                #55 As long as button pressed
              01b7 a001  suba $01         1170  suba(1)                         #56 ... count down the timer
              01b8 c212  st   [$12]       1171  st([resetTimer])                #57
              01b9 207f  anda $7f         1172  anda(127)                       #58
              01ba f0c6  beq  .restart#61 1173  beq('.restart#61')              #59 Reset at 0 (normal 2s) or 128 (extended 4s)
              01bb 00ee  ld   $ee         1174  ld((vReset&255)-2)              #60 Start force reset when hitting 0
              01bc fcc5  bra  .restart#63 1175  bra('.restart#63')              #61 ... otherwise do nothing yet
              01bd fcc4  bra  .restart#64 1176  bra('.restart#64')              #62
                                          1177  label('.restart#56')
