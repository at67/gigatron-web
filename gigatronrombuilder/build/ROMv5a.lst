                                          3807  # SYS_ResetWaveforms_v4_50 implementation
                                          3808  label('sys_ResetWaveforms')
sys_ResetWaveforms:
              0eae 0118  ld   [$18]       3809  ld([vAC+0])                     #18 X=4i
              0eaf 8200  adda ac          3810  adda(AC)                        #19
              0eb0 9200  adda ac,x        3811  adda(AC,X)                      #20
              0eb1 0118  ld   [$18]       3812  ld([vAC+0])                     #21
              0eb2 de00  st   [y,x++]     3813  st([Y,Xpp])                     #22 Sawtooth: T[4i+0] = i
              0eb3 2020  anda $20         3814  anda(0x20)                      #23 Triangle: T[4i+1] = 2i if i<32 else 127-2i
              0eb4 ecb7  bne  $0eb7       3815  bne(pc()+3)                     #24
              0eb5 0118  ld   [$18]       3816  ld([vAC+0])                     #25
              0eb6 fcb9  bra  $0eb9       3817  bra(pc()+3)                     #26
              0eb7 8118  adda [$18]       3818  adda([vAC+0])                   #26,27
              0eb8 607f  xora $7f         3819  xora(127)                       #27
              0eb9 de00  st   [y,x++]     3820  st([Y,Xpp])                     #28
              0eba 0118  ld   [$18]       3821  ld([vAC+0])                     #29 Pulse: T[4i+2] = 0 if i<32 else 63
              0ebb 2020  anda $20         3822  anda(0x20)                      #30
              0ebc ecbf  bne  $0ebf       3823  bne(pc()+3)                     #31
              0ebd fcc0  bra  $0ec0       3824  bra(pc()+3)                     #32
              0ebe 0000  ld   $00         3825  ld(0)                           #33
              0ebf 003f  ld   $3f         3826  ld(63)                          #33(!)
              0ec0 de00  st   [y,x++]     3827  st([Y,Xpp])                     #34
              0ec1 0118  ld   [$18]       3828  ld([vAC+0])                     #35 Sawtooth: T[4i+3] = i
              0ec2 ce00  st   [y,x]       3829  st([Y,X])                       #36
              0ec3 8001  adda $01         3830  adda(1)                         #37 i += 1
              0ec4 c218  st   [$18]       3831  st([vAC+0])                     #38
              0ec5 6040  xora $40         3832  xora(64)                        #39 For 64 iterations
              0ec6 f0c9  beq  $0ec9       3833  beq(pc()+3)                     #40
              0ec7 fcca  bra  $0eca       3834  bra(pc()+3)                     #41
              0ec8 00fe  ld   $fe         3835  ld(-2)                          #42
              0ec9 0000  ld   $00         3836  ld(0)                           #42(!)
              0eca 8116  adda [$16]       3837  adda([vPC])                     #43
              0ecb c216  st   [$16]       3838  st([vPC])                       #44
              0ecc 1403  ld   $03,y       3839  ld(hi('REENTER'),Y)             #45
              0ecd e0cb  jmp  y,$cb       3840  jmp(Y,'REENTER')                #46
              0ece 00e7  ld   $e7         3841  ld(-50/2)                       #47
