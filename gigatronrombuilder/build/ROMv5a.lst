                                          791   #       sysArgs[0:1]    ROM pointer (in)
                                          792   #       sysArgs[2:3]    RAM pointer (changed)
                                          793   #       sysArgs[4]      State counter (changed)
                                          794   #       vLR             vCPU continues here (in)
                                          795
