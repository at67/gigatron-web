                                          5092  # Entered last line of vertical blank (line 40)
                                          5093  label('vBlankLast#34')
                                          5094
                                          5095  #-----------------------------------------------------------------------
                                          5096  #       Extended vertical blank logic: game controller decoding
                                          5097  #-----------------------------------------------------------------------
                                          5098
                                          5099  # Game controller types
                                          5100  # TypeA: Based on 74LS165 shift register (not supported)
                                          5101  # TypeB: Based on CD4021B shift register (standard)
                                          5102  # TypeC: Based on priority encoder
                                          5103  #
                                          5104  # Notes:
                                          5105  # - TypeA was only used during development and first beta test, before ROM v1
                                          5106  # - TypeB appears as type A with negative logic levels
                                          5107  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          5108  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          5109  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          5110  # - TypeB and TypeC can be sampled in the same scanline
                                          5111  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          5112  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          5113  #
                                          5114  #       TypeC    Alias    Button TypeB
                                          5115  #       00000000  ^@   -> Right  11111110
                                          5116  #       00000001  ^A   -> Left   11111101
                                          5117  #       00000011  ^C   -> Down   11111011
                                          5118  #       00000111  ^G   -> Up     11110111
                                          5119  #       00001111  ^O   -> Start  11101111
                                          5120  #       00011111  ^_   -> Select 11011111
                                          5121  #       00111111  ?    -> B      10111111
                                          5122  #       01111111  DEL  -> A      01111111
                                          5123  #       11111111       -> (None) 11111111
                                          5124  #
                                          5125  #       Conversion formula:
                                          5126  #               f(x) := 254 - x
                                          5127
                                          5128  # Detect controller TypeC codes
vBlankLast#34:
              122e 010f  ld   [$0f]       5129  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              122f 8001  adda $01         5130  adda(1)                         #35
              1230 210f  anda [$0f]       5131  anda([serialRaw])               #36
              1231 ec42  bne  .buttons#39 5132  bne('.buttons#39')              #37
                                          5133
                                          5134  # TypeC
              1232 010f  ld   [$0f]       5135  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              1233 8001  adda $01         5136  adda(1)                         #39
              1234 2110  anda [$10]       5137  anda([serialLast])              #40
              1235 ec39  bne  .buttons#43 5138  bne('.buttons#43')              #41
              1236 00fe  ld   $fe         5139  ld(254)                         #42 then clear the selected bit
              1237 0200  nop              5140  nop()                           #43
              1238 fc3c  bra  .buttons#46 5141  bra('.buttons#46')              #44
                                          5142  label('.buttons#43')
.buttons#43:  1239 a10f  suba [$0f]       5143  suba([serialRaw])               #43,45
              123a 2111  anda [$11]       5144  anda([buttonState])             #44
              123b c211  st   [$11]       5145  st([buttonState])               #45
                                          5146  label('.buttons#46')
.buttons#46:  123c 010f  ld   [$0f]       5147  ld([serialRaw])                 #46 Set the lower bits
              123d 4111  ora  [$11]       5148  ora([buttonState])              #47
                                          5149  label('.buttons#48')
.buttons#48:  123e c211  st   [$11]       5150  st([buttonState])               #48
              123f 010f  ld   [$0f]       5151  ld([serialRaw])                 #49 Update serialLast for next pass
              1240 e0b3  jmp  y,$b3       5152  jmp(Y,'vBlankLast#52')          #50
              1241 c210  st   [$10]       5153  st([serialLast])                #51
                                          5154
                                          5155  # TypeB
                                          5156  # pChange = pNew & ~pOld
                                          5157  # nChange = nNew | ~nOld {DeMorgan}
                                          5158  label('.buttons#39')
.buttons#39:  1242 00ff  ld   $ff         5159  ld(255)                         #39 [TypeB] Bitwise edge-filter to detect button presses
              1243 6110  xora [$10]       5160  xora([serialLast])              #40
              1244 410f  ora  [$0f]       5161  ora([serialRaw])                #41 Catch button-press events
              1245 2111  anda [$11]       5162  anda([buttonState])             #42 Keep active button presses
              1246 410f  ora  [$0f]       5163  ora([serialRaw])                #43
              1247 0200  nop              5164  nop()                           #44
              1248 0200  nop              5165  nop()                           #45
              1249 fc3e  bra  .buttons#48 5166  bra('.buttons#48')              #46
              124a 0200  nop              5167  nop()                           #47
