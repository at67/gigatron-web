                                          3079  # -------------------------------------------------------------
                                          3080  # vCPU instructions for comparisons between two 16-bit operands
                                          3081  # -------------------------------------------------------------
                                          3082  #
                                          3083  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          3084  # treating vAC as a two's complement 16-bit number. When we need to
                                          3085  # compare two arbitrary numnbers we normally first take their difference
                                          3086  # with SUBW.  However, when this difference is too large, the subtraction
                                          3087  # overflows and we get the wrong outcome. To get it right over the
                                          3088  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          3089  # blurp for its relational operators. (It compares stack variable $02
                                          3090  # with zero page variable $3a.)
                                          3091  #
                                          3092  #       0461  ee 02            LDLW  $02
                                          3093  #       0463  fc 3a            XORW  $3a
                                          3094  #       0465  35 53 6a         BGE   $046c
                                          3095  #       0468  ee 02            LDLW  $02
                                          3096  #       046a  90 6e            BRA   $0470
                                          3097  #       046c  ee 02            LDLW  $02
                                          3098  #       046e  b8 3a            SUBW  $3a
                                          3099  #       0470  35 56 73         BLE   $0475
                                          3100  #
                                          3101  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          3102  # They inspect both operands to see if there is an overflow risk. If
                                          3103  # so, they modify vAC such that their difference gets smaller, while
                                          3104  # preserving the relation between the two operands. After that, the
                                          3105  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          3106  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          3107  # the sequence above becomes:
                                          3108  #
                                          3109  #       0461  ee 02            LDLW  $02
                                          3110  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          3111  #       0465  b8 3a            SUBW  $3a
                                          3112  #       0467  35 56 73         BLE   $0475
                                          3113  #
                                          3114  # CMPHS/CMPHU don't make much sense other than in combination with
                                          3115  # SUBW. These modify vACH, if needed, as given in the following table:
                                          3116  #
                                          3117  #       vACH  varH  |     vACH
                                          3118  #       bit7  bit7  | CMPHS  CMPHU
                                          3119  #       ---------------------------
                                          3120  #         0     0   |  vACH   vACH      no change needed
                                          3121  #         0     1   | varH+1 varH-1     narrowing the range
                                          3122  #         1     0   | varH-1 varH+1     narrowing the range
                                          3123  #         1     1   |  vACH   vACH      no change needed
                                          3124  #       ---------------------------
                                          3125
                                          3126  # CMPHS implementation (vCPU instruction)
                                          3127  label('cmphs#13')
cmphs#13:     0bbc 1403  ld   $03,y       3128  ld(hi('REENTER'),Y)             #13
              0bbd 0500  ld   [x]         3129  ld([X])                         #14
              0bbe 6119  xora [$19]       3130  xora([vAC+1])                   #15
              0bbf f4d0  bge  .cmphu#18   3131  bpl('.cmphu#18')                #16 Skip if same sign
              0bc0 0119  ld   [$19]       3132  ld([vAC+1])                     #17
              0bc1 e8c4  blt  $0bc4       3133  bmi(pc()+3)                     #18
              0bc2 fcc5  bra  .cmphs#21   3134  bra(pc()+3)                     #19
                                          3135  label('.cmphs#20')
.cmphs#20:    0bc3 0001  ld   $01         3136  ld(+1)                          #20    vAC < variable
              0bc4 00ff  ld   $ff         3137  ld(-1)                          #20(!) vAC > variable
                                          3138  label('.cmphs#21')
.cmphs#21:    0bc5 8500  adda [x]         3139  adda([X])                       #21
              0bc6 c219  st   [$19]       3140  st([vAC+1])                     #22
              0bc7 e0ca  jmp  y,$ca       3141  jmp(Y,'REENTER_28')             #23
                                          3142  #dummy()                        #24 Overlap
                                          3143  #
                                          3144  # CMPHS implementation (vCPU instruction)
                                          3145  label('cmphu#13')
cmphu#13:     0bc8 1403  ld   $03,y       3146  ld(hi('REENTER'),Y)             #13,24
              0bc9 0500  ld   [x]         3147  ld([X])                         #14
              0bca 6119  xora [$19]       3148  xora([vAC+1])                   #15
              0bcb f4d0  bge  .cmphu#18   3149  bpl('.cmphu#18')                #16 Skip if same sign
              0bcc 0119  ld   [$19]       3150  ld([vAC+1])                     #17
              0bcd e8c3  blt  .cmphs#20   3151  bmi('.cmphs#20')                #18
              0bce fcc5  bra  .cmphs#21   3152  bra('.cmphs#21')                #19
              0bcf 00ff  ld   $ff         3153  ld(-1)                          #20    vAC > variable
