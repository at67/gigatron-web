              04f8 1403  ld   $03,y       2322  ld(hi('REENTER'),Y)             #23
              04f9 e0cb  jmp  y,$cb       2323  jmp(Y,'REENTER')                #24
              04fa 00f2  ld   $f2         2324  ld(-28/2)                       #25
