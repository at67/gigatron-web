                                          3867  # All interpreter entry points must share the same page offset, because
                                          3868  # this offset is hard-coded as immediate operand in the video driver.
                                          3869  # The Gigatron's original vCPU's 'ENTER' label is already at $2ff, so we
                                          3870  # just use $dff for 'v6502_ENTER'. v6502 actually has two entry points.
                                          3871  # The other is 'v6502_RESUME' at $10ff. It is used for instructions
                                          3872  # that were fetched but not yet executed. Allowing the split gives finer
                                          3873  # granulariy, and hopefully more throughput for the simpler instructions.
                                          3874  # (There is no "overhead" for allowing instruction splitting, because
                                          3875  #  both emulation phases must administer [vTicks] anyway.)
                                          3876  while pc()&255 < 255:
              0df2 0200  nop              3877    nop()
              0df3 0200  nop
              0df4 0200  nop
              * 13 times
