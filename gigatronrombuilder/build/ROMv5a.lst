              03d8 c216  st   [$16]       1844  st([vPC])                       #19
              03d9 011d  ld   [$1d]       1845  ld([vTmp])                      #20
              03da 9001  adda $01,x       1846  adda(1,X)                       #21
              03db 0500  ld   [x]         1847  ld([X])                         #22
              03dc d617  st   [$17],y     1848  st([vPC+1],Y)                   #23
              03dd fc01  bra  NEXT        1849  bra('NEXT')                     #24
              03de 00f3  ld   $f3         1850  ld(-26/2)                       #25
