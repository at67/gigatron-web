                                          2995  # Extension SYS_ResetWaveforms_v4_50
                                          2996  #-----------------------------------------------------------------------
                                          2997
                                          2998  # soundTable[4x+0] = sawtooth, to be modified into metallic/noise
                                          2999  # soundTable[4x+1] = pulse
                                          3000  # soundTable[4x+2] = triangle
                                          3001  # soundTable[4x+3] = sawtooth, also useful to right shift 2 bits
                                          3002
                                          3003  label('SYS_ResetWaveforms_v4_50')
SYS_ResetWaveforms_v4_50:
              0b0f 1412  ld   $12,y       3004  ld(hi('sys_ResetWaveforms'),Y)  #15 Initial setup of waveforms. [vAC+0]=i
              0b10 e0ae  jmp  y,$ae       3005  jmp(Y,'sys_ResetWaveforms')     #16
              0b11 1407  ld   $07,y       3006  ld(soundTable>>8,Y)             #17
