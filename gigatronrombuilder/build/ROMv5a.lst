                                          641
                                          642   #-----------------------------------------------------------------------
                                          643   # Placeholders for future SYS functions. This works as a kind of jump
                                          644   # table. The indirection allows SYS implementations to be moved around
                                          645   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          646   # the function is not present it just acts as a NOP. Of course, when a
                                          647   # SYS function must be patched or extended it needs to have budget for
                                          648   # that in its declared maximum cycle count.
                                          649   #
                                          650   # Technically the same goal can be achieved by starting each function
                                          651   # with 2 nop's, or by overdeclaring their duration in the first place
                                          652   # (a bit is still wise to do). But this can result in fragmentation
                                          653   # of future ROM images. The indirection avoids that.
                                          654   #
                                          655   # An added advantage of having these in ROM page 0 is that it saves one
                                          656   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          657   #-----------------------------------------------------------------------
                                          658
              007a 0200  nop              659   align(0x80, size=0x80)
              007b 0200  nop
              007c 0200  nop
              * 6 times
                                          660   assert pc() == 0x80
                                          661
              0080 1403  ld   $03,y       662   ld(hi('REENTER'),Y)             #15 slot 0x80
              0081 e0cb  jmp  y,$cb       663   jmp(Y,'REENTER')                #16
              0082 00f6  ld   $f6         664   ld(-20/2)                       #17
                                          665
              0083 1403  ld   $03,y       666   ld(hi('REENTER'),Y)             #15 slot 0x83
