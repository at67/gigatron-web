                                          3775  label('.sysVdb0')
.sysVdb0:     0e90 c21d  st   [$1d]       3776  st([vTmp])                      #19+i*25
              0e91 9529  adda [$29],y     3777  adda([sysArgs+5],Y)             #20+i*25 Y=[sysPos+1]+[vTmp]
              0e92 0126  ld   [$26]       3778  ld([sysArgs+2])                 #21+i*25 Select color
              0e93 e896  blt  $0e96       3779  bmi(pc()+3)                     #22+i*25
              0e94 fc97  bra  $0e97       3780  bra(pc()+3)                     #23+i*25
              0e95 0124  ld   [$24]       3781  ld([sysArgs+0])                 #24+i*25
              0e96 0125  ld   [$25]       3782  ld([sysArgs+1])                 #24+i*25(!)
              0e97 ce00  st   [y,x]       3783  st([Y,X])                       #25+i*25 Draw pixel
              0e98 0126  ld   [$26]       3784  ld([sysArgs+2])                 #26+i*25 Shift byte left
              0e99 8200  adda ac          3785  adda(AC)                        #27+i*25
              0e9a c226  st   [$26]       3786  st([sysArgs+2])                 #28+i*25
              0e9b 011d  ld   [$1d]       3787  ld([vTmp])                      #29+i*25 Unrolled loop (once)
              0e9c 8129  adda [$29]       3788  adda([sysArgs+5])               #31+i*25
              0e9d 9401  adda $01,y       3789  adda(1,Y)                       #30+i*25 Y=[sysPos+1]+[vTmp]+1
              0e9e 0126  ld   [$26]       3790  ld([sysArgs+2])                 #32+i*25 Select color
              0e9f e8a2  blt  $0ea2       3791  bmi(pc()+3)                     #33+i*25
              0ea0 fca3  bra  $0ea3       3792  bra(pc()+3)                     #34+i*25
              0ea1 0124  ld   [$24]       3793  ld([sysArgs+0])                 #35+i*25
              0ea2 0125  ld   [$25]       3794  ld([sysArgs+1])                 #35+i*25(!)
              0ea3 ce00  st   [y,x]       3795  st([Y,X])                       #36+i*25 Draw pixel
              0ea4 0126  ld   [$26]       3796  ld([sysArgs+2])                 #37+i*25 Shift byte left
              0ea5 8200  adda ac          3797  adda(AC)                        #38+i*25
              0ea6 c226  st   [$26]       3798  st([sysArgs+2])                 #39+i*25
              0ea7 011d  ld   [$1d]       3799  ld([vTmp])                      #40+i*25 Loop counter
              0ea8 a006  suba $06         3800  suba(6)                         #41+i*25
              0ea9 ec90  bne  .sysVdb0    3801  bne('.sysVdb0')                 #42+i*25
              0eaa 8008  adda $08         3802  adda(8)                         #43+i*25 Steps of 2
              0eab 1403  ld   $03,y       3803  ld(hi('REENTER'),Y)             #119
              0eac e0cb  jmp  y,$cb       3804  jmp(Y,'REENTER')                #120
              0ead 00c2  ld   $c2         3805  ld(-124/2)                      #121
