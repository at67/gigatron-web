              04fb f0f0  beq  vRTI#15     2327  beq('vRTI#15')                  #13 vRTI sequence
              04fc 9001  adda $01,x       2328  adda(1,X)                       #14
              04fd 1412  ld   $12,y       2329  ld(hi('vRTI#18'),Y)             #15 Switch and wait for end of timeslice (slower)
              04fe e020  jmp  y,$20       2330  jmp(Y,'vRTI#18')                #16
