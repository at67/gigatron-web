notesTable:   0900 0000  ld   $00         2766  ld(0)
              0901 0000  ld   $00         2767  ld(0)
                                          2768  for i in range(0, 250, 2):
                                          2769    j = i//2-1
                                          2770    freq = 440.0*2.0**((j-57)/12.0)
                                          2771    if j>=0 and freq <= sampleRate/2.0:
                                          2772      key = int(round(32768 * freq / sampleRate))
                                          2773      octave, note = j//12, notes[j%12]
                                          2774      sharp = '-' if notes[j%12-1] != note else '#'
                                          2775      comment = '%s%s%s (%0.1f Hz)' % (note, sharp, octave, freq)
                                          2776      ld(key&127); C(comment); ld(key>>7)
