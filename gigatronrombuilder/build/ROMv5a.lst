                                          2692      key = int(round(32768 * freq / sampleRate))
                                          2693      octave, note = j//12, notes[j%12]
                                          2694      sharp = '-' if notes[j%12-1] != note else '#'
                                          2695      comment = '%s%s%s (%0.1f Hz)' % (note, sharp, octave, freq)
