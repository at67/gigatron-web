              0108 c209  st   [$09]       983   st([videoY])                    #36
                                          984
                                          985   # Update frame count and [0x80] (4 cycles)
              0109 0001  ld   $01         986   ld(1)                           #37 Reinitialize carry lookup, for robustness
              010a c280  st   [$80]       987   st([0x80])                      #38
              010b 810e  adda [$0e]       988   adda([frameCount])              #39 Frame counter
              010c c20e  st   [$0e]       989   st([frameCount])                #40
                                          990
                                          991   # Mix entropy (11 cycles)
              010d 6107  xora [$07]       992   xora([entropy+1])               #41 Mix entropy
              010e 610f  xora [$0f]       993   xora([serialRaw])               #42 Mix in serial input
              010f 8106  adda [$06]       994   adda([entropy+0])               #43
              0110 c206  st   [$06]       995   st([entropy+0])                 #44
              0111 8108  adda [$08]       996   adda([entropy+2])               #45 Some hidden state
              0112 c208  st   [$08]       997   st([entropy+2])                 #46
              0113 e816  blt  $0116       998   bmi(pc()+3)                     #47
              0114 fc17  bra  $0117       999   bra(pc()+3)                     #48
              0115 6053  xora $53         1000  xora(64+16+2+1)                 #49
              0116 606c  xora $6c         1001  xora(64+32+8+4)                 #49(!)
              0117 8107  adda [$07]       1002  adda([entropy+1])               #50
              0118 c207  st   [$07]       1003  st([entropy+1])                 #51
