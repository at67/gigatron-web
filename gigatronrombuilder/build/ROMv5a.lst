                                          4345  #   L7 R7 C7   RX UC SC
                                          4346  #   -- -- -- | -- -- --
                                          4347  #    0  0  0 |  0  0  0
                                          4348  #    0  0  1 |  0  0  0
                                          4349  #    1  0  0 |  0  1 +1
                                          4350  #    1  0  1 |  0  0  0
                                          4351  #    0  1  0 | -1  1  0
                                          4352  #    0  1  1 | -1  0 -1
                                          4353  #    1  1  0 | -1  1  0
                                          4354  #    1  1  1 | -1  1  0
                                          4355  #   -- -- -- | -- -- --
                                          4356  #    ^  ^  ^    ^  ^  ^
                                          4357  #    |  |  |    |  |  `--- Carry of unsigned L + signed R: SC = RX + UC
                                          4358  #    |  |  |    |  `----- Carry of unsigned L + unsigned R: UC = C7 ? L7&R7 : L7|R7
                                          4359  #    |  |  |    `------- Sign extension of signed R
                                          4360  #    |  |  `--------- MSB of unextended L + R
                                          4361  #    |  `----------- MSB of right operand R
                                          4362  #    `------------- MSB of left operand L
