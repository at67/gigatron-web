                                          3229
                                          3230  # -------------------------------------------------------------
                                          3231  # vCPU instructions for comparisons between two 16-bit operands
                                          3232  # -------------------------------------------------------------
                                          3233  #
                                          3234  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          3235  # treating vAC as a two's complement 16-bit number. When we need to
                                          3236  # compare two arbitrary numnbers we normally first take their difference
                                          3237  # with SUBW.  However, when this difference is too large, the subtraction
                                          3238  # overflows and we get the wrong outcome. To get it right over the
                                          3239  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          3240  # blurp for its relational operators. (It compares stack variable $02
                                          3241  # with zero page variable $3a.)
                                          3242  #
                                          3243  #       0461  ee 02            LDLW  $02
                                          3244  #       0463  fc 3a            XORW  $3a
                                          3245  #       0465  35 53 6a         BGE   $046c
                                          3246  #       0468  ee 02            LDLW  $02
                                          3247  #       046a  90 6e            BRA   $0470
                                          3248  #       046c  ee 02            LDLW  $02
                                          3249  #       046e  b8 3a            SUBW  $3a
                                          3250  #       0470  35 56 73         BLE   $0475
                                          3251  #
                                          3252  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          3253  # They inspect both operands to see if there is an overflow risk. If
                                          3254  # so, they modify vAC such that their difference gets smaller, while
                                          3255  # preserving the relation between the two operands. After that, the
                                          3256  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          3257  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          3258  # the sequence above becomes:
                                          3259  #
                                          3260  #       0461  ee 02            LDLW  $02
                                          3261  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          3262  #       0465  b8 3a            SUBW  $3a
                                          3263  #       0467  35 56 73         BLE   $0475
                                          3264  #
                                          3265  # CMPHS/CMPHU don't make much sense other than in combination with
                                          3266  # SUBW. These modify vACH, if needed, as given in the following table:
                                          3267  #
                                          3268  #       vACH  varH  |     vACH
                                          3269  #       bit7  bit7  | CMPHS  CMPHU
                                          3270  #       ---------------------------
                                          3271  #         0     0   |  vACH   vACH      no change needed
                                          3272  #         0     1   | varH+1 varH-1     narrowing the range
                                          3273  #         1     0   | varH-1 varH+1     narrowing the range
                                          3274  #         1     1   |  vACH   vACH      no change needed
                                          3275  #       ---------------------------
                                          3276
                                          3277  # CMPHS implementation (vCPU instruction)
                                          3278  label('cmphs#13')
cmphs#13:     0bbc 1403  ld   $03,y       3279  ld(hi('REENTER'),Y)             #13
              0bbd 0500  ld   [x]         3280  ld([X])                         #14
              0bbe 6119  xora [$19]       3281  xora([vAC+1])                   #15
              0bbf f4d0  bge  .cmphu#18   3282  bpl('.cmphu#18')                #16 Skip if same sign
              0bc0 0119  ld   [$19]       3283  ld([vAC+1])                     #17
              0bc1 e8c4  blt  $0bc4       3284  bmi(pc()+3)                     #18
              0bc2 fcc5  bra  .cmphs#21   3285  bra(pc()+3)                     #19
                                          3286  label('.cmphs#20')
.cmphs#20:    0bc3 0001  ld   $01         3287  ld(+1)                          #20    vAC < variable
              0bc4 00ff  ld   $ff         3288  ld(-1)                          #20(!) vAC > variable
                                          3289  label('.cmphs#21')
.cmphs#21:    0bc5 8500  adda [x]         3290  adda([X])                       #21
              0bc6 c219  st   [$19]       3291  st([vAC+1])                     #22
              0bc7 e0ca  jmp  y,$ca       3292  jmp(Y,'REENTER_28')             #23
                                          3293  #dummy()                        #24 Overlap
                                          3294  #
                                          3295  # CMPHS implementation (vCPU instruction)
                                          3296  label('cmphu#13')
cmphu#13:     0bc8 1403  ld   $03,y       3297  ld(hi('REENTER'),Y)             #13,24
              0bc9 0500  ld   [x]         3298  ld([X])                         #14
              0bca 6119  xora [$19]       3299  xora([vAC+1])                   #15
              0bcb f4d0  bge  .cmphu#18   3300  bpl('.cmphu#18')                #16 Skip if same sign
              0bcc 0119  ld   [$19]       3301  ld([vAC+1])                     #17
              0bcd e8c3  blt  .cmphs#20   3302  bmi('.cmphs#20')                #18
              0bce fcc5  bra  .cmphs#21   3303  bra('.cmphs#21')                #19
              0bcf 00ff  ld   $ff         3304  ld(-1)                          #20    vAC > variable
                                          3305
