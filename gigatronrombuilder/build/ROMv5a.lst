                                          2530  #-----------------------------------------------------------------------
                                          2531  # Extension SYS_Read3_40
                                          2532  #-----------------------------------------------------------------------
                                          2533
                                          2534  # Read 3 consecutive bytes from ROM
                                          2535  #
                                          2536  # Note: This function a bit obsolete, as it has very limited use. It's
                                          2537  #       effectively an application-specific SYS function for the Pictures
                                          2538  #       application from ROM v1. It requires the ROM data be organized
                                          2539  #       with trampoline3a and trampoline3b fragments, and their address
                                          2540  #       in ROM to be known. Better avoid using this.
                                          2541  #
                                          2542  # Variables:
                                          2543  #       sysArgs[0:2]    Bytes (out)
                                          2544  #       sysArgs[6:7]    ROM pointer (in)
                                          2545
                                          2546  label('SYS_Read3_40')
SYS_Read3_40: 06b9 152b  ld   [$2b],y     2547  ld([sysArgs+7],Y)               #15,32
              06ba e079  jmp  y,$79       2548  jmp(Y,128-7)                    #16 trampoline3a
              06bb 012a  ld   [$2a]       2549  ld([sysArgs+6])                 #17
                                          2550  label('txReturn')
txReturn:     06bc c226  st   [$26]       2551  st([sysArgs+2])                 #34
              06bd 1403  ld   $03,y       2552  ld(hi('REENTER'),Y)             #35
              06be e0cb  jmp  y,$cb       2553  jmp(Y,'REENTER')                #36
              06bf 00ec  ld   $ec         2554  ld(-40/2)                       #37
                                          2555
                                          2556  def trampoline3a():
                                          2557    """Read 3 bytes from ROM page"""
                                          2558    while pc()&255 < 128-7:
                                          2559      nop()
                                          2560    bra(AC)                       #18
                                          2561    C('Trampoline for page $%02x00 reading (entry)' % (pc()>>8))
                                          2562    bra(123)                      #19
                                          2563    st([sysArgs+0])               #21
                                          2564    ld([sysArgs+6])               #22
                                          2565    adda(1)                       #23
                                          2566    bra(AC)                       #24
                                          2567    bra(250)                      #25 trampoline3b
                                          2568    align(1, size=0x80)
                                          2569
                                          2570  def trampoline3b():
                                          2571    """Read 3 bytes from ROM page (continue)"""
                                          2572    while pc()&255 < 256-6:
                                          2573      nop()
                                          2574    st([sysArgs+1])               #27
                                          2575    C('Trampoline for page $%02x00 reading (continue)' % (pc()>>8))
                                          2576    ld([sysArgs+6])               #28
                                          2577    adda(2)                       #29
                                          2578    ld(hi('txReturn'),Y)          #30
                                          2579    bra(AC)                       #31
                                          2580    jmp(Y,'txReturn')             #32
                                          2581    align(1, size=0x100)
                                          2582
