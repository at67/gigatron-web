                                          2303  # Interrupt handler:
                                          2304  #       ST   $xx        -> optionally store vCpuSelect
                                          2305  #       ... IRQ payload ...
                                          2306  # either:
                                          2307  #       LDWI $400
                                          2308  #       LUP  0          -> vRTI and don't switch interpreter (immediate resume)
                                          2309  # or:
                                          2310  #       LDWI $400
                                          2311  #       LUP  $xx        -> vRTI and switch interpreter type as stored in [$xx]
              04e9 0200  nop              2312  fillers(until=251-11)
              04ea 0200  nop
              04eb 0200  nop
              * 7 times
                                          2313  label('vRTI#15')
vRTI#15:      04f0 0130  ld   [$30]       2314  ld([0x30])                      #15 Continue with vCPU in the same timeslice (faster)
              04f1 c216  st   [$16]       2315  st([vPC])                       #16
              04f2 0131  ld   [$31]       2316  ld([0x31])                      #17
              04f3 c217  st   [$17]       2317  st([vPC+1])                     #18
              04f4 0132  ld   [$32]       2318  ld([0x32])                      #19
              04f5 c218  st   [$18]       2319  st([vAC])                       #20
              04f6 0133  ld   [$33]       2320  ld([0x33])                      #21
