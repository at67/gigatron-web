              011b fc1e  bra  $011e       1008  bra(pc()+3)                     #54
              011c a001  suba $01         1009  suba(1)                         #55
              011d 012f  ld   [$2f]       1010  ld([ledTempo])                  #55(!)
              011e c22d  st   [$2d]       1011  st([ledTimer])                  #56
              011f f022  beq  $0122       1012  beq(pc()+3)                     #57
              0120 fc23  bra  $0123       1013  bra(pc()+3)                     #58
              0121 0000  ld   $00         1014  ld(0)                           #59 Don't advance state
              0122 0001  ld   $01         1015  ld(1)                           #59(!) Advance state when timer passes through 0
              0123 812e  adda [$2e]       1016  adda([ledState_v2])             #60
