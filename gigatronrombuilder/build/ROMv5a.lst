              102c c219  st   [$19]       4333  st([v6502_BI])                  #12 Park modified operand for v6502_ADC
              102d 0019  ld   $19         4334  ld(v6502_BI&255)                #13 Address of BI
              102e d224  st   [$24],x     4335  st([v6502_ADL],X)               #14
