                                          1878  # Instruction LSLW: Logical shift left (vAC<<=1), 28 cycles
                                          1879  # Useful, because ADDW can't add vAC to itself. Also more compact.
                                          1880  label('LSLW')
LSLW:         03e9 1404  ld   $04,y       1881  ld(hi('lslw'),Y)                #10
              03ea e035  jmp  y,$35       1882  jmp(Y,'lslw')                   #11
              03eb 0118  ld   [$18]       1883  ld([vAC])                       #12
                                          1884
                                          1885  # Instruction STLW: Store word in stack frame ([vSP+D],[vSP+D+1]=vAC&255,vAC>>8), 26 cycles
