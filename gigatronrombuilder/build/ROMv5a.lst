                                          3697  # SYS_Exec_88 implementation
                                          3698  label('sys_Exec')
sys_Exec:     0e4b d617  st   [$17],y     3699  st([vPC+1],Y)                   #18 Clear vPCH and Y
              0e4c 011c  ld   [$1c]       3700  ld([vSP])                       #19 Place ROM loader below current stack pointer
              0e4d a037  suba $37         3701  suba(53+2)                      #20 (AC -> *+0) One extra word for PUSH
              0e4e d21d  st   [$1d],x     3702  st([vTmp],X)                    #21
              0e4f 80fe  adda $fe         3703  adda(-2)                        #22 (AC -> *-2)
              0e50 c216  st   [$16]       3704  st([vPC])                       #23
                                          3705  # Start of manually compiled vCPU section
              0e51 dc75  st   $75,[y,x++] 3706  st('PUSH',    [Y,Xpp])          #24 *+0
              0e52 dccf  st   $cf,[y,x++] 3707  st('CALL',    [Y,Xpp])          #25 *+26 Fetch first byte
              0e53 8023  adda $23         3708  adda(33-(-2))                   #26 (AC -> *+33)
              0e54 de00  st   [y,x++]     3709  st(           [Y,Xpp])          #27 *+27
              0e55 dc5e  st   $5e,[y,x++] 3710  st('ST',      [Y,Xpp])          #28 *+3 Chunk copy loop
              0e56 dc27  st   $27,[y,x++] 3711  st(sysArgs+3, [Y,Xpp])          #29 *+4 High-address comes first
              0e57 dccf  st   $cf,[y,x++] 3712  st('CALL',    [Y,Xpp])          #30 *+5
              0e58 de00  st   [y,x++]     3713  st(           [Y,Xpp])          #31 *+6
              0e59 dc5e  st   $5e,[y,x++] 3714  st('ST',      [Y,Xpp])          #32 *+7
              0e5a dc26  st   $26,[y,x++] 3715  st(sysArgs+2, [Y,Xpp])          #33 *+8 Then the low address
              0e5b dccf  st   $cf,[y,x++] 3716  st('CALL',    [Y,Xpp])          #34 *+9
              0e5c de00  st   [y,x++]     3717  st(           [Y,Xpp])          #35 *+10
              0e5d dc5e  st   $5e,[y,x++] 3718  st('ST',      [Y,Xpp])          #36 *+11 Byte copy loop
              0e5e dc28  st   $28,[y,x++] 3719  st(sysArgs+4, [Y,Xpp])          #37 *+12 Byte count (0 means 256)
              0e5f dccf  st   $cf,[y,x++] 3720  st('CALL',    [Y,Xpp])          #38 *+13
              0e60 de00  st   [y,x++]     3721  st(           [Y,Xpp])          #39 *+14
              0e61 dcf0  st   $f0,[y,x++] 3722  st('POKE',    [Y,Xpp])          #40 *+15
              0e62 dc26  st   $26,[y,x++] 3723  st(sysArgs+2, [Y,Xpp])          #41 *+16
              0e63 dc93  st   $93,[y,x++] 3724  st('INC',     [Y,Xpp])          #42 *+17
              0e64 dc26  st   $26,[y,x++] 3725  st(sysArgs+2, [Y,Xpp])          #43 *+18
              0e65 dc1a  st   $1a,[y,x++] 3726  st('LD',      [Y,Xpp])          #44 *+19
              0e66 dc28  st   $28,[y,x++] 3727  st(sysArgs+4, [Y,Xpp])          #45 *+20
              0e67 dce6  st   $e6,[y,x++] 3728  st('SUBI',    [Y,Xpp])          #46 *+21
              0e68 dc01  st   $01,[y,x++] 3729  st(1,         [Y,Xpp])          #47 *+22
              0e69 dc35  st   $35,[y,x++] 3730  st('BCC',     [Y,Xpp])          #48 *+23
              0e6a dc72  st   $72,[y,x++] 3731  st('NE',      [Y,Xpp])          #49 *+24
              0e6b 80e8  adda $e8         3732  adda(11-2-33)                   #50 (AC -> *+9)
              0e6c de00  st   [y,x++]     3733  st(           [Y,Xpp])          #51 *+25
              0e6d dccf  st   $cf,[y,x++] 3734  st('CALL',    [Y,Xpp])          #52 *+26 Go to next block
              0e6e 8018  adda $18         3735  adda(33-9)                      #53 (AC -> *+33)
              0e6f de00  st   [y,x++]     3736  st(           [Y,Xpp])          #54 *+27
              0e70 dc35  st   $35,[y,x++] 3737  st('BCC',     [Y,Xpp])          #55 *+28
              0e71 dc72  st   $72,[y,x++] 3738  st('NE',      [Y,Xpp])          #56 *+29
              0e72 80e0  adda $e0         3739  adda(3-2-33)                    #57 (AC -> *+1)
              0e73 de00  st   [y,x++]     3740  st(           [Y,Xpp])          #58 *+30
              0e74 dc63  st   $63,[y,x++] 3741  st('POP',     [Y,Xpp])          #59 *+31 End
              0e75 dcff  st   $ff,[y,x++] 3742  st('RET',     [Y,Xpp])          #60 *+32
                                          3743  # Pointer constant pointing to the routine below (for use by CALL)
              0e76 8022  adda $22         3744  adda(35-1)                      #61 (AC -> *+35)
              0e77 de00  st   [y,x++]     3745  st(           [Y,Xpp])          #62 *+33
              0e78 dc00  st   $00,[y,x++] 3746  st(0,         [Y,Xpp])          #63 *+34
                                          3747  # Routine to read next byte from ROM and advance read pointer
              0e79 dc1a  st   $1a,[y,x++] 3748  st('LD',      [Y,Xpp])          #64 *+35 Test for end of ROM table
              0e7a dc24  st   $24,[y,x++] 3749  st(sysArgs+0, [Y,Xpp])          #65 *+36
              0e7b dc8c  st   $8c,[y,x++] 3750  st('XORI',    [Y,Xpp])          #66 *+37
              0e7c dcfb  st   $fb,[y,x++] 3751  st(251,       [Y,Xpp])          #67 *+38
              0e7d dc35  st   $35,[y,x++] 3752  st('BCC',     [Y,Xpp])          #68 *+39
              0e7e dc72  st   $72,[y,x++] 3753  st('NE',      [Y,Xpp])          #69 *+40
              0e7f 8009  adda $09         3754  adda(46-2-35)                   #70 (AC -> *+44)
              0e80 de00  st   [y,x++]     3755  st(           [Y,Xpp])          #71 *+41
              0e81 dc5e  st   $5e,[y,x++] 3756  st('ST',      [Y,Xpp])          #72 *+42 Wrap to next ROM page
              0e82 dc24  st   $24,[y,x++] 3757  st(sysArgs+0, [Y,Xpp])          #73 *+43
              0e83 dc93  st   $93,[y,x++] 3758  st('INC',     [Y,Xpp])          #74 *+44
              0e84 dc25  st   $25,[y,x++] 3759  st(sysArgs+1, [Y,Xpp])          #75 *+45
              0e85 dc21  st   $21,[y,x++] 3760  st('LDW',     [Y,Xpp])          #76 *+46 Read next byte from ROM table
              0e86 dc24  st   $24,[y,x++] 3761  st(sysArgs+0, [Y,Xpp])          #77 *+47
              0e87 dc7f  st   $7f,[y,x++] 3762  st('LUP',     [Y,Xpp])          #78 *+48
              0e88 dc00  st   $00,[y,x++] 3763  st(0,         [Y,Xpp])          #79 *+49
              0e89 dc93  st   $93,[y,x++] 3764  st('INC',     [Y,Xpp])          #80 *+50 Increment read pointer
              0e8a dc24  st   $24,[y,x++] 3765  st(sysArgs+0, [Y,Xpp])          #81 *+51
              0e8b dcff  st   $ff,[y,x++] 3766  st('RET',     [Y,Xpp])          #82 *+52 Return
                                          3767  # Return to interpreter
              0e8c 1403  ld   $03,y       3768  ld(hi('REENTER'),Y)             #83
              0e8d e0cb  jmp  y,$cb       3769  jmp(Y,'REENTER')                #84
              0e8e 00d4  ld   $d4         3770  ld(-88/2)                       #85
