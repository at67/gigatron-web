                                          3598  # vIRQ sequence WITH interpreter switch
                                          3599  label('vRTI#18')
vRTI#18:      0e20 0500  ld   [x]         3600  ld([X])                         #18
              0e21 c205  st   [$05]       3601  st([vCpuSelect])                #19
              0e22 0130  ld   [$30]       3602  ld([0x30])                      #20
              0e23 c216  st   [$16]       3603  st([vPC])                       #21
              0e24 0131  ld   [$31]       3604  ld([0x31])                      #22
              0e25 c217  st   [$17]       3605  st([vPC+1])                     #23
              0e26 0132  ld   [$32]       3606  ld([0x32])                      #24
              0e27 c218  st   [$18]       3607  st([vAC])                       #25
              0e28 0133  ld   [$33]       3608  ld([0x33])                      #26
              0e29 c219  st   [$19]       3609  st([vAC+1])                     #27
              0e2a 0200  nop              3610  nop()                           #0
              0e2b 1403  ld   $03,y       3611  ld(hi('RESYNC'),Y)              #1
              0e2c e00c  jmp  y,$0c       3612  jmp(Y,'RESYNC')                 #2
              0e2d 0115  ld   [$15]       3613  ld([vTicks])                    #3
                                          3614
                                          3615  # Entered last line of vertical blank (line 40)
                                          3616  label('vBlankLast#34')
                                          3617
                                          3618  #-----------------------------------------------------------------------
                                          3619  #       Extended vertical blank logic: game controller decoding
                                          3620  #-----------------------------------------------------------------------
                                          3621
                                          3622  # Game controller types
                                          3623  # TypeA: Based on 74LS165 shift register (not supported)
                                          3624  # TypeB: Based on CD4021B shift register (standard)
                                          3625  # TypeC: Based on priority encoder
                                          3626  #
                                          3627  # Notes:
                                          3628  # - TypeA was only used during development and first beta test, before ROM v1
                                          3629  # - TypeB appears as type A with negative logic levels
                                          3630  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          3631  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          3632  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          3633  # - TypeB and TypeC can be sampled in the same scanline
                                          3634  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          3635  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          3636  #
                                          3637  #       TypeC    Alias    Button TypeB
                                          3638  #       00000000  ^@   -> Right  11111110
                                          3639  #       00000001  ^A   -> Left   11111101
                                          3640  #       00000011  ^C   -> Down   11111011
                                          3641  #       00000111  ^G   -> Up     11110111
                                          3642  #       00001111  ^O   -> Start  11101111
                                          3643  #       00011111  ^_   -> Select 11011111
                                          3644  #       00111111  ?    -> B      10111111
                                          3645  #       01111111  DEL  -> A      01111111
                                          3646  #       11111111       -> (None) 11111111
                                          3647  #
                                          3648  #       Conversion formula:
                                          3649  #               f(x) := 254 - x
                                          3650
                                          3651  # Detect controller TypeC codes
vBlankLast#34:
              0e2e 010f  ld   [$0f]       3652  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              0e2f 8001  adda $01         3653  adda(1)                         #35
              0e30 210f  anda [$0f]       3654  anda([serialRaw])               #36
              0e31 ec42  bne  .buttons#39 3655  bne('.buttons#39')              #37
                                          3656
                                          3657  # TypeC
              0e32 010f  ld   [$0f]       3658  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              0e33 8001  adda $01         3659  adda(1)                         #39
              0e34 2110  anda [$10]       3660  anda([serialLast])              #40
              0e35 ec39  bne  .buttons#43 3661  bne('.buttons#43')              #41
              0e36 00fe  ld   $fe         3662  ld(254)                         #42 then clear the selected bit
              0e37 0200  nop              3663  nop()                           #43
              0e38 fc3c  bra  .buttons#46 3664  bra('.buttons#46')              #44
                                          3665  label('.buttons#43')
.buttons#43:  0e39 a10f  suba [$0f]       3666  suba([serialRaw])               #43,45
              0e3a 2111  anda [$11]       3667  anda([buttonState])             #44
              0e3b c211  st   [$11]       3668  st([buttonState])               #45
                                          3669  label('.buttons#46')
.buttons#46:  0e3c 010f  ld   [$0f]       3670  ld([serialRaw])                 #46 Set the lower bits
              0e3d 4111  ora  [$11]       3671  ora([buttonState])              #47
                                          3672  label('.buttons#48')
.buttons#48:  0e3e c211  st   [$11]       3673  st([buttonState])               #48
              0e3f 010f  ld   [$0f]       3674  ld([serialRaw])                 #49 Update serialLast for next pass
              0e40 e0b3  jmp  y,$b3       3675  jmp(Y,'vBlankLast#52')          #50
              0e41 c210  st   [$10]       3676  st([serialLast])                #51
                                          3677
                                          3678  # TypeB
                                          3679  # pChange = pNew & ~pOld
                                          3680  # nChange = nNew | ~nOld {DeMorgan}
                                          3681  label('.buttons#39')
.buttons#39:  0e42 00ff  ld   $ff         3682  ld(255)                         #39 [TypeB] Bitwise edge-filter to detect button presses
              0e43 6110  xora [$10]       3683  xora([serialLast])              #40
              0e44 410f  ora  [$0f]       3684  ora([serialRaw])                #41 Catch button-press events
              0e45 2111  anda [$11]       3685  anda([buttonState])             #42 Keep active button presses
              0e46 410f  ora  [$0f]       3686  ora([serialRaw])                #43
              0e47 0200  nop              3687  nop()                           #44
              0e48 0200  nop              3688  nop()                           #45
              0e49 fc3e  bra  .buttons#48 3689  bra('.buttons#48')              #46
              0e4a 0200  nop              3690  nop()                           #47
