              0b12 1412  ld   $12,y       3015  ld(hi('sys_ShuffleNoise'),Y)    #15 Shuffle soundTable[4i+0]. [vAC+0]=4j, [vAC+1]=4i
              0b13 e0cf  jmp  y,$cf       3016  jmp(Y,'sys_ShuffleNoise')       #16
              0b14 1407  ld   $07,y       3017  ld(soundTable>>8,Y)             #17
