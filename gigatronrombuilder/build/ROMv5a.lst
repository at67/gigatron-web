                                          961   #
                                          962   #-----------------------------------------------------------------------
                                          963   align(0x100, size=0x100)
                                          964
                                          965   # Video off mode (also no sound, serial, timer, blinkenlights, ...).
                                          966   # For benchmarking purposes. This still has the overhead for the vTicks
                                          967   # administration, time slice granularity etc.
                                          968   label('videoZ')
                                          969   videoZ = pc()
videoZ:       0100 1505  ld   [$05],y     970   runVcpu(None, '---- novideo', returnTo=videoZ)
              0101 e0ff  jmp  y,$ff
              0102 007f  ld   $7f
