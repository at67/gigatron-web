                                          2587  #-----------------------------------------------------------------------
                                          2588  # Extension SYS_Read3_40
                                          2589  #-----------------------------------------------------------------------
                                          2590
                                          2591  # Read 3 consecutive bytes from ROM
                                          2592  #
                                          2593  # Note: This function a bit obsolete, as it has very limited use. It's
                                          2594  #       effectively an application-specific SYS function for the Pictures
                                          2595  #       application from ROM v1. It requires the ROM data be organized
                                          2596  #       with trampoline3a and trampoline3b fragments, and their address
                                          2597  #       in ROM to be known. Better avoid using this.
                                          2598  #
                                          2599  # Variables:
                                          2600  #       sysArgs[0:2]    Bytes (out)
                                          2601  #       sysArgs[6:7]    ROM pointer (in)
                                          2602
                                          2603  label('SYS_Read3_40')
SYS_Read3_40: 06b9 152b  ld   [$2b],y     2604  ld([sysArgs+7],Y)               #15,32
              06ba e079  jmp  y,$79       2605  jmp(Y,128-7)                    #16 trampoline3a
              06bb 012a  ld   [$2a]       2606  ld([sysArgs+6])                 #17
                                          2607  label('txReturn')
txReturn:     06bc c226  st   [$26]       2608  st([sysArgs+2])                 #34
              06bd 1403  ld   $03,y       2609  ld(hi('REENTER'),Y)             #35
              06be e0cb  jmp  y,$cb       2610  jmp(Y,'REENTER')                #36
              06bf 00ec  ld   $ec         2611  ld(-40/2)                       #37
                                          2612
                                          2613  def trampoline3a():
                                          2614    """Read 3 bytes from ROM page"""
                                          2615    while pc()&255 < 128-7:
                                          2616      nop()
                                          2617    bra(AC)                       #18
                                          2618    C('Trampoline for page $%02x00 reading (entry)' % (pc()>>8))
                                          2619    bra(123)                      #19
                                          2620    st([sysArgs+0])               #21
                                          2621    ld([sysArgs+6])               #22
                                          2622    adda(1)                       #23
                                          2623    bra(AC)                       #24
                                          2624    bra(250)                      #25 trampoline3b
                                          2625    align(1, size=0x80)
                                          2626
                                          2627  def trampoline3b():
                                          2628    """Read 3 bytes from ROM page (continue)"""
                                          2629    while pc()&255 < 256-6:
                                          2630      nop()
                                          2631    st([sysArgs+1])               #27
                                          2632    C('Trampoline for page $%02x00 reading (continue)' % (pc()>>8))
                                          2633    ld([sysArgs+6])               #28
                                          2634    adda(2)                       #29
                                          2635    ld(hi('txReturn'),Y)          #30
                                          2636    bra(AC)                       #31
                                          2637    jmp(Y,'txReturn')             #32
                                          2638    align(1, size=0x100)
                                          2639
