              128c 1403  ld   $03,y       5245  ld(hi('REENTER'),Y)             #83
              128d e0cb  jmp  y,$cb       5246  jmp(Y,'REENTER')                #84
              128e 00d4  ld   $d4         5247  ld(-88/2)                       #85
