                                          948   # LED sequencer (18 cycles)
              0119 012d  ld   [$2d]       949   ld([ledTimer])                  #52 Blinkenlight sequencer
              011a f01d  beq  $011d       950   beq(pc()+3)                     #53
              011b fc1e  bra  $011e       951   bra(pc()+3)                     #54
              011c a001  suba $01         952   suba(1)                         #55
              011d 012f  ld   [$2f]       953   ld([ledTempo])                  #55(!)
              011e c22d  st   [$2d]       954   st([ledTimer])                  #56
              011f f022  beq  $0122       955   beq(pc()+3)                     #57
              0120 fc23  bra  $0123       956   bra(pc()+3)                     #58
              0121 0000  ld   $00         957   ld(0)                           #59 Don't advance state
              0122 0001  ld   $01         958   ld(1)                           #59(!) Advance state when timer passes through 0
              0123 812e  adda [$2e]       959   adda([ledState_v2])             #60
              0124 ec27  bne  $0127       960   bne(pc()+3)                     #61
              0125 fc28  bra  $0128       961   bra(pc()+3)                     #62
              0126 00e8  ld   $e8         962   ld(-24)                         #63 State 0 becomes -24, start of sequence
              0127 e42c  bgt  .leds#65    963   bgt('.leds#65')                 #63(!) Catch the stopped state (>0)
              0128 c22e  st   [$2e]       964   st([ledState_v2])               #64
              0129 8048  adda $48         965   adda('.leds#69')                #65
              012a fe00  bra  ac          966   bra(AC)                         #66 Jump to lookup table
              012b fc48  bra  .leds#69    967   bra('.leds#69')                 #67 Single-instruction subroutine
                                          968
                                          969   label('.leds#65')
.leds#65:     012c 000f  ld   $0f         970   ld(0x0f)                        #65 Maintain stopped state
              012d c22e  st   [$2e]       971   st([ledState_v2])               #66
              012e fc48  bra  .leds#69    972   bra('.leds#69')                 #67
              012f 2114  anda [$14]       973   anda([xoutMask])                #68 Always clear sound bits (this is why AC=0x0f)
