                                          1852  # Instruction ALLOC: Create or destroy stack frame (vSP+=D), 14 cycles
                                          1853  label('ALLOC')
ALLOC:        03df 811c  adda [$1c]       1854  adda([vSP])                     #10
              03e0 c21c  st   [$1c]       1855  st([vSP])                       #11
              03e1 fc01  bra  NEXT        1856  bra('NEXT')                     #12
