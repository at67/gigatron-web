                                          722   #-----------------------------------------------------------------------
                                          723   # Extension SYS_Exec_88: Load code from ROM into memory and execute it
                                          724   #-----------------------------------------------------------------------
                                          725   #
                                          726   # This loads the vCPU code with consideration of the current vSP
                                          727   # Used during reset, but also for switching between applications or for
                                          728   # loading data from ROM from within an application (overlays).
                                          729   #
                                          730   # ROM stream format is [<addrH> <addrL> <n&255> n*<byte>]* 0
                                          731   # on top of lookup tables.
                                          732   #
                                          733   # Variables:
                                          734   #       sysArgs[0:1]    ROM pointer (in)
                                          735   #       sysArgs[2:3]    RAM pointer (changed)
                                          736   #       sysArgs[4]      State counter (changed)
                                          737   #       vLR             vCPU continues here (in)
                                          738
                                          739   label('SYS_Exec_88')
SYS_Exec_88:  00ad 140e  ld   $0e,y       740   ld(hi('sys_Exec'),Y)            #15
              00ae e04b  jmp  y,$4b       741   jmp(Y,'sys_Exec')               #16
              00af 0000  ld   $00         742   ld(0)                           #17 Address of loader on zero page
