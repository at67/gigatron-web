                                          2802
                                          2803  #-----------------------------------------------------------------------
                                          2804  # Extension SYS_SetMode_v2_80
                                          2805  #-----------------------------------------------------------------------
                                          2806
                                          2807  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          2808  #
                                          2809  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          2810  # the user can experiment. It's adviced to refrain from using
                                          2811  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          2812  # personal preference, and the programmer shouldn't overrule the user
                                          2813  # in that choice. The Gigatron philisophy is that the end user has
                                          2814  # the final say on what happens on the system, not the application,
                                          2815  # even if that implies a degraded performance. This doesn't mean that
                                          2816  # all applications must work well in all video modes: mode 1 is still
                                          2817  # the default. If an application really doesn't work at all in that
                                          2818  # mode, it's acceptable to change mode once after loading.
                                          2819  #
                                          2820  # There's no "SYS_GetMode" function.
                                          2821  #
                                          2822  # Variables:
                                          2823  #       vAC bit 0:1     Mode:
                                          2824  #                         0      "ABCD" -> Full mode (slowest)
                                          2825  #                         1      "ABC-" -> Default mode after reset
                                          2826  #                         2      "A-C-" -> at67's mode
                                          2827  #                         3      "A---" -> HGM's mode
                                          2828  #       vAC bit 2:15    Ignored bits and should be 0
                                          2829  #
                                          2830  # Special values (ROM v4):
                                          2831  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          2832  #                        no blinkenlights).
                                          2833  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          2834
                                          2835  # Actual duration is <80 cycles, but keep some room for future extensions
                                          2836  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       2837  ld(hi('sys_SetMode'),Y)         #15
              0b01 e054  jmp  y,$54       2838  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       2839  ld([vReturn])                   #17
                                          2840
                                          2841  #-----------------------------------------------------------------------
                                          2842  # Extension SYS_SetMemory_v2_54
                                          2843  #-----------------------------------------------------------------------
                                          2844
                                          2845  # SYS function for setting 1..256 bytes
                                          2846  #
                                          2847  # sysArgs[0]   Copy count (in, changed)
                                          2848  # sysArgs[1]   Copy value (in)
                                          2849  # sysArgs[2:3] Destination address (in, changed)
                                          2850  #
                                          2851  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          2852  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          2853  # All combined that gives a 300% speedup over ROMv4 and before.
                                          2854
                                          2855  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       2856  ld([sysArgs+0])                 #15
                                          2857  bra('sys_SetMemory#18')         #16
              0b04 fc18  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     2858  ld([sysArgs+2],X)               #17
                                          2859
                                          2860  #-----------------------------------------------------------------------
                                          2861  # Extension SYS_SendSerial1_v3_80
                                          2862  #-----------------------------------------------------------------------
                                          2863
                                          2864  # SYS function for sending data over serial controller port using
                                          2865  # pulse width modulation of the vertical sync signal.
                                          2866  #
                                          2867  # Variables:
                                          2868  #       sysArgs[0:1]    Source address               (in, changed)
                                          2869  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          2870  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          2871  #
                                          2872  # The sending will abort if input data is detected on the serial port.
                                          2873  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          2874  #
                                          2875  # This modulates the next upcoming X vertical pulses with the supplied
                                          2876  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          2877  # After that, the vPulse width falls back to 8 lines (idle).
                                          2878
                                          2879  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       2880  ld([videoY])                    #15
                                          2881  bra('sys_SendSerial1')          #16
              0b07 fc83  bra  sys_SendSerial1
              0b08 60b3  xora $b3         2882  xora(videoYline0)               #17 First line of vertical blank
                                          2883
                                          2884  #-----------------------------------------------------------------------
                                          2885  # Extension SYS_ExpanderControl_v4_40
                                          2886  #-----------------------------------------------------------------------
                                          2887
                                          2888  # Sets the I/O and RAM expander's control register
                                          2889  #
                                          2890  # Variables:
                                          2891  #       vAC bit 2       Device enable /SS0
                                          2892  #           bit 3       Device enable /SS1
                                          2893  #           bit 4       Device enable /SS2
                                          2894  #           bit 5       Device enable /SS3
                                          2895  #           bit 6       Banking B0
                                          2896  #           bit 7       Banking B1
                                          2897  #           bit 15      Data out MOSI
                                          2898  #       sysArgs[7]      Cache for control state (written to)
                                          2899  #
                                          2900  # Intended for prototyping, and probably too low-level for most applications
                                          2901  # Still there's a safeguard: it's not possible to disable RAM using this
                                          2902
                                          2903  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140c  ld   $0c,y       2904  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e0fb  jmp  y,$fb       2905  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 00fc  ld   $fc         2906  ld(0b11111100)                  #17 Safety (SCLK=0)
                                          2907  #    ^^^^^^^^
                                          2908  #    |||||||`-- SCLK
                                          2909  #    ||||||`--- Not connected
                                          2910  #    |||||`---- /SS0
                                          2911  #    ||||`----- /SS1
                                          2912  #    |||`------ /SS2
                                          2913  #    ||`------- /SS3
                                          2914  #    |`-------- B0
                                          2915  #    `--------- B1
                                          2916
                                          2917  #-----------------------------------------------------------------------
                                          2918  # Extension SYS_Run6502_v4_80
                                          2919  #-----------------------------------------------------------------------
                                          2920
                                          2921  # Transfer control to v6502
                                          2922  #
                                          2923  # Calling 6502 code from vCPU goes (only) through this SYS function.
                                          2924  # Directly modifying the vCpuSelect variable is unreliable. The
                                          2925  # control transfer is immediate, without waiting for the current
                                          2926  # time slice to end or first returning to vCPU.
                                          2927  #
                                          2928  # vCPU code and v6502 code can interoperate without much hassle:
                                          2929  # - The v6502 program counter is vLR, and v6502 doesn't touch vPC
                                          2930  # - Returning to vCPU is with the BRK instruction
                                          2931  # - BRK doesn't dump process state on the stack
                                          2932  # - vCPU can save/restore the vLR with PUSH/POP
                                          2933  # - Stacks are shared, vAC is shared
                                          2934  # - vAC can indicate what the v6502 code wants. vAC+1 will be cleared
                                          2935  # - Alternative is to leave a word in sysArgs[6:7] (v6502 X and Y registers)
                                          2936  # - Another way is to set vPC before BRK, and vCPU will continue there(+2)
                                          2937  #
                                          2938  # Calling v6502 code from vCPU looks like this:
                                          2939  #       LDWI  SYS_Run6502_v4_80
                                          2940  #       STW   sysFn
                                          2941  #       LDWI  $6502_start_address
                                          2942  #       STW   vLR
                                          2943  #       SYS   80
                                          2944  #
                                          2945  # Variables:
                                          2946  #       vAC             Accumulator
                                          2947  #       vLR             Program Counter
                                          2948  #       vSP             Stack Pointer (+1)
                                          2949  #       sysArgs[6]      Index Register X
                                          2950  #       sysArgs[7]      Index Register Y
                                          2951  # For info:
                                          2952  #       sysArgs[0:1]    Address Register, free to clobber
                                          2953  #       sysArgs[2]      Instruction Register, free to clobber
                                          2954  #       sysArgs[3:5]    Flags, don't touch
                                          2955  #
                                          2956  # Implementation details::
                                          2957  #
                                          2958  #  The time to reserve for this transition is the maximum time
                                          2959  #  between NEXT and v6502_check. This is
                                          2960  #       SYS call duration + 2*v6502_maxTicks + (v6502_overhead - vCPU_overhead)
                                          2961  #     = 22 + 28 + (11 - 9) = 62 cycles.
                                          2962  #  So reserving 80 cycles is future proof. This isn't overhead, as it includes
                                          2963  #  the fetching of the first 6502 opcode and its operands..
                                          2964  #
                                          2965  #                      0            10                 28=0         9
                                          2966  #    ---+----+---------+------------+------------------+-----------+---
                                          2967  # video | nop| runVcpu |   ENTER    | At least one ins |   EXIT    | video
                                          2968  #    ---+----+---------+------------+------------------+-----------+---
                                          2969  #        sync  prelude  ENTER-to-ins    ins-to-NEXT     NEXT-to-video
                                          2970  #       |<-->|
                                          2971  #        0/1 |<------->|
                                          2972  #                 5    |<----------------------------->|
                                          2973  #          runVCpu_overhead           28               |<--------->|
                                          2974  #                                 2*maxTicks                 9
                                          2975  #                                                      vCPU_overhead
                                          2976  #
                                          2977  #                      0                21                    38=0       11
                                          2978  #    ---+----+---------+----------------+--------------------+-----------+---
                                          2979  # video | nop| runVcpu |   v6502_ENTER  | At least one fetch |v6502_exitB| video
                                          2980  #    ---+----+---------+----------------+--------------------+-----------+---
                                          2981  #        sync  prelude   enter-to-fetch     fetch-to-check    check-to-video
                                          2982  #       |<-->|
                                          2983  #        0/1 |<------->|
                                          2984  #                 5    |<----------------------------------->|
                                          2985  #          runVcpu_overhead           38                     |<--------->|
                                          2986  #                              2*v6520_maxTicks                    11
                                          2987  #                                                            v6502_overhead
                                          2988
                                          2989  label('SYS_Run6502_v4_80')
SYS_Run6502_v4_80:
              0b0c 140d  ld   $0d,y       2990  ld(hi('sys_v6502'),Y)           #15
              0b0d e07f  jmp  y,$7f       2991  jmp(Y,'sys_v6502')              #16
              0b0e 000d  ld   $0d         2992  ld(hi('v6502_ENTER'))           #17 Activate v6502
                                          2993
