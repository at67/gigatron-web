                                          2868  #-----------------------------------------------------------------------
                                          2869  # Extension SYS_SpiExchangeBytes_v4_134
                                          2870  #-----------------------------------------------------------------------
                                          2871
                                          2872  # Send AND receive 1..256 bytes over SPI interface
                                          2873
                                          2874  # Variables:
                                          2875  #       sysArgs[0]      Page index start, for both send/receive (in, changed)
                                          2876  #       sysArgs[1]      Memory page for send data (in)
                                          2877  #       sysArgs[2]      Page index stop (in)
                                          2878  #       sysArgs[3]      Memory page for receive data (in)
                                          2879  #       sysArgs[4]      Scratch (changed)
                                          2880
                                          2881  label('SYS_SpiExchangeBytes_v4_134')
SYS_SpiExchangeBytes_v4_134:
              0b15 140d  ld   $0d,y       2882  ld(hi('sys_SpiExchangeBytes'),Y)#15
              0b16 e009  jmp  y,$09       2883  jmp(Y,'sys_SpiExchangeBytes')   #16
              0b17 1401  ld   $01,y       2884  ld(hi(ctrlBits),Y)              #17 Control state as saved by SYS_ExpanderControl
