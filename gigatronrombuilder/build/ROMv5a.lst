                                          1833  # Instruction CALL: Goto address and remember vPC (vLR,vPC=vPC+2,[D]+256*[D+1]-2), 26 cycles
                                          1834  label('CALL')
CALL:         03cf c21d  st   [$1d]       1835  st([vTmp])                      #10,12
              03d0 0116  ld   [$16]       1836  ld([vPC])                       #11
