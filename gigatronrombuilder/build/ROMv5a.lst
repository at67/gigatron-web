                                          594   #-----------------------------------------------------------------------
                                          595   # Extension SYS_Reset_88: Soft reset
                                          596   #-----------------------------------------------------------------------
                                          597
                                          598   # SYS_Reset_88 initiates an immediate Gigatron reset from within the vCPU.
                                          599   # The reset sequence itself is mostly implemented in GCL by Reset.gcl,
                                          600   # which must first be loaded into RAM. But as that takes more than 1 scanline,
                                          601   # some vCPU bootstrapping code gets loaded with SYS_Exec_88.
                                          602   # !!! This function was REMOVED from interface.json
                                          603   # !!! Better use vReset as generic entry point for soft reset
                                          604
                                          605   # ROM type (see also Docs/GT1-files.txt)
                                          606   romTypeValue = symbol('romTypeValue_ROMv5')
                                          607
                                          608   label('SYS_Reset_88')
                                          609   assert pc()>>8 == 0
                                          610   assert (romTypeValue & 7) == 0
SYS_Reset_88: 005e 0040  ld   $40         611   ld(romTypeValue)                #15 Set ROM type/version and clear channel mask
              005f c221  st   [$21]       612   st([romType])                   #16
              0060 0000  ld   $00         613   ld(0)                           #17
              0061 c21c  st   [$1c]       614   st([vSP])                       #18 vSP
              0062 1401  ld   $01,y       615   ld(hi('videoTop_v5'),Y)         #19
              0063 caf9  st   [y,$f9]     616   st([Y,lo('videoTop_v5')])       #20 Show all 120 pixel lines
              0064 caf6  st   [y,$f6]     617   st([Y,vIRQ_v5])                 #21 Disable vIRQ dispatch
              0065 caf7  st   [y,$f7]     618   st([Y,vIRQ_v5+1])               #22
              0066 c22c  st   [$2c]       619   st([soundTimer])                #23 soundTimer
                                          620   assert userCode&255 == 0
              0067 c21a  st   [$1a]       621   st([vLR])                       #24 vLR
              0068 0002  ld   $02         622   ld(userCode>>8)                 #25
              0069 c21b  st   [$1b]       623   st([vLR+1])                     #26
              006a 00f6  ld   $f6         624   ld('nopixels')                  #27 Video mode 3 (fast)
              006b c20a  st   [$0a]       625   st([videoModeB])                #28
              006c c20b  st   [$0b]       626   st([videoModeC])                #29
              006d c20c  st   [$0c]       627   st([videoModeD])                #30
