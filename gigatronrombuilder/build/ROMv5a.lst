                                          901   #-----------------------------------------------------------------------
                                          902   #
                                          903   #  $0100 ROM page 1: Video loop vertical blank
                                          904   #
                                          905   #-----------------------------------------------------------------------
                                          906   align(0x100, size=0x100)
                                          907
                                          908   # Video off mode (also no sound, serial, timer, blinkenlights, ...).
                                          909   # For benchmarking purposes. This still has the overhead for the vTicks
                                          910   # administration, time slice granularity etc.
                                          911   label('videoZ')
                                          912   videoZ = pc()
videoZ:       0100 1505  ld   [$05],y     913   runVcpu(None, '---- novideo', returnTo=videoZ)
              0101 e0ff  jmp  y,$ff
              0102 007f  ld   $7f
                                          914
                                          915   label('startVideo')             # (Re)start of video signal from idle state
startVideo:   0103 00c0  ld   $c0         916   ld(syncBits)
                                          917
                                          918   # Start of vertical blank interval
                                          919   label('vBlankStart')
vBlankStart:  0104 c21f  st   [$1f]       920   st([videoSync0])                #32 Start of vertical blank interval
              0105 0080  ld   $80         921   ld(syncBits^hSync)              #33
              0106 c220  st   [$20]       922   st([videoSync1])                #34
                                          923
                                          924   # Reset line counter before vCPU can see it
              0107 00b3  ld   $b3         925   ld(videoYline0)                 #35
              0108 c209  st   [$09]       926   st([videoY])                    #36
                                          927
                                          928   # Update frame count and [0x80] (4 cycles)
              0109 0001  ld   $01         929   ld(1)                           #37 Reinitialize carry lookup, for robustness
              010a c280  st   [$80]       930   st([0x80])                      #38
              010b 810e  adda [$0e]       931   adda([frameCount])              #39 Frame counter
              010c c20e  st   [$0e]       932   st([frameCount])                #40
                                          933
                                          934   # Mix entropy (11 cycles)
              010d 6107  xora [$07]       935   xora([entropy+1])               #41 Mix entropy
              010e 610f  xora [$0f]       936   xora([serialRaw])               #42 Mix in serial input
              010f 8106  adda [$06]       937   adda([entropy+0])               #43
              0110 c206  st   [$06]       938   st([entropy+0])                 #44
              0111 8108  adda [$08]       939   adda([entropy+2])               #45 Some hidden state
              0112 c208  st   [$08]       940   st([entropy+2])                 #46
              0113 e816  blt  $0116       941   bmi(pc()+3)                     #47
              0114 fc17  bra  $0117       942   bra(pc()+3)                     #48
              0115 6053  xora $53         943   xora(64+16+2+1)                 #49
              0116 606c  xora $6c         944   xora(64+32+8+4)                 #49(!)
              0117 8107  adda [$07]       945   adda([entropy+1])               #50
              0118 c207  st   [$07]       946   st([entropy+1])                 #51
