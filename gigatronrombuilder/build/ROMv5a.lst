                                          1859  # The instructions below are all implemented in the second code page. Jumping
                                          1860  # back and forth makes each 6 cycles slower, but it also saves space in the
                                          1861  # primary page for the instructions above. Most of them are in fact not very
                                          1862  # critical, as evidenced by the fact that they weren't needed for the first
                                          1863  # Gigatron applications (Snake, Racer, Mandelbrot, Loader). By providing them
                                          1864  # in this way, at least they don't need to be implemented as a SYS extension.
                                          1865
                                          1866  # Instruction ADDI: Add small positive constant (vAC+=D), 28 cycles
                                          1867  label('ADDI')
ADDI:         03e3 1404  ld   $04,y       1868  ld(hi('addi'),Y)                #10
              03e4 e018  jmp  y,$18       1869  jmp(Y,'addi')                   #11
              03e5 c21d  st   [$1d]       1870  st([vTmp])                      #12
