                                          2333  #-----------------------------------------------------------------------
                                          2334  #
                                          2335  #  $0500 ROM page 5-6: Shift table and code
                                          2336  #
                                          2337  #-----------------------------------------------------------------------
                                          2338
                                          2339  align(0x100, size=0x200)
                                          2340
                                          2341  # Lookup table for i>>n, with n in 1..6
                                          2342  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          2343  #       ...
                                          2344  #       ld   <.ret
                                          2345  #       st   [vTmp]
                                          2346  #       ld   >shiftTable,y
                                          2347  #       <calculate ix>
                                          2348  #       jmp  y,ac
                                          2349  #       bra  $ff
                                          2350  # .ret: ...
                                          2351  #
                                          2352  # i >> 7 can be always be done with RAM: [i&128]
                                          2353  #       ...
                                          2354  #       anda $80,x
                                          2355  #       ld   [x]
                                          2356  #       ...
                                          2357
                                          2358  label('shiftTable')
                                          2359  shiftTable = pc()
                                          2360
                                          2361  for ix in range(255):
                                          2362    for n in range(1,7): # Find first zero
                                          2363      if ~ix & (1 << (n-1)):
                                          2364        break
                                          2365    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          2366    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
shiftTable:   0500 0000  ld   $00         ;0b0000000x >> 1
              0501 0000  ld   $00         ;0b000000xx >> 2
              0502 0001  ld   $01         ;0b0000001x >> 1
              0503 0000  ld   $00         ;0b00000xxx >> 3
              0504 0002  ld   $02         ;0b0000010x >> 1
              0505 0001  ld   $01         ;0b000001xx >> 2
              0506 0003  ld   $03         ;0b0000011x >> 1
              0507 0000  ld   $00         ;0b0000xxxx >> 4
              0508 0004  ld   $04         ;0b0000100x >> 1
              0509 0002  ld   $02         ;0b000010xx >> 2
              050a 0005  ld   $05         ;0b0000101x >> 1
              050b 0001  ld   $01         ;0b00001xxx >> 3
