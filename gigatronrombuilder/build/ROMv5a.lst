                                          699   #-----------------------------------------------------------------------
                                          700   # Placeholders for future SYS functions. This works as a kind of jump
                                          701   # table. The indirection allows SYS implementations to be moved around
                                          702   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          703   # the function is not present it just acts as a NOP. Of course, when a
                                          704   # SYS function must be patched or extended it needs to have budget for
                                          705   # that in its declared maximum cycle count.
                                          706   #
                                          707   # Technically the same goal can be achieved by starting each function
                                          708   # with 2 nop's, or by overdeclaring their duration in the first place
                                          709   # (a bit is still wise to do). But this can result in fragmentation
                                          710   # of future ROM images. The indirection avoids that.
                                          711   #
                                          712   # An added advantage of having these in ROM page 0 is that it saves one
                                          713   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          714   #-----------------------------------------------------------------------
                                          715
              007a 0200  nop              716   align(0x80, size=0x80)
              007b 0200  nop
              007c 0200  nop
              * 6 times
                                          717   assert pc() == 0x80
                                          718
              0080 1403  ld   $03,y       719   ld(hi('REENTER'),Y)             #15 slot 0x80
              0081 e0cb  jmp  y,$cb       720   jmp(Y,'REENTER')                #16
              0082 00f6  ld   $f6         721   ld(-20/2)                       #17
                                          722
