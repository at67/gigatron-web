                                          3715  #-----------------------------------------------------------------------
                                          3716  #       MOS 6502 emulator
                                          3717  #-----------------------------------------------------------------------
                                          3718
                                          3719  # Some quirks:
                                          3720  # - Stack in zero page instead of page 1
                                          3721  # - No interrupts
                                          3722  # - No decimal mode (may never be added). D flag is emulated but ignored.
                                          3723  # - BRK switches back to running 16-bits vCPU
                                          3724  # - Illegal opcodes map to BRK, but can read ghost operands before trapping
                                          3725  # - Illegal opcode $ff won't be trapped and cause havoc instead
                                          3726
                                          3727  # Big things TODO:
                                          3728  # XXX Tuning, put most frequent instructions in the primary page
