                                          641   #-----------------------------------------------------------------------
                                          642   # Extension SYS_Reset_88: Soft reset
                                          643   #-----------------------------------------------------------------------
                                          644   #
                                          645   # SYS_Reset_88 initiates an immediate Gigatron reset from within the vCPU.
                                          646   # The reset sequence itself is mostly implemented in GCL by Reset.gcl,
                                          647   # which must first be loaded into RAM. But as that takes more than 1 scanline,
                                          648   # some vCPU bootstrapping code gets loaded with SYS_Exec_88.
                                          649   # !!! This function was REMOVED from interface.json
                                          650   # !!! Better use vReset as generic entry point for soft reset
                                          651
                                          652   label('SYS_Reset_88')
                                          653   assert pc()>>8 == 0
                                          654   assert (romTypeValue & 7) == 0
SYS_Reset_88: 004f 141f  ld   $1f,y       655   ld(hi('sys_Reset_88'),Y)        #15
              0050 e041  jmp  y,$41       656   jmp(Y,'sys_Reset_88')           #16
              0051 0080  ld   $80         657   ld(romTypeValue)                #17 Set ROM type/version and clear channel mask
                                          658
                                          659
              0052 0200  nop              660   align(0x80, size=0x80)
              0053 0200  nop
              0054 0200  nop
              * 46 times
                                          661   assert pc() == 0x80
