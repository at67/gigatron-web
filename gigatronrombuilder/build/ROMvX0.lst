                                          9707
                                          9708
                                          9709  # -------------------------------------------------------------
                                          9710  # vCPU instructions for comparisons between two 16-bit operands
                                          9711  # -------------------------------------------------------------
                                          9712  #
                                          9713  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          9714  # treating vAC as a two's complement 16-bit number. When we need to
                                          9715  # compare two arbitrary numnbers we normally first take their difference
                                          9716  # with SUBW.  However, when this difference is too large, the subtraction
                                          9717  # overflows and we get the wrong outcome. To get it right over the
                                          9718  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          9719  # blurp for its relational operators. (It compares stack variable $02
                                          9720  # with zero page variable $3a.)
                                          9721  #
                                          9722  #       0461  ee 02            LDLW  $02
                                          9723  #       0463  fc 3a            XORW  $3a
                                          9724  #       0465  35 53 6a         BGE   $046c
                                          9725  #       0468  ee 02            LDLW  $02
                                          9726  #       046a  90 6e            BRA   $0470
                                          9727  #       046c  ee 02            LDLW  $02
                                          9728  #       046e  b8 3a            SUBW  $3a
                                          9729  #       0470  35 56 73         BLE   $0475
                                          9730  #
                                          9731  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          9732  # They inspect both operands to see if there is an overflow risk. If
                                          9733  # so, they modify vAC such that their difference gets smaller, while
                                          9734  # preserving the relation between the two operands. After that, the
                                          9735  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          9736  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          9737  # the sequence above becomes:
                                          9738  #
                                          9739  #       0461  ee 02            LDLW  $02
                                          9740  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          9741  #       0465  b8 3a            SUBW  $3a
                                          9742  #       0467  35 56 73         BLE   $0475
                                          9743  #
                                          9744  # CMPHS/CMPHU don't make much sense other than in combination with
                                          9745  # SUBW. These modify vACH, if needed, as given in the following table:
                                          9746  #
                                          9747  #       vACH  varH  |     vACH
                                          9748  #       bit7  bit7  | CMPHS  CMPHU
                                          9749  #       ---------------------------
                                          9750  #         0     0   |  vACH   vACH      no change needed
                                          9751  #         0     1   | varH+1 varH-1     narrowing the range
                                          9752  #         1     0   | varH-1 varH+1     narrowing the range
                                          9753  #         1     1   |  vACH   vACH      no change needed
                                          9754  #       ---------------------------
                                          9755
                                          9756  # CMPHS implementation
                                          9757  label('cmphs#13')
cmphs#13:     26e0 0500  ld   [x]         9758  ld([X])                         #13
              26e1 6119  xora [$19]       9759  xora([vAC+1])                   #14
              26e2 f4f4  bge  .cmphu#17   9760  bpl('.cmphu#17')                #15 Skip if same sign
              26e3 0119  ld   [$19]       9761  ld([vAC+1])                     #16
              26e4 e8e7  blt  $26e7       9762  bmi(pc()+3)                     #17
              26e5 fce8  bra  .cmphs#20   9763  bra(pc()+3)                     #18
