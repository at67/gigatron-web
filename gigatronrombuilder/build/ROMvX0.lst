                                          2214  # pc = 0x03ec, Opcode = 0xec
                                          2215  # Instruction STLW: Store word in stack frame ([vSP+D],[vSP+D+1]=vAC&255,vAC>>8), 24 cycles
                                          2216  label('STLW')
STLW:         03ec 1404  ld   $04,y       2217  ld(hi('stlw#13'),Y)             #10
              03ed e034  jmp  y,$34       2218  jmp(Y,'stlw#13')                #11
                                          2219  #dummy()                        #12 Overlap
                                          2220  #
                                          2221  # pc = 0x03ee, Opcode = 0xee
                                          2222  # Instruction LDLW: Load word from stack frame (vAC=[vSP+D]+256*[vSP+D+1]), 24 cycles
                                          2223  label('LDLW')
LDLW:         03ee 1404  ld   $04,y       2224  ld(hi('ldlw#13'),Y)             #10 #12
              03ef e03d  jmp  y,$3d       2225  jmp(Y,'ldlw#13')                #11
                                          2226  #dummy()                        #12 Overlap
                                          2227  #
                                          2228  # pc = 0x03f0, Opcode = 0xf0
                                          2229  # Instruction POKE: Write byte in memory ([[D+1],[D]]=vAC&255), 26 cycles
