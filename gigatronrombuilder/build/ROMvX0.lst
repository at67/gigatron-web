                                          426   #
                                          427   #  RAM page 1: video line table
                                          428   #
                                          429   #-----------------------------------------------------------------------
                                          430   #
                                          431   # Byte 0-239 define the video lines
                                          432   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          433
                                          434   vReset          = 0x01f0
                                          435   vIRQ_v5         = 0x01f6
                                          436   ctrlBits        = 0x01f8
                                          437   videoTop_v5     = 0x01f9 # Number of skip lines
                                          438
                                          439   # Highest bytes are for sound channel variables
                                          440   wavA = 250      # Waveform modulation with `adda'
                                          441   wavX = 251      # Waveform modulation with `xora'
                                          442   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          443   keyH = 253      # Frequency high 8 bits
                                          444   oscL = 254      # Phase low 7 bits
                                          445   oscH = 255      # Phase high 8 bits
                                          446
                                          447   #-----------------------------------------------------------------------
                                          448   #  Memory layout
                                          449   #-----------------------------------------------------------------------
                                          450
                                          451   userCode = 0x0200       # Application vCPU code
                                          452   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          453   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          454
                                          455   #-----------------------------------------------------------------------
                                          456   #  Application definitions
                                          457   #-----------------------------------------------------------------------
                                          458
                                          459   maxTicks = 30//2                 # Duration of vCPU's slowest virtual opcode (ticks)
                                          460   minTicks = 14//2                 # vcPU's fastest instruction
                                          461
                                          462   runVcpu_overhead = 5            # Caller overhead (cycles)
                                          463   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          464
                                          465   def runVcpu(n, ref=None, returnTo=None):
                                          466     """Macro to run interpreter for exactly n cycles. Returns 0 in AC.
                                          467
                                          468     - `n' is the number of available Gigatron cycles including overhead.
                                          469       This is converted into interpreter ticks and takes into account
                                          470       the vCPU calling overheads. A `nop' is inserted when necessary
                                          471       for alignment between cycles and ticks.
                                          472     - `returnTo' is where program flow continues after return. If not set
                                          473        explicitely, it will be the first instruction behind the expansion.
                                          474     - If another interpreter than vCPU is active (v6502...), that one
                                          475       must adjust for the timing differences, because runVcpu wouldn't know."""
                                          476
                                          477     overhead = runVcpu_overhead + vCPU_overhead
                                          478     if returnTo == 0x100:         # Special case for videoZ
                                          479       overhead -= 2
                                          480
                                          481     if n is None:
                                          482       # (Clumsily) create a maximum time slice, corresponding to a vTicks
                                          483       # value of 127 (giving 282 cycles). A higher value doesn't work because
                                          484       # then SYS functions that just need 28 cycles (0 excess) won't start.
                                          485       n = (127 + maxTicks) * 2 + overhead
                                          486
                                          487     n -= overhead
                                          488     assert n > 0
                                          489
                                          490     if n % 2 == 1:
                                          491       nop()                       # Tick alignment
                                          492       n -= 1
                                          493     assert n % 2 == 0
                                          494
                                          495     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), n, ref))
                                          496
                                          497     if returnTo != 0x100:
                                          498       if returnTo is None:
                                          499         returnTo = pc() + 5       # Next instruction
                                          500       ld(lo(returnTo))            #0
                                          501       st([vReturn])               #1
                                          502
                                          503     n //= 2
                                          504     n -= maxTicks                 # First instruction always runs
                                          505     assert n < 128
                                          506
                                          507     ld([vCpuSelect],Y)            #2
                                          508     jmp(Y,'ENTER')                #3
                                          509     ld(n)                         #4
                                          510   assert runVcpu_overhead ==       5
                                          511
                                          512
