                                          517   #-----------------------------------------------------------------------
                                          518
                                          519   align(0x100, size=0x80)
                                          520
                                          521   # ROM type (see also Docs/GT1-files.txt)
                                          522   romTypeValue = symbol('romTypeValue_ROMvX0')
                                          523
                                          524   #ROM's from ROMvX0 onwards will always have the romType at a fixed and known location
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0080  ld   $80         525   ld(romTypeValue)
                                          526
                                          527   # Give a first sign of life that can be checked with a voltmeter
              0001 000f  ld   $0f         528   ld(0b1111)                      # LED's
              0002 1880  ld   $80,out     529   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0003 18c0  ld   $c0,out     530   ld(syncBits,OUT)                # hSync goes up, updating XOUT, (turn on real LED's)
                                          531
                                          532   # Setup I/O and RAM expander
              0004 c17f  rand $7f         533   ctrl(0b01111111)                # Expansion board: (1) reset signal.
              0005 c17c  rand $7c         534   ctrl(0b01111100)                # (2) disable SPI slaves, enable RAM bank 1
                                          535   #      ^^^^^^^^
                                          536   #      |||||||`-- SCLK
                                          537   #      ||||||`--- Not connected
                                          538   #      |||||`---- /SS0
                                          539   #      ||||`----- /SS1
                                          540   #      |||`------ /SS2
                                          541   #      ||`------- /SS3
                                          542   #      |`-------- B0
                                          543   #      `--------- B1
                                          544   # bit15 --------- MOSI = 0
                                          545
                                          546   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0006 0001  ld   $01         547   ld(1)                           # Quick RAM test and count
                                          548   label('.countMem0')
.countMem0:   0007 d601  st   [$01],y     549   st([memSize],Y)                 # Store in RAM and load AC in Y
              0008 00ff  ld   $ff         550   ld(255)
              0009 6900  xora [y,$00]     551   xora([Y,0])                     # Invert value from memory
              000a ca00  st   [y,$00]     552   st([Y,0])                       # Test RAM by writing the new value
              000b c200  st   [$00]       553   st([0])                         # Copy result in [0]
              000c 6900  xora [y,$00]     554   xora([Y,0])                     # Read back and compare if written ok
              000d ec0d  bne  $000d       555   bne(pc())                       # Loop forever on RAM failure here
              000e 00ff  ld   $ff         556   ld(255)
              000f 6900  xora [y,$00]     557   xora([Y,0])                     # Invert memory value again
              0010 ca00  st   [y,$00]     558   st([Y,0])                       # To restore original value
              0011 6100  xora [$00]       559   xora([0])                       # Compare with inverted copy
              0012 f016  beq  .countMem1  560   beq('.countMem1')               # If equal, we wrapped around
              0013 0101  ld   [$01]       561   ld([memSize])
              0014 fc07  bra  .countMem0  562   bra('.countMem0')               # Loop to test next address line
              0015 8200  adda ac          563   adda(AC)                        # Executes in the branch delay slot!
                                          564   label('.countMem1')
                                          565
                                          566   #ld(syncBits^hSync,OUT)
                                          567   #ld(syncBits,OUT)
                                          568
