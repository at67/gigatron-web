vRTI#15:      04ee 0130  ld   [$30]       2605  ld([vIrqSave+0])                #15 Continue with vCPU in the same timeslice (faster)
              04ef c216  st   [$16]       2606  st([vPC])                       #16
              04f0 0131  ld   [$31]       2607  ld([vIrqSave+1])                #17
              04f1 c217  st   [$17]       2608  st([vPC+1])                     #18
