              01b9 0001  ld   $01         1248  ld(vReset>>8)                   #62
              01ba c217  st   [$17]       1249  st([vPC+1])                     #63
              01bb 0002  ld   $02         1250  ld(hi('ENTER'))                 #64 Set active interpreter to vCPU
              01bc c202  st   [$02]       1251  st([vCpuSelect])                #65
                                          1252  label('.restart#66')
                                          1253
