                                          3177  #-----------------------------------------------------------------------
                                          3178  # Extension SYS_SpiExchangeBytes_v4_134
                                          3179  #-----------------------------------------------------------------------
                                          3180  #
                                          3181  # Send AND receive 1..256 bytes over SPI interface
                                          3182
                                          3183  # Variables:
                                          3184  #       sysArgs[0]      Page index start, for both send/receive (in, changed)
                                          3185  #       sysArgs[1]      Memory page for send data (in)
                                          3186  #       sysArgs[2]      Page index stop (in)
                                          3187  #       sysArgs[3]      Memory page for receive data (in)
                                          3188  #       sysArgs[4]      Scratch (changed)
                                          3189
                                          3190  label('SYS_SpiExchangeBytes_v4_134')
SYS_SpiExchangeBytes_v4_134:
              0b15 140d  ld   $0d,y       3191  ld(hi('sys_SpiExchangeBytes'),Y)#15
              0b16 e015  jmp  y,$15       3192  jmp(Y,'sys_SpiExchangeBytes')   #16
              0b17 1401  ld   $01,y       3193  ld(hi(ctrlBits),Y)              #17 Control state as saved by SYS_ExpanderControl
