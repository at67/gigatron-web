                                          570   # The 16-bit address space is scanned, even if less RAM was detected.
.countMem1:   0016 0000  ld   $00         571   ld(0)                           # Collect entropy from RAM
              0017 d218  st   [$18],x     572   st([vAC+0],X)
              0018 d619  st   [$19],y     573   st([vAC+1],Y)
                                          574   label('.initEnt0')
.initEnt0:    0019 0106  ld   [$06]       575   ld([entropy+0])
              001a f41d  bge  .initEnt1   576   bpl('.initEnt1')
              001b 8d00  adda [y,x]       577   adda([Y,X])
              001c 60bf  xora $bf         578   xora(191)
