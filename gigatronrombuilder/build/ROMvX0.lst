                                          700
                                          701   #-----------------------------------------------------------------------
                                          702   # Placeholders for future SYS functions. This works as a kind of jump
                                          703   # table. The indirection allows SYS implementations to be moved around
                                          704   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          705   # the function is not present it just acts as a NOP. Of course, when a
                                          706   # SYS function must be patched or extended it needs to have budget for
                                          707   # that in its declared maximum cycle count.
                                          708   #
                                          709   # Technically the same goal can be achieved by starting each function
                                          710   # with 2 nop's, or by overdeclaring their duration in the first place
                                          711   # (a bit is still wise to do). But this can result in fragmentation
                                          712   # of future ROM images. The indirection avoids that.
                                          713   #
                                          714   # An added advantage of having these in ROM page 0 is that it saves one
                                          715   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          716   #-----------------------------------------------------------------------
                                          717
                                          718   label('SYS_Multiply_s16_vX_66')
SYS_Multiply_s16_vX_66:
              009e 1419  ld   $19,y       719   ld(hi('sys_Multiply_s16'),Y)    #15 slot 0x9e
              009f e000  jmp  y,$00       720   jmp(Y,'sys_Multiply_s16')       #16
              00a0 012a  ld   [$2a]       721   ld([sysArgs+6])                 #17 load mask.lo
                                          722
                                          723   label('SYS_Divide_s16_vX_80')
SYS_Divide_s16_vX_80:
              00a1 1419  ld   $19,y       724   ld(hi('sys_Divide_s16'),Y)      #15 slot 0xa1
              00a2 e038  jmp  y,$38       725   jmp(Y,'sys_Divide_s16')         #16
              00a3 0128  ld   [$28]       726   ld([sysArgs+4])                 #17
                                          727
