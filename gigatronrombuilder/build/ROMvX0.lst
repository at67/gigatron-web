                                          3030
                                          3031  #-----------------------------------------------------------------------
                                          3032  # Extension SYS_SetMode_v2_80
                                          3033  #-----------------------------------------------------------------------
                                          3034  #
                                          3035  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          3036  #
                                          3037  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          3038  # the user can experiment. It's adviced to refrain from using
                                          3039  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          3040  # personal preference, and the programmer shouldn't overrule the user
                                          3041  # in that choice. The Gigatron philisophy is that the end user has
                                          3042  # the final say on what happens on the system, not the application,
                                          3043  # even if that implies a degraded performance. This doesn't mean that
                                          3044  # all applications must work well in all video modes: mode 1 is still
                                          3045  # the default. If an application really doesn't work at all in that
                                          3046  # mode, it's acceptable to change mode once after loading.
                                          3047  #
                                          3048  # There's no "SYS_GetMode" function.
                                          3049  #
                                          3050  # Variables:
                                          3051  #       vAC bit 0:1     Mode:
                                          3052  #                         0      "ABCD" -> Full mode (slowest)
                                          3053  #                         1      "ABC-" -> Default mode after reset
                                          3054  #                         2      "A-C-" -> at67's mode
                                          3055  #                         3      "A---" -> HGM's mode
                                          3056  #       vAC bit 2:15    Ignored bits and should be 0
                                          3057  #
                                          3058  # Special values (ROM v4):
                                          3059  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          3060  #                        no blinkenlights).
                                          3061  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          3062
                                          3063  # Actual duration is <80 cycles, but keep some room for future extensions
                                          3064  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       3065  ld(hi('sys_SetMode'),Y)         #15
              0b01 e054  jmp  y,$54       3066  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       3067  ld([vReturn])                   #17
                                          3068
                                          3069  #-----------------------------------------------------------------------
                                          3070  # Extension SYS_SetMemory_v2_54
                                          3071  #-----------------------------------------------------------------------
                                          3072  #
                                          3073  # SYS function for setting 1..256 bytes
                                          3074  #
                                          3075  # sysArgs[0]   Copy count (in, changed)
                                          3076  # sysArgs[1]   Copy value (in)
                                          3077  # sysArgs[2:3] Destination address (in, changed)
                                          3078  #
                                          3079  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          3080  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          3081  # All combined that gives a 300% speedup over ROMv4 and before.
                                          3082
                                          3083  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       3084  ld([sysArgs+0])                 #15
                                          3085  bra('sys_SetMemory#18')         #16
              0b04 fc18  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     3086  ld([sysArgs+2],X)               #17
                                          3087
                                          3088  #-----------------------------------------------------------------------
                                          3089  # Extension SYS_SendSerial1_v3_80
                                          3090  #-----------------------------------------------------------------------
                                          3091  #
                                          3092  # SYS function for sending data over serial controller port using
                                          3093  # pulse width modulation of the vertical sync signal.
                                          3094  #
                                          3095  # Variables:
                                          3096  #       sysArgs[0:1]    Source address               (in, changed)
                                          3097  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          3098  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          3099  #
                                          3100  # The sending will abort if input data is detected on the serial port.
                                          3101  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          3102  #
                                          3103  # This modulates the next upcoming X vertical pulses with the supplied
                                          3104  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          3105  # After that, the vPulse width falls back to 8 lines (idle).
                                          3106
                                          3107  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       3108  ld([videoY])                    #15
                                          3109  bra('sys_SendSerial1')          #16
              0b07 fc83  bra  sys_SendSerial1
              0b08 60b3  xora $b3         3110  xora(videoYline0)               #17 First line of vertical blank
                                          3111
                                          3112  #-----------------------------------------------------------------------
                                          3113  # Extension SYS_ExpanderControl_v4_40
                                          3114  #-----------------------------------------------------------------------
                                          3115  #
                                          3116  # Sets the I/O and RAM expander's control register
                                          3117  #
                                          3118  # Variables:
                                          3119  #       vAC bit 2       Device enable /SS0
                                          3120  #           bit 3       Device enable /SS1
                                          3121  #           bit 4       Device enable /SS2
                                          3122  #           bit 5       Device enable /SS3
                                          3123  #           bit 6       Banking B0
                                          3124  #           bit 7       Banking B1
                                          3125  #           bit 15      Data out MOSI
                                          3126  #       sysArgs[7]      Cache for control state (written to)
                                          3127  #
                                          3128  # Intended for prototyping, and probably too low-level for most applications
                                          3129  # Still there's a safeguard: it's not possible to disable RAM using this
                                          3130
                                          3131  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140d  ld   $0d,y       3132  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e000  jmp  y,$00       3133  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 000c  ld   $0c         3134  ld(0b00001100)                  #17
                                          3135  #    ^^^^^^^^
                                          3136  #    |||||||`-- SCLK
                                          3137  #    ||||||`--- Not connected
                                          3138  #    |||||`---- /SS0
                                          3139  #    ||||`----- /SS1
                                          3140  #    |||`------ /SS2
                                          3141  #    ||`------- /SS3
                                          3142  #    |`-------- B0
                                          3143  #    `--------- B1
                                          3144
                                          3145  #-----------------------------------------------------------------------
                                          3146  # Extension SPARE
                                          3147  #-----------------------------------------------------------------------
              0b0c 1403  ld   $03,y       3148  ld(hi('REENTER'),Y)             #15 slot 0xa7
              0b0d e0cb  jmp  y,$cb       3149  jmp(Y,'REENTER')                #16
              0b0e 00f6  ld   $f6         3150  ld(-20/2)                       #17
                                          3151
                                          3152  #-----------------------------------------------------------------------
                                          3153  # Extension SYS_ResetWaveforms_v4_50
                                          3154  #-----------------------------------------------------------------------
                                          3155  #
                                          3156  # soundTable[4x+0] = sawtooth, to be modified into metallic/noise
                                          3157  # soundTable[4x+1] = pulse
                                          3158  # soundTable[4x+2] = triangle
                                          3159  # soundTable[4x+3] = sawtooth, also useful to right shift 2 bits
                                          3160
                                          3161  label('SYS_ResetWaveforms_v4_50')
SYS_ResetWaveforms_v4_50:
              0b0f 140e  ld   $0e,y       3162  ld(hi('sys_ResetWaveforms'),Y)  #15 Initial setup of waveforms. [vAC+0]=i
              0b10 e0b2  jmp  y,$b2       3163  jmp(Y,'sys_ResetWaveforms')     #16
              0b11 1407  ld   $07,y       3164  ld(soundTable>>8,Y)             #17
                                          3165
                                          3166  #-----------------------------------------------------------------------
                                          3167  # Extension SYS_ShuffleNoise_v4_46
                                          3168  #-----------------------------------------------------------------------
                                          3169  #
                                          3170  # Use simple 6-bits variation of RC4 to permutate waveform 0 in soundTable
                                          3171
                                          3172  label('SYS_ShuffleNoise_v4_46')
SYS_ShuffleNoise_v4_46:
              0b12 140e  ld   $0e,y       3173  ld(hi('sys_ShuffleNoise'),Y)    #15 Shuffle soundTable[4i+0]. [vAC+0]=4j, [vAC+1]=4i
              0b13 e0d3  jmp  y,$d3       3174  jmp(Y,'sys_ShuffleNoise')       #16
              0b14 1407  ld   $07,y       3175  ld(soundTable>>8,Y)             #17
