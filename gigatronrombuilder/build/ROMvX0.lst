                                          2090  # pc = 0x03c7, Opcode = 0xc7
                                          2091  # Instruction PREFX3: switches instruction page to 0x2200
                                          2092  # original idea by lb3361, see https://forum.gigatron.io/viewtopic.php?p=2099#p2099
                                          2093  label('PREFX3')
PREFX3:       03c7 1414  ld   $14,y       2094  ld(hi('prefx3#13'),Y)           #10 #12
              03c8 e0c5  jmp  y,$c5       2095  jmp(Y,'prefx3#13')              #11
              03c9 c22b  st   [$2b]       2096  st([sysArgs+7])                 #12 Second operand
                                          2097
                                          2098  # SYS calls and instruction implementations rely on these labels
                                          2099  label('REENTER_28')
REENTER_28:   03ca 00f2  ld   $f2         2100  ld(-28/2)                       #25
                                          2101  label('REENTER')
REENTER:      03cb fc01  bra  NEXT        2102  bra('NEXT')                     #26 Return from SYS calls
              03cc 1517  ld   [$17],y     2103  ld([vPC+1],Y)                   #27
                                          2104
                                          2105  fillers(until=0xcd)
                                          2106
                                          2107  #
                                          2108  # The instructions below are all implemented in the second code page. Jumping
                                          2109  # back and forth makes each 6 cycles slower, but it also saves space in the
                                          2110  # primary page for the instructions above. Most of them are in fact not very
                                          2111  # critical, as evidenced by the fact that they weren't needed for the first
                                          2112  # Gigatron applications (Snake, Racer, Mandelbrot, Loader). By providing them
                                          2113  # in this way, at least they don't need to be implemented as a SYS extension.
                                          2114  #
                                          2115  # pc = 0x03cd, Opcode = 0xcd
                                          2116  # Instruction DEF: Define data or code (vAC,vPC=vPC+2,(vPC&0xff00)+D), 26 cycles
                                          2117  label('DEF')
DEF:          03cd 1404  ld   $04,y       2118  ld(hi('def#13'),Y)              #10
              03ce e017  jmp  y,$17       2119  jmp(Y,'def#13')                 #11
                                          2120  # dummy                         #12 Overlap
                                          2121  #
                                          2122  # pc = 0x03cf, Opcode = 0xcf
                                          2123  # Instruction CALL: Goto address and remember vPC (vLR,vPC=vPC+2,[D]+256*[D+1]-2), 30 cycles
                                          2124  label('CALL')
CALL:         03cf 1404  ld   $04,y       2125  ld(hi('call#13'),Y)             #10 #12
              03d0 e007  jmp  y,$07       2126  jmp(Y,'call#13')                #11
                                          2127  # dummy                         #12 Overlap
                                          2128  #
                                          2129  # pc = 0x03d1, Opcode = 0xd1
                                          2130  # Instruction POKEV+: Poke byte in vAC to address contained in var, inc var, 30 cycles
                                          2131  label('POKEV+')
POKEV+:       03d1 1418  ld   $18,y       2132  ld(hi('pokev+#13'),Y)           #10 #12
              03d2 e030  jmp  y,$30       2133  jmp(Y,'pokev+#13')              #11
                                          2134  # dummy                         #12 Overlap
                                          2135  #
                                          2136  # pc = 0x03d3, Opcode = 0xd3
                                          2137  # Instruction DOKEI+: doke immediate word into [vAC], vAC += 2, 40 cycles
                                          2138  label('DOKEI+')
DOKEI+:       03d3 1438  ld   $38,y       2139  ld(hi('dokei+#13'),Y)           #10 #12
              03d4 e087  jmp  y,$87       2140  jmp(Y,'dokei+#13')              #11
                                          2141  # dummy                         #12 Overlap
                                          2142  #
                                          2143  # pc = 0x03d5, Opcode = 0xd5
                                          2144  # Instruction TGE: Test for GE, returns 0x0000 or 0xFFFF in zero page var, 24 cycles
                                          2145  label('TGE')
TGE:          03d5 1415  ld   $15,y       2146  ld(hi('tge#13'),Y)              #10 #12
              03d6 e085  jmp  y,$85       2147  jmp(Y,'tge#13')                 #11
                                          2148  # dummy                         #12 Overlap
                                          2149  #
                                          2150  # pc = 0x03d7, Opcode = 0xd7
                                          2151  # Instruction TLT: Test for LT, returns 0x0000 or 0xFFFF in zero page var, 24 cycles
                                          2152  label('TLT')
TLT:          03d7 1415  ld   $15,y       2153  ld(hi('tlt#13'),Y)             #10 #12
              03d8 e093  jmp  y,$93       2154  jmp(Y,'tlt#13')                #11
                                          2155  # dummy                        #12 Overlap
                                          2156  #
                                          2157  # pc = 0x03d9, Opcode = 0xd9
                                          2158  # Instruction TGT: Test for GT, returns 0x0000 or 0xFFFF in zero page var, 24-26 cycles
                                          2159  label('TGT')
TGT:          03d9 1415  ld   $15,y       2160  ld(hi('tgt#13'),Y)             #10 #12
              03da e0a1  jmp  y,$a1       2161  jmp(Y,'tgt#13')                #11
                                          2162  # dummy                        #12 Overlap
                                          2163  #
                                          2164  # pc = 0x03db, Opcode = 0xdb
                                          2165  # Instruction TLE: Test for LE, returns 0x0000 or 0xFFFF in zero page var, 24-26 cycles
                                          2166  label('TLE')
TLE:          03db 1415  ld   $15,y       2167  ld(hi('tle#13'),Y)             #10 #12
              03dc e0b7  jmp  y,$b7       2168  jmp(Y,'tle#13')                #11
                                          2169  # dummy                        #12 Overlap
                                          2170  #
                                          2171  # pc = 0x03dd, Opcode = 0xdd
                                          2172  # Instruction DECWA: Decrement word var, vAC=var, 28-30 cycles
                                          2173  label('DECWA')
DECWA:        03dd 1415  ld   $15,y       2174  ld(hi('decwa#13'),Y)           #10 #12
              03de e0df  jmp  y,$df       2175  jmp(Y,'decwa#13')              #11
                                          2176  # dummy                        #12 Overlap
                                          2177  #
                                          2178  # pc = 0x03df, Opcode = 0xdf
                                          2179  # Instruction ALLOC: Create or destroy stack frame (vSP+=D), 20 cycles
                                          2180  label('ALLOC')
ALLOC:        03df 1416  ld   $16,y       2181  ld(hi('alloc#13'),Y)           #10 #12
              03e0 e03d  jmp  y,$3d       2182  jmp(Y,'alloc#13')              #11
                                          2183  # dummy                        #12 Overlap
                                          2184  #
                                          2185  # pc = 0x03e1, Opcode = 0xe1
                                          2186  # Instruction PACKVW: var = src0.lo | (src1.lo <<8), 42 cycles
                                          2187  label('PACKVW')
PACKVW:       03e1 142e  ld   $2e,y       2188  ld(hi('packvw#13'),Y)           #10 #12
              03e2 e05a  jmp  y,$5a       2189  jmp(Y,'packvw#13')              #11
                                          2190  # dummy                         #12 Overlap
                                          2191  #
                                          2192  # pc = 0x03e3, Opcode = 0xe3
                                          2193  # Instruction ADDI: Add small positive constant (vAC+=D), 26 cycles
                                          2194  label('ADDI')
ADDI:         03e3 1415  ld   $15,y       2195  ld(hi('addi#13'),Y)             #10 #12
              03e4 e000  jmp  y,$00       2196  jmp(Y,'addi#13')                #11
              03e5 c21d  st   [$1d]       2197  st([vTmp])                      #12
                                          2198
                                          2199  # pc = 0x03e6, Opcode = 0xe6
                                          2200  # Instruction SUBI: Subtract small positive constant (vAC+=D), 26 cycles
