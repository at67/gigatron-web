                                          1061
                                          1062  # When the total number of scan lines per frame is not an exact multiple of the
                                          1063  # (4) channels, there will be an audible discontinuity if no measure is taken.
                                          1064  # This static noise can be suppressed by swallowing the first `lines mod 4'
                                          1065  # partial samples after transitioning into vertical blank. This is easiest if
                                          1066  # the modulo is 0 (do nothing), 1 (reset sample when entering the last visible
                                          1067  # scan line), or 2 (reset sample while in the first blank scan line). For the
                                          1068  # last case there is no solution yet: give a warning.
                                          1069  extra = 0
                                          1070  if soundDiscontinuity == 2:
                                          1071    st(sample, [sample])          # Sound continuity
                                          1072    extra += 1
                                          1073  if soundDiscontinuity > 2:
                                          1074    highlight('Warning: sound discontinuity not suppressed')
