              0023 0118  ld   [$18]       587   ld([vAC+0])
              0024 8001  adda $01         588   adda(1)
              0025 ec19  bne  .initEnt0   589   bne('.initEnt0')
              0026 d218  st   [$18],x     590   st([vAC+0],X)
              0027 0119  ld   [$19]       591   ld([vAC+1])
              0028 8001  adda $01         592   adda(1)
              0029 ec19  bne  .initEnt0   593   bne('.initEnt0')
              002a d619  st   [$19],y     594   st([vAC+1],Y)
