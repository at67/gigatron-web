                                          2593  #
                                          2594  # Interrupt handler:
                                          2595  #       STW  $xx        -> optionally store vCpuSelect
                                          2596  #       ... IRQ payload ...
                                          2597  # either:
                                          2598  #       LDWI $400
                                          2599  #       LUP  0          -> vRTI and don't switch interpreter (immediate resume)
                                          2600  # or:
                                          2601  #       LDWI $400
                                          2602  #       LUP  $xx        -> vRTI and switch interpreter type as stored in [$xx]
              04e4 0200  nop              2603  fillers(until=251-13)
              04e5 0200  nop
              04e6 0200  nop
