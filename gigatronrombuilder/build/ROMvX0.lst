SUBI:         03e6 1415  ld   $15,y       2202  ld(hi('subi#13'),Y)             #10
              03e7 e014  jmp  y,$14       2203  jmp(Y,'subi#13')                #11
              03e8 c21d  st   [$1d]       2204  st([vTmp])                      #12
