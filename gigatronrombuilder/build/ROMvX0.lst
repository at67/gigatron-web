SYS_DrawLine_vX_86:
              00a4 1419  ld   $19,y       729   ld(hi('sys_DrawLine'),Y)        #15 slot 0xa4
              00a5 e07f  jmp  y,$7f       730   jmp(Y,'sys_DrawLine')           #16
              00a6 01a3  ld   [$a3]       731   ld([0xA3])                      #17 fgcolour
                                          732
