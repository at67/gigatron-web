              2207 0d00  ld   [y,x]       8089  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              2208 de00  st   [y,x++]     8090  st([Y,Xpp])                     #7 Just X++
              2209 fe00  bra  ac          8091  bra(AC)                         #8 Dispatch
