                                          3896
                                          3897  #-----------------------------------------------------------------------
                                          3898  #       Extended vertical blank logic: game controller decoding
                                          3899  #-----------------------------------------------------------------------
                                          3900  #
                                          3901  # Game controller types
                                          3902  # TypeA: Based on 74LS165 shift register (not supported)
                                          3903  # TypeB: Based on CD4021B shift register (standard)
                                          3904  # TypeC: Based on priority encoder
                                          3905  #
                                          3906  # Notes:
                                          3907  # - TypeA was only used during development and first beta test, before ROM v1
                                          3908  # - TypeB appears as type A with negative logic levels
                                          3909  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          3910  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          3911  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          3912  # - TypeB and TypeC can be sampled in the same scanline
                                          3913  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          3914  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          3915  #
                                          3916  #       TypeC    Alias    Button TypeB
                                          3917  #       00000000  ^@   -> Right  11111110
                                          3918  #       00000001  ^A   -> Left   11111101
                                          3919  #       00000011  ^C   -> Down   11111011
                                          3920  #       00000111  ^G   -> Up     11110111
                                          3921  #       00001111  ^O   -> Start  11101111
                                          3922  #       00011111  ^_   -> Select 11011111
                                          3923  #       00111111  ?    -> B      10111111
                                          3924  #       01111111  DEL  -> A      01111111
                                          3925  #       11111111       -> (None) 11111111
                                          3926  #
                                          3927  #       Conversion formula:
                                          3928  #               f(x) := 254 - x
                                          3929
                                          3930  # Detect controller TypeC codes
vBlankLast#34:
              0e32 010f  ld   [$0f]       3931  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              0e33 8001  adda $01         3932  adda(1)                         #35
              0e34 210f  anda [$0f]       3933  anda([serialRaw])               #36
              0e35 ec46  bne  .buttons#39 3934  bne('.buttons#39')              #37
                                          3935
                                          3936  # TypeC
              0e36 010f  ld   [$0f]       3937  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              0e37 8001  adda $01         3938  adda(1)                         #39
              0e38 2110  anda [$10]       3939  anda([serialLast])              #40
              0e39 ec3d  bne  .buttons#43 3940  bne('.buttons#43')              #41
              0e3a 00fe  ld   $fe         3941  ld(254)                         #42 then clear the selected bit
              0e3b 0200  nop              3942  nop()                           #43
              0e3c fc40  bra  .buttons#46 3943  bra('.buttons#46')              #44
                                          3944  label('.buttons#43')
.buttons#43:  0e3d a10f  suba [$0f]       3945  suba([serialRaw])               #43,45
              0e3e 2111  anda [$11]       3946  anda([buttonState])             #44
              0e3f c211  st   [$11]       3947  st([buttonState])               #45
                                          3948  label('.buttons#46')
.buttons#46:  0e40 010f  ld   [$0f]       3949  ld([serialRaw])                 #46 Set the lower bits
              0e41 4111  ora  [$11]       3950  ora([buttonState])              #47
                                          3951  label('.buttons#48')
.buttons#48:  0e42 c211  st   [$11]       3952  st([buttonState])               #48
              0e43 010f  ld   [$0f]       3953  ld([serialRaw])                 #49 Update serialLast for next pass
              0e44 e0a5  jmp  y,$a5       3954  jmp(Y,'vBlankLast#52')          #50
              0e45 c210  st   [$10]       3955  st([serialLast])                #51
