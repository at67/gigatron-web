                                          2005  #
                                          2006  # The 'SYS' vCPU instruction first checks the number of desired ticks given by
                                          2007  # the operand. As long as there are insufficient ticks available in the current
                                          2008  # time slice, the instruction will be retried. This will effectively wait for
                                          2009  # the next scan line if the current slice is almost out of time. Then a jump to
                                          2010  # native code is made. This code can do whatever it wants, but it must return
                                          2011  # to the 'REENTER' label when done. When returning, AC must hold (the negative
                                          2012  # of) the actual consumed number of whole ticks for the entire virtual
                                          2013  # instruction cycle (from NEXT to NEXT). This duration may not exceed the prior
                                          2014  # declared duration in the operand + 28 (or maxTicks). The operand specifies the
                                          2015  # (negative) of the maximum number of *extra* ticks that the native call will
                                          2016  # need. The GCL compiler automatically makes this calculation from gross number
                                          2017  # of cycles to excess number of ticks.
                                          2018  # SYS functions can modify vPC to implement repetition. For example to split
                                          2019  # up work into multiple chucks.
                                          2020  label('.sys#13')
.sys#13:      03af 1418  ld   $18,y       2021  ld(hi('.sys#16'),Y)             #13 #12
              03b0 e000  jmp  y,$00       2022  jmp(Y,'.sys#16')                #14
                                          2023  # dummy                         #15 Overlap
                                          2024  #
                                          2025  # pc = 0x03b1, Opcode = 0xb1
                                          2026  # Instruction PREFX1
                                          2027  label('PREFX1')
PREFX1:       03b1 1414  ld   $14,y       2028  ld(hi('prefx1#13'),Y)           #10 #15
              03b2 e0d5  jmp  y,$d5       2029  jmp(Y,'prefx1#13')              #11
              03b3 0023  ld   $23         2030  ld(hi('PREFX1_PAGE'))           #12 ENTER is at $(n-1)ff, where n = instruction page
                                          2031
                                          2032  # pc = 0x03b4, Opcode = 0xb4
                                          2033  # Instruction SYS: Native call, <=256 cycles (<=128 ticks, in reality less)
                                          2034  label('SYS')
SYS:          03b4 8115  adda [$15]       2035  adda([vTicks])                  #10
              03b5 e8af  blt  .sys#13     2036  blt('.sys#13')                  #11
              03b6 1523  ld   [$23],y     2037  ld([sysFn+1],Y)                 #12
              03b7 e122  jmp  y,[$22]     2038  jmp(Y,[sysFn])                  #13
