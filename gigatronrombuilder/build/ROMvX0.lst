* source: /var/www/html/phpbb/ext/at67/gigatronrombuilder/romsrc/ROMvX0.asm.py
                                          201   enableListing()
                                          202   #-----------------------------------------------------------------------
                                          203   #
                                          204   #  Start of core
                                          205   #
                                          206   #-----------------------------------------------------------------------
                                          207   #
                                          208   # Pre-loading the formal interface as a way to get warnings when
                                          209   # accidentally redefined with a different value
                                          210   loadBindings('ROMvX0_interface.json')
                                          211   loadBindings('Core/interface-dev.json') # Provisional values for DEVROM
                                          212
                                          213   # Gigatron clock
                                          214   cpuClock = 6.250e+06
                                          215
                                          216   # Output pin assignment for VGA
                                          217   R, G, B, hSync, vSync = 1, 4, 16, 64, 128
                                          218   syncBits = hSync+vSync # Both pulses negative
                                          219
                                          220   # When the XOUT register is in the circuit, the rising edge triggers its update.
                                          221   # The loop can therefore not be agnostic to the horizontal pulse polarity.
                                          222   assert syncBits & hSync != 0
                                          223
                                          224   # VGA 640x480 defaults (to be adjusted below!)
                                          225   vFront = 10     # Vertical front porch
                                          226   vPulse = 2      # Vertical sync pulse
                                          227   vBack  = 33     # Vertical back porch
                                          228   vgaLines = vFront + vPulse + vBack + 480
                                          229   vgaClock = 25.175e+06
                                          230
                                          231   # Video adjustments for Gigatron
                                          232   # 1. Our clock is (slightly) slower than 1/4th VGA clock. Not all monitors will
                                          233   #    accept the decreased frame rate, so we restore the frame rate to above
                                          234   #    minimum 59.94 Hz by cutting some lines from the vertical front porch.
                                          235   vFrontAdjust = vgaLines - int(4 * cpuClock / vgaClock * vgaLines)
                                          236   vFront -= vFrontAdjust
                                          237   # 2. Extend vertical sync pulse so we can feed the game controller the same
                                          238   #    signal. This is needed for controllers based on the 4021 instead of 74165
                                          239   vPulseExtension = max(0, 8-vPulse)
                                          240   vPulse += vPulseExtension
                                          241   # 3. Borrow these lines from the back porch so the refresh rate remains
                                          242   #    unaffected
                                          243   vBack -= vPulseExtension
                                          244
                                          245   # Start value of vertical blank counter
                                          246   videoYline0 = 1-2*(vFront+vPulse+vBack-2)
                                          247
                                          248   # Mismatch between video lines and sound channels
                                          249   soundDiscontinuity = (vFront+vPulse+vBack) % 4
                                          250
                                          251   # QQVGA resolution
                                          252   qqVgaWidth      = 160
                                          253   qqVgaHeight     = 120
                                          254
                                          255   # Game controller bits (actual controllers in kit have negative output)
                                          256   # +----------------------------------------+
                                          257   # |       Up                        B*     |
                                          258   # |  Left    Right               B     A*  |
                                          259   # |      Down      Select Start     A      |
                                          260   # +----------------------------------------+ *=Auto fire
                                          261   buttonRight     = 1
                                          262   buttonLeft      = 2
                                          263   buttonDown      = 4
                                          264   buttonUp        = 8
                                          265   buttonStart     = 16
                                          266   buttonSelect    = 32
                                          267   buttonB         = 64
                                          268   buttonA         = 128
                                          269
                                          270   #-----------------------------------------------------------------------
                                          271   #
                                          272   #  RAM page 0: zero-page variables
                                          273   #
                                          274   #-----------------------------------------------------------------------
                                          275   #
                                          276   # Memory size in pages from auto-detect
                                          277   memSize         = zpByte()
                                          278
                                          279   # Active interpreter page, swapped with channel, so that we can do a one
                                          280   # instruction vCpuSelect reset, i.e. st(vCpuSelect,[vCpuSelect])
                                          281   vCpuSelect      = zpByte()
                                          282
                                          283   # Next sound sample being synthesized
                                          284   sample          = zpByte()
                                          285   # To save one instruction in the critical inner loop, `sample' is always
                                          286   # reset with its own address instead of, for example, the value 0. Compare:
                                          287   # 1 instruction reset
                                          288   #       st sample,[sample]
                                          289   # 2 instruction reset:
                                          290   #       ld 0
                                          291   #       st [sample]
                                          292   # The difference is not audible. This is fine when the reset/address
                                          293   # value is low and doesn't overflow with 4 channels added to it.
                                          294   # There is an alternative, but it requires pull-down diodes on the data bus:
                                          295   #       st [sample],[sample]
                                          296   assert 4*63 + sample < 256
                                          297   # We pin this reset/address value to 3, so `sample' swings from 3 to 255
                                          298   assert sample == 3
                                          299
                                          300   # Former bootCount and bootCheck (<= ROMv3)
                                          301   vSPH             = zpByte()
                                          302
                                          303   # The current channel number for sound generation. Advanced every scan line
                                          304   # and independent of the vertical refresh to maintain constant oscillation.
                                          305   channel         = zpByte()
                                          306
                                          307   # Entropy harvested from SRAM startup and controller input
                                          308   entropy         = zpByte(2)
                                          309
                                          310   # Audio quantisation bit mask, (needs a HW mod for full realisation)
                                          311   audioBitMask    = zpByte() # 0xFF:0bits to 0x00:8bits, default 0x0F:4bits
                                          312
                                          313   # Visible video
                                          314   videoY          = zpByte() # Counts up from 0 to 238 in steps of 2
                                          315                              # Counts up (and is odd) during vertical blank
                                          316   videoModeB      = zpByte() # Handler for every 2nd line (pixel burst or vCPU)
                                          317   videoModeC      = zpByte() # Handler for every 3rd line (pixel burst or vCPU)
                                          318   videoModeD      = zpByte() # Handler for every 4th line (pixel burst or vCPU)
                                          319
                                          320   nextVideo       = zpByte() # Jump offset to scan line handler (videoA, B, C...)
                                          321   videoPulse      = nextVideo # Used for pulse width modulation
                                          322
                                          323   # Frame counter is good enough as system clock
                                          324   frameCount      = zpByte(1)
                                          325
                                          326   # Serial input (game controller)
                                          327   serialRaw       = zpByte() # New raw serial read
                                          328   serialLast      = zpByte() # Previous serial read
                                          329   buttonState     = zpByte() # Clearable button state
                                          330   resetTimer      = zpByte() # After 2 seconds of holding 'Start', do a soft reset
                                          331                              # XXX move to page 1 to free up space
                                          332
                                          333   # Extended output (blinkenlights in bit 0:3 and audio in bit 4:7). This
                                          334   # value must be present in AC during a rising hSync edge. It then gets
                                          335   # copied to the XOUT register by the hardware. The XOUT register is only
                                          336   # accessible in this indirect manner because it isn't part of the core
                                          337   # CPU architecture.
                                          338   xout            = zpByte()
                                          339   xoutMask        = zpByte() # The blinkenlights and sound on/off state
                                          340
                                          341   # vCPU interpreter
                                          342   vTicks          = zpByte()  # Interpreter ticks are units of 2 clocks
                                          343   vPC             = zpByte(2) # Interpreter program counter, points into RAM
                                          344   vAC             = zpByte(2) # Interpreter accumulator, 16-bits
                                          345   vLR             = zpByte(2) # Return address, for returning after CALL
                                          346   vSP             = zpByte(1) # Stack pointer
                                          347   vTmp            = zpByte()
                                          348   vReturn         = zpByte()  # Return into video loop (in page of vBlankStart)
                                          349
                                          350   # Scratch
                                          351   frameX          = zpByte() # Starting byte within page
                                          352   frameY          = zpByte() # Page of current pixel line (updated by videoA)
                                          353
                                          354   # Vertical blank (reuse some variables used in the visible part)
                                          355   videoSync0      = frameX   # Vertical sync type on current line (0xc0 or 0x40)
                                          356   videoSync1      = frameY   # Same during horizontal pulse (0x80 or 0x00)
                                          357
                                          358   # Versioning for GT1 compatibility
                                          359   # Please refer to Docs/GT1-files.txt for interpreting this variable
                                          360   romType         = zpByte(1)
                                          361
                                          362   # The low 3 bits are repurposed to select the actively updated sound channels.
                                          363   # Valid bit combinations are:
                                          364   #  xxxxx011     Default after reset: 4 channels (page 1,2,3,4)
                                          365   #  xxxxx001     2 channels at double update rate (page 1,2)
                                          366   #  xxxxx000     1 channel at quadruple update rate (page 1)
                                          367   # The main application for this is to free up the high bytes of page 2,3,4.
                                          368   channelMask = symbol('channelMask_v4')
                                          369   assert romType == channelMask
                                          370
                                          371   # SYS function arguments and results/scratch
                                          372   sysFn           = zpByte(2)
                                          373   sysArgs         = zpByte(8)
                                          374
                                          375   # Play sound if non-zero, count down and stop sound when zero
                                          376   soundTimer      = zpByte()
                                          377
                                          378   # Fow now the LED state machine itself is hard-coded in the program ROM
                                          379   #ledTimer        = zpByte() # Number of ticks until next LED change
                                          380   #ledState_v2     = zpByte() # Current LED state
                                          381   #ledTempo        = zpByte() # Next value for ledTimer after LED state change
                                          382   jiffiesTick     = zpByte() # VBlank ticks
                                          383   secondsTickLo   = zpByte() # Seconds ticks low byte
                                          384   secondsTickHi   = zpByte() # Seconds ticks high byte
                                          385
                                          386   # All bytes above userVars, except 0x80, are potentially usable by user code
                                          387   # that refrains from using ROM facilities introduced since ROMv5a.
                                          388   userVars        = zpByte(0)
                                          389
                                          390   # [0x30-0x35]
                                          391   # Saved vCPU context during vIRQ (since ROMv5a)
                                          392   # Code that uses vCPU interrupts should not use these locations.
                                          393   # area register save area
                                          394   vIrqSave        = zpByte(6)
                                          395   userVars1       = zpByte(0)
                                          396
                                          397   # [0x80]
                                          398   # Constant 0x01.
                                          399   zpReset(0x80)
                                          400   oneConst        = zpByte(1)
                                          401   userVars2       = zpByte(0)
                                          402
                                          403   # [0x82-0xB7]
                                          404   # Scratch for certain ops and sys calls introduced in ROMvX0.
                                          405   # Pending more specific information to be inserted here.
                                          406   zpReset(0x82)
                                          407   vX0Scratch      = zpByte(0xB8-0x82)
                                          408
                                          409   # [0xB8-0xBF]
                                          410   # State for ROMvX0 SYS calls with vCPU callbacks.
                                          411   # Pending more specific information to be inserted here.
                                          412   vX0State        = zpByte(0xC0-0xB8)
                                          413
                                          414   # [0xC0-0xCF]
                                          415   # Fixed locations for ROMvX0 opcodes that operate on long and floats.
                                          416   # Pending more specific information to be inserted here.
                                          417   vFAC_reserved   = zpByte(4)     # reserved for float accumulator
                                          418   vLAC            = zpByte(4)     # long accumulator/continued float accumulator
                                          419   vTmpL           = zpByte(4)     # long scratch register
                                          420   vDST            = zpByte(2)     # destination address for copy opcodes.
                                          421   vTmpW           = zpByte(2)     # word scratch register
