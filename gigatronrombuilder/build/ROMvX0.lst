                                          1211  label('vBlankLast#52')
                                          1212
                                          1213  # Respond to reset button (14 cycles)
                                          1214  # - ResetTimer decrements as long as just [Start] is pressed down
                                          1215  # - Reaching 0 (normal) or 128 (extended) triggers the soft reset sequence
                                          1216  # - Initial value is 128 (or 255 at boot), first decrement, then check
                                          1217  # - This starts vReset -> SYS_Reset_88 -> SYS_Exec_88 -> Reset.gcl -> Main.gcl
                                          1218  # - Main.gcl then recognizes extended presses if resetTimer is 0..127 ("paasei")
                                          1219  # - This requires a full cycle (4s) in the warm boot scenario
                                          1220  # - Or a half cycle (2s) when pressing [Select] down during hard reset
                                          1221  # - This furthermore requires >=1 frame (and <=128) to have passed between
                                          1222  #   reaching 128 and getting through Reset and the start of Main, while [Start]
                                          1223  #   was still pressed so the count reaches <128. Two reasonable expectations.
                                          1224  # - The unintended power-up scenarios of ROMv1 (pulling SER_DATA low, or
                                          1225  #   pressing [Select] together with another button) now don't trigger anymore.
                                          1226
vBlankLast#52:
              01a5 0111  ld   [$11]       1227  ld([buttonState])               #52 Check [Start] for soft reset
              01a6 60ef  xora $ef         1228  xora(~buttonStart)              #53
              01a7 ecb0  bne  .restart#56 1229  bne('.restart#56')              #54
              01a8 0112  ld   [$12]       1230  ld([resetTimer])                #55 As long as button pressed
              01a9 a001  suba $01         1231  suba(1)                         #56 ... count down the timer
              01aa c212  st   [$12]       1232  st([resetTimer])                #57
              01ab 207f  anda $7f         1233  anda(127)                       #58
              01ac f0b8  beq  .restart#61 1234  beq('.restart#61')              #59 Reset at 0 (normal 2s) or 128 (extended 4s)
              01ad 00ee  ld   $ee         1235  ld((vReset&255)-2)              #60 Start force reset when hitting 0
              01ae fcb7  bra  .restart#63 1236  bra('.restart#63')              #61 ... otherwise do nothing yet
              01af fcb6  bra  .restart#64 1237  bra('.restart#64')              #62
                                          1238  label('.restart#56')
.restart#56:  01b0 0001  ld   $01         1239  wait(62-56)                     #56
              01b1 ecb1  bne  $01b1
              01b2 a001  suba $01
              01b3 0200  nop
              01b4 0080  ld   $80         1240  ld(128)                         #62 Not pressed, reset the timer
              01b5 c212  st   [$12]       1241  st([resetTimer])                #63
                                          1242  label('.restart#64')
.restart#64:  01b6 fcbd  bra  .restart#66 1243  bra('.restart#66')              #64
                                          1244  label('.restart#63')
