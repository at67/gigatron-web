LSLW:         03e9 1404  ld   $04,y       2210  ld(hi('lslw#13'),Y)             #10
              03ea e028  jmp  y,$28       2211  jmp(Y,'lslw#13')                #11
              03eb 0118  ld   [$18]       2212  ld([vAC])                       #12
