                                          974   #-----------------------------------------------------------------------
                                          975   #
                                          976   #  $0100 ROM page 1: Video loop vertical blank
                                          977   #
                                          978   #-----------------------------------------------------------------------
                                          979   align(0x100, size=0x100)
                                          980
                                          981   # Video off mode (also no sound, serial, timer, blinkenlights, ...).
                                          982   # For benchmarking purposes. This still has the overhead for the vTicks
                                          983   # administration, time slice granularity etc.
                                          984   label('videoZ')
                                          985   videoZ = pc()
videoZ:       0100 1502  ld   [$02],y     986   runVcpu(None, '---- novideo', returnTo=videoZ)
              0101 e0ff  jmp  y,$ff
              0102 007f  ld   $7f
                                          987
                                          988   label('startVideo')             # (Re)start of video signal from idle state
startVideo:   0103 00c0  ld   $c0         989   ld(syncBits)
                                          990
                                          991   # Start of vertical blank interval
                                          992   label('vBlankStart')
vBlankStart:  0104 c21f  st   [$1f]       993   st([videoSync0])                #32 Start of vertical blank interval
              0105 0080  ld   $80         994   ld(syncBits^hSync)              #33
              0106 c220  st   [$20]       995   st([videoSync1])                #34
                                          996
                                          997   # Reset line counter before vCPU can see it
              0107 00b3  ld   $b3         998   ld(videoYline0)                 #35
              0108 c209  st   [$09]       999   st([videoY])                    #36
                                          1000
                                          1001  # Update frame count and [0x80] (4 cycles)
              0109 0001  ld   $01         1002  ld(1)                           #37 Reinitialize carry lookup, for robustness
              010a c280  st   [$80]       1003  st([0x80])                      #38
              010b 810e  adda [$0e]       1004  adda([frameCount])              #39 Frame counter
              010c c20e  st   [$0e]       1005  st([frameCount])                #40
                                          1006
                                          1007  # Mix entropy (11 cycles)
              010d 6107  xora [$07]       1008  xora([entropy+1])               #41 Mix entropy
              010e 610f  xora [$0f]       1009  xora([serialRaw])               #42 Mix in serial input
              010f 8106  adda [$06]       1010  adda([entropy+0])               #43
              0110 c206  st   [$06]       1011  st([entropy+0])                 #44
              0111 8116  adda [$16]       1012  adda([vPC])                     #45 Some hidden state
              0112 e815  blt  $0115       1013  bmi(pc()+3)                     #46
              0113 fc16  bra  $0116       1014  bra(pc()+3)                     #47
              0114 6053  xora $53         1015  xora(64+16+2+1)                 #48
              0115 606c  xora $6c         1016  xora(64+32+8+4)                 #48(!)
              0116 8107  adda [$07]       1017  adda([entropy+1])               #49
              0117 c207  st   [$07]       1018  st([entropy+1])                 #50
                                          1019
                                          1020
                                          1021  # Timer
              0118 012d  ld   [$2d]       1022  ld([jiffiesTick])               #51
              0119 8001  adda $01         1023  adda(1)                         #52
              011a c22d  st   [$2d]       1024  st([jiffiesTick])               #53
              011b 603c  xora $3c         1025  xora(60)                        #54
              011c f01f  beq  $011f       1026  beq(pc()+3)                     #55
              011d fc20  bra  $0120       1027  bra(pc()+3)                     #56
              011e 0200  nop              1028  nop()                           #57
              011f c22d  st   [$2d]       1029  st([jiffiesTick])               #57(!)
              0120 f023  beq  $0123       1030  beq(pc()+3)                     #58
              0121 fc24  bra  $0124       1031  bra(pc()+3)                     #59
              0122 0000  ld   $00         1032  ld(0)                           #60
              0123 0001  ld   $01         1033  ld(1)                           #60(!)
                                          1034  beq('vblankExpansion')          #61
              0124 f02e  beq  vblankExpansion
              0125 812e  adda [$2e]       1035  adda([secondsTickLo])           #62
              0126 c22e  st   [$2e]       1036  st([secondsTickLo])             #63
              0127 f02a  beq  $012a       1037  beq(pc()+3)                     #64
              0128 fc2b  bra  $012b       1038  bra(pc()+3)                     #65
              0129 0000  ld   $00         1039  ld(0)                           #66
              012a 0001  ld   $01         1040  ld(1)                           #66(!)
              012b 812f  adda [$2f]       1041  adda([secondsTickHi])           #67
              012c fc35  bra  vPulseInit  1042  bra('vPulseInit')               #68
