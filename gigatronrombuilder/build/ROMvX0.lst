                                          3958  # pChange = pNew & ~pOld
                                          3959  # nChange = nNew | ~nOld {DeMorgan}
                                          3960  label('.buttons#39')
.buttons#39:  0e46 00ff  ld   $ff         3961  ld(255)                         #39 [TypeB] Bitwise edge-filter to detect button presses
              0e47 6110  xora [$10]       3962  xora([serialLast])              #40
              0e48 410f  ora  [$0f]       3963  ora([serialRaw])                #41 Catch button-press events
              0e49 2111  anda [$11]       3964  anda([buttonState])             #42 Keep active button presses
              0e4a 410f  ora  [$0f]       3965  ora([serialRaw])                #43
              0e4b 0200  nop              3966  nop()                           #44
              0e4c 0200  nop              3967  nop()                           #45
              0e4d fc42  bra  .buttons#48 3968  bra('.buttons#48')              #46
              0e4e 0200  nop              3969  nop()                           #47
