              02ba caff  st   [y,$ff]     1364  st([Y,oscH])                    #14
              02bb 20fc  anda $fc         1365  anda(0xfc)                      #15
              02bc 69fb  xora [y,$fb]     1366  xora([Y,wavX])                  #16
              02bd 1200  ld   ac,x        1367  ld(AC,X)                        #17
              02be 09fa  ld   [y,$fa]     1368  ld([Y,wavA])                    #18
              02bf 1407  ld   $07,y       1369  ld(soundTable>>8,Y)             #19
              02c0 8d00  adda [y,x]       1370  adda([Y,X])                     #20
              02c1 e8c4  blt  $02c4       1371  bmi(pc()+3)                     #21
              02c2 fcc5  bra  $02c5       1372  bra(pc()+3)                     #22
              02c3 203f  anda $3f         1373  anda(63)                        #23
              02c4 003f  ld   $3f         1374  ld(63)                          #23(!)
              02c5 8103  adda [$03]       1375  adda([sample])                  #24
              02c6 c203  st   [$03]       1376  st([sample])                    #25
                                          1377
              02c7 0113  ld   [$13]       1378  ld([xout])                      #26 Gets copied to XOUT
              02c8 fd0d  bra  [$0d]       1379  bra([nextVideo])                #27
              02c9 18c0  ld   $c0,out     1380  ld(syncBits,OUT)                #28 End horizontal pulse
                                          1381
                                          1382  # Back porch B: second of 4 repeated scan lines
                                          1383  # - Recompute Xi from dXi and store for retrieval in the next scan lines
                                          1384  label('videoB')
videoB:       02ca 00d3  ld   $d3         1385  ld('videoC')                    #29 2nd scanline of 4
              02cb c20d  st   [$0d]       1386  st([nextVideo])                 #30
              02cc 1401  ld   $01,y       1387  ld(videoTable>>8,Y)             #31
              02cd 0109  ld   [$09]       1388  ld([videoY])                    #32
              02ce 9001  adda $01,x       1389  adda(1,X)                       #33
              02cf 011f  ld   [$1f]       1390  ld([frameX])                    #34
              02d0 8d00  adda [y,x]       1391  adda([Y,X])                     #35
              02d1 fd0a  bra  [$0a]       1392  bra([videoModeB])               #36
              02d2 d21f  st   [$1f],x     1393  st([frameX],X)                  #37 Store in RAM and X
                                          1394
                                          1395  # Back porch C: third of 4 repeated scan lines
                                          1396  # - Nothing new to for video do as Yi and Xi are known,
                                          1397  # - This is the time to emit and reset the next sound sample
                                          1398  label('videoC')
videoC:       02d3 00dc  ld   $dc         1399  ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1400  st([nextVideo])                 #30
              02d5 0103  ld   [$03]       1401  ld([sample])                    #31 New sound sample is ready (didn't fit in the audio loop)
              02d6 4108  ora  [$08]       1402  ora([audioBitMask])             #32 configure 4/6/8bit audio
              02d7 2114  anda [$14]       1403  anda([xoutMask])                #33
              02d8 c213  st   [$13]       1404  st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
              02d9 c003  st   $03,[$03]   1405  st(sample, [sample])            #35 Reset for next sample
              02da fd0b  bra  [$0b]       1406  bra([videoModeC])               #36
              02db 111f  ld   [$1f],x     1407  ld([frameX],X)                  #37
                                          1408
                                          1409  # Back porch D: last of 4 repeated scan lines
                                          1410  # - Calculate the next frame index
                                          1411  # - Decide if this is the last line or not
                                          1412  label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1413  ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1414  ld([videoY])                    #30
              02de a0ee  suba $ee         1415  suba((120-1)*2)                 #31
                                          1416  beq('.lastpixels#34')           #32
              02df f0e5  beq  .lastpixels#34
              02e0 80f0  adda $f0         1417  adda(120*2)                     #33 More pixel lines to go
              02e1 c209  st   [$09]       1418  st([videoY])                    #34
              02e2 0001  ld   $01         1419  ld('videoA')                    #35
              02e3 fd0c  bra  [$0c]       1420  bra([videoModeD])               #36
              02e4 c20d  st   [$0d]       1421  st([nextVideo])                 #37
                                          1422
                                          1423  label('.lastpixels#34')
                                          1424  if soundDiscontinuity == 1:
.lastpixels#34:
              02e5 c003  st   $03,[$03]   1425    st(sample, [sample])          #34 Sound continuity
                                          1426  else:
                                          1427    nop()                         #34
              02e6 00e9  ld   $e9         1428  ld('videoE')                    #35 No more pixel lines to go
              02e7 fd0c  bra  [$0c]       1429  bra([videoModeD])               #36
              02e8 c20d  st   [$0d]       1430  st([nextVideo])                 #37
                                          1431
                                          1432  # Back porch "E": after the last line
                                          1433  # - Go back and and enter vertical blank (program page 2)
                                          1434  label('videoE') # Exit visible area
videoE:       02e9 1401  ld   $01,y       1435  ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
              02ea e004  jmp  y,$04       1436  jmp(Y,'vBlankStart')            #30
              02eb 00c0  ld   $c0         1437  ld(syncBits)                    #31
                                          1438
                                          1439  # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1440  # This yields some speed, but also frees up screen memory for other purposes.
                                          1441  # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1442  # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1443  label('videoF')
videoF:       02ec 0120  ld   [$20]       1444  ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1445  adda(0x80)                      #30
              02ee d220  st   [$20],x     1446  st([videoSync1],X)              #31
              02ef 011f  ld   [$1f]       1447  ld([frameX])                    #32
              02f0 a500  suba [x]         1448  suba([X])                       #33 Decrements every two VGA scanlines
              02f1 f0f4  beq  .videoF#36  1449  beq('.videoF#36')               #34
              02f2 c21f  st   [$1f]       1450  st([frameX])                    #35
              02f3 fcf6  bra  nopixels    1451  bra('nopixels')                 #36
                                          1452  label('.videoF#36')
.videoF#36:   02f4 0001  ld   $01         1453  ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1454  st([nextVideo])                 #37
                                          1455  #
                                          1456  # Alternative for pixel burst: faster application mode
                                          1457  label('nopixels')
nopixels:     02f6 00ff  ld   $ff         1458  runVcpu(200-38, 'ABCD line 40-520',
              02f7 c21e  st   [$1e]
              02f8 1502  ld   [$02],y
              02f9 e0ff  jmp  y,$ff
              02fa 003b  ld   $3b
                                          1459    returnTo=0x1ff)               #38 Application interpreter (black scanlines)
                                          1460
                                          1461  #-----------------------------------------------------------------------
                                          1462  #
                                          1463  #  $0300 ROM page 3: Application interpreter primary page
                                          1464  #
                                          1465  #-----------------------------------------------------------------------
                                          1466  #
                                          1467  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1468  #
                                          1469  # This routine will execute as many as possible instructions in the
                                          1470  # allotted time. When time runs out, it synchronizes such that the total
                                          1471  # duration matches the caller's request. Durations are counted in `ticks',
                                          1472  # which are multiples of 2 clock cycles.
                                          1473  #
                                          1474  # Synopsis: Use the runVcpu() macro as entry point
                                          1475
                                          1476  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1477  # precious space in the packed interpreter code page. Although ENTER's
                                          1478  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1479  # in this case it will still jump into the right space, because branches
                                          1480  # from $xxFF land in the next page anyway.
                                          1481  while pc()&255 < 255:
              02fb 0200  nop              1482    nop()
              02fc 0200  nop
              02fd 0200  nop
              02fe 0200  nop
                                          1483  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1484  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1485  # --- Page boundary ---
                                          1486  align(0x100,size=0x100)
                                          1487  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1488  ld([vPC+1],Y)                   #1
                                          1489
                                          1490  # Fetch next instruction and execute it, but only if there are sufficient
                                          1491  # ticks left for the slowest instruction.
                                          1492  label('NEXT')
NEXT:         0301 8115  adda [$15]       1493  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        1494  blt('EXIT')                     #1 Escape near time out
                                          1495  label('.next2')
.next2:       0303 c215  st   [$15]       1496  st([vTicks])                    #2
              0304 0116  ld   [$16]       1497  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         1498  adda(2)                         #4
              0306 d216  st   [$16],x     1499  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       1500  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     1501  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          1502  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       1503  ld([Y,X])                       #9 Prefetch operand
                                          1504
                                          1505  # Resync with video driver and transfer control
                                          1506  label('EXIT')
EXIT:         030b 800f  adda $0f         1507  adda(maxTicks)                  #3
                                          1508  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      1509  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         1510  suba(1)                         #5
              030e 1401  ld   $01,y       1511  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     1512  jmp(Y,[vReturn])                #7 To video driver
              0310 0000  ld   $00         1513  ld(0)                           #8 AC should be 0 already. Still..
                                          1514  assert vCPU_overhead ==          9
                                          1515
                                          1516  # pc = 0x0311, Opcode = 0x11
                                          1517  # Instruction LDWI: Load immediate word constant (vAC=D), 24 cycles
                                          1518  label('LDWI')
LDWI:         0311 140b  ld   $0b,y       1519  ld(hi('ldwi#13'),Y)             #10
              0312 e0b0  jmp  y,$b0       1520  jmp(Y,'ldwi#13')                #11
              0313 1517  ld   [$17],y     1521  ld([vPC+1],Y)                   #12
                                          1522
                                          1523  # pc = 0x0314, Opcode = 0x14
                                          1524  # Instruction DEC: Decrement byte var ([D]--), 22 cycles
                                          1525  label('DEC')
DEC:          0314 1416  ld   $16,y       1526  ld(hi('dec#13'),Y)              #10
              0315 e00a  jmp  y,$0a       1527  jmp(Y,'dec#13')                 #11
                                          1528  # dummy                         #12 Overlap
                                          1529  #
                                          1530  # pc = 0x0316, Opcode = 0x16
                                          1531  # Instruction MOVQB: Load a byte var with a small constant 0..255, 28 cycles
                                          1532  label('MOVQB')
MOVQB:        0316 1416  ld   $16,y       1533  ld(hi('movqb#13'),Y)            #10 #12
              0317 e069  jmp  y,$69       1534  jmp(Y,'movqb#13')               #11
                                          1535  # dummy                         #12 Overlap
                                          1536  #
                                          1537  # pc = 0x0318, Opcode = 0x18
                                          1538  # Instruction LSRB: Logical shift right byte var, 28 cycles
                                          1539  label('LSRB')
LSRB:         0318 1416  ld   $16,y       1540  ld(hi('lsrb#13'),Y)             #10 #12
              0319 e0b7  jmp  y,$b7       1541  jmp(Y,'lsrb#13')                #11
                                          1542  # dummy                         #12 Overlap
                                          1543  #
                                          1544  # pc = 0x031a, Opcode = 0x1a
                                          1545  # Instruction LD: Load byte from zero page (vAC=[D]), 22 cycles
                                          1546  label('LD')
LD:           031a 1416  ld   $16,y       1547  ld(hi('ld#13'),Y)               #10 #12
              031b e011  jmp  y,$11       1548  jmp(Y,'ld#13')                  #11
                                          1549  # dummy                         #12 Overlap
                                          1550  #
                                          1551  # pc = 0x031c, Opcode = 0x1c
                                          1552  # Instruction ADDBI: dst.lo = imm + src.lo, 30 cycles
                                          1553  label('ADDBI')
ADDBI:        031c 1435  ld   $35,y       1554  ld(hi('addbi#13'),Y)            #10 #12
              031d e000  jmp  y,$00       1555  jmp(Y,'addbi#13')               #11
              031e 1517  ld   [$17],y     1556  ld([vPC+1],Y)                   #12 vPC.hi
                                          1557
                                          1558  # pc = 0x031f, Opcode = 0x1f
                                          1559  # Instruction SPARE0:
                                          1560  label('SPARE0')
SPARE0:       031f 1403  ld   $03,y       1561  ld(hi('SPARE0'),Y)              #10
              0320 e01f  jmp  y,$1f       1562  jmp(Y,'SPARE0')                 #11
                                          1563  # dummy                         #12 Overlap, not dependent on ld(AC,X) anymore
                                          1564  #
                                          1565  # pc = 0x0321, Opcode = 0x21
                                          1566  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 24 cycles
                                          1567  label('LDW')
LDW:          0321 1416  ld   $16,y       1568  ld(hi('ldw#13'),Y)              #10 #12
              0322 e0bf  jmp  y,$bf       1569  jmp(Y,'ldw#13')                 #11
                                          1570  # dummy                         #12 Overlap
                                          1571  #
                                          1572  # pc = 0x0323, Opcode = 0x23
                                          1573  # Instruction PEEKV+: Peek byte at address contained in var, inc var, 30 cycles
                                          1574  label('PEEKV+')
PEEKV+:       0323 1418  ld   $18,y       1575  ld(hi('peekv+#13'),Y)           #10 #12
              0324 e00b  jmp  y,$0b       1576  jmp(Y,'peekv+#13')              #11
                                          1577  # dummy                         #12 Overlap
                                          1578  #
                                          1579  # pc = 0x0325, Opcode = 0x25
                                          1580  # Instruction POKEI: Poke immediate byte into address contained in [vAC], 20 cycles
                                          1581  label('POKEI')
POKEI:        0325 1417  ld   $17,y       1582  ld(hi('pokei#13'),Y)            #10 #12
              0326 e0ca  jmp  y,$ca       1583  jmp(Y,'pokei#13')               #11
                                          1584  # dummy                         #12 Overlap
                                          1585  #
                                          1586  # pc = 0x0327, Opcode = 0x27
                                          1587  # Instruction LSLV: Logical shift left word var, 28 cycles
                                          1588  label('LSLV')
LSLV:         0327 1416  ld   $16,y       1589  ld(hi('lslv#13'),Y)             #10 #12
              0328 e0a3  jmp  y,$a3       1590  jmp(Y,'lslv#13')                #11
                                          1591  # dummy                         #12 Overlap
                                          1592  #
                                          1593  # pc = 0x0329, Opcode = 0x29
                                          1594  # Instruction ADDVB: dst.lo = src0.lo + src1.lo, 36 cycles
                                          1595  label('ADDVB')
ADDVB:        0329 142d  ld   $2d,y       1596  ld(hi('addvb#13'),Y)            #10 #12
              032a e0b4  jmp  y,$b4       1597  jmp(Y,'addvb#13')               #11
                                          1598  # dummy                         #12 Overlap
                                          1599  #
                                          1600  # pc = 0x032b, Opcode = 0x2b
                                          1601  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 24 cycles
                                          1602  label('STW')
STW:          032b 1416  ld   $16,y       1603  ld(hi('stw#13'),Y)              #10 #12
              032c e0c9  jmp  y,$c9       1604  jmp(Y,'stw#13')                 #11
                                          1605  # dummy                         #12 Overlap
                                          1606  #
                                          1607  # pc = 0x032d, Opcode = 0x2d
                                          1608  # Instruction CNVXY: var = src0.lo | ((src1.lo + 8) <<8), 44 cycles
                                          1609  label('CNVXY')
CNVXY:        032d 142e  ld   $2e,y       1610  ld(hi('cnvxy#13'),Y)            #10 #12
              032e e07c  jmp  y,$7c       1611  jmp(Y,'cnvxy#13')               #11
                                          1612  # dummy                         #12 Overlap
                                          1613  #
                                          1614  # pc = 0x032f, Opcode = 0x2f
                                          1615  # Instruction PREFX2
                                          1616  label('PREFX2')
PREFX2:       032f 1414  ld   $14,y       1617  ld(hi('prefx2#13'),Y)           #10 #12
              0330 e0cd  jmp  y,$cd       1618  jmp(Y,'prefx2#13')              #11
              0331 c22b  st   [$2b]       1619  st([sysArgs+7])                 #12 Operand
                                          1620
                                          1621  # pc = 0x0332, Opcode = 0x32
                                          1622  # Instruction MOVWA: Move 16bits from src zero page var to dst zero page var, vAC=dst, 40 cycles
                                          1623  label('MOVWA')
MOVWA:        0332 1417  ld   $17,y       1624  ld(hi('movwa#13'),Y)            #10
              0333 e0df  jmp  y,$df       1625  jmp(Y,'movwa#13')               #11
              0334 1517  ld   [$17],y     1626  ld([vPC+1],Y)                   #12 vPC.hi
                                          1627
                                          1628  # pc = 0x0335, Opcode = 0x35
                                          1629  # Instruction BCC: Test AC sign and branch conditionally, variable, (24-26), cycles
                                          1630  label('BCC')
BCC:          0335 de00  st   [y,x++]     1631  st([Y,Xpp])                     #10 X++
              0336 143f  ld   $3f,y       1632  ld(0x3f,Y)                      #11
              0337 e200  jmp  y,ac        1633  jmp(Y,AC)                       #12 AC is the conditional operand
                                          1634  # dummy                         #13 Overlap
                                          1635  #
                                          1636  # pc = 0x0338, Opcode = 0x38
                                          1637  # Instruction SUBBI: dst.lo = src.lo - imm, 34 cycles
                                          1638  label('SUBBI')
SUBBI:        0338 1435  ld   $35,y       1639  ld(hi('subbi#13'),Y)            #10 #12
              0339 e010  jmp  y,$10       1640  jmp(Y,'subbi#13')               #11
              033a 1517  ld   [$17],y     1641  ld([vPC+1],Y)                   #12 vPC.hi
                                          1642
                                          1643  # pc = 0x033b, Opcode = 0x3b
                                          1644  # Instruction DEEKV: read word from address contained in var, 28 cycles
                                          1645  label('DEEKV')
DEEKV:        033b 1416  ld   $16,y       1646  ld(hi('deekv#13'),Y)            #10
              033c e093  jmp  y,$93       1647  jmp(Y,'deekv#13')               #11
                                          1648  # dummy                         #12 Overlap
                                          1649  #
                                          1650  # pc = 0x033d, Opcode = 0x3d
                                          1651  # Instruction ARRVW: vAC = imm16 + idx*2, 56 cycles
                                          1652  label('ARRVW')
ARRVW:        033d 1428  ld   $28,y       1653  ld(hi('arrvw#13'),Y)            #10 #12
              033e e0a0  jmp  y,$a0       1654  jmp(Y,'arrvw#13')               #11
                                          1655  # dummy                         #12 Overlap
                                          1656  #
                                          1657  # pc = 0x033f, Opcode = 0x3f
                                          1658  # Instruction LDARRW: vAC = deek [imm16 + idx*2], 62 cycles
                                          1659  label('LDARRW')
LDARRW:       033f 1436  ld   $36,y       1660  ld(hi('ldarrw#13'),Y)           #10
              0340 e037  jmp  y,$37       1661  jmp(Y,'ldarrw#13')              #11
              0341 1517  ld   [$17],y     1662  ld([vPC+1],Y)                   #12 vPC.hi
                                          1663
                                          1664  # pc = 0x0342, Opcode = 0x42
                                          1665  # Instruction ADDVI: dst = src + imm, vAC = dst, 54 cycles
                                          1666  label('ADDVI')
ADDVI:        0342 1428  ld   $28,y       1667  ld(hi('addvi#13'),Y)            #10
              0343 e000  jmp  y,$00       1668  jmp(Y,'addvi#13')               #11
                                          1669  # dummy                         #12 Overlap
                                          1670
                                          1671  # pc = 0x0344, Opcode = 0x44
                                          1672  # Instruction SUBVI: dst = src - imm, vAC = dst, 54 cycles
                                          1673  label('SUBVI')
SUBVI:        0344 1428  ld   $28,y       1674  ld(hi('subvi#13'),Y)            #10 #12
              0345 e02f  jmp  y,$2f       1675  jmp(Y,'subvi#13')               #11
                                          1676  # dummy                         #12 Overlap
                                          1677
                                          1678  # pc = 0x0346, Opcode = 0x46
                                          1679  # Instruction DEEKV+: Deek word at address contained in var, var += 2, 30 cycles
                                          1680  label('DEEKV+')
DEEKV+:       0346 1418  ld   $18,y       1681  ld(hi('deekv+#13'),Y)           #10 #12
              0347 e051  jmp  y,$51       1682  jmp(Y,'deekv+#13')              #11
                                          1683  # dummy                         #12 Overlap
                                          1684  #
                                          1685  # pc = 0x0348, Opcode = 0x48
                                          1686  # Instruction SUBVB: dst.lo = src0.lo - src1.lo, 36 cycles
                                          1687  label('SUBVB')
SUBVB:        0348 142d  ld   $2d,y       1688  ld(hi('subvb#13'),Y)            #10 #12
              0349 e0d0  jmp  y,$d0       1689  jmp(Y,'subvb#13')               #11
                                          1690  # dummy                         #12 Overlap
                                          1691  #
                                          1692  # pc = 0x034a, Opcode = 0x4a
                                          1693  # Instruction DJGE:
                                          1694  label('DJGE')
DJGE:         034a 142b  ld   $2b,y       1695  ld(hi('djge#13'),Y)             #10 #12
              034b e000  jmp  y,$00       1696  jmp(Y,'djge#13')                #11
              034c 1517  ld   [$17],y     1697  ld([vPC+1],Y)                   #12
                                          1698
                                          1699  # pc = 0x034d, Opcode = 0x4d
                                          1700  # Instruction MOVQW: Load a word var with a small constant 0..255, 28 cycles
                                          1701  label('MOVQW')
MOVQW:        034d 1416  ld   $16,y       1702  ld(hi('movqw#13'),Y)            #10 #12
              034e e076  jmp  y,$76       1703  jmp(Y,'movqw#13')               #11
                                          1704  # dummy                         #12 Overlap
                                          1705  #
                                          1706  # pc = 0x034f, Opcode = 0x4f
                                          1707  # Instruction STWM: store [vAC] into [imm16], 30 cycles
                                          1708  label('STWM')
STWM:         034f 142e  ld   $2e,y       1709  ld(hi('stwm#13'),Y)             #10 #12
              0350 e0af  jmp  y,$af       1710  jmp(Y,'stwm#13')                #11
                                          1711  # dummy                         #12 Overlap
                                          1712  #
                                          1713  # pc = 0x0351, Opcode = 0x51
                                          1714  # Instruction STARRW: doke [imm16 + idx*2] with vAC, 62 cycles
                                          1715  label('STARRW')
STARRW:       0351 1436  ld   $36,y       1716  ld(hi('starrw#13'),Y)           #10 #12
              0352 e06f  jmp  y,$6f       1717  jmp(Y,'starrw#13')              #11
                                          1718  # dummy                         #12 Overlap
