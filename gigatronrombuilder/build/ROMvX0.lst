                                          2628  #  $0500 ROM page 5-6: Shift table and code
                                          2629  #
                                          2630  #-----------------------------------------------------------------------
                                          2631
                                          2632  align(0x100, size=0x200)
                                          2633
                                          2634  # Lookup table for i>>n, with n in 1..6
                                          2635  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          2636  #       ...
                                          2637  #       ld   <.ret
                                          2638  #       st   [vTmp]
                                          2639  #       ld   >shiftTable,y
                                          2640  #       <calculate ix>
                                          2641  #       jmp  y,ac
                                          2642  #       bra  $ff
                                          2643  # .ret: ...
                                          2644  #
                                          2645  # i >> 7 can be always be done with RAM: [i&128]
                                          2646  #       ...
                                          2647  #       anda $80,x
                                          2648  #       ld   [x]
                                          2649  #       ...
                                          2650
                                          2651  label('shiftTable')
                                          2652  shiftTable = pc()
                                          2653
                                          2654  for ix in range(255):
                                          2655    for n in range(1,7): # Find first zero
                                          2656      if ~ix & (1 << (n-1)):
                                          2657        break
                                          2658    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          2659    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
