              002c c216  st   [$16]       601   st([vPC])
              002d 9002  adda $02,x       602   adda(2,X)
              002e 0001  ld   $01         603   ld(vReset>>8)
              002f d617  st   [$17],y     604   st([vPC+1],Y)
              0030 dc59  st   $59,[y,x++] 605   st('LDI',             [Y,Xpp])
