              04f5 c219  st   [$19]       2612  st([vAC+1])                     #22
              04f6 0134  ld   [$34]       2613  ld([vIrqSave+4])                #23 Restore vCpuSelect for PREFIX
              04f7 c202  st   [$02]       2614  st([vCpuSelect])                #24
              04f8 9401  adda $01,y       2615  adda(1,Y)                       #25 Jump to correct PREFIX page, (or page3 by default)
              04f9 e0cb  jmp  y,$cb       2616  jmp(Y,'REENTER')                #26
              04fa 00f1  ld   $f1         2617  ld(-30/2)                       #27
