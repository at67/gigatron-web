              2203 c215  st   [$15]       8085  st([vTicks])                    #2
              2204 1116  ld   [$16],x     8086  ld([vPC],X)                     #3 PREFIX+ARG1 is 2 bytes, vPC has been incremented by 2
              2205 0200  nop              8087  nop()                           #4
