                                          3439
                                          3440  #-----------------------------------------------------------------------
                                          3441  # Extension SYS_Sprite6_v3_64
                                          3442  # Extension SYS_Sprite6x_v3_64
                                          3443  # Extension SYS_Sprite6y_v3_64
                                          3444  # Extension SYS_Sprite6xy_v3_64
                                          3445  #-----------------------------------------------------------------------
                                          3446  #
                                          3447  # Blit sprite in screen memory
                                          3448  #
                                          3449  # Variables
                                          3450  #       vAC             Destination address in screen
                                          3451  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          3452  #                       by negative byte value N (typically N = -Y)
                                          3453  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          3454  #
                                          3455  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          3456  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          3457  # of 6 pixels at a time, and then written to the screen through the
                                          3458  # destination pointer (each chunk underneath the previous), thus
                                          3459  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          3460  # negative byte N after a chunk signals the end of the sprite data.
                                          3461  # So the sprite's height Y is determined by the source data and is
                                          3462  # therefore flexible. This negative byte value, typically N == -Y,
                                          3463  # is then used to adjust the destination pointer's high byte, to make
                                          3464  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          3465  # call for as many 6-pixel wide stripes you need. All arguments are
                                          3466  # already left in place to facilitate this. After one call, the source
                                          3467  # pointer will point past that source data, effectively:
                                          3468  #       src += Y * 6 + 1
                                          3469  # The destination pointer will have been adjusted as:
                                          3470  #       dst += (Y + N) * 256 + 6
                                          3471  # (With arithmetic wrapping around on the same memory page)
                                          3472  #
                                          3473  # Y is only limited by source memory, not by CPU cycles. The
                                          3474  # implementation is such that the SYS function self-repeats, each
                                          3475  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          3476  # pixels per scanline this way.
                                          3477
                                          3478  label('SYS_Sprite6_v3_64')
                                          3479
SYS_Sprite6_v3_64:
              0c00 1124  ld   [$24],x     3480  ld([sysArgs+0],X)               #15 Pixel data source address
              0c01 1525  ld   [$25],y     3481  ld([sysArgs+1],Y)               #16
              0c02 0d00  ld   [y,x]       3482  ld([Y,X])                       #17 Next pixel or stop
              0c03 f411  bge  .sysDpx0    3483  bpl('.sysDpx0')                 #18
              0c04 de00  st   [y,x++]     3484  st([Y,Xpp])                     #19 Just X++
                                          3485
              0c05 8119  adda [$19]       3486  adda([vAC+1])                   #20 Adjust dst for convenience
              0c06 c219  st   [$19]       3487  st([vAC+1])                     #21
              0c07 0118  ld   [$18]       3488  ld([vAC])                       #22
              0c08 8006  adda $06         3489  adda(6)                         #23
              0c09 c218  st   [$18]       3490  st([vAC])                       #24
              0c0a 0124  ld   [$24]       3491  ld([sysArgs+0])                 #25 Adjust src for convenience
              0c0b 8001  adda $01         3492  adda(1)                         #26
              0c0c c224  st   [$24]       3493  st([sysArgs+0])                 #27
              0c0d 0200  nop              3494  nop()                           #28
              0c0e 1403  ld   $03,y       3495  ld(hi('REENTER'),Y)             #29 Normal exit (no self-repeat)
              0c0f e0cb  jmp  y,$cb       3496  jmp(Y,'REENTER')                #30
              0c10 00ef  ld   $ef         3497  ld(-34/2)                       #31
