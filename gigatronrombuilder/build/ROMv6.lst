                                          684
                                          685   #-----------------------------------------------------------------------
                                          686   # Placeholders for future SYS functions. This works as a kind of jump
                                          687   # table. The indirection allows SYS implementations to be moved around
                                          688   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          689   # the function is not present it just acts as a NOP. Of course, when a
                                          690   # SYS function must be patched or extended it needs to have budget for
                                          691   # that in its declared maximum cycle count.
                                          692   #
                                          693   # Technically the same goal can be achieved by starting each function
                                          694   # with 2 nop's, or by overdeclaring their duration in the first place
                                          695   # (a bit is still wise to do). But this can result in fragmentation
                                          696   # of future ROM images. The indirection avoids that.
                                          697   #
                                          698   # An added advantage of having these in ROM page 0 is that it saves one
                                          699   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          700   #-----------------------------------------------------------------------
                                          701
              007e 0200  nop              702   align(0x80, size=0x80)
              007f 0200  nop
                                          703   assert pc() == 0x80
                                          704
              0080 1403  ld   $03,y       705   ld(hi('REENTER'),Y)             #15 slot 0x80
              0081 e0cb  jmp  y,$cb       706   jmp(Y,'REENTER')                #16
              0082 00f6  ld   $f6         707   ld(-20/2)                       #17
                                          708
              0083 1403  ld   $03,y       709   ld(hi('REENTER'),Y)             #15 slot 0x83
              0084 e0cb  jmp  y,$cb       710   jmp(Y,'REENTER')                #16
              0085 00f6  ld   $f6         711   ld(-20/2)                       #17
                                          712
              0086 1403  ld   $03,y       713   ld(hi('REENTER'),Y)             #15 slot 0x86
              0087 e0cb  jmp  y,$cb       714   jmp(Y,'REENTER')                #16
              0088 00f6  ld   $f6         715   ld(-20/2)                       #17
                                          716
              0089 1403  ld   $03,y       717   ld(hi('REENTER'),Y)             #15 slot 0x89
              008a e0cb  jmp  y,$cb       718   jmp(Y,'REENTER')                #16
              008b 00f6  ld   $f6         719   ld(-20/2)                       #17
                                          720
              008c 1403  ld   $03,y       721   ld(hi('REENTER'),Y)             #15 slot 0x8c
