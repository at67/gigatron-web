                                          5274  # Entered last line of vertical blank (line 40)
                                          5275  label('vBlankLast#34')
                                          5276
                                          5277  #-----------------------------------------------------------------------
                                          5278  #       Extended vertical blank logic: game controller decoding
                                          5279  #-----------------------------------------------------------------------
                                          5280
                                          5281  # Game controller types
                                          5282  # TypeA: Based on 74LS165 shift register (not supported)
                                          5283  # TypeB: Based on CD4021B shift register (standard)
                                          5284  # TypeC: Based on priority encoder
                                          5285  #
                                          5286  # Notes:
                                          5287  # - TypeA was only used during development and first beta test, before ROM v1
                                          5288  # - TypeB appears as type A with negative logic levels
                                          5289  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          5290  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          5291  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          5292  # - TypeB and TypeC can be sampled in the same scanline
                                          5293  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          5294  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          5295  #
                                          5296  #       TypeC    Alias    Button TypeB
                                          5297  #       00000000  ^@   -> Right  11111110
                                          5298  #       00000001  ^A   -> Left   11111101
                                          5299  #       00000011  ^C   -> Down   11111011
                                          5300  #       00000111  ^G   -> Up     11110111
                                          5301  #       00001111  ^O   -> Start  11101111
                                          5302  #       00011111  ^_   -> Select 11011111
                                          5303  #       00111111  ?    -> B      10111111
                                          5304  #       01111111  DEL  -> A      01111111
                                          5305  #       11111111       -> (None) 11111111
                                          5306  #
                                          5307  #       Conversion formula:
                                          5308  #               f(x) := 254 - x
                                          5309
                                          5310  # Detect controller TypeC codes
vBlankLast#34:
              1225 010f  ld   [$0f]       5311  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              1226 8001  adda $01         5312  adda(1)                         #35
              1227 210f  anda [$0f]       5313  anda([serialRaw])               #36
              1228 ec39  bne  .buttons#39 5314  bne('.buttons#39')              #37
                                          5315
                                          5316  # TypeC
              1229 010f  ld   [$0f]       5317  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              122a 8001  adda $01         5318  adda(1)                         #39
              122b 2110  anda [$10]       5319  anda([serialLast])              #40
              122c ec30  bne  .buttons#43 5320  bne('.buttons#43')              #41
              122d 00fe  ld   $fe         5321  ld(254)                         #42 then clear the selected bit
              122e 0200  nop              5322  nop()                           #43
              122f fc33  bra  .buttons#46 5323  bra('.buttons#46')              #44
                                          5324  label('.buttons#43')
.buttons#43:  1230 a10f  suba [$0f]       5325  suba([serialRaw])               #43,45
              1231 2111  anda [$11]       5326  anda([buttonState])             #44
              1232 c211  st   [$11]       5327  st([buttonState])               #45
                                          5328  label('.buttons#46')
.buttons#46:  1233 010f  ld   [$0f]       5329  ld([serialRaw])                 #46 Set the lower bits
              1234 4111  ora  [$11]       5330  ora([buttonState])              #47
