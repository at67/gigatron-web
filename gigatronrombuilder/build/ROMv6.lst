                                          398   #-----------------------------------------------------------------------
                                          399   #
                                          400   #  RAM page 1: video line table
                                          401   #
                                          402   #-----------------------------------------------------------------------
                                          403
                                          404   # Byte 0-239 define the video lines
                                          405   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          406
                                          407   vReset          = 0x01f0
                                          408   vIRQ_v5         = 0x01f6
                                          409   ctrlBits        = 0x01f8
                                          410   videoTop_v5     = 0x01f9 # Number of skip lines
                                          411
                                          412   # Highest bytes are for sound channel variables
                                          413   wavA = 250      # Waveform modulation with `adda'
                                          414   wavX = 251      # Waveform modulation with `xora'
                                          415   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          416   keyH = 253      # Frequency high 8 bits
                                          417   oscL = 254      # Phase low 7 bits
                                          418   oscH = 255      # Phase high 8 bits
                                          419
                                          420   #-----------------------------------------------------------------------
                                          421   #  Memory layout
                                          422   #-----------------------------------------------------------------------
                                          423
                                          424   userCode = 0x0200       # Application vCPU code
                                          425   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          426   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          427
                                          428   #-----------------------------------------------------------------------
                                          429   #  Application definitions
                                          430   #-----------------------------------------------------------------------
                                          431
                                          432   maxTicks = 28//2                 # Duration of vCPU's slowest virtual opcode (ticks)
                                          433   minTicks = 14//2                 # vcPU's fastest instruction
                                          434
                                          435   runVcpu_overhead = 5            # Caller overhead (cycles)
                                          436   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          437
                                          438   def runVcpu(n, ref=None, returnTo=None):
                                          439     """Macro to run interpreter for exactly n cycles. Returns 0 in AC.
                                          440
                                          441     - `n' is the number of available Gigatron cycles including overhead.
                                          442       This is converted into interpreter ticks and takes into account
                                          443       the vCPU calling overheads. A `nop' is inserted when necessary
                                          444       for alignment between cycles and ticks.
                                          445     - `returnTo' is where program flow continues after return. If not set
                                          446        explicitely, it will be the first instruction behind the expansion.
                                          447     - If another interpreter than vCPU is active (v6502...), that one
                                          448       must adjust for the timing differences, because runVcpu wouldn't know."""
                                          449
                                          450     overhead = runVcpu_overhead + vCPU_overhead
                                          451     if returnTo == 0x100:         # Special case for videoZ
                                          452       overhead -= 2
                                          453
                                          454     if n is None:
                                          455       # (Clumsily) create a maximum time slice, corresponding to a vTicks
                                          456       # value of 127 (giving 282 cycles). A higher value doesn't work because
                                          457       # then SYS functions that just need 28 cycles (0 excess) won't start.
                                          458       n = (127 + maxTicks) * 2 + overhead
                                          459
                                          460     n -= overhead
                                          461     assert n > 0
                                          462
                                          463     if n % 2 == 1:
                                          464       nop()                       # Tick alignment
                                          465       n -= 1
                                          466     assert n % 2 == 0
                                          467
                                          468     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), n, ref))
                                          469
                                          470     if returnTo != 0x100:
                                          471       if returnTo is None:
                                          472         returnTo = pc() + 5       # Next instruction
                                          473       ld(lo(returnTo))            #0
                                          474       st([vReturn])               #1
                                          475
                                          476     n //= 2
                                          477     n -= maxTicks                 # First instruction always runs
                                          478     assert n < 128
                                          479
                                          480     ld([vCpuSelect],Y)            #2
                                          481     jmp(Y,'ENTER')                #3
                                          482     ld(n)                         #4
                                          483   assert runVcpu_overhead ==       5
                                          484
                                          485   #-----------------------------------------------------------------------
                                          486   #
                                          487   #  $0000 ROM page 0: Boot
                                          488   #
                                          489   #-----------------------------------------------------------------------
                                          490
                                          491   align(0x100, size=0x80)
                                          492
                                          493   # Give a first sign of life that can be checked with a voltmeter
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0000  ld   $00         494   ld(0b0000)                      # LEDs |OOOO|
              0001 1880  ld   $80,out     495   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0002 18c0  ld   $c0,out     496   ld(syncBits,OUT)                # hSync goes up, updating XOUT
                                          497
                                          498   # Setup I/O and RAM expander
              0003 c17f  rand $7f         499   ctrl(0b01111111)                # Reset signal (default state | 0x3)
              0004 c17c  rand $7c         500   ctrl(0b01111100)                # Disable SPI slaves, enable RAM, bank 1
                                          501   #      ^^^^^^^^
                                          502   #      |||||||`-- SCLK
                                          503   #      ||||||`--- Not connected
                                          504   #      |||||`---- /SS0
                                          505   #      ||||`----- /SS1
                                          506   #      |||`------ /SS2
                                          507   #      ||`------- /SS3
                                          508   #      |`-------- B0
                                          509   #      `--------- B1
                                          510   # bit15 --------- MOSI = 0
                                          511
                                          512   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0005 0001  ld   $01         513   ld(1)                           # Quick RAM test and count
                                          514   label('.countMem0')
.countMem0:   0006 d601  st   [$01],y     515   st([memSize],Y)                 # Store in RAM and load AC in Y
              0007 00ff  ld   $ff         516   ld(255)
              0008 6900  xora [y,$00]     517   xora([Y,0])                     # Invert value from memory
              0009 ca00  st   [y,$00]     518   st([Y,0])                       # Test RAM by writing the new value
              000a c200  st   [$00]       519   st([0])                         # Copy result in [0]
              000b 6900  xora [y,$00]     520   xora([Y,0])                     # Read back and compare if written ok
              000c ec0c  bne  $000c       521   bne(pc())                       # Loop forever on RAM failure here
              000d 00ff  ld   $ff         522   ld(255)
              000e 6900  xora [y,$00]     523   xora([Y,0])                     # Invert memory value again
              000f ca00  st   [y,$00]     524   st([Y,0])                       # To restore original value
              0010 6100  xora [$00]       525   xora([0])                       # Compare with inverted copy
              0011 f015  beq  .countMem1  526   beq('.countMem1')               # If equal, we wrapped around
              0012 0101  ld   [$01]       527   ld([memSize])
              0013 fc06  bra  .countMem0  528   bra('.countMem0')               # Loop to test next address line
              0014 8200  adda ac          529   adda(AC)                        # Executes in the branch delay slot!
                                          530   label('.countMem1')
                                          531
                                          532   # Momentarily wait to allow for debouncing of the reset switch by spinning
                                          533   # roughly 2^15 times at 2 clocks per loop: 6.5ms@10MHz to 10ms@6.3MHz
                                          534   # Real-world switches normally bounce shorter than that.
                                          535   # "[...] 16 switches exhibited an average 1557 usec of bouncing, with,
                                          536   #  as I said, a max of 6200 usec" (From: http://www.ganssle.com/debouncing.htm)
                                          537   # Relevant for the breadboard version, as the kit doesn't have a reset switch.
                                          538
.countMem1:   0015 00ff  ld   $ff         539   ld(255)                         # Debounce reset button
                                          540   label('.debounce')
.debounce:    0016 c200  st   [$00]       541   st([0])
              0017 ec17  bne  $0017       542   bne(pc())
              0018 a001  suba $01         543   suba(1)                         # Branch delay slot
              0019 0100  ld   [$00]       544   ld([0])
              001a ec16  bne  .debounce   545   bne('.debounce')
              001b a001  suba $01         546   suba(1)                         # Branch delay slot
                                          547
                                          548   # Update LEDs (memory is present and counted, reset is stable)
              001c 0001  ld   $01         549   ld(0b0001)                      # LEDs |*OOO|
              001d 1880  ld   $80,out     550   ld(syncBits^hSync,OUT)
              001e 18c0  ld   $c0,out     551   ld(syncBits,OUT)
                                          552
                                          553   # Scan the entire RAM space to collect entropy for a random number generator.
                                          554   # The 16-bit address space is scanned, even if less RAM was detected.
              001f 0000  ld   $00         555   ld(0)                           # Collect entropy from RAM
              0020 d218  st   [$18],x     556   st([vAC+0],X)
              0021 d619  st   [$19],y     557   st([vAC+1],Y)
                                          558   label('.initEnt0')
.initEnt0:    0022 0106  ld   [$06]       559   ld([entropy+0])
              0023 f426  bge  .initEnt1   560   bpl('.initEnt1')
              0024 8d00  adda [y,x]       561   adda([Y,X])
              0025 60bf  xora $bf         562   xora(191)
                                          563   label('.initEnt1')
.initEnt1:    0026 c206  st   [$06]       564   st([entropy+0])
              0027 0107  ld   [$07]       565   ld([entropy+1])
              0028 f42b  bge  .initEnt2   566   bpl('.initEnt2')
              0029 8106  adda [$06]       567   adda([entropy+0])
              002a 60c1  xora $c1         568   xora(193)
                                          569   label('.initEnt2')
.initEnt2:    002b c207  st   [$07]       570   st([entropy+1])
              002c 8108  adda [$08]       571   adda([entropy+2])
              002d c208  st   [$08]       572   st([entropy+2])
              002e 0118  ld   [$18]       573   ld([vAC+0])
              002f 8001  adda $01         574   adda(1)
              0030 ec22  bne  .initEnt0   575   bne('.initEnt0')
              0031 d218  st   [$18],x     576   st([vAC+0],X)
              0032 0119  ld   [$19]       577   ld([vAC+1])
              0033 8001  adda $01         578   adda(1)
              0034 ec22  bne  .initEnt0   579   bne('.initEnt0')
              0035 d619  st   [$19],y     580   st([vAC+1],Y)
                                          581
                                          582   # Update LEDs
              0036 0003  ld   $03         583   ld(0b0011)                      # LEDs |**OO|
              0037 1880  ld   $80,out     584   ld(syncBits^hSync,OUT)
              0038 18c0  ld   $c0,out     585   ld(syncBits,OUT)
                                          586
                                          587   # vCPU reset handler
              0039 00ee  ld   $ee         588   ld((vReset&255)-2)              # Setup vCPU reset handler
              003a c216  st   [$16]       589   st([vPC])
              003b 9002  adda $02,x       590   adda(2,X)
              003c 0001  ld   $01         591   ld(vReset>>8)
              003d d617  st   [$17],y     592   st([vPC+1],Y)
              003e dc59  st   $59,[y,x++] 593   st('LDI',             [Y,Xpp])
              003f dc5f  st   $5f,[y,x++] 594   st('SYS_Reset_88',    [Y,Xpp])
              0040 dc2b  st   $2b,[y,x++] 595   st('STW',             [Y,Xpp])
              0041 dc22  st   $22,[y,x++] 596   st(sysFn,             [Y,Xpp])
              0042 dcb4  st   $b4,[y,x++] 597   st('SYS',             [Y,Xpp])  # SYS -> SYS_Reset_88 -> SYS_Exec_88
              0043 dce2  st   $e2,[y,x++] 598   st(256-88//2+maxTicks,[Y,Xpp])
              0044 dc00  st   $00,[y,x++] 599   st(0,                 [Y,Xpp])  # vIRQ_v5: Disable interrupts
              0045 dc00  st   $00,[y,x++] 600   st(0,                 [Y,Xpp])  # vIRQ_v5
              0046 dcfc  st   $fc,[y,x++] 601   st(0b11111100,        [Y,Xpp])  # Control register
              0047 dc00  st   $00,[y,x++] 602   st(0,                 [Y,Xpp])  # videoTop
                                          603
              0048 0002  ld   $02         604   ld(hi('ENTER'))                 # Active interpreter vCPU
              0049 c205  st   [$05]       605   st([vCpuSelect])
                                          606
              004a 00ff  ld   $ff         607   ld(255)                         # Setup serial input
              004b c20e  st   [$0e]       608   st([frameCount])
              004c c20f  st   [$0f]       609   st([serialRaw])
              004d c210  st   [$10]       610   st([serialLast])
              004e c211  st   [$11]       611   st([buttonState])
              004f c212  st   [$12]       612   st([resetTimer])                # resetTimer<0 when entering Main.gcl
                                          613
              0050 0007  ld   $07         614   ld(0b0111)                      # LEDs |***O|
              0051 1880  ld   $80,out     615   ld(syncBits^hSync,OUT)
              0052 18c0  ld   $c0,out     616   ld(syncBits,OUT)
                                          617
              0053 0000  ld   $00         618   ld(0)
              0054 c200  st   [$00]       619   st([0])                         # Carry lookup ([0x80] in 1st line of vBlank)
              0055 c202  st   [$02]       620   st([channel])
              0056 c22c  st   [$2c]       621   st([soundTimer])
                                          622
              0057 000f  ld   $0f         623   ld(0b1111)                      # LEDs |****|
              0058 1880  ld   $80,out     624   ld(syncBits^hSync,OUT)
              0059 18c0  ld   $c0,out     625   ld(syncBits,OUT)
              005a c213  st   [$13]       626   st([xout])                      # Setup for control by video loop
              005b c214  st   [$14]       627   st([xoutMask])
                                          628
              005c 1401  ld   $01,y       629   ld(hi('startVideo'),Y)          # Enter video loop at vertical blank
              005d e003  jmp  y,$03       630   jmp(Y,'startVideo')
              005e c22e  st   [$2e]       631   st([ledState_v2])               # Setting to 1..126 means "stopped"
