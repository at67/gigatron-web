                                          1834  #
                                          1835  # Instruction SYS: Native call, <=256 cycles (<=128 ticks, in reality less)
                                          1836  #
                                          1837  # The 'SYS' vCPU instruction first checks the number of desired ticks given by
                                          1838  # the operand. As long as there are insufficient ticks available in the current
                                          1839  # time slice, the instruction will be retried. This will effectively wait for
                                          1840  # the next scan line if the current slice is almost out of time. Then a jump to
                                          1841  # native code is made. This code can do whatever it wants, but it must return
                                          1842  # to the 'REENTER' label when done. When returning, AC must hold (the negative
                                          1843  # of) the actual consumed number of whole ticks for the entire virtual
                                          1844  # instruction cycle (from NEXT to NEXT). This duration may not exceed the prior
                                          1845  # declared duration in the operand + 28 (or maxTicks). The operand specifies the
                                          1846  # (negative) of the maximum number of *extra* ticks that the native call will
                                          1847  # need. The GCL compiler automatically makes this calculation from gross number
                                          1848  # of cycles to excess number of ticks.
                                          1849  # SYS functions can modify vPC to implement repetition. For example to split
                                          1850  # up work into multiple chucks.
                                          1851  label('.sys#13')
.sys#13:      03af 0116  ld   [$16]       1852  ld([vPC])                       #13,12 Retry until sufficient time
              03b0 a002  suba $02         1853  suba(2)                         #14
              03b1 c216  st   [$16]       1854  st([vPC])                       #15
              03b2 fccb  bra  REENTER     1855  bra('REENTER')                  #16
              03b3 00f6  ld   $f6         1856  ld(-20/2)                       #17
                                          1857  label('SYS')
SYS:          03b4 8115  adda [$15]       1858  adda([vTicks])                  #10
              03b5 e8af  blt  .sys#13     1859  blt('.sys#13')                  #11
              03b6 1523  ld   [$23],y     1860  ld([sysFn+1],Y)                 #12
              03b7 e122  jmp  y,[$22]     1861  jmp(Y,[sysFn])                  #13
                                          1862  #dummy()                        #14 Overlap
                                          1863  #
                                          1864  # Instruction SUBW: Word subtract with zero page (AC-=[D]+256*[D+1]), 28 cycles
                                          1865  # All cases can be done in 26 cycles, but the code will become much larger
                                          1866  label('SUBW')
SUBW:         03b8 1200  ld   ac,x        1867  ld(AC,X)                        #10,14 Address of low byte to be subtracted
              03b9 8001  adda $01         1868  adda(1)                         #11
              03ba c21d  st   [$1d]       1869  st([vTmp])                      #12 Address of high byte to be subtracted
              03bb 0118  ld   [$18]       1870  ld([vAC])                       #13
              03bc e8c1  blt  .subw#16    1871  bmi('.subw#16')                 #14
              03bd a500  suba [x]         1872  suba([X])                       #15
              03be c218  st   [$18]       1873  st([vAC])                       #16 Store low result
              03bf fcc4  bra  .subw#19    1874  bra('.subw#19')                 #17
              03c0 4500  ora  [x]         1875  ora([X])                        #18 Carry in bit 7
                                          1876  label('.subw#16')
.subw#16:     03c1 c218  st   [$18]       1877  st([vAC])                       #16 Store low result
              03c2 2500  anda [x]         1878  anda([X])                       #17 Carry in bit 7
              03c3 0200  nop              1879  nop()                           #18
                                          1880  label('.subw#19')
.subw#19:     03c4 3080  anda $80,x       1881  anda(0x80,X)                    #19 Move carry to bit 0
              03c5 0119  ld   [$19]       1882  ld([vAC+1])                     #20
              03c6 a500  suba [x]         1883  suba([X])                       #21
              03c7 111d  ld   [$1d],x     1884  ld([vTmp],X)                    #22
              03c8 a500  suba [x]         1885  suba([X])                       #23
              03c9 c219  st   [$19]       1886  st([vAC+1])                     #24
                                          1887  label('REENTER_28')
REENTER_28:   03ca 00f2  ld   $f2         1888  ld(-28/2)                       #25
                                          1889  label('REENTER')
REENTER:      03cb fc01  bra  NEXT        1890  bra('NEXT')                     #26 Return from SYS calls
              03cc 1517  ld   [$17],y     1891  ld([vPC+1],Y)                   #27
                                          1892
                                          1893  # Instruction DEF: Define data or code (vAC,vPC=vPC+2,(vPC&0xff00)+D), 24 cycles
                                          1894  label('DEF')
DEF:          03cd 1404  ld   $04,y       1895  ld(hi('def#13'),Y)              #10
              03ce e007  jmp  y,$07       1896  jmp(Y,'def#13')                 #11
                                          1897  #st([vTmp])                     #12 Overlap
                                          1898  #
                                          1899  # Instruction CALL: Goto address and remember vPC (vLR,vPC=vPC+2,[D]+256*[D+1]-2), 26 cycles
                                          1900  label('CALL')
CALL:         03cf c21d  st   [$1d]       1901  st([vTmp])                      #10,12
              03d0 0116  ld   [$16]       1902  ld([vPC])                       #11
              03d1 8002  adda $02         1903  adda(2)                         #12 Point to instruction after CALL
              03d2 c21a  st   [$1a]       1904  st([vLR])                       #13
              03d3 0117  ld   [$17]       1905  ld([vPC+1])                     #14
              03d4 c21b  st   [$1b]       1906  st([vLR+1])                     #15
              03d5 111d  ld   [$1d],x     1907  ld([vTmp],X)                    #16
              03d6 0500  ld   [x]         1908  ld([X])                         #17
              03d7 a002  suba $02         1909  suba(2)                         #18 Because NEXT will add 2
              03d8 c216  st   [$16]       1910  st([vPC])                       #19
              03d9 011d  ld   [$1d]       1911  ld([vTmp])                      #20
              03da 9001  adda $01,x       1912  adda(1,X)                       #21
              03db 0500  ld   [x]         1913  ld([X])                         #22
              03dc d617  st   [$17],y     1914  st([vPC+1],Y)                   #23
              03dd fc01  bra  NEXT        1915  bra('NEXT')                     #24
              03de 00f3  ld   $f3         1916  ld(-26/2)                       #25
                                          1917
                                          1918  # Instruction ALLOC: Create or destroy stack frame (vSP+=D), 14 cycles
                                          1919  label('ALLOC')
ALLOC:        03df 811c  adda [$1c]       1920  adda([vSP])                     #10
              03e0 c21c  st   [$1c]       1921  st([vSP])                       #11
              03e1 fc01  bra  NEXT        1922  bra('NEXT')                     #12
              03e2 00f9  ld   $f9         1923  ld(-14/2)                       #13
                                          1924
                                          1925  # The instructions below are all implemented in the second code page. Jumping
                                          1926  # back and forth makes each 6 cycles slower, but it also saves space in the
                                          1927  # primary page for the instructions above. Most of them are in fact not very
                                          1928  # critical, as evidenced by the fact that they weren't needed for the first
                                          1929  # Gigatron applications (Snake, Racer, Mandelbrot, Loader). By providing them
                                          1930  # in this way, at least they don't need to be implemented as a SYS extension.
                                          1931
                                          1932  # Instruction ADDI: Add small positive constant (vAC+=D), 28 cycles
                                          1933  label('ADDI')
ADDI:         03e3 1404  ld   $04,y       1934  ld(hi('addi'),Y)                #10
              03e4 e018  jmp  y,$18       1935  jmp(Y,'addi')                   #11
              03e5 c21d  st   [$1d]       1936  st([vTmp])                      #12
                                          1937
                                          1938  # Instruction SUBI: Subtract small positive constant (vAC+=D), 28 cycles
                                          1939  label('SUBI')
SUBI:         03e6 1404  ld   $04,y       1940  ld(hi('subi'),Y)                #10
              03e7 e026  jmp  y,$26       1941  jmp(Y,'subi')                   #11
              03e8 c21d  st   [$1d]       1942  st([vTmp])                      #12
                                          1943
                                          1944  # Instruction LSLW: Logical shift left (vAC<<=1), 28 cycles
                                          1945  # Useful, because ADDW can't add vAC to itself. Also more compact.
                                          1946  label('LSLW')
LSLW:         03e9 1404  ld   $04,y       1947  ld(hi('lslw'),Y)                #10
              03ea e035  jmp  y,$35       1948  jmp(Y,'lslw')                   #11
              03eb 0118  ld   [$18]       1949  ld([vAC])                       #12
                                          1950
                                          1951  # Instruction STLW: Store word in stack frame ([vSP+D],[vSP+D+1]=vAC&255,vAC>>8), 26 cycles
                                          1952  label('STLW')
STLW:         03ec 1404  ld   $04,y       1953  ld(hi('stlw'),Y)                #10
              03ed e041  jmp  y,$41       1954  jmp(Y,'stlw')                   #11
                                          1955  #dummy()                        #12 Overlap
                                          1956  #
                                          1957  # Instruction LDLW: Load word from stack frame (vAC=[vSP+D]+256*[vSP+D+1]), 26 cycles
                                          1958  label('LDLW')
LDLW:         03ee 1404  ld   $04,y       1959  ld(hi('ldlw'),Y)                #10,12
              03ef e04c  jmp  y,$4c       1960  jmp(Y,'ldlw')                   #11
                                          1961  #dummy()                        #12 Overlap
                                          1962  #
                                          1963  # Instruction POKE: Write byte in memory ([[D+1],[D]]=vAC&255), 28 cycles
                                          1964  label('POKE')
POKE:         03f0 1404  ld   $04,y       1965  ld(hi('poke'),Y)                #10,12
              03f1 e057  jmp  y,$57       1966  jmp(Y,'poke')                   #11
              03f2 c21d  st   [$1d]       1967  st([vTmp])                      #12
                                          1968
                                          1969  # Instruction DOKE: Write word in memory ([[D+1],[D]],[[D+1],[D]+1]=vAC&255,vAC>>8), 28 cycles
                                          1970  label('DOKE')
DOKE:         03f3 1404  ld   $04,y       1971  ld(hi('doke'),Y)                #10
              03f4 e06d  jmp  y,$6d       1972  jmp(Y,'doke')                   #11
              03f5 c21d  st   [$1d]       1973  st([vTmp])                      #12
                                          1974
                                          1975  # Instruction DEEK: Read word from memory (vAC=[vAC]+256*[vAC+1]), 28 cycles
                                          1976  label('DEEK')
DEEK:         03f6 1404  ld   $04,y       1977  ld(hi('deek'),Y)                #10
              03f7 e07a  jmp  y,$7a       1978  jmp(Y,'deek')                   #11
                                          1979  #dummy()                        #12 Overlap
                                          1980  #
                                          1981  # Instruction ANDW: Word logical-AND with zero page (vAC&=[D]+256*[D+1]), 28 cycles
                                          1982  label('ANDW')
ANDW:         03f8 1404  ld   $04,y       1983  ld(hi('andw'),Y)                #10,12
              03f9 e086  jmp  y,$86       1984  jmp(Y,'andw')                   #11
                                          1985  #dummy()                        #12 Overlap
                                          1986  #
                                          1987  # Instruction ORW: Word logical-OR with zero page (vAC|=[D]+256*[D+1]), 28 cycles
                                          1988  label('ORW')
ORW:          03fa 1404  ld   $04,y       1989  ld(hi('orw'),Y)                 #10,12
              03fb e091  jmp  y,$91       1990  jmp(Y,'orw')                    #11
                                          1991  #dummy()                        #12 Overlap
                                          1992  #
                                          1993  # Instruction XORW: Word logical-XOR with zero page (vAC^=[D]+256*[D+1]), 26 cycles
                                          1994  label('XORW')
XORW:         03fc 1404  ld   $04,y       1995  ld(hi('xorw'),Y)                #10,12
              03fd e09c  jmp  y,$9c       1996  jmp(Y,'xorw')                   #11
              03fe c21d  st   [$1d]       1997  st([vTmp])                      #12
                                          1998  # We keep XORW 2 cycles faster than ANDW/ORW, because that
                                          1999  # can be useful for comparing numbers for equality a tiny
                                          2000  # bit faster than with SUBW
                                          2001
                                          2002  # Instruction RET: Function return (vPC=vLR-2), 16 cycles
                                          2003  label('RET')
RET:          03ff 011a  ld   [$1a]       2004  ld([vLR])                       #10
                                          2005  assert pc()&255 == 0
