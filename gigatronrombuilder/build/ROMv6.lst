                                          633   #-----------------------------------------------------------------------
                                          634   # Extension SYS_Reset_88: Soft reset
                                          635   #-----------------------------------------------------------------------
                                          636
                                          637   # SYS_Reset_88 initiates an immediate Gigatron reset from within the vCPU.
                                          638   # The reset sequence itself is mostly implemented in GCL by Reset.gcl,
                                          639   # which must first be loaded into RAM. But as that takes more than 1 scanline,
                                          640   # some vCPU bootstrapping code gets loaded with SYS_Exec_88.
                                          641   # !!! This function was REMOVED from interface.json
                                          642   # !!! Better use vReset as generic entry point for soft reset
                                          643
                                          644   # ROM type (see also Docs/GT1-files.txt)
                                          645   romTypeValue = symbol('romTypeValue_ROMv6')
                                          646
                                          647   label('SYS_Reset_88')
                                          648   assert pc()>>8 == 0
                                          649   assert (romTypeValue & 7) == 0
SYS_Reset_88: 005f 0048  ld   $48         650   ld(romTypeValue)                #15 Set ROM type/version and clear channel mask
              0060 c221  st   [$21]       651   st([romType])                   #16
