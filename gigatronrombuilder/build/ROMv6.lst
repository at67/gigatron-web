                                          2023  # DEF implementation
                                          2024  label('def#13')
def#13:       0407 0116  ld   [$16]       2025  ld([vPC])                       #13
              0408 8002  adda $02         2026  adda(2)                         #14
              0409 c218  st   [$18]       2027  st([vAC])                       #15
              040a 0117  ld   [$17]       2028  ld([vPC+1])                     #16
              040b c219  st   [$19]       2029  st([vAC+1])                     #17
              040c 011d  ld   [$1d]       2030  ld([vTmp])                      #18
              040d c216  st   [$16]       2031  st([vPC])                       #19
              040e 1403  ld   $03,y       2032  ld(hi('NEXTY'),Y)               #20
              040f e000  jmp  y,$00       2033  jmp(Y,'NEXTY')                  #21
              0410 00f4  ld   $f4         2034  ld(-24/2)                       #22
