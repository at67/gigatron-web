                                          4057  # All interpreter entry points must share the same page offset, because
                                          4058  # this offset is hard-coded as immediate operand in the video driver.
                                          4059  # The Gigatron's original vCPU's 'ENTER' label is already at $2ff, so we
                                          4060  # just use $dff for 'v6502_ENTER'. v6502 actually has two entry points.
                                          4061  # The other is 'v6502_RESUME' at $10ff. It is used for instructions
                                          4062  # that were fetched but not yet executed. Allowing the split gives finer
                                          4063  # granulariy, and hopefully more throughput for the simpler instructions.
                                          4064  # (There is no "overhead" for allowing instruction splitting, because
                                          4065  #  both emulation phases must administer [vTicks] anyway.)
                                          4066  while pc()&255 < 255:
              0dfe 0200  nop              4067    nop()
                                          4068  label('v6502_ENTER')
v6502_ENTER:  0dff fc22  bra  v6502_next2 4069  bra('v6502_next2')              #0 v6502 primary entry point
                                          4070  # --- Page boundary ---
              0e00 a006  suba $06         4071  suba(v6502_adjust)              #1,19 Adjust for vCPU/v6520 timing differences
