                                          1800  #
                                          1801  # Instruction ADDW: Word addition with zero page (vAC+=[D]+256*[D+1]), 28 cycles
                                          1802  label('ADDW')
                                          1803  # The non-carry paths could be 26 cycles at the expense of (much) more code.
                                          1804  # But a smaller size is better so more instructions fit in this code page.
                                          1805  # 28 cycles is still 4.5 usec. The 6502 equivalent takes 20 cycles or 20 usec.
ADDW:         0399 1200  ld   ac,x        1806  ld(AC,X)                        #10,12 Address of low byte to be added
              039a 8001  adda $01         1807  adda(1)                         #11
              039b c21d  st   [$1d]       1808  st([vTmp])                      #12 Address of high byte to be added
              039c 0118  ld   [$18]       1809  ld([vAC])                       #13 Add the low bytes
              039d 8500  adda [x]         1810  adda([X])                       #14
              039e c218  st   [$18]       1811  st([vAC])                       #15 Store low result
              039f e8a3  blt  .addw#18    1812  bmi('.addw#18')                 #16 Now figure out if there was a carry
              03a0 a500  suba [x]         1813  suba([X])                       #17 Gets back the initial value of vAC
              03a1 fca5  bra  .addw#20    1814  bra('.addw#20')                 #18
              03a2 4500  ora  [x]         1815  ora([X])                        #19 Carry in bit 7
                                          1816  label('.addw#18')
.addw#18:     03a3 2500  anda [x]         1817  anda([X])                       #18 Carry in bit 7
              03a4 0200  nop              1818  nop()                           #19
                                          1819  label('.addw#20')
.addw#20:     03a5 3080  anda $80,x       1820  anda(0x80,X)                    #20 Move carry to bit 0
              03a6 0500  ld   [x]         1821  ld([X])                         #21
              03a7 8119  adda [$19]       1822  adda([vAC+1])                   #22 Add the high bytes with carry
              03a8 111d  ld   [$1d],x     1823  ld([vTmp],X)                    #23
              03a9 8500  adda [x]         1824  adda([X])                       #24
              03aa c219  st   [$19]       1825  st([vAC+1])                     #25 Store high result
              03ab fc01  bra  NEXT        1826  bra('NEXT')                     #26
              03ac 00f2  ld   $f2         1827  ld(-28/2)                       #27
