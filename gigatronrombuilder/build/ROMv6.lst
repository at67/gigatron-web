                                          1512
                                          1513  # Back porch C: third of 4 repeated scan lines
                                          1514  # - Nothing new to for video do as Yi and Xi are known,
                                          1515  # - This is the time to emit and reset the next sound sample
                                          1516  label('videoC')
videoC:       02d3 00dc  ld   $dc         1517  ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1518  st([nextVideo])                 #30
