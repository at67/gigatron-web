                                          3000  # Extension SYS_SpiExchangeBytes_v4_134
                                          3001  #-----------------------------------------------------------------------
                                          3002
                                          3003  # Send AND receive 1..256 bytes over SPI interface
                                          3004
                                          3005  # Variables:
                                          3006  #       sysArgs[0]      Page index start, for both send/receive (in, changed)
                                          3007  #       sysArgs[1]      Memory page for send data (in)
                                          3008  #       sysArgs[2]      Page index stop (in)
                                          3009  #       sysArgs[3]      Memory page for receive data (in)
                                          3010  #       sysArgs[4]      Scratch (changed)
                                          3011
                                          3012  label('SYS_SpiExchangeBytes_v4_134')
SYS_SpiExchangeBytes_v4_134:
              0b15 140d  ld   $0d,y       3013  ld(hi('sys_SpiExchangeBytes'),Y)#15
              0b16 e015  jmp  y,$15       3014  jmp(Y,'sys_SpiExchangeBytes')   #16
              0b17 1401  ld   $01,y       3015  ld(hi(ctrlBits),Y)              #17 Control state as saved by SYS_ExpanderControl
                                          3016
                                          3017
                                          3018  #-----------------------------------------------------------------------
                                          3019  # Extension SYS_ReceiveSerial1_v6_32
                                          3020  #-----------------------------------------------------------------------
                                          3021
                                          3022  # SYS function for receiving one byte over the serial controller port.
                                          3023  # This is a public version of SYS_NextByteIn from the loader private
                                          3024  # extension.  A byte is read from IN when videoY reaches
                                          3025  # sysArgs[3]. The byte is added to the checksum sysArgs[2] then stored
                                          3026  # at address sysArgs[0:1] which gets incremented.
                                          3027  #
                                          3028  # The 65 bytes of a serial frame can be read for the following values
                                          3029  # of videoY: 207 (protocol byte) 219 (length, 6 bits only) 235, 251
                                          3030  # (address) then 2, 6, 10, .. 238 stepping by four, then 185.
                                          3031  #
                                          3032  # Variables:
                                          3033  #     sysArgs[0:1] Address
                                          3034  #     sysArgs[2]   Checksum
                                          3035  #     sysArgs[3]   Wait value (videoY)
                                          3036
                                          3037  label('SYS_ReceiveSerial1_v6_32')
SYS_ReceiveSerial1_v6_32:                 3038  bra('sys_ReceiveSerial1')       #15
              0b18 fcb2  bra  sys_ReceiveSerial1
              0b19 0127  ld   [$27]       3039  ld([sysArgs+3])                 #16
                                          3040
                                          3041  #-----------------------------------------------------------------------
                                          3042  #  Implementations
                                          3043  #-----------------------------------------------------------------------
                                          3044
                                          3045  # SYS_SetMemory_54 implementation
                                          3046  label('sys_SetMemory#18')
sys_SetMemory#18:
              0b1a 1527  ld   [$27],y     3047  ld([sysArgs+3],Y)               #18
              0b1b f83e  ble  .sysSb#21   3048  ble('.sysSb#21')                #19 Enter fast lane if >=128 or at 0 (-> 256)
              0b1c a008  suba $08         3049  suba(8)                         #20
              0b1d f440  bge  .sysSb#23   3050  bge('.sysSb#23')                #21 Or when >=8
              0b1e c224  st   [$24]       3051  st([sysArgs+0])                 #22
              0b1f 2004  anda $04         3052  anda(4)                         #23
              0b20 f027  beq  .sysSb#26   3053  beq('.sysSb#26')                #24
              0b21 0125  ld   [$25]       3054  ld([sysArgs+1])                 #25 Set 4 pixels
              0b22 de00  st   [y,x++]     3055  st([Y,Xpp])                     #26
              0b23 de00  st   [y,x++]     3056  st([Y,Xpp])                     #27
              0b24 de00  st   [y,x++]     3057  st([Y,Xpp])                     #28
              0b25 fc2a  bra  .sysSb#31   3058  bra('.sysSb#31')                #29
              0b26 de00  st   [y,x++]     3059  st([Y,Xpp])                     #30
                                          3060  label('.sysSb#26')
.sysSb#26:    0b27 0001  ld   $01         3061  wait(31-26)                     #26
              0b28 ec28  bne  $0b28
              0b29 a001  suba $01
