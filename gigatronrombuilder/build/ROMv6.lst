videoF:       02ec 0120  ld   [$20]       1549  ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1550  adda(0x80)                      #30
              02ee d220  st   [$20],x     1551  st([videoSync1],X)              #31
