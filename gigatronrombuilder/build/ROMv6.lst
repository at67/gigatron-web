notesTable:   0900 0000  ld   $00         2817  ld(0)
              0901 0000  ld   $00         2818  ld(0)
                                          2819  for i in range(0, 250, 2):
                                          2820    j = i//2-1
                                          2821    freq = 440.0*2.0**((j-57)/12.0)
                                          2822    if j>=0 and freq <= sampleRate/2.0:
                                          2823      key = int(round(32768 * freq / sampleRate))
                                          2824      octave, note = j//12, notes[j%12]
                                          2825      sharp = '-' if notes[j%12-1] != note else '#'
                                          2826      comment = '%s%s%s (%0.1f Hz)' % (note, sharp, octave, freq)
                                          2827      ld(key&127); C(comment); ld(key>>7)
