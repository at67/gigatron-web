              020d 5d00  ora  [y,x++],out
              020e 5d00  ora  [y,x++],out
              * 160 times
              02ac 18c0  ld   $c0,out     1462  ld(syncBits,OUT)                #0 <New scan line start> Back to black
                                          1463
                                          1464  # Front porch
              02ad 0102  ld   [$02]       1465  ld([channel])                   #1 Advance to next sound channel
                                          1466  label('sound3')                 # Return from vCPU interpreter
sound3:       02ae 2121  anda [$21]       1467  anda([channelMask])             #2
              02af 8001  adda $01         1468  adda(1)                         #3
              02b0 1880  ld   $80,out     1469  ld(syncBits^hSync,OUT)          #4 Start horizontal pulse
                                          1470
                                          1471  # Horizontal sync and sound channel update for scanlines outside vBlank
