                                          1438  align(0x100, size=0x100)
              0200 0102  ld   [$02]       1439  ld([channel])                   #1 Advance to next sound channel
                                          1440
                                          1441  # Back porch A: first of 4 repeated scan lines
                                          1442  # - Fetch next Yi and store it for retrieval in the next scan lines
                                          1443  # - Calculate Xi from dXi, but there is no cycle time left to store it as well
                                          1444  label('videoA')
videoA:       0201 00ca  ld   $ca         1445  ld('videoB')                    #29 1st scanline of 4 (always visible)
              0202 c20d  st   [$0d]       1446  st([nextVideo])                 #30
              0203 1401  ld   $01,y       1447  ld(videoTable>>8,Y)             #31
              0204 1109  ld   [$09],x     1448  ld([videoY],X)                  #32
              0205 0d00  ld   [y,x]       1449  ld([Y,X])                       #33
              0206 de00  st   [y,x++]     1450  st([Y,Xpp])                     #34 Just X++
              0207 c220  st   [$20]       1451  st([frameY])                    #35
              0208 0d00  ld   [y,x]       1452  ld([Y,X])                       #36
              0209 911f  adda [$1f],x     1453  adda([frameX],X)                #37
                                          1454  label('pixels')
pixels:       020a 1520  ld   [$20],y     1455  ld([frameY],Y)                  #38
              020b 00c0  ld   $c0         1456  ld(syncBits)                    #39
                                          1457
                                          1458  # Stream 160 pixels from memory location <Yi,Xi> onwards
                                          1459  # Superimpose the sync signal bits to be robust against misprogramming
                                          1460  for i in range(qqVgaWidth):
