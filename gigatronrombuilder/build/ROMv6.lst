              01ef fcf2  bra  $01f2       1357  bra(pc()+3)                     #196
              01f0 0001  ld   $01         1358  ld('videoA')                    #197
              01f1 00ec  ld   $ec         1359  ld('videoF')                    #197(!)
              01f2 c20d  st   [$0d]       1360  st([nextVideo])                 #198
              01f3 0102  ld   [$02]       1361  ld([channel])                   #199 Advance to next sound channel
              01f4 2121  anda [$21]       1362  anda([channelMask])             #0 <New scan line start>
              01f5 8001  adda $01         1363  adda(1)                         #1
              01f6 1402  ld   $02,y       1364  ld(hi('sound2'),Y)              #2
              01f7 e0b1  jmp  y,$b1       1365  jmp(Y,'sound2')                 #3
              01f8 1880  ld   $80,out     1366  ld(syncBits^hSync,OUT)          #4 Start horizontal pulse
                                          1367
              01f9 0200  nop              1368  fillers(until=0xff)
              01fa 0200  nop
              01fb 0200  nop
              * 6 times
                                          1369
                                          1370  #-----------------------------------------------------------------------
                                          1371  # Return point for vCPU slices during visible screen area
                                          1372  #-----------------------------------------------------------------------
                                          1373
                                          1374  assert pc() == 0x1ff            # Enables runVcpu() to re-enter into the next page
              01ff fcae  bra  sound3      1375  bra('sound3')                   #200,0 <New scan line start>
                                          1376
                                          1377  #-----------------------------------------------------------------------
                                          1378  #
                                          1379  #  $0200 ROM page 2: Video loop visible scanlines
                                          1380  #
                                          1381  #-----------------------------------------------------------------------
                                          1382  align(0x100, size=0x100)
              0200 0102  ld   [$02]       1383  ld([channel])                   #1 Advance to next sound channel
                                          1384
                                          1385  # Back porch A: first of 4 repeated scan lines
                                          1386  # - Fetch next Yi and store it for retrieval in the next scan lines
                                          1387  # - Calculate Xi from dXi, but there is no cycle time left to store it as well
                                          1388  label('videoA')
videoA:       0201 00ca  ld   $ca         1389  ld('videoB')                    #29 1st scanline of 4 (always visible)
              0202 c20d  st   [$0d]       1390  st([nextVideo])                 #30
              0203 1401  ld   $01,y       1391  ld(videoTable>>8,Y)             #31
              0204 1109  ld   [$09],x     1392  ld([videoY],X)                  #32
              0205 0d00  ld   [y,x]       1393  ld([Y,X])                       #33
              0206 de00  st   [y,x++]     1394  st([Y,Xpp])                     #34 Just X++
              0207 c220  st   [$20]       1395  st([frameY])                    #35
              0208 0d00  ld   [y,x]       1396  ld([Y,X])                       #36
              0209 911f  adda [$1f],x     1397  adda([frameX],X)                #37
                                          1398  label('pixels')
pixels:       020a 1520  ld   [$20],y     1399  ld([frameY],Y)                  #38
              020b 00c0  ld   $c0         1400  ld(syncBits)                    #39
                                          1401
                                          1402  # Stream 160 pixels from memory location <Yi,Xi> onwards
                                          1403  # Superimpose the sync signal bits to be robust against misprogramming
                                          1404  for i in range(qqVgaWidth):
              020c 5d00  ora  [y,x++],out 1405    ora([Y,Xpp],OUT)              #40-199 Pixel burst
              020d 5d00  ora  [y,x++],out
              020e 5d00  ora  [y,x++],out
              * 160 times
              02ac 18c0  ld   $c0,out     1406  ld(syncBits,OUT)                #0 <New scan line start> Back to black
                                          1407
                                          1408  # Front porch
              02ad 0102  ld   [$02]       1409  ld([channel])                   #1 Advance to next sound channel
                                          1410  label('sound3')                 # Return from vCPU interpreter
sound3:       02ae 2121  anda [$21]       1411  anda([channelMask])             #2
              02af 8001  adda $01         1412  adda(1)                         #3
              02b0 1880  ld   $80,out     1413  ld(syncBits^hSync,OUT)          #4 Start horizontal pulse
                                          1414
                                          1415  # Horizontal sync and sound channel update for scanlines outside vBlank
                                          1416  label('sound2')
sound2:       02b1 d602  st   [$02],y     1417  st([channel],Y)                 #5
              02b2 007f  ld   $7f         1418  ld(0x7f)                        #6
              02b3 29fe  anda [y,$fe]     1419  anda([Y,oscL])                  #7
              02b4 89fc  adda [y,$fc]     1420  adda([Y,keyL])                  #8
              02b5 cafe  st   [y,$fe]     1421  st([Y,oscL])                    #9
              02b6 3080  anda $80,x       1422  anda(0x80,X)                    #10
              02b7 0500  ld   [x]         1423  ld([X])                         #11
              02b8 89ff  adda [y,$ff]     1424  adda([Y,oscH])                  #12
              02b9 89fd  adda [y,$fd]     1425  adda([Y,keyH])                  #13
              02ba caff  st   [y,$ff]     1426  st([Y,oscH] )                   #14
              02bb 20fc  anda $fc         1427  anda(0xfc)                      #15
              02bc 69fb  xora [y,$fb]     1428  xora([Y,wavX])                  #16
              02bd 1200  ld   ac,x        1429  ld(AC,X)                        #17
              02be 09fa  ld   [y,$fa]     1430  ld([Y,wavA])                    #18
              02bf 1407  ld   $07,y       1431  ld(soundTable>>8,Y)             #19
              02c0 8d00  adda [y,x]       1432  adda([Y,X])                     #20
              02c1 e8c4  blt  $02c4       1433  bmi(pc()+3)                     #21
              02c2 fcc5  bra  $02c5       1434  bra(pc()+3)                     #22
              02c3 203f  anda $3f         1435  anda(63)                        #23
              02c4 003f  ld   $3f         1436  ld(63)                          #23(!)
              02c5 8103  adda [$03]       1437  adda([sample])                  #24
              02c6 c203  st   [$03]       1438  st([sample])                    #25
                                          1439
              02c7 0113  ld   [$13]       1440  ld([xout])                      #26 Gets copied to XOUT
              02c8 fd0d  bra  [$0d]       1441  bra([nextVideo])                #27
              02c9 18c0  ld   $c0,out     1442  ld(syncBits,OUT)                #28 End horizontal pulse
                                          1443
                                          1444  # Back porch B: second of 4 repeated scan lines
                                          1445  # - Recompute Xi from dXi and store for retrieval in the next scan lines
                                          1446  label('videoB')
videoB:       02ca 00d3  ld   $d3         1447  ld('videoC')                    #29 2nd scanline of 4
              02cb c20d  st   [$0d]       1448  st([nextVideo])                 #30
              02cc 1401  ld   $01,y       1449  ld(videoTable>>8,Y)             #31
              02cd 0109  ld   [$09]       1450  ld([videoY])                    #32
              02ce 9001  adda $01,x       1451  adda(1,X)                       #33
              02cf 011f  ld   [$1f]       1452  ld([frameX])                    #34
              02d0 8d00  adda [y,x]       1453  adda([Y,X])                     #35
              02d1 fd0a  bra  [$0a]       1454  bra([videoModeB])               #36
              02d2 d21f  st   [$1f],x     1455  st([frameX],X)                  #37 Store in RAM and X
                                          1456
                                          1457  # Back porch C: third of 4 repeated scan lines
                                          1458  # - Nothing new to for video do as Yi and Xi are known,
                                          1459  # - This is the time to emit and reset the next sound sample
                                          1460  label('videoC')
videoC:       02d3 00dc  ld   $dc         1461  ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1462  st([nextVideo])                 #30
              02d5 0103  ld   [$03]       1463  ld([sample])                    #31 New sound sample is ready (didn't fit in the audio loop)
              02d6 400f  ora  $0f         1464  ora(0x0f)                       #32
              02d7 2114  anda [$14]       1465  anda([xoutMask])                #33
              02d8 c213  st   [$13]       1466  st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
              02d9 c003  st   $03,[$03]   1467  st(sample, [sample])            #35 Reset for next sample
              02da fd0b  bra  [$0b]       1468  bra([videoModeC])               #36
              02db 111f  ld   [$1f],x     1469  ld([frameX],X)                  #37
                                          1470
                                          1471  # Back porch D: last of 4 repeated scan lines
                                          1472  # - Calculate the next frame index
                                          1473  # - Decide if this is the last line or not
                                          1474  label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1475  ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1476  ld([videoY])                    #30
              02de a0ee  suba $ee         1477  suba((120-1)*2)                 #31
                                          1478  beq('.lastpixels#34')           #32
              02df f0e5  beq  .lastpixels#34
              02e0 80f0  adda $f0         1479  adda(120*2)                     #33 More pixel lines to go
              02e1 c209  st   [$09]       1480  st([videoY])                    #34
              02e2 0001  ld   $01         1481  ld('videoA')                    #35
              02e3 fd0c  bra  [$0c]       1482  bra([videoModeD])               #36
              02e4 c20d  st   [$0d]       1483  st([nextVideo])                 #37
                                          1484
                                          1485  label('.lastpixels#34')
                                          1486  if soundDiscontinuity == 1:
.lastpixels#34:
              02e5 c003  st   $03,[$03]   1487    st(sample, [sample])          #34 Sound continuity
                                          1488  else:
                                          1489    nop()                         #34
              02e6 00e9  ld   $e9         1490  ld('videoE')                    #35 No more pixel lines to go
              02e7 fd0c  bra  [$0c]       1491  bra([videoModeD])               #36
              02e8 c20d  st   [$0d]       1492  st([nextVideo])                 #37
                                          1493
                                          1494  # Back porch "E": after the last line
                                          1495  # - Go back and and enter vertical blank (program page 2)
                                          1496  label('videoE') # Exit visible area
videoE:       02e9 1401  ld   $01,y       1497  ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
              02ea e004  jmp  y,$04       1498  jmp(Y,'vBlankStart')            #30
              02eb 00c0  ld   $c0         1499  ld(syncBits)                    #31
                                          1500
                                          1501  # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1502  # This yields some speed, but also frees up screen memory for other purposes.
                                          1503  # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1504  # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1505  label('videoF')
videoF:       02ec 0120  ld   [$20]       1506  ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1507  adda(0x80)                      #30
              02ee d220  st   [$20],x     1508  st([videoSync1],X)              #31
              02ef 011f  ld   [$1f]       1509  ld([frameX])                    #32
              02f0 a500  suba [x]         1510  suba([X])                       #33 Decrements every two VGA scanlines
              02f1 f0f4  beq  .videoF#36  1511  beq('.videoF#36')               #34
              02f2 c21f  st   [$1f]       1512  st([frameX])                    #35
              02f3 fcf6  bra  nopixels    1513  bra('nopixels')                 #36
                                          1514  label('.videoF#36')
.videoF#36:   02f4 0001  ld   $01         1515  ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1516  st([nextVideo])                 #37
                                          1517  #
                                          1518  # Alternative for pixel burst: faster application mode
                                          1519  label('nopixels')
nopixels:     02f6 00ff  ld   $ff         1520  runVcpu(200-38, 'ABCD line 40-520',
              02f7 c21e  st   [$1e]
              02f8 1505  ld   [$05],y
              02f9 e0ff  jmp  y,$ff
              02fa 003c  ld   $3c
                                          1521    returnTo=0x1ff)               #38 Application interpreter (black scanlines)
                                          1522
                                          1523  #-----------------------------------------------------------------------
                                          1524  #
                                          1525  #  $0300 ROM page 3: Application interpreter primary page
                                          1526  #
                                          1527  #-----------------------------------------------------------------------
                                          1528
                                          1529  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1530  #
                                          1531  # This routine will execute as many as possible instructions in the
                                          1532  # allotted time. When time runs out, it synchronizes such that the total
                                          1533  # duration matches the caller's request. Durations are counted in `ticks',
                                          1534  # which are multiples of 2 clock cycles.
                                          1535  #
                                          1536  # Synopsis: Use the runVcpu() macro as entry point
                                          1537
                                          1538  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1539  # precious space in the packed interpreter code page. Although ENTER's
                                          1540  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1541  # in this case it will still jump into the right space, because branches
                                          1542  # from $xxFF land in the next page anyway.
                                          1543  while pc()&255 < 255:
              02fb 0200  nop              1544    nop()
              02fc 0200  nop
              02fd 0200  nop
              02fe 0200  nop
                                          1545  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1546  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1547  # --- Page boundary ---
                                          1548  align(0x100,size=0x100)
                                          1549  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1550  ld([vPC+1],Y)                   #1
                                          1551
                                          1552  # Fetch next instruction and execute it, but only if there are sufficient
                                          1553  # ticks left for the slowest instruction.
                                          1554  label('NEXT')
NEXT:         0301 8115  adda [$15]       1555  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        1556  blt('EXIT')                     #1 Escape near time out
                                          1557  label('.next2')
.next2:       0303 c215  st   [$15]       1558  st([vTicks])                    #2
              0304 0116  ld   [$16]       1559  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         1560  adda(2)                         #4
              0306 d216  st   [$16],x     1561  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       1562  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     1563  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          1564  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       1565  ld([Y,X])                       #9 Prefetch operand
                                          1566
                                          1567  # Resync with video driver and transfer control
                                          1568  label('EXIT')
EXIT:         030b 800e  adda $0e         1569  adda(maxTicks)                  #3
                                          1570  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      1571  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         1572  suba(1)                         #5
              030e 1401  ld   $01,y       1573  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     1574  jmp(Y,[vReturn])                #7 To video driver
              0310 0000  ld   $00         1575  ld(0)                           #8 AC should be 0 already. Still..
                                          1576  assert vCPU_overhead ==          9
                                          1577
                                          1578  # Instruction LDWI: Load immediate word constant (vAC=D), 20 cycles
                                          1579  label('LDWI')
LDWI:         0311 c218  st   [$18]       1580  st([vAC])                       #10
              0312 de00  st   [y,x++]     1581  st([Y,Xpp])                     #11 Just X++
              0313 0d00  ld   [y,x]       1582  ld([Y,X])                       #12 Fetch second operand
              0314 c219  st   [$19]       1583  st([vAC+1])                     #13
              0315 0116  ld   [$16]       1584  ld([vPC])                       #14 Advance vPC one more
              0316 8001  adda $01         1585  adda(1)                         #15
              0317 c216  st   [$16]       1586  st([vPC])                       #16
              0318 00f6  ld   $f6         1587  ld(-20/2)                       #17
              0319 fc01  bra  NEXT        1588  bra('NEXT')                     #18
                                          1589  #dummy()                        #19 Overlap
                                          1590  #
                                          1591  # Instruction LD: Load byte from zero page (vAC=[D]), 22 cycles
                                          1592  label('LD')
LD:           031a 1200  ld   ac,x        1593  ld(AC,X)                        #10,19
              031b 0500  ld   [x]         1594  ld([X])                         #11
              031c 1404  ld   $04,y       1595  ld(hi('ld#15'),Y)               #12
              031d e013  jmp  y,$13       1596  jmp(Y,'ld#15')                  #13
              031e c218  st   [$18]       1597  st([vAC])                       #14
                                          1598
                                          1599  # Instruction CMPHS: Adjust high byte for signed compare (vACH=XXX), 28 cycles
                                          1600  label('CMPHS_v5')
CMPHS_v5:     031f 140b  ld   $0b,y       1601  ld(hi('cmphs#13'),Y)            #10
              0320 e0d2  jmp  y,$d2       1602  jmp(Y,'cmphs#13')               #11
                                          1603  #ld(AC,X)                       #12 Overlap
                                          1604  #
                                          1605  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 20 cycles
                                          1606  label('LDW')
LDW:          0321 1200  ld   ac,x        1607  ld(AC,X)                        #10,12
              0322 8001  adda $01         1608  adda(1)                         #11
              0323 c21d  st   [$1d]       1609  st([vTmp])                      #12 Address of high byte
              0324 0500  ld   [x]         1610  ld([X])                         #13
              0325 c218  st   [$18]       1611  st([vAC])                       #14
              0326 111d  ld   [$1d],x     1612  ld([vTmp],X)                    #15
              0327 0500  ld   [x]         1613  ld([X])                         #16
              0328 c219  st   [$19]       1614  st([vAC+1])                     #17
              0329 fc01  bra  NEXT        1615  bra('NEXT')                     #18
              032a 00f6  ld   $f6         1616  ld(-20/2)                       #19
                                          1617
                                          1618  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 20 cycles
                                          1619  label('STW')
STW:          032b 1200  ld   ac,x        1620  ld(AC,X)                        #10,20
              032c 8001  adda $01         1621  adda(1)                         #11
              032d c21d  st   [$1d]       1622  st([vTmp])                      #12 Address of high byte
              032e 0118  ld   [$18]       1623  ld([vAC])                       #13
              032f c600  st   [x]         1624  st([X])                         #14
              0330 111d  ld   [$1d],x     1625  ld([vTmp],X)                    #15
              0331 0119  ld   [$19]       1626  ld([vAC+1])                     #16
              0332 c600  st   [x]         1627  st([X])                         #17
              0333 fc01  bra  NEXT        1628  bra('NEXT')                     #18
              0334 00f6  ld   $f6         1629  ld(-20/2)                       #19
                                          1630
                                          1631  # Instruction BCC: Test AC sign and branch conditionally, 28 cycles
                                          1632  label('BCC')
BCC:          0335 0119  ld   [$19]       1633  ld([vAC+1])                     #10 First inspect high byte of vAC
              0336 ec40  bne  .bcc#13     1634  bne('.bcc#13')                  #11
              0337 c21d  st   [$1d]       1635  st([vTmp])                      #12
              0338 0118  ld   [$18]       1636  ld([vAC])                       #13 Additionally inspect low byte of vAC
              0339 f043  beq  .bcc#16     1637  beq('.bcc#16')                  #14
              033a 0001  ld   $01         1638  ld(1)                           #15
              033b c21d  st   [$1d]       1639  st([vTmp])                      #16
              033c 0d00  ld   [y,x]       1640  ld([Y,X])                       #17 Operand is the conditional
                                          1641  label('.bcc#18')
.bcc#18:      033d fe00  bra  ac          1642  bra(AC)                         #18
              033e 011d  ld   [$1d]       1643  ld([vTmp])                      #19
                                          1644
                                          1645  # Conditional EQ: Branch if zero (if(vACL==0)vPCL=D)
                                          1646  label('EQ')
EQ:           033f ec45  bne  .bcc#22     1647  bne('.bcc#22')                  #20
                                          1648  label('.bcc#13')
.bcc#13:      0340 f048  beq  .bcc#23     1649  beq('.bcc#23')                  #21,13 AC=0 in EQ, AC!=0 from BCC... Overlap with BCC
              0341 0d00  ld   [y,x]       1650  ld([Y,X])                       #22,14 Overlap with BCC
                                          1651  #
                                          1652  # (continue BCC)
                                          1653  #label('.bcc#13')
                                          1654  #dummy()                        #13
                                          1655  #dummy()                        #14
              0342 0200  nop              1656  nop()                           #15
                                          1657  label('.bcc#16')
.bcc#16:      0343 fc3d  bra  .bcc#18     1658  bra('.bcc#18')                  #16
              0344 0d00  ld   [y,x]       1659  ld([Y,X])                       #17 Operand is the conditional
                                          1660  label('.bcc#22')
.bcc#22:      0345 0116  ld   [$16]       1661  ld([vPC])                       #22 False condition
              0346 fc4a  bra  .bcc#25     1662  bra('.bcc#25')                  #23
              0347 8001  adda $01         1663  adda(1)                         #24
                                          1664  label('.bcc#23')
.bcc#23:      0348 de00  st   [y,x++]     1665  st([Y,Xpp])                     #23 Just X++ True condition
              0349 0d00  ld   [y,x]       1666  ld([Y,X])                       #24
                                          1667  label('.bcc#25')
.bcc#25:      034a c216  st   [$16]       1668  st([vPC])                       #25
              034b fc01  bra  NEXT        1669  bra('NEXT')                     #26
              034c 00f2  ld   $f2         1670  ld(-28/2)                       #27
                                          1671
                                          1672  # Conditional GT: Branch if positive (if(vACL>0)vPCL=D)
                                          1673  label('GT')
GT:           034d f845  ble  .bcc#22     1674  ble('.bcc#22')                  #20
              034e e448  bgt  .bcc#23     1675  bgt('.bcc#23')                  #21
              034f 0d00  ld   [y,x]       1676  ld([Y,X])                       #22
                                          1677
                                          1678  # Conditional LT: Branch if negative (if(vACL<0)vPCL=D)
                                          1679  label('LT')
LT:           0350 f445  bge  .bcc#22     1680  bge('.bcc#22')                  #20
              0351 e848  blt  .bcc#23     1681  blt('.bcc#23')                  #21
              0352 0d00  ld   [y,x]       1682  ld([Y,X])                       #22
                                          1683
                                          1684  # Conditional GE: Branch if positive or zero (if(vACL>=0)vPCL=D)
                                          1685  label('GE')
GE:           0353 e845  blt  .bcc#22     1686  blt('.bcc#22')                  #20
              0354 f448  bge  .bcc#23     1687  bge('.bcc#23')                  #21
              0355 0d00  ld   [y,x]       1688  ld([Y,X])                       #22
                                          1689
                                          1690  # Conditional LE: Branch if negative or zero (if(vACL<=0)vPCL=D)
                                          1691  label('LE')
LE:           0356 e445  bgt  .bcc#22     1692  bgt('.bcc#22')                  #20
              0357 f848  ble  .bcc#23     1693  ble('.bcc#23')                  #21
              0358 0d00  ld   [y,x]       1694  ld([Y,X])                       #22
                                          1695
                                          1696  # Instruction LDI: Load immediate small positive constant (vAC=D), 16 cycles
                                          1697  label('LDI')
LDI:          0359 c218  st   [$18]       1698  st([vAC])                       #10
              035a 0000  ld   $00         1699  ld(0)                           #11
              035b c219  st   [$19]       1700  st([vAC+1])                     #12
              035c fc00  bra  NEXTY       1701  bra('NEXTY')                    #13
