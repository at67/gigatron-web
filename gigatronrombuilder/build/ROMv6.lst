                                          2009  #  $0400 ROM page 4: Application interpreter extension
                                          2010  #
                                          2011  #-----------------------------------------------------------------------
                                          2012  align(0x100, size=0x100)
                                          2013
                                          2014  # (Continue RET)
              0400 a002  suba $02         2015  suba(2)                         #11
              0401 c216  st   [$16]       2016  st([vPC])                       #12
              0402 011b  ld   [$1b]       2017  ld([vLR+1])                     #13
              0403 c217  st   [$17]       2018  st([vPC+1])                     #14
              0404 1403  ld   $03,y       2019  ld(hi('REENTER'),Y)             #15
              0405 e0cb  jmp  y,$cb       2020  jmp(Y,'REENTER')                #16
              0406 00f6  ld   $f6         2021  ld(-20/2)                       #17
