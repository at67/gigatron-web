notesTable:   0900 0000  ld   $00         2896  ld(0)
              0901 0000  ld   $00         2897  ld(0)
                                          2898  for i in range(0, 250, 2):
                                          2899    j = i//2-1
                                          2900    freq = 440.0*2.0**((j-57)/12.0)
                                          2901    if j>=0 and freq <= sampleRate/2.0:
                                          2902      key = int(round(32768 * freq / sampleRate))
                                          2903      octave, note = j//12, notes[j%12]
                                          2904      sharp = '-' if notes[j%12-1] != note else '#'
                                          2905      comment = '%s%s%s (%0.1f Hz)' % (note, sharp, octave, freq)
                                          2906      ld(key&127); C(comment); ld(key>>7)
