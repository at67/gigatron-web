                                          3501  #-----------------------------------------------------------------------
                                          3502  # Extension SYS_Sprite6_v3_64
                                          3503  # Extension SYS_Sprite6x_v3_64
                                          3504  # Extension SYS_Sprite6y_v3_64
                                          3505  # Extension SYS_Sprite6xy_v3_64
                                          3506  #-----------------------------------------------------------------------
                                          3507
                                          3508  # Blit sprite in screen memory
                                          3509  #
                                          3510  # Variables
                                          3511  #       vAC             Destination address in screen
                                          3512  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          3513  #                       by negative byte value N (typically N = -Y)
                                          3514  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          3515  #
                                          3516  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          3517  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          3518  # of 6 pixels at a time, and then written to the screen through the
                                          3519  # destination pointer (each chunk underneath the previous), thus
                                          3520  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          3521  # negative byte N after a chunk signals the end of the sprite data.
                                          3522  # So the sprite's height Y is determined by the source data and is
                                          3523  # therefore flexible. This negative byte value, typically N == -Y,
                                          3524  # is then used to adjust the destination pointer's high byte, to make
                                          3525  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          3526  # call for as many 6-pixel wide stripes you need. All arguments are
                                          3527  # already left in place to facilitate this. After one call, the source
                                          3528  # pointer will point past that source data, effectively:
                                          3529  #       src += Y * 6 + 1
                                          3530  # The destination pointer will have been adjusted as:
                                          3531  #       dst += (Y + N) * 256 + 6
                                          3532  # (With arithmetic wrapping around on the same memory page)
                                          3533  #
                                          3534  # Y is only limited by source memory, not by CPU cycles. The
                                          3535  # implementation is such that the SYS function self-repeats, each
                                          3536  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          3537  # pixels per scanline this way.
                                          3538
                                          3539  label('SYS_Sprite6_v3_64')
                                          3540
SYS_Sprite6_v3_64:
              0c00 1124  ld   [$24],x     3541  ld([sysArgs+0],X)               #15 Pixel data source address
              0c01 1525  ld   [$25],y     3542  ld([sysArgs+1],Y)               #16
              0c02 0d00  ld   [y,x]       3543  ld([Y,X])                       #17 Next pixel or stop
              0c03 f411  bge  .sysDpx0    3544  bpl('.sysDpx0')                 #18
              0c04 de00  st   [y,x++]     3545  st([Y,Xpp])                     #19 Just X++
                                          3546
