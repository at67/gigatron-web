                                          1024  #-----------------------------------------------------------------------
                                          1025  #
                                          1026  #  $0100 ROM page 1: Video loop vertical blank
                                          1027  #
                                          1028  #-----------------------------------------------------------------------
                                          1029  align(0x100, size=0x100)
                                          1030
                                          1031  # Video off mode (also no sound, serial, timer, blinkenlights, ...).
                                          1032  # For benchmarking purposes. This still has the overhead for the vTicks
                                          1033  # administration, time slice granularity etc.
                                          1034  label('videoZ')
                                          1035  videoZ = pc()
videoZ:       0100 1505  ld   [$05],y     1036  runVcpu(None, '---- novideo', returnTo=videoZ)
              0101 e0ff  jmp  y,$ff
              0102 007f  ld   $7f
                                          1037
                                          1038  label('startVideo')             # (Re)start of video signal from idle state
startVideo:   0103 00c0  ld   $c0         1039  ld(syncBits)
                                          1040
                                          1041  # Start of vertical blank interval
                                          1042  label('vBlankStart')
vBlankStart:  0104 c21f  st   [$1f]       1043  st([videoSync0])                #32 Start of vertical blank interval
              0105 0080  ld   $80         1044  ld(syncBits^hSync)              #33
              0106 c220  st   [$20]       1045  st([videoSync1])                #34
                                          1046
                                          1047  # Reset line counter before vCPU can see it
              0107 00b3  ld   $b3         1048  ld(videoYline0)                 #35
              0108 c209  st   [$09]       1049  st([videoY])                    #36
                                          1050
                                          1051  # Update frame count and [0x80] (4 cycles)
