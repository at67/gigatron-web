                                          1329  label('vBlankLast#52')
                                          1330
                                          1331  # Respond to reset button (14 cycles)
                                          1332  # - ResetTimer decrements as long as just [Start] is pressed down
                                          1333  # - Reaching 0 (normal) or 128 (extended) triggers the soft reset sequence
                                          1334  # - Initial value is 128 (or 255 at boot), first decrement, then check
                                          1335  # - This starts vReset -> SYS_Reset_88 -> SYS_Exec_88 -> Reset.gcl -> Main.gcl
                                          1336  # - Main.gcl then recognizes extended presses if resetTimer is 0..127 ("paasei")
                                          1337  # - This requires a full cycle (4s) in the warm boot scenario
                                          1338  # - Or a half cycle (2s) when pressing [Select] down during hard reset
                                          1339  # - This furthermore requires >=1 frame (and <=128) to have passed between
                                          1340  #   reaching 128 and getting through Reset and the start of Main, while [Start]
                                          1341  #   was still pressed so the count reaches <128. Two reasonable expectations.
                                          1342  # - The unintended power-up scenarios of ROMv1 (pulling SER_DATA low, or
                                          1343  #   pressing [Select] together with another button) now don't trigger anymore.
                                          1344
vBlankLast#52:
              01b3 0111  ld   [$11]       1345  ld([buttonState])               #52 Check [Start] for soft reset
              01b4 60ef  xora $ef         1346  xora(~buttonStart)              #53
              01b5 ecbe  bne  .restart#56 1347  bne('.restart#56')              #54
              01b6 0112  ld   [$12]       1348  ld([resetTimer])                #55 As long as button pressed
              01b7 a001  suba $01         1349  suba(1)                         #56 ... count down the timer
              01b8 c212  st   [$12]       1350  st([resetTimer])                #57
              01b9 207f  anda $7f         1351  anda(127)                       #58
              01ba f0c6  beq  .restart#61 1352  beq('.restart#61')              #59 Reset at 0 (normal 2s) or 128 (extended 4s)
              01bb 00ee  ld   $ee         1353  ld((vReset&255)-2)              #60 Start force reset when hitting 0
              01bc fcc5  bra  .restart#63 1354  bra('.restart#63')              #61 ... otherwise do nothing yet
              01bd fcc4  bra  .restart#64 1355  bra('.restart#64')              #62
                                          1356  label('.restart#56')
.restart#56:  01be 0001  ld   $01         1357  wait(62-56)                     #56
              01bf ecbf  bne  $01bf
              01c0 a001  suba $01
              01c1 0200  nop
              01c2 0080  ld   $80         1358  ld(128)                         #62 Not pressed, reset the timer
              01c3 c212  st   [$12]       1359  st([resetTimer])                #63
                                          1360  label('.restart#64')
