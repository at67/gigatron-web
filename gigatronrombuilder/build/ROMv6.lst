                                          1579  #-----------------------------------------------------------------------
                                          1580  #
                                          1581  #  $0300 ROM page 3: Application interpreter primary page
                                          1582  #
                                          1583  #-----------------------------------------------------------------------
                                          1584
                                          1585  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1586  #
                                          1587  # This routine will execute as many as possible instructions in the
                                          1588  # allotted time. When time runs out, it synchronizes such that the total
                                          1589  # duration matches the caller's request. Durations are counted in `ticks',
                                          1590  # which are multiples of 2 clock cycles.
                                          1591  #
                                          1592  # Synopsis: Use the runVcpu() macro as entry point
                                          1593
                                          1594  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1595  # precious space in the packed interpreter code page. Although ENTER's
                                          1596  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1597  # in this case it will still jump into the right space, because branches
                                          1598  # from $xxFF land in the next page anyway.
                                          1599  while pc()&255 < 255:
              02fb 0200  nop              1600    nop()
              02fc 0200  nop
              02fd 0200  nop
              02fe 0200  nop
                                          1601  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1602  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1603  # --- Page boundary ---
                                          1604  align(0x100,size=0x100)
                                          1605  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1606  ld([vPC+1],Y)                   #1
                                          1607
                                          1608  # Fetch next instruction and execute it, but only if there are sufficient
                                          1609  # ticks left for the slowest instruction.
                                          1610  label('NEXT')
NEXT:         0301 8115  adda [$15]       1611  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        1612  blt('EXIT')                     #1 Escape near time out
                                          1613  label('.next2')
.next2:       0303 c215  st   [$15]       1614  st([vTicks])                    #2
              0304 0116  ld   [$16]       1615  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         1616  adda(2)                         #4
              0306 d216  st   [$16],x     1617  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       1618  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     1619  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          1620  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       1621  ld([Y,X])                       #9 Prefetch operand
                                          1622
                                          1623  # Resync with video driver and transfer control
                                          1624  label('EXIT')
EXIT:         030b 800e  adda $0e         1625  adda(maxTicks)                  #3
                                          1626  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      1627  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         1628  suba(1)                         #5
              030e 1401  ld   $01,y       1629  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     1630  jmp(Y,[vReturn])                #7 To video driver
              0310 0000  ld   $00         1631  ld(0)                           #8 AC should be 0 already. Still..
                                          1632  assert vCPU_overhead ==          9
                                          1633
                                          1634  # Instruction LDWI: Load immediate word constant (vAC=D), 20 cycles
                                          1635  label('LDWI')
LDWI:         0311 c218  st   [$18]       1636  st([vAC])                       #10
              0312 de00  st   [y,x++]     1637  st([Y,Xpp])                     #11 Just X++
              0313 0d00  ld   [y,x]       1638  ld([Y,X])                       #12 Fetch second operand
              0314 c219  st   [$19]       1639  st([vAC+1])                     #13
              0315 0116  ld   [$16]       1640  ld([vPC])                       #14 Advance vPC one more
              0316 8001  adda $01         1641  adda(1)                         #15
              0317 c216  st   [$16]       1642  st([vPC])                       #16
              0318 00f6  ld   $f6         1643  ld(-20/2)                       #17
              0319 fc01  bra  NEXT        1644  bra('NEXT')                     #18
                                          1645  #dummy()                        #19 Overlap
                                          1646  #
                                          1647  # Instruction LD: Load byte from zero page (vAC=[D]), 22 cycles
                                          1648  label('LD')
LD:           031a 1200  ld   ac,x        1649  ld(AC,X)                        #10,19
              031b 0500  ld   [x]         1650  ld([X])                         #11
              031c 1404  ld   $04,y       1651  ld(hi('ld#15'),Y)               #12
              031d e013  jmp  y,$13       1652  jmp(Y,'ld#15')                  #13
              031e c218  st   [$18]       1653  st([vAC])                       #14
                                          1654
                                          1655  # Instruction CMPHS: Adjust high byte for signed compare (vACH=XXX), 28 cycles
                                          1656  label('CMPHS_v5')
CMPHS_v5:     031f 140b  ld   $0b,y       1657  ld(hi('cmphs#13'),Y)            #10
              0320 e0d2  jmp  y,$d2       1658  jmp(Y,'cmphs#13')               #11
                                          1659  #ld(AC,X)                       #12 Overlap
                                          1660  #
                                          1661  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 20 cycles
                                          1662  label('LDW')
LDW:          0321 1200  ld   ac,x        1663  ld(AC,X)                        #10,12
              0322 8001  adda $01         1664  adda(1)                         #11
              0323 c21d  st   [$1d]       1665  st([vTmp])                      #12 Address of high byte
              0324 0500  ld   [x]         1666  ld([X])                         #13
              0325 c218  st   [$18]       1667  st([vAC])                       #14
              0326 111d  ld   [$1d],x     1668  ld([vTmp],X)                    #15
              0327 0500  ld   [x]         1669  ld([X])                         #16
              0328 c219  st   [$19]       1670  st([vAC+1])                     #17
              0329 fc01  bra  NEXT        1671  bra('NEXT')                     #18
              032a 00f6  ld   $f6         1672  ld(-20/2)                       #19
                                          1673
                                          1674  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 20 cycles
                                          1675  label('STW')
STW:          032b 1200  ld   ac,x        1676  ld(AC,X)                        #10,20
              032c 8001  adda $01         1677  adda(1)                         #11
              032d c21d  st   [$1d]       1678  st([vTmp])                      #12 Address of high byte
              032e 0118  ld   [$18]       1679  ld([vAC])                       #13
              032f c600  st   [x]         1680  st([X])                         #14
              0330 111d  ld   [$1d],x     1681  ld([vTmp],X)                    #15
              0331 0119  ld   [$19]       1682  ld([vAC+1])                     #16
              0332 c600  st   [x]         1683  st([X])                         #17
              0333 fc01  bra  NEXT        1684  bra('NEXT')                     #18
              0334 00f6  ld   $f6         1685  ld(-20/2)                       #19
                                          1686
                                          1687  # Instruction BCC: Test AC sign and branch conditionally, 28 cycles
                                          1688  label('BCC')
BCC:          0335 0119  ld   [$19]       1689  ld([vAC+1])                     #10 First inspect high byte of vAC
              0336 ec40  bne  .bcc#13     1690  bne('.bcc#13')                  #11
              0337 c21d  st   [$1d]       1691  st([vTmp])                      #12
              0338 0118  ld   [$18]       1692  ld([vAC])                       #13 Additionally inspect low byte of vAC
              0339 f043  beq  .bcc#16     1693  beq('.bcc#16')                  #14
              033a 0001  ld   $01         1694  ld(1)                           #15
              033b c21d  st   [$1d]       1695  st([vTmp])                      #16
              033c 0d00  ld   [y,x]       1696  ld([Y,X])                       #17 Operand is the conditional
                                          1697  label('.bcc#18')
.bcc#18:      033d fe00  bra  ac          1698  bra(AC)                         #18
              033e 011d  ld   [$1d]       1699  ld([vTmp])                      #19
                                          1700
                                          1701  # Conditional EQ: Branch if zero (if(vACL==0)vPCL=D)
                                          1702  label('EQ')
EQ:           033f ec45  bne  .bcc#22     1703  bne('.bcc#22')                  #20
