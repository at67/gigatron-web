                                          3160  #       sysArgs[4]      Scratch (changed)
                                          3161
                                          3162  label('SYS_SpiExchangeBytes_v4_134')
SYS_SpiExchangeBytes_v4_134:
              0b15 140d  ld   $0d,y       3163  ld(hi('sys_SpiExchangeBytes'),Y)#15
              0b16 e015  jmp  y,$15       3164  jmp(Y,'sys_SpiExchangeBytes')   #16
