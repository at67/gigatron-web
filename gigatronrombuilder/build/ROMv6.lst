                                          2925  #-----------------------------------------------------------------------
                                          2926  #
                                          2927  #  $0d00 ROM page 11: More SYS functions
                                          2928  #
                                          2929  #-----------------------------------------------------------------------
                                          2930
                                          2931  align(0x100, size=0x100)
                                          2932
                                          2933  #-----------------------------------------------------------------------
                                          2934  # Extension SYS_SetMode_v2_80
                                          2935  #-----------------------------------------------------------------------
                                          2936
                                          2937  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          2938  #
                                          2939  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          2940  # the user can experiment. It's adviced to refrain from using
                                          2941  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          2942  # personal preference, and the programmer shouldn't overrule the user
                                          2943  # in that choice. The Gigatron philisophy is that the end user has
                                          2944  # the final say on what happens on the system, not the application,
                                          2945  # even if that implies a degraded performance. This doesn't mean that
                                          2946  # all applications must work well in all video modes: mode 1 is still
                                          2947  # the default. If an application really doesn't work at all in that
                                          2948  # mode, it's acceptable to change mode once after loading.
                                          2949  #
                                          2950  # There's no "SYS_GetMode" function.
                                          2951  #
                                          2952  # Variables:
                                          2953  #       vAC bit 0:1     Mode:
                                          2954  #                         0      "ABCD" -> Full mode (slowest)
                                          2955  #                         1      "ABC-" -> Default mode after reset
                                          2956  #                         2      "A-C-" -> at67's mode
                                          2957  #                         3      "A---" -> HGM's mode
                                          2958  #       vAC bit 2:15    Ignored bits and should be 0
                                          2959  #
                                          2960  # Special values (ROM v4):
                                          2961  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          2962  #                        no blinkenlights).
                                          2963  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          2964
                                          2965  # Actual duration is <80 cycles, but keep some room for future extensions
                                          2966  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       2967  ld(hi('sys_SetMode'),Y)         #15
              0b01 e056  jmp  y,$56       2968  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       2969  ld([vReturn])                   #17
                                          2970
                                          2971  #-----------------------------------------------------------------------
                                          2972  # Extension SYS_SetMemory_v2_54
                                          2973  #-----------------------------------------------------------------------
                                          2974
                                          2975  # SYS function for setting 1..256 bytes
                                          2976  #
                                          2977  # sysArgs[0]   Copy count (in, changed)
                                          2978  # sysArgs[1]   Copy value (in)
                                          2979  # sysArgs[2:3] Destination address (in, changed)
                                          2980  #
                                          2981  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          2982  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          2983  # All combined that gives a 300% speedup over ROMv4 and before.
                                          2984
                                          2985  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       2986  ld([sysArgs+0])                 #15
                                          2987  bra('sys_SetMemory#18')         #16
              0b04 fc1a  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     2988  ld([sysArgs+2],X)               #17
                                          2989
                                          2990  #-----------------------------------------------------------------------
                                          2991  # Extension SYS_SendSerial1_v3_80
                                          2992  #-----------------------------------------------------------------------
                                          2993
                                          2994  # SYS function for sending data over serial controller port using
                                          2995  # pulse width modulation of the vertical sync signal.
                                          2996  #
                                          2997  # Variables:
                                          2998  #       sysArgs[0:1]    Source address               (in, changed)
                                          2999  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          3000  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          3001  #
                                          3002  # The sending will abort if input data is detected on the serial port.
                                          3003  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          3004  #
                                          3005  # This modulates the next upcoming X vertical pulses with the supplied
                                          3006  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          3007  # After that, the vPulse width falls back to 8 lines (idle).
                                          3008
                                          3009  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       3010  ld([videoY])                    #15
                                          3011  bra('sys_SendSerial1')          #16
              0b07 fc85  bra  sys_SendSerial1
              0b08 60b3  xora $b3         3012  xora(videoYline0)               #17 First line of vertical blank
                                          3013
                                          3014  #-----------------------------------------------------------------------
                                          3015  # Extension SYS_ExpanderControl_v4_40
                                          3016  #-----------------------------------------------------------------------
                                          3017
                                          3018  # Sets the I/O and RAM expander's control register
                                          3019  #
                                          3020  # Variables:
                                          3021  #       vAC bit 2       Device enable /SS0
                                          3022  #           bit 3       Device enable /SS1
                                          3023  #           bit 4       Device enable /SS2
                                          3024  #           bit 5       Device enable /SS3
                                          3025  #           bit 6       Banking B0
                                          3026  #           bit 7       Banking B1
                                          3027  #           bit 15      Data out MOSI
                                          3028  #       sysArgs[7]      Cache for control state (written to)
                                          3029  #
                                          3030  # Intended for prototyping, and probably too low-level for most applications
                                          3031  # Still there's a safeguard: it's not possible to disable RAM using this
                                          3032
                                          3033  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140d  ld   $0d,y       3034  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e000  jmp  y,$00       3035  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 000c  ld   $0c         3036  ld(0b00001100)                  #17
                                          3037  #    ^^^^^^^^
                                          3038  #    |||||||`-- SCLK
                                          3039  #    ||||||`--- Not connected
                                          3040  #    |||||`---- /SS0
                                          3041  #    ||||`----- /SS1
                                          3042  #    |||`------ /SS2 or /CPOL
                                          3043  #    ||`------- /SS3 or /ZPBANK
                                          3044  #    |`-------- B0
                                          3045  #    `--------- B1
                                          3046
                                          3047  #-----------------------------------------------------------------------
                                          3048  # Extension SYS_Run6502_v4_80
                                          3049  #-----------------------------------------------------------------------
                                          3050
                                          3051  # Transfer control to v6502
                                          3052  #
                                          3053  # Calling 6502 code from vCPU goes (only) through this SYS function.
                                          3054  # Directly modifying the vCpuSelect variable is unreliable. The
                                          3055  # control transfer is immediate, without waiting for the current
                                          3056  # time slice to end or first returning to vCPU.
                                          3057  #
                                          3058  # vCPU code and v6502 code can interoperate without much hassle:
                                          3059  # - The v6502 program counter is vLR, and v6502 doesn't touch vPC
                                          3060  # - Returning to vCPU is with the BRK instruction
                                          3061  # - BRK doesn't dump process state on the stack
                                          3062  # - vCPU can save/restore the vLR with PUSH/POP
                                          3063  # - Stacks are shared, vAC is shared
                                          3064  # - vAC can indicate what the v6502 code wants. vAC+1 will be cleared
                                          3065  # - Alternative is to leave a word in sysArgs[6:7] (v6502 X and Y registers)
                                          3066  # - Another way is to set vPC before BRK, and vCPU will continue there(+2)
                                          3067  #
                                          3068  # Calling v6502 code from vCPU looks like this:
                                          3069  #       LDWI  SYS_Run6502_v4_80
                                          3070  #       STW   sysFn
                                          3071  #       LDWI  $6502_start_address
                                          3072  #       STW   vLR
                                          3073  #       SYS   80
                                          3074  #
                                          3075  # Variables:
                                          3076  #       vAC             Accumulator
                                          3077  #       vLR             Program Counter
                                          3078  #       vSP             Stack Pointer (+1)
                                          3079  #       sysArgs[6]      Index Register X
                                          3080  #       sysArgs[7]      Index Register Y
                                          3081  # For info:
                                          3082  #       sysArgs[0:1]    Address Register, free to clobber
                                          3083  #       sysArgs[2]      Instruction Register, free to clobber
                                          3084  #       sysArgs[3:5]    Flags, don't touch
                                          3085  #
                                          3086  # Implementation details::
                                          3087  #
                                          3088  #  The time to reserve for this transition is the maximum time
                                          3089  #  between NEXT and v6502_check. This is
                                          3090  #       SYS call duration + 2*v6502_maxTicks + (v6502_overhead - vCPU_overhead)
                                          3091  #     = 22 + 28 + (11 - 9) = 62 cycles.
                                          3092  #  So reserving 80 cycles is future proof. This isn't overhead, as it includes
                                          3093  #  the fetching of the first 6502 opcode and its operands..
                                          3094  #
                                          3095  #                      0            10                 28=0         9
                                          3096  #    ---+----+---------+------------+------------------+-----------+---
                                          3097  # video | nop| runVcpu |   ENTER    | At least one ins |   EXIT    | video
                                          3098  #    ---+----+---------+------------+------------------+-----------+---
                                          3099  #        sync  prelude  ENTER-to-ins    ins-to-NEXT     NEXT-to-video
                                          3100  #       |<-->|
                                          3101  #        0/1 |<------->|
                                          3102  #                 5    |<----------------------------->|
                                          3103  #          runVCpu_overhead           28               |<--------->|
                                          3104  #                                 2*maxTicks                 9
                                          3105  #                                                      vCPU_overhead
                                          3106  #
                                          3107  #                      0                21                    38=0       11
                                          3108  #    ---+----+---------+----------------+--------------------+-----------+---
                                          3109  # video | nop| runVcpu |   v6502_ENTER  | At least one fetch |v6502_exitB| video
                                          3110  #    ---+----+---------+----------------+--------------------+-----------+---
                                          3111  #        sync  prelude   enter-to-fetch     fetch-to-check    check-to-video
                                          3112  #       |<-->|
                                          3113  #        0/1 |<------->|
                                          3114  #                 5    |<----------------------------------->|
                                          3115  #          runVcpu_overhead           38                     |<--------->|
                                          3116  #                              2*v6520_maxTicks                    11
                                          3117  #                                                            v6502_overhead
                                          3118
                                          3119  label('SYS_Run6502_v4_80')
SYS_Run6502_v4_80:
              0b0c 140d  ld   $0d,y       3120  ld(hi('sys_v6502'),Y)           #15
              0b0d e08b  jmp  y,$8b       3121  jmp(Y,'sys_v6502')              #16
              0b0e 000d  ld   $0d         3122  ld(hi('v6502_ENTER'))           #17 Activate v6502
