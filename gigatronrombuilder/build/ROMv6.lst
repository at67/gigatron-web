.videoF#36:   02f4 0001  ld   $01         1571  ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1572  st([nextVideo])                 #37
                                          1573  #
                                          1574  # Alternative for pixel burst: faster application mode
                                          1575  label('nopixels')
nopixels:     02f6 00ff  ld   $ff         1576  runVcpu(200-38, 'ABCD line 40-520',
              02f7 c21e  st   [$1e]
              02f8 1505  ld   [$05],y
              02f9 e0ff  jmp  y,$ff
              02fa 003c  ld   $3c
