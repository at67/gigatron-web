                                          3350
                                          3351  #-----------------------------------------------------------------------
                                          3352  # Extension SYS_Sprite6_v3_64
                                          3353  # Extension SYS_Sprite6x_v3_64
                                          3354  # Extension SYS_Sprite6y_v3_64
                                          3355  # Extension SYS_Sprite6xy_v3_64
                                          3356  #-----------------------------------------------------------------------
                                          3357
                                          3358  # Blit sprite in screen memory
                                          3359  #
                                          3360  # Variables
                                          3361  #       vAC             Destination address in screen
                                          3362  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          3363  #                       by negative byte value N (typically N = -Y)
                                          3364  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          3365  #
                                          3366  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          3367  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          3368  # of 6 pixels at a time, and then written to the screen through the
                                          3369  # destination pointer (each chunk underneath the previous), thus
                                          3370  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          3371  # negative byte N after a chunk signals the end of the sprite data.
                                          3372  # So the sprite's height Y is determined by the source data and is
                                          3373  # therefore flexible. This negative byte value, typically N == -Y,
                                          3374  # is then used to adjust the destination pointer's high byte, to make
                                          3375  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          3376  # call for as many 6-pixel wide stripes you need. All arguments are
                                          3377  # already left in place to facilitate this. After one call, the source
                                          3378  # pointer will point past that source data, effectively:
                                          3379  #       src += Y * 6 + 1
                                          3380  # The destination pointer will have been adjusted as:
                                          3381  #       dst += (Y + N) * 256 + 6
                                          3382  # (With arithmetic wrapping around on the same memory page)
                                          3383  #
                                          3384  # Y is only limited by source memory, not by CPU cycles. The
                                          3385  # implementation is such that the SYS function self-repeats, each
                                          3386  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          3387  # pixels per scanline this way.
                                          3388
                                          3389  label('SYS_Sprite6_v3_64')
                                          3390
SYS_Sprite6_v3_64:
