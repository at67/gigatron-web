                                          2410  #
                                          2411  #-----------------------------------------------------------------------
                                          2412
                                          2413  align(0x100, size=0x200)
                                          2414
                                          2415  # Lookup table for i>>n, with n in 1..6
                                          2416  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          2417  #       ...
                                          2418  #       ld   <.ret
                                          2419  #       st   [vTmp]
                                          2420  #       ld   >shiftTable,y
                                          2421  #       <calculate ix>
                                          2422  #       jmp  y,ac
                                          2423  #       bra  $ff
                                          2424  # .ret: ...
                                          2425  #
                                          2426  # i >> 7 can be always be done with RAM: [i&128]
                                          2427  #       ...
                                          2428  #       anda $80,x
                                          2429  #       ld   [x]
                                          2430  #       ...
                                          2431
                                          2432  label('shiftTable')
                                          2433  shiftTable = pc()
                                          2434
                                          2435  for ix in range(255):
                                          2436    for n in range(1,7): # Find first zero
                                          2437      if ~ix & (1 << (n-1)):
                                          2438        break
                                          2439    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          2440    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
