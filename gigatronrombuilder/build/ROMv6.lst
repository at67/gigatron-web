                                          1183  # When the total number of scan lines per frame is not an exact multiple of the
                                          1184  # (4) channels, there will be an audible discontinuity if no measure is taken.
                                          1185  # This static noise can be suppressed by swallowing the first `lines mod 4'
                                          1186  # partial samples after transitioning into vertical blank. This is easiest if
                                          1187  # the modulo is 0 (do nothing), 1 (reset sample when entering the last visible
                                          1188  # scan line), or 2 (reset sample while in the first blank scan line). For the
                                          1189  # last case there is no solution yet: give a warning.
                                          1190  extra = 0
                                          1191  if soundDiscontinuity == 2:
