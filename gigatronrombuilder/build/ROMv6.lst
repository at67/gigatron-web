                                          191   enableListing()
                                          192   #-----------------------------------------------------------------------
                                          193   #
                                          194   #  Start of core
                                          195   #
                                          196   #-----------------------------------------------------------------------
                                          197
                                          198   # Pre-loading the formal interface as a way to get warnings when
                                          199   # accidentally redefined with a different value
                                          200   loadBindings('interface.json')
                                          201   loadBindings('Core/interface-dev.json') # Provisional values for DEVROM
                                          202
                                          203   # Gigatron clock
                                          204   cpuClock = 6.250e+06
                                          205
                                          206   # Output pin assignment for VGA
                                          207   R, G, B, hSync, vSync = 1, 4, 16, 64, 128
                                          208   syncBits = hSync+vSync # Both pulses negative
                                          209
                                          210   # When the XOUT register is in the circuit, the rising edge triggers its update.
                                          211   # The loop can therefore not be agnostic to the horizontal pulse polarity.
                                          212   assert syncBits & hSync != 0
                                          213
                                          214   # VGA 640x480 defaults (to be adjusted below!)
                                          215   vFront = 10     # Vertical front porch
                                          216   vPulse = 2      # Vertical sync pulse
                                          217   vBack  = 33     # Vertical back porch
                                          218   vgaLines = vFront + vPulse + vBack + 480
                                          219   vgaClock = 25.175e+06
                                          220
                                          221   # Video adjustments for Gigatron
                                          222   # 1. Our clock is (slightly) slower than 1/4th VGA clock. Not all monitors will
                                          223   #    accept the decreased frame rate, so we restore the frame rate to above
                                          224   #    minimum 59.94 Hz by cutting some lines from the vertical front porch.
                                          225   vFrontAdjust = vgaLines - int(4 * cpuClock / vgaClock * vgaLines)
                                          226   vFront -= vFrontAdjust
                                          227   # 2. Extend vertical sync pulse so we can feed the game controller the same
                                          228   #    signal. This is needed for controllers based on the 4021 instead of 74165
                                          229   vPulseExtension = max(0, 8-vPulse)
                                          230   vPulse += vPulseExtension
                                          231   # 3. Borrow these lines from the back porch so the refresh rate remains
                                          232   #    unaffected
                                          233   vBack -= vPulseExtension
                                          234
                                          235   # Start value of vertical blank counter
                                          236   videoYline0 = 1-2*(vFront+vPulse+vBack-2)
                                          237
                                          238   # Mismatch between video lines and sound channels
                                          239   soundDiscontinuity = (vFront+vPulse+vBack) % 4
                                          240
                                          241   # QQVGA resolution
                                          242   qqVgaWidth      = 160
                                          243   qqVgaHeight     = 120
                                          244
                                          245   # Game controller bits (actual controllers in kit have negative output)
                                          246   # +----------------------------------------+
                                          247   # |       Up                        B*     |
                                          248   # |  Left    Right               B     A*  |
                                          249   # |      Down      Select Start     A      |
                                          250   # +----------------------------------------+ *=Auto fire
                                          251   buttonRight     = 1
                                          252   buttonLeft      = 2
                                          253   buttonDown      = 4
                                          254   buttonUp        = 8
                                          255   buttonStart     = 16
                                          256   buttonSelect    = 32
                                          257   buttonB         = 64
                                          258   buttonA         = 128
                                          259
                                          260   #-----------------------------------------------------------------------
                                          261   #
                                          262   #  RAM page 0: zero-page variables
                                          263   #
                                          264   #-----------------------------------------------------------------------
                                          265
                                          266   # Memory size in pages from auto-detect
                                          267   memSize         = zpByte()
                                          268
                                          269   # The current channel number for sound generation. Advanced every scan line
                                          270   # and independent of the vertical refresh to maintain constant oscillation.
                                          271   channel         = zpByte()
                                          272
                                          273   # Next sound sample being synthesized
                                          274   sample          = zpByte()
                                          275   # To save one instruction in the critical inner loop, `sample' is always
                                          276   # reset with its own address instead of, for example, the value 0. Compare:
                                          277   # 1 instruction reset
                                          278   #       st sample,[sample]
                                          279   # 2 instruction reset:
                                          280   #       ld 0
                                          281   #       st [sample]
                                          282   # The difference is not audible. This is fine when the reset/address
                                          283   # value is low and doesn't overflow with 4 channels added to it.
                                          284   # There is an alternative, but it requires pull-down diodes on the data bus:
                                          285   #       st [sample],[sample]
                                          286   assert 4*63 + sample < 256
                                          287   # We pin this reset/address value to 3, so `sample' swings from 3 to 255
                                          288   assert sample == 3
                                          289
                                          290   # Former bootCount and bootCheck (<= ROMv3)
                                          291   zpReserved      = zpByte() # Recycled and still unused. Candidate future uses:
                                          292                              # - Video driver high address (for alternative video modes)
                                          293                              # - v6502: ADH offset ("MMU")
                                          294                              # - v8080: ???
                                          295   vCpuSelect      = zpByte() # Active interpreter page
                                          296
                                          297   # Entropy harvested from SRAM startup and controller input
                                          298   entropy         = zpByte(3)
                                          299
                                          300   # Visible video
                                          301   videoY          = zpByte() # Counts up from 0 to 238 in steps of 2
                                          302                              # Counts up (and is odd) during vertical blank
                                          303   videoModeB      = zpByte() # Handler for every 2nd line (pixel burst or vCPU)
                                          304   videoModeC      = zpByte() # Handler for every 3rd line (pixel burst or vCPU)
                                          305   videoModeD      = zpByte() # Handler for every 4th line (pixel burst or vCPU)
                                          306
                                          307   nextVideo       = zpByte() # Jump offset to scan line handler (videoA, B, C...)
                                          308   videoPulse      = nextVideo # Used for pulse width modulation
                                          309
                                          310   # Frame counter is good enough as system clock
                                          311   frameCount      = zpByte(1)
                                          312
                                          313   # Serial input (game controller)
                                          314   serialRaw       = zpByte() # New raw serial read
                                          315   serialLast      = zpByte() # Previous serial read
                                          316   buttonState     = zpByte() # Clearable button state
                                          317   resetTimer      = zpByte() # After 2 seconds of holding 'Start', do a soft reset
                                          318                              # XXX move to page 1 to free up space
                                          319
                                          320   # Extended output (blinkenlights in bit 0:3 and audio in bit 4:7). This
                                          321   # value must be present in AC during a rising hSync edge. It then gets
                                          322   # copied to the XOUT register by the hardware. The XOUT register is only
                                          323   # accessible in this indirect manner because it isn't part of the core
                                          324   # CPU architecture.
                                          325   xout            = zpByte()
                                          326   xoutMask        = zpByte() # The blinkenlights and sound on/off state
                                          327
                                          328   # vCPU interpreter
                                          329   vTicks          = zpByte()  # Interpreter ticks are units of 2 clocks
                                          330   vPC             = zpByte(2) # Interpreter program counter, points into RAM
                                          331   vAC             = zpByte(2) # Interpreter accumulator, 16-bits
                                          332   vLR             = zpByte(2) # Return address, for returning after CALL
                                          333   vSP             = zpByte(1) # Stack pointer
                                          334   vTmp            = zpByte()
                                          335   vReturn         = zpByte()  # Return into video loop (in page of vBlankStart)
                                          336
                                          337   # Scratch
                                          338   frameX          = zpByte() # Starting byte within page
                                          339   frameY          = zpByte() # Page of current pixel line (updated by videoA)
                                          340
                                          341   # Vertical blank (reuse some variables used in the visible part)
                                          342   videoSync0      = frameX   # Vertical sync type on current line (0xc0 or 0x40)
                                          343   videoSync1      = frameY   # Same during horizontal pulse (0x80 or 0x00)
                                          344
                                          345   # Versioning for GT1 compatibility
                                          346   # Please refer to Docs/GT1-files.txt for interpreting this variable
                                          347   romType         = zpByte(1)
                                          348
                                          349   # The low 3 bits are repurposed to select the actively updated sound channels.
                                          350   # Valid bit combinations are:
                                          351   #  xxxxx011     Default after reset: 4 channels (page 1,2,3,4)
                                          352   #  xxxxx001     2 channels at double update rate (page 1,2)
                                          353   #  xxxxx000     1 channel at quadruple update rate (page 1)
                                          354   # The main application for this is to free up the high bytes of page 2,3,4.
                                          355   channelMask = symbol('channelMask_v4')
                                          356   assert romType == channelMask
                                          357
                                          358   # SYS function arguments and results/scratch
                                          359   sysFn           = zpByte(2)
                                          360   sysArgs         = zpByte(8)
                                          361
                                          362   # Play sound if non-zero, count down and stop sound when zero
                                          363   soundTimer      = zpByte()
                                          364
                                          365   # Fow now the LED state machine itself is hard-coded in the program ROM
                                          366   ledTimer        = zpByte() # Number of ticks until next LED change
                                          367   ledState_v2     = zpByte() # Current LED state
                                          368   ledTempo        = zpByte() # Next value for ledTimer after LED state change
                                          369
                                          370
                                          371   # Management of free space in page zero (userVars)
                                          372   # * Programs that only use the features of ROMvx can
                                          373   #   safely use all bytes above userVars_vx except 0x80.
                                          374   # * Programs that use some but not all features of ROMvx
                                          375   #   may exceptionally use bytes between userVars
                                          376   #   and userVars_vx if they avoid using ROM features
                                          377   #   that need them. This is considerably riskier.
                                          378   userVars        = zpByte(0)
                                          379   userVars_v4     = zpByte(0)
                                          380   # Saved vCPU context during vIRQ
                                          381   # Code that uses vCPU interrupts should not use these locations.
                                          382   vIrqSave        = zpByte(6)
                                          383   # Start of safely usable bytes under ROMv5
                                          384   userVars_v5     = zpByte(0)
                                          385   # Start of safely usable bytes under ROMv6
                                          386   userVars_v6     = zpByte(0)
                                          387
                                          388   # [0x80]
                                          389   # Constant 0x01.
                                          390   zpReset(0x80)
                                          391   oneConst        = zpByte(1)
                                          392   userVars2       = zpByte(0)
                                          393
                                          394   # Warning: One should avoid using SYS_ExpanderControl
                                          395   # under ROMv4 overwrites becauses it overwrites 0x81.
                                          396
                                          397
                                          398   #-----------------------------------------------------------------------
                                          399   #
                                          400   #  RAM page 1: video line table
                                          401   #
                                          402   #-----------------------------------------------------------------------
                                          403
                                          404   # Byte 0-239 define the video lines
                                          405   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          406
                                          407   vReset          = 0x01f0
                                          408   vIRQ_v5         = 0x01f6
                                          409   ctrlBits        = 0x01f8
                                          410   videoTop_v5     = 0x01f9 # Number of skip lines
                                          411
                                          412   # Highest bytes are for sound channel variables
                                          413   wavA = 250      # Waveform modulation with `adda'
                                          414   wavX = 251      # Waveform modulation with `xora'
                                          415   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          416   keyH = 253      # Frequency high 8 bits
                                          417   oscL = 254      # Phase low 7 bits
                                          418   oscH = 255      # Phase high 8 bits
                                          419
                                          420   #-----------------------------------------------------------------------
                                          421   #  Memory layout
                                          422   #-----------------------------------------------------------------------
                                          423
                                          424   userCode = 0x0200       # Application vCPU code
                                          425   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          426   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          427
                                          428   #-----------------------------------------------------------------------
                                          429   #  Application definitions
                                          430   #-----------------------------------------------------------------------
                                          431
                                          432   maxTicks = 28//2                 # Duration of vCPU's slowest virtual opcode (ticks)
                                          433   minTicks = 14//2                 # vcPU's fastest instruction
                                          434   v6502_maxTicks = 38//2           # Max duration of v6502 processing phase (ticks)
                                          435
                                          436   runVcpu_overhead = 5            # Caller overhead (cycles)
                                          437   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          438   v6502_overhead = 11             # Callee overhead for v6502 (cycles)
                                          439
                                          440   v6502_adjust = (v6502_maxTicks - maxTicks) + (v6502_overhead - vCPU_overhead)//2
                                          441   assert v6502_adjust >= 0        # v6502's overhead is a bit more than vCPU
                                          442
                                          443   def runVcpu(n, ref=None, returnTo=None):
                                          444     """Macro to run interpreter for exactly n cycles. Returns 0 in AC.
                                          445
                                          446     - `n' is the number of available Gigatron cycles including overhead.
                                          447       This is converted into interpreter ticks and takes into account
                                          448       the vCPU calling overheads. A `nop' is inserted when necessary
                                          449       for alignment between cycles and ticks.
                                          450     - `returnTo' is where program flow continues after return. If not set
                                          451        explicitely, it will be the first instruction behind the expansion.
                                          452     - If another interpreter than vCPU is active (v6502...), that one
                                          453       must adjust for the timing differences, because runVcpu wouldn't know."""
                                          454
                                          455     overhead = runVcpu_overhead + vCPU_overhead
                                          456     if returnTo == 0x100:         # Special case for videoZ
                                          457       overhead -= 2
                                          458
                                          459     if n is None:
                                          460       # (Clumsily) create a maximum time slice, corresponding to a vTicks
                                          461       # value of 127 (giving 282 cycles). A higher value doesn't work because
                                          462       # then SYS functions that just need 28 cycles (0 excess) won't start.
                                          463       n = (127 + maxTicks) * 2 + overhead
                                          464
                                          465     n -= overhead
                                          466     assert n > 0
                                          467
                                          468     if n % 2 == 1:
                                          469       nop()                       # Tick alignment
                                          470       n -= 1
                                          471     assert n % 2 == 0
                                          472
                                          473     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), n, ref))
                                          474
                                          475     if returnTo != 0x100:
                                          476       if returnTo is None:
                                          477         returnTo = pc() + 5       # Next instruction
                                          478       ld(lo(returnTo))            #0
                                          479       st([vReturn])               #1
                                          480
                                          481     n //= 2
                                          482     n -= maxTicks                 # First instruction always runs
                                          483     assert n < 128
                                          484     assert n >= v6502_adjust
                                          485
                                          486     ld([vCpuSelect],Y)            #2
                                          487     jmp(Y,'ENTER')                #3
                                          488     ld(n)                         #4
                                          489   assert runVcpu_overhead ==       5
                                          490
                                          491   #-----------------------------------------------------------------------
                                          492   #       v6502 definitions
                                          493   #-----------------------------------------------------------------------
                                          494
                                          495   # Registers are zero page variables
                                          496   v6502_PC        = vLR           # Program Counter
                                          497   v6502_PCL       = vLR+0         # Program Counter Low
                                          498   v6502_PCH       = vLR+1         # Program Counter High
                                          499   v6502_S         = vSP           # Stack Pointer (kept as "S+1")
                                          500   v6502_A         = vAC+0         # Accumulator
                                          501   v6502_BI        = vAC+1         # B Input Register (used by SBC)
                                          502   v6502_ADL       = sysArgs+0     # Low Address Register
                                          503   v6502_ADH       = sysArgs+1     # High Address Register
                                          504   v6502_IR        = sysArgs+2     # Instruction Register
                                          505   v6502_P         = sysArgs+3     # Processor Status Register (V flag in bit 7)
                                          506   v6502_Qz        = sysArgs+4     # Quick Status Register for Z flag
                                          507   v6502_Qn        = sysArgs+5     # Quick Status Register for N flag
                                          508   v6502_X         = sysArgs+6     # Index Register X
                                          509   v6502_Y         = sysArgs+7     # Index Register Y
                                          510   v6502_Tmp       = vTmp          # Scratch (may be clobbered outside v6502)
                                          511
                                          512   # MOS 6502 definitions for P register
                                          513   v6502_Cflag = 1                 # Carry Flag (unsigned overflow)
                                          514   v6502_Zflag = 2                 # Zero Flag (all bits zero)
                                          515   v6502_Iflag = 4                 # Interrupt Enable Flag (1=Disable)
                                          516   v6502_Dflag = 8                 # Decimal Enable Flag (aka BCD mode, 1=Enable)
                                          517   v6502_Bflag = 16                # Break (or PHP) Instruction Flag
                                          518   v6502_Uflag = 32                # Unused (always 1)
                                          519   v6502_Vflag = 64                # Overflow Flag (signed overflow)
                                          520   v6502_Nflag = 128               # Negative Flag (bit 7 of result)
                                          521
                                          522   # In emulation it is much faster to keep the V flag in bit 7
                                          523   # This can be corrected when importing/exporting with PHP, PLP, etc
                                          524   v6502_Vemu = 128
                                          525
                                          526   # On overflow:
                                          527   #       """Overflow is set if two inputs with the same sign produce
                                          528   #          a result with a different sign. Otherwise it is clear."""
                                          529   # Formula (without carry/borrow in!):
                                          530   #       (A ^ (A+B)) & (B ^ (A+B)) & 0x80
                                          531   # References:
                                          532   #       http://www.righto.com/2012/12/the-6502-overflow-flag-explained.html
                                          533   #       http://6502.org/tutorials/vflag.html
                                          534
                                          535   # Memory layout
                                          536   v6502_Stack     = 0x0000        # 0x0100 is already used in the Gigatron
                                          537   #v6502_NMI      = 0xfffa
                                          538   #v6502_RESET    = 0xfffc
                                          539   #v6502_IRQ      = 0xfffe
                                          540
                                          541   #-----------------------------------------------------------------------
                                          542   #
                                          543   #  $0000 ROM page 0: Boot
                                          544   #
                                          545   #-----------------------------------------------------------------------
                                          546
                                          547   align(0x100, size=0x80)
                                          548
                                          549   # Give a first sign of life that can be checked with a voltmeter
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0000  ld   $00         550   ld(0b0000)                      # LEDs |OOOO|
              0001 1880  ld   $80,out     551   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0002 18c0  ld   $c0,out     552   ld(syncBits,OUT)                # hSync goes up, updating XOUT
                                          553
                                          554   # Setup I/O and RAM expander
              0003 c17f  rand $7f         555   ctrl(0b01111111)                # Reset signal (default state | 0x3)
              0004 c17c  rand $7c         556   ctrl(0b01111100)                # Disable SPI slaves, enable RAM, bank 1
                                          557   #      ^^^^^^^^
                                          558   #      |||||||`-- SCLK
                                          559   #      ||||||`--- Not connected
                                          560   #      |||||`---- /SS0
                                          561   #      ||||`----- /SS1
                                          562   #      |||`------ /SS2
                                          563   #      ||`------- /SS3
                                          564   #      |`-------- B0
                                          565   #      `--------- B1
                                          566   # bit15 --------- MOSI = 0
                                          567
                                          568   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0005 0001  ld   $01         569   ld(1)                           # Quick RAM test and count
                                          570   label('.countMem0')
.countMem0:   0006 d601  st   [$01],y     571   st([memSize],Y)                 # Store in RAM and load AC in Y
              0007 00ff  ld   $ff         572   ld(255)
              0008 6900  xora [y,$00]     573   xora([Y,0])                     # Invert value from memory
              0009 ca00  st   [y,$00]     574   st([Y,0])                       # Test RAM by writing the new value
              000a c200  st   [$00]       575   st([0])                         # Copy result in [0]
              000b 6900  xora [y,$00]     576   xora([Y,0])                     # Read back and compare if written ok
              000c ec0c  bne  $000c       577   bne(pc())                       # Loop forever on RAM failure here
              000d 00ff  ld   $ff         578   ld(255)
              000e 6900  xora [y,$00]     579   xora([Y,0])                     # Invert memory value again
              000f ca00  st   [y,$00]     580   st([Y,0])                       # To restore original value
              0010 6100  xora [$00]       581   xora([0])                       # Compare with inverted copy
              0011 f015  beq  .countMem1  582   beq('.countMem1')               # If equal, we wrapped around
              0012 0101  ld   [$01]       583   ld([memSize])
              0013 fc06  bra  .countMem0  584   bra('.countMem0')               # Loop to test next address line
              0014 8200  adda ac          585   adda(AC)                        # Executes in the branch delay slot!
                                          586   label('.countMem1')
                                          587
                                          588   # Momentarily wait to allow for debouncing of the reset switch by spinning
                                          589   # roughly 2^15 times at 2 clocks per loop: 6.5ms@10MHz to 10ms@6.3MHz
                                          590   # Real-world switches normally bounce shorter than that.
                                          591   # "[...] 16 switches exhibited an average 1557 usec of bouncing, with,
                                          592   #  as I said, a max of 6200 usec" (From: http://www.ganssle.com/debouncing.htm)
                                          593   # Relevant for the breadboard version, as the kit doesn't have a reset switch.
                                          594
.countMem1:   0015 00ff  ld   $ff         595   ld(255)                         # Debounce reset button
                                          596   label('.debounce')
.debounce:    0016 c200  st   [$00]       597   st([0])
              0017 ec17  bne  $0017       598   bne(pc())
              0018 a001  suba $01         599   suba(1)                         # Branch delay slot
              0019 0100  ld   [$00]       600   ld([0])
              001a ec16  bne  .debounce   601   bne('.debounce')
              001b a001  suba $01         602   suba(1)                         # Branch delay slot
                                          603
                                          604   # Update LEDs (memory is present and counted, reset is stable)
              001c 0001  ld   $01         605   ld(0b0001)                      # LEDs |*OOO|
              001d 1880  ld   $80,out     606   ld(syncBits^hSync,OUT)
              001e 18c0  ld   $c0,out     607   ld(syncBits,OUT)
                                          608
                                          609   # Scan the entire RAM space to collect entropy for a random number generator.
                                          610   # The 16-bit address space is scanned, even if less RAM was detected.
              001f 0000  ld   $00         611   ld(0)                           # Collect entropy from RAM
              0020 d218  st   [$18],x     612   st([vAC+0],X)
              0021 d619  st   [$19],y     613   st([vAC+1],Y)
                                          614   label('.initEnt0')
.initEnt0:    0022 0106  ld   [$06]       615   ld([entropy+0])
              0023 f426  bge  .initEnt1   616   bpl('.initEnt1')
              0024 8d00  adda [y,x]       617   adda([Y,X])
              0025 60bf  xora $bf         618   xora(191)
                                          619   label('.initEnt1')
.initEnt1:    0026 c206  st   [$06]       620   st([entropy+0])
              0027 0107  ld   [$07]       621   ld([entropy+1])
              0028 f42b  bge  .initEnt2   622   bpl('.initEnt2')
              0029 8106  adda [$06]       623   adda([entropy+0])
              002a 60c1  xora $c1         624   xora(193)
                                          625   label('.initEnt2')
.initEnt2:    002b c207  st   [$07]       626   st([entropy+1])
              002c 8108  adda [$08]       627   adda([entropy+2])
              002d c208  st   [$08]       628   st([entropy+2])
              002e 0118  ld   [$18]       629   ld([vAC+0])
              002f 8001  adda $01         630   adda(1)
              0030 ec22  bne  .initEnt0   631   bne('.initEnt0')
              0031 d218  st   [$18],x     632   st([vAC+0],X)
              0032 0119  ld   [$19]       633   ld([vAC+1])
              0033 8001  adda $01         634   adda(1)
              0034 ec22  bne  .initEnt0   635   bne('.initEnt0')
              0035 d619  st   [$19],y     636   st([vAC+1],Y)
                                          637
                                          638   # Update LEDs
              0036 0003  ld   $03         639   ld(0b0011)                      # LEDs |**OO|
              0037 1880  ld   $80,out     640   ld(syncBits^hSync,OUT)
              0038 18c0  ld   $c0,out     641   ld(syncBits,OUT)
                                          642
                                          643   # vCPU reset handler
              0039 00ee  ld   $ee         644   ld((vReset&255)-2)              # Setup vCPU reset handler
              003a c216  st   [$16]       645   st([vPC])
              003b 9002  adda $02,x       646   adda(2,X)
              003c 0001  ld   $01         647   ld(vReset>>8)
              003d d617  st   [$17],y     648   st([vPC+1],Y)
              003e dc59  st   $59,[y,x++] 649   st('LDI',             [Y,Xpp])
              003f dc5f  st   $5f,[y,x++] 650   st('SYS_Reset_88',    [Y,Xpp])
              0040 dc2b  st   $2b,[y,x++] 651   st('STW',             [Y,Xpp])
              0041 dc22  st   $22,[y,x++] 652   st(sysFn,             [Y,Xpp])
              0042 dcb4  st   $b4,[y,x++] 653   st('SYS',             [Y,Xpp])  # SYS -> SYS_Reset_88 -> SYS_Exec_88
              0043 dce2  st   $e2,[y,x++] 654   st(256-88//2+maxTicks,[Y,Xpp])
