                                          1890  #
                                          1891  # Instruction SYS: Native call, <=256 cycles (<=128 ticks, in reality less)
                                          1892  #
                                          1893  # The 'SYS' vCPU instruction first checks the number of desired ticks given by
                                          1894  # the operand. As long as there are insufficient ticks available in the current
                                          1895  # time slice, the instruction will be retried. This will effectively wait for
                                          1896  # the next scan line if the current slice is almost out of time. Then a jump to
                                          1897  # native code is made. This code can do whatever it wants, but it must return
                                          1898  # to the 'REENTER' label when done. When returning, AC must hold (the negative
                                          1899  # of) the actual consumed number of whole ticks for the entire virtual
                                          1900  # instruction cycle (from NEXT to NEXT). This duration may not exceed the prior
                                          1901  # declared duration in the operand + 28 (or maxTicks). The operand specifies the
                                          1902  # (negative) of the maximum number of *extra* ticks that the native call will
                                          1903  # need. The GCL compiler automatically makes this calculation from gross number
                                          1904  # of cycles to excess number of ticks.
                                          1905  # SYS functions can modify vPC to implement repetition. For example to split
                                          1906  # up work into multiple chucks.
                                          1907  label('.sys#13')
.sys#13:      03af 0116  ld   [$16]       1908  ld([vPC])                       #13,12 Retry until sufficient time
              03b0 a002  suba $02         1909  suba(2)                         #14
              03b1 c216  st   [$16]       1910  st([vPC])                       #15
              03b2 fccb  bra  REENTER     1911  bra('REENTER')                  #16
              03b3 00f6  ld   $f6         1912  ld(-20/2)                       #17
                                          1913  label('SYS')
SYS:          03b4 8115  adda [$15]       1914  adda([vTicks])                  #10
              03b5 e8af  blt  .sys#13     1915  blt('.sys#13')                  #11
              03b6 1523  ld   [$23],y     1916  ld([sysFn+1],Y)                 #12
              03b7 e122  jmp  y,[$22]     1917  jmp(Y,[sysFn])                  #13
                                          1918  #dummy()                        #14 Overlap
                                          1919  #
                                          1920  # Instruction SUBW: Word subtract with zero page (AC-=[D]+256*[D+1]), 28 cycles
                                          1921  # All cases can be done in 26 cycles, but the code will become much larger
                                          1922  label('SUBW')
SUBW:         03b8 1200  ld   ac,x        1923  ld(AC,X)                        #10,14 Address of low byte to be subtracted
              03b9 8001  adda $01         1924  adda(1)                         #11
              03ba c21d  st   [$1d]       1925  st([vTmp])                      #12 Address of high byte to be subtracted
              03bb 0118  ld   [$18]       1926  ld([vAC])                       #13
              03bc e8c1  blt  .subw#16    1927  bmi('.subw#16')                 #14
              03bd a500  suba [x]         1928  suba([X])                       #15
              03be c218  st   [$18]       1929  st([vAC])                       #16 Store low result
              03bf fcc4  bra  .subw#19    1930  bra('.subw#19')                 #17
              03c0 4500  ora  [x]         1931  ora([X])                        #18 Carry in bit 7
                                          1932  label('.subw#16')
.subw#16:     03c1 c218  st   [$18]       1933  st([vAC])                       #16 Store low result
              03c2 2500  anda [x]         1934  anda([X])                       #17 Carry in bit 7
              03c3 0200  nop              1935  nop()                           #18
                                          1936  label('.subw#19')
.subw#19:     03c4 3080  anda $80,x       1937  anda(0x80,X)                    #19 Move carry to bit 0
              03c5 0119  ld   [$19]       1938  ld([vAC+1])                     #20
              03c6 a500  suba [x]         1939  suba([X])                       #21
              03c7 111d  ld   [$1d],x     1940  ld([vTmp],X)                    #22
              03c8 a500  suba [x]         1941  suba([X])                       #23
              03c9 c219  st   [$19]       1942  st([vAC+1])                     #24
                                          1943  label('REENTER_28')
REENTER_28:   03ca 00f2  ld   $f2         1944  ld(-28/2)                       #25
                                          1945  label('REENTER')
REENTER:      03cb fc01  bra  NEXT        1946  bra('NEXT')                     #26 Return from SYS calls
              03cc 1517  ld   [$17],y     1947  ld([vPC+1],Y)                   #27
