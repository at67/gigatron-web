                                          1829  # Instruction PEEK: Read byte from memory (vAC=[vAC]), 26 cycles
                                          1830  label('PEEK')
PEEK:         03ad 1404  ld   $04,y       1831  ld(hi('peek'),Y)                #10
              03ae e062  jmp  y,$62       1832  jmp(Y,'peek')                   #11
