              0e3d 410f  ora  [$0f]       3869  ora([serialRaw])                #43
              0e3e 0200  nop              3870  nop()                           #44
              0e3f 0200  nop              3871  nop()                           #45
              0e40 fc35  bra  .buttons#48 3872  bra('.buttons#48')              #46
              0e41 0200  nop              3873  nop()                           #47
