                                          3168  #-----------------------------------------------------------------------
                                          3169  # Extension SYS_ReceiveSerial1_v6_32
                                          3170  #-----------------------------------------------------------------------
                                          3171
                                          3172  # SYS function for receiving one byte over the serial controller port.
                                          3173  # This is a public version of SYS_NextByteIn from the loader private
                                          3174  # extension.  A byte is read from IN when videoY reaches
                                          3175  # sysArgs[3]. The byte is added to the checksum sysArgs[2] then stored
                                          3176  # at address sysArgs[0:1] which gets incremented.
                                          3177  #
                                          3178  # The 65 bytes of a serial frame can be read for the following values
                                          3179  # of videoY: 207 (protocol byte) 219 (length, 6 bits only) 235, 251
                                          3180  # (address) then 2, 6, 10, .. 238 stepping by four, then 185.
                                          3181  #
                                          3182  # Variables:
                                          3183  #     sysArgs[0:1] Address
                                          3184  #     sysArgs[2]   Checksum
                                          3185  #     sysArgs[3]   Wait value (videoY)
                                          3186
                                          3187  label('SYS_ReceiveSerial1_v6_32')
SYS_ReceiveSerial1_v6_32:                 3188  bra('sys_ReceiveSerial1')       #15
              0b18 fcb2  bra  sys_ReceiveSerial1
              0b19 0127  ld   [$27]       3189  ld([sysArgs+3])                 #16
