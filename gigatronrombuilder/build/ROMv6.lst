                                          2037  label('andi#13')
andi#13:      0411 0200  nop              2038  nop()                           #13
              0412 c218  st   [$18]       2039  st([vAC])                       #14
                                          2040  #
                                          2041  label('ld#15')
ld#15:        0413 0000  ld   $00         2042  ld(0)                           #15 Clear high byte
              0414 c219  st   [$19]       2043  st([vAC+1])                     #16
              0415 1403  ld   $03,y       2044  ld(hi('REENTER'),Y)             #17
              0416 e0cb  jmp  y,$cb       2045  jmp(Y,'REENTER')                #18
              0417 00f5  ld   $f5         2046  ld(-22/2)                       #19
