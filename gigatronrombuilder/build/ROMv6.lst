                                          3258
                                          3259  # -------------------------------------------------------------
                                          3260  # vCPU instructions for comparisons between two 16-bit operands
                                          3261  # -------------------------------------------------------------
                                          3262  #
                                          3263  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          3264  # treating vAC as a two's complement 16-bit number. When we need to
                                          3265  # compare two arbitrary numnbers we normally first take their difference
                                          3266  # with SUBW.  However, when this difference is too large, the subtraction
                                          3267  # overflows and we get the wrong outcome. To get it right over the
                                          3268  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          3269  # blurp for its relational operators. (It compares stack variable $02
                                          3270  # with zero page variable $3a.)
                                          3271  #
                                          3272  #       0461  ee 02            LDLW  $02
                                          3273  #       0463  fc 3a            XORW  $3a
                                          3274  #       0465  35 53 6a         BGE   $046c
                                          3275  #       0468  ee 02            LDLW  $02
                                          3276  #       046a  90 6e            BRA   $0470
                                          3277  #       046c  ee 02            LDLW  $02
                                          3278  #       046e  b8 3a            SUBW  $3a
                                          3279  #       0470  35 56 73         BLE   $0475
                                          3280  #
                                          3281  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          3282  # They inspect both operands to see if there is an overflow risk. If
                                          3283  # so, they modify vAC such that their difference gets smaller, while
                                          3284  # preserving the relation between the two operands. After that, the
                                          3285  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          3286  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          3287  # the sequence above becomes:
                                          3288  #
                                          3289  #       0461  ee 02            LDLW  $02
                                          3290  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          3291  #       0465  b8 3a            SUBW  $3a
                                          3292  #       0467  35 56 73         BLE   $0475
                                          3293  #
                                          3294  # CMPHS/CMPHU don't make much sense other than in combination with
                                          3295  # SUBW. These modify vACH, if needed, as given in the following table:
                                          3296  #
                                          3297  #       vACH  varH  |     vACH
                                          3298  #       bit7  bit7  | CMPHS  CMPHU
                                          3299  #       ---------------------------
                                          3300  #         0     0   |  vACH   vACH      no change needed
                                          3301  #         0     1   | varH+1 varH-1     narrowing the range
                                          3302  #         1     0   | varH-1 varH+1     narrowing the range
                                          3303  #         1     1   |  vACH   vACH      no change needed
                                          3304  #       ---------------------------
                                          3305
                                          3306  # CMPHS implementation (vCPU instruction)
                                          3307  label('cmphs#13')
cmphs#13:     0bd2 1403  ld   $03,y       3308  ld(hi('REENTER'),Y)             #13
              0bd3 0500  ld   [x]         3309  ld([X])                         #14
              0bd4 6119  xora [$19]       3310  xora([vAC+1])                   #15
              0bd5 f4e6  bge  .cmphu#18   3311  bpl('.cmphu#18')                #16 Skip if same sign
              0bd6 0119  ld   [$19]       3312  ld([vAC+1])                     #17
              0bd7 e8da  blt  $0bda       3313  bmi(pc()+3)                     #18
              0bd8 fcdb  bra  .cmphs#21   3314  bra(pc()+3)                     #19
                                          3315  label('.cmphs#20')
.cmphs#20:    0bd9 0001  ld   $01         3316  ld(+1)                          #20    vAC < variable
              0bda 00ff  ld   $ff         3317  ld(-1)                          #20(!) vAC > variable
                                          3318  label('.cmphs#21')
.cmphs#21:    0bdb 8500  adda [x]         3319  adda([X])                       #21
              0bdc c219  st   [$19]       3320  st([vAC+1])                     #22
              0bdd e0ca  jmp  y,$ca       3321  jmp(Y,'REENTER_28')             #23
                                          3322  #dummy()                        #24 Overlap
                                          3323  #
                                          3324  # CMPHS implementation (vCPU instruction)
                                          3325  label('cmphu#13')
cmphu#13:     0bde 1403  ld   $03,y       3326  ld(hi('REENTER'),Y)             #13,24
              0bdf 0500  ld   [x]         3327  ld([X])                         #14
              0be0 6119  xora [$19]       3328  xora([vAC+1])                   #15
              0be1 f4e6  bge  .cmphu#18   3329  bpl('.cmphu#18')                #16 Skip if same sign
              0be2 0119  ld   [$19]       3330  ld([vAC+1])                     #17
              0be3 e8d9  blt  .cmphs#20   3331  bmi('.cmphs#20')                #18
              0be4 fcdb  bra  .cmphs#21   3332  bra('.cmphs#21')                #19
              0be5 00ff  ld   $ff         3333  ld(-1)                          #20    vAC > variable
                                          3334
