                                          1517  label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1518  ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1519  ld([videoY])                    #30
