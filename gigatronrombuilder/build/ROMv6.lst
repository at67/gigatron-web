                                          2853
                                          2854  #-----------------------------------------------------------------------
                                          2855  # Extension SYS_SetMode_v2_80
                                          2856  #-----------------------------------------------------------------------
                                          2857
                                          2858  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          2859  #
                                          2860  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          2861  # the user can experiment. It's adviced to refrain from using
                                          2862  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          2863  # personal preference, and the programmer shouldn't overrule the user
                                          2864  # in that choice. The Gigatron philisophy is that the end user has
                                          2865  # the final say on what happens on the system, not the application,
                                          2866  # even if that implies a degraded performance. This doesn't mean that
                                          2867  # all applications must work well in all video modes: mode 1 is still
                                          2868  # the default. If an application really doesn't work at all in that
                                          2869  # mode, it's acceptable to change mode once after loading.
                                          2870  #
                                          2871  # There's no "SYS_GetMode" function.
                                          2872  #
                                          2873  # Variables:
                                          2874  #       vAC bit 0:1     Mode:
                                          2875  #                         0      "ABCD" -> Full mode (slowest)
                                          2876  #                         1      "ABC-" -> Default mode after reset
                                          2877  #                         2      "A-C-" -> at67's mode
                                          2878  #                         3      "A---" -> HGM's mode
                                          2879  #       vAC bit 2:15    Ignored bits and should be 0
                                          2880  #
                                          2881  # Special values (ROM v4):
                                          2882  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          2883  #                        no blinkenlights).
                                          2884  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          2885
                                          2886  # Actual duration is <80 cycles, but keep some room for future extensions
                                          2887  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       2888  ld(hi('sys_SetMode'),Y)         #15
              0b01 e056  jmp  y,$56       2889  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       2890  ld([vReturn])                   #17
                                          2891
                                          2892  #-----------------------------------------------------------------------
                                          2893  # Extension SYS_SetMemory_v2_54
                                          2894  #-----------------------------------------------------------------------
                                          2895
                                          2896  # SYS function for setting 1..256 bytes
                                          2897  #
                                          2898  # sysArgs[0]   Copy count (in, changed)
                                          2899  # sysArgs[1]   Copy value (in)
                                          2900  # sysArgs[2:3] Destination address (in, changed)
                                          2901  #
                                          2902  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          2903  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          2904  # All combined that gives a 300% speedup over ROMv4 and before.
                                          2905
                                          2906  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       2907  ld([sysArgs+0])                 #15
                                          2908  bra('sys_SetMemory#18')         #16
              0b04 fc1a  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     2909  ld([sysArgs+2],X)               #17
                                          2910
                                          2911  #-----------------------------------------------------------------------
                                          2912  # Extension SYS_SendSerial1_v3_80
                                          2913  #-----------------------------------------------------------------------
                                          2914
                                          2915  # SYS function for sending data over serial controller port using
                                          2916  # pulse width modulation of the vertical sync signal.
                                          2917  #
                                          2918  # Variables:
                                          2919  #       sysArgs[0:1]    Source address               (in, changed)
                                          2920  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          2921  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          2922  #
                                          2923  # The sending will abort if input data is detected on the serial port.
                                          2924  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          2925  #
                                          2926  # This modulates the next upcoming X vertical pulses with the supplied
                                          2927  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          2928  # After that, the vPulse width falls back to 8 lines (idle).
                                          2929
                                          2930  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       2931  ld([videoY])                    #15
                                          2932  bra('sys_SendSerial1')          #16
              0b07 fc85  bra  sys_SendSerial1
              0b08 60b3  xora $b3         2933  xora(videoYline0)               #17 First line of vertical blank
                                          2934
                                          2935  #-----------------------------------------------------------------------
                                          2936  # Extension SYS_ExpanderControl_v4_40
                                          2937  #-----------------------------------------------------------------------
                                          2938
                                          2939  # Sets the I/O and RAM expander's control register
                                          2940  #
                                          2941  # Variables:
                                          2942  #       vAC bit 2       Device enable /SS0
                                          2943  #           bit 3       Device enable /SS1
                                          2944  #           bit 4       Device enable /SS2
                                          2945  #           bit 5       Device enable /SS3
                                          2946  #           bit 6       Banking B0
                                          2947  #           bit 7       Banking B1
                                          2948  #           bit 15      Data out MOSI
                                          2949  #       sysArgs[7]      Cache for control state (written to)
                                          2950  #
                                          2951  # Intended for prototyping, and probably too low-level for most applications
                                          2952  # Still there's a safeguard: it's not possible to disable RAM using this
                                          2953
                                          2954  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140d  ld   $0d,y       2955  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e000  jmp  y,$00       2956  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 000c  ld   $0c         2957  ld(0b00001100)                  #17
                                          2958  #    ^^^^^^^^
                                          2959  #    |||||||`-- SCLK
                                          2960  #    ||||||`--- Not connected
                                          2961  #    |||||`---- /SS0
                                          2962  #    ||||`----- /SS1
                                          2963  #    |||`------ /SS2 or /CPOL
                                          2964  #    ||`------- /SS3 or /ZPBANK
                                          2965  #    |`-------- B0
                                          2966  #    `--------- B1
                                          2967
                                          2968
                                          2969  label('SYS_SPARE0')
SYS_SPARE0:   0b0c 140b  ld   $0b,y       2970  ld(hi('SYS_SPARE0'),Y)           #15
              0b0d e00c  jmp  y,$0c       2971  jmp(Y,'SYS_SPARE0')              #16
              0b0e 0000  ld   $00         2972  ld(0)                            #17
                                          2973
                                          2974  #-----------------------------------------------------------------------
                                          2975  # Extension SYS_ResetWaveforms_v4_50
                                          2976  #-----------------------------------------------------------------------
                                          2977
                                          2978  # soundTable[4x+0] = sawtooth, to be modified into metallic/noise
                                          2979  # soundTable[4x+1] = pulse
                                          2980  # soundTable[4x+2] = triangle
                                          2981  # soundTable[4x+3] = sawtooth, also useful to right shift 2 bits
                                          2982
                                          2983  label('SYS_ResetWaveforms_v4_50')
SYS_ResetWaveforms_v4_50:
              0b0f 140e  ld   $0e,y       2984  ld(hi('sys_ResetWaveforms'),Y)  #15 Initial setup of waveforms. [vAC+0]=i
              0b10 e0a5  jmp  y,$a5       2985  jmp(Y,'sys_ResetWaveforms')     #16
              0b11 1407  ld   $07,y       2986  ld(soundTable>>8,Y)             #17
                                          2987
                                          2988  #-----------------------------------------------------------------------
                                          2989  # Extension SYS_ShuffleNoise_v4_46
                                          2990  #-----------------------------------------------------------------------
                                          2991
                                          2992  # Use simple 6-bits variation of RC4 to permutate waveform 0 in soundTable
                                          2993
                                          2994  label('SYS_ShuffleNoise_v4_46')
SYS_ShuffleNoise_v4_46:
              0b12 140e  ld   $0e,y       2995  ld(hi('sys_ShuffleNoise'),Y)    #15 Shuffle soundTable[4i+0]. [vAC+0]=4j, [vAC+1]=4i
              0b13 e0c6  jmp  y,$c6       2996  jmp(Y,'sys_ShuffleNoise')       #16
              0b14 1407  ld   $07,y       2997  ld(soundTable>>8,Y)             #17
