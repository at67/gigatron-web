sound2:       02b1 d602  st   [$02],y     1473  st([channel],Y)                 #5
              02b2 007f  ld   $7f         1474  ld(0x7f)                        #6
              02b3 29fe  anda [y,$fe]     1475  anda([Y,oscL])                  #7
              02b4 89fc  adda [y,$fc]     1476  adda([Y,keyL])                  #8
              02b5 cafe  st   [y,$fe]     1477  st([Y,oscL])                    #9
              02b6 3080  anda $80,x       1478  anda(0x80,X)                    #10
              02b7 0500  ld   [x]         1479  ld([X])                         #11
              02b8 89ff  adda [y,$ff]     1480  adda([Y,oscH])                  #12
              02b9 89fd  adda [y,$fd]     1481  adda([Y,keyH])                  #13
              02ba caff  st   [y,$ff]     1482  st([Y,oscH] )                   #14
              02bb 20fc  anda $fc         1483  anda(0xfc)                      #15
