                                          3801  #-----------------------------------------------------------------------
                                          3802  #       Extended vertical blank logic: game controller decoding
                                          3803  #-----------------------------------------------------------------------
                                          3804
                                          3805  # Game controller types
                                          3806  # TypeA: Based on 74LS165 shift register (not supported)
                                          3807  # TypeB: Based on CD4021B shift register (standard)
                                          3808  # TypeC: Based on priority encoder
                                          3809  #
                                          3810  # Notes:
                                          3811  # - TypeA was only used during development and first beta test, before ROM v1
                                          3812  # - TypeB appears as type A with negative logic levels
                                          3813  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          3814  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          3815  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          3816  # - TypeB and TypeC can be sampled in the same scanline
                                          3817  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          3818  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          3819  #
                                          3820  #       TypeC    Alias    Button TypeB
                                          3821  #       00000000  ^@   -> Right  11111110
                                          3822  #       00000001  ^A   -> Left   11111101
                                          3823  #       00000011  ^C   -> Down   11111011
                                          3824  #       00000111  ^G   -> Up     11110111
                                          3825  #       00001111  ^O   -> Start  11101111
                                          3826  #       00011111  ^_   -> Select 11011111
                                          3827  #       00111111  ?    -> B      10111111
                                          3828  #       01111111  DEL  -> A      01111111
                                          3829  #       11111111       -> (None) 11111111
                                          3830  #
                                          3831  #       Conversion formula:
                                          3832  #               f(x) := 254 - x
                                          3833
                                          3834  # Detect controller TypeC codes
vBlankLast#34:
              0e25 010f  ld   [$0f]       3835  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              0e26 8001  adda $01         3836  adda(1)                         #35
              0e27 210f  anda [$0f]       3837  anda([serialRaw])               #36
              0e28 ec39  bne  .buttons#39 3838  bne('.buttons#39')              #37
                                          3839
                                          3840  # TypeC
              0e29 010f  ld   [$0f]       3841  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              0e2a 8001  adda $01         3842  adda(1)                         #39
              0e2b 2110  anda [$10]       3843  anda([serialLast])              #40
              0e2c ec30  bne  .buttons#43 3844  bne('.buttons#43')              #41
              0e2d 00fe  ld   $fe         3845  ld(254)                         #42 then clear the selected bit
              0e2e 0200  nop              3846  nop()                           #43
              0e2f fc33  bra  .buttons#46 3847  bra('.buttons#46')              #44
                                          3848  label('.buttons#43')
.buttons#43:  0e30 a10f  suba [$0f]       3849  suba([serialRaw])               #43,45
              0e31 2111  anda [$11]       3850  anda([buttonState])             #44
              0e32 c211  st   [$11]       3851  st([buttonState])               #45
                                          3852  label('.buttons#46')
.buttons#46:  0e33 010f  ld   [$0f]       3853  ld([serialRaw])                 #46 Set the lower bits
              0e34 4111  ora  [$11]       3854  ora([buttonState])              #47
                                          3855  label('.buttons#48')
.buttons#48:  0e35 c211  st   [$11]       3856  st([buttonState])               #48
              0e36 010f  ld   [$0f]       3857  ld([serialRaw])                 #49 Update serialLast for next pass
              0e37 e0b3  jmp  y,$b3       3858  jmp(Y,'vBlankLast#52')          #50
              0e38 c210  st   [$10]       3859  st([serialLast])                #51
