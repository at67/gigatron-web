              0087 e0cb  jmp  y,$cb       770   jmp(Y,'REENTER')                #16
              0088 00f6  ld   $f6         771   ld(-20/2)                       #17
                                          772
              0089 1403  ld   $03,y       773   ld(hi('REENTER'),Y)             #15 slot 0x89
              008a e0cb  jmp  y,$cb       774   jmp(Y,'REENTER')                #16
              008b 00f6  ld   $f6         775   ld(-20/2)                       #17
                                          776
              008c 1403  ld   $03,y       777   ld(hi('REENTER'),Y)             #15 slot 0x8c
