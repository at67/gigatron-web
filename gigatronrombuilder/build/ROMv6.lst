                                          2465  #  $0500 ROM page 5-6: Shift table and code
                                          2466  #
                                          2467  #-----------------------------------------------------------------------
                                          2468
                                          2469  align(0x100, size=0x200)
                                          2470
                                          2471  # Lookup table for i>>n, with n in 1..6
                                          2472  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          2473  #       ...
                                          2474  #       ld   <.ret
                                          2475  #       st   [vTmp]
                                          2476  #       ld   >shiftTable,y
                                          2477  #       <calculate ix>
                                          2478  #       jmp  y,ac
                                          2479  #       bra  $ff
                                          2480  # .ret: ...
                                          2481  #
                                          2482  # i >> 7 can be always be done with RAM: [i&128]
                                          2483  #       ...
                                          2484  #       anda $80,x
                                          2485  #       ld   [x]
                                          2486  #       ...
                                          2487
                                          2488  label('shiftTable')
                                          2489  shiftTable = pc()
                                          2490
                                          2491  for ix in range(255):
                                          2492    for n in range(1,7): # Find first zero
                                          2493      if ~ix & (1 << (n-1)):
                                          2494        break
                                          2495    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          2496    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
