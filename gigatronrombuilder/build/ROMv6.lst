                                          3408
                                          3409  # -------------------------------------------------------------
                                          3410  # vCPU instructions for comparisons between two 16-bit operands
                                          3411  # -------------------------------------------------------------
                                          3412  #
                                          3413  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          3414  # treating vAC as a two's complement 16-bit number. When we need to
                                          3415  # compare two arbitrary numnbers we normally first take their difference
                                          3416  # with SUBW.  However, when this difference is too large, the subtraction
                                          3417  # overflows and we get the wrong outcome. To get it right over the
                                          3418  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          3419  # blurp for its relational operators. (It compares stack variable $02
                                          3420  # with zero page variable $3a.)
                                          3421  #
                                          3422  #       0461  ee 02            LDLW  $02
                                          3423  #       0463  fc 3a            XORW  $3a
                                          3424  #       0465  35 53 6a         BGE   $046c
                                          3425  #       0468  ee 02            LDLW  $02
                                          3426  #       046a  90 6e            BRA   $0470
                                          3427  #       046c  ee 02            LDLW  $02
                                          3428  #       046e  b8 3a            SUBW  $3a
                                          3429  #       0470  35 56 73         BLE   $0475
                                          3430  #
                                          3431  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          3432  # They inspect both operands to see if there is an overflow risk. If
                                          3433  # so, they modify vAC such that their difference gets smaller, while
                                          3434  # preserving the relation between the two operands. After that, the
                                          3435  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          3436  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          3437  # the sequence above becomes:
                                          3438  #
                                          3439  #       0461  ee 02            LDLW  $02
                                          3440  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          3441  #       0465  b8 3a            SUBW  $3a
                                          3442  #       0467  35 56 73         BLE   $0475
                                          3443  #
                                          3444  # CMPHS/CMPHU don't make much sense other than in combination with
                                          3445  # SUBW. These modify vACH, if needed, as given in the following table:
                                          3446  #
                                          3447  #       vACH  varH  |     vACH
                                          3448  #       bit7  bit7  | CMPHS  CMPHU
                                          3449  #       ---------------------------
                                          3450  #         0     0   |  vACH   vACH      no change needed
                                          3451  #         0     1   | varH+1 varH-1     narrowing the range
                                          3452  #         1     0   | varH-1 varH+1     narrowing the range
                                          3453  #         1     1   |  vACH   vACH      no change needed
                                          3454  #       ---------------------------
                                          3455
                                          3456  # CMPHS implementation (vCPU instruction)
                                          3457  label('cmphs#13')
cmphs#13:     0bd2 1403  ld   $03,y       3458  ld(hi('REENTER'),Y)             #13
              0bd3 0500  ld   [x]         3459  ld([X])                         #14
              0bd4 6119  xora [$19]       3460  xora([vAC+1])                   #15
              0bd5 f4e6  bge  .cmphu#18   3461  bpl('.cmphu#18')                #16 Skip if same sign
              0bd6 0119  ld   [$19]       3462  ld([vAC+1])                     #17
              0bd7 e8da  blt  $0bda       3463  bmi(pc()+3)                     #18
              0bd8 fcdb  bra  .cmphs#21   3464  bra(pc()+3)                     #19
                                          3465  label('.cmphs#20')
.cmphs#20:    0bd9 0001  ld   $01         3466  ld(+1)                          #20    vAC < variable
              0bda 00ff  ld   $ff         3467  ld(-1)                          #20(!) vAC > variable
                                          3468  label('.cmphs#21')
.cmphs#21:    0bdb 8500  adda [x]         3469  adda([X])                       #21
              0bdc c219  st   [$19]       3470  st([vAC+1])                     #22
              0bdd e0ca  jmp  y,$ca       3471  jmp(Y,'REENTER_28')             #23
                                          3472  #dummy()                        #24 Overlap
                                          3473  #
                                          3474  # CMPHS implementation (vCPU instruction)
                                          3475  label('cmphu#13')
cmphu#13:     0bde 1403  ld   $03,y       3476  ld(hi('REENTER'),Y)             #13,24
              0bdf 0500  ld   [x]         3477  ld([X])                         #14
              0be0 6119  xora [$19]       3478  xora([vAC+1])                   #15
              0be1 f4e6  bge  .cmphu#18   3479  bpl('.cmphu#18')                #16 Skip if same sign
              0be2 0119  ld   [$19]       3480  ld([vAC+1])                     #17
              0be3 e8d9  blt  .cmphs#20   3481  bmi('.cmphs#20')                #18
              0be4 fcdb  bra  .cmphs#21   3482  bra('.cmphs#21')                #19
              0be5 00ff  ld   $ff         3483  ld(-1)                          #20    vAC > variable
                                          3484
                                          3485  # No-operation for CMPHS/CMPHU when high bits are equal
                                          3486  label('.cmphu#18')
.cmphu#18:    0be6 e0cb  jmp  y,$cb       3487  jmp(Y,'REENTER')                #18
              0be7 00f5  ld   $f5         3488  ld(-22/2)                       #19
