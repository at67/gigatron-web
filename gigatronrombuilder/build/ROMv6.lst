                                          689   #-----------------------------------------------------------------------
                                          690   # Extension SYS_Reset_88: Soft reset
                                          691   #-----------------------------------------------------------------------
                                          692
                                          693   # SYS_Reset_88 initiates an immediate Gigatron reset from within the vCPU.
                                          694   # The reset sequence itself is mostly implemented in GCL by Reset.gcl,
                                          695   # which must first be loaded into RAM. But as that takes more than 1 scanline,
                                          696   # some vCPU bootstrapping code gets loaded with SYS_Exec_88.
                                          697   # !!! This function was REMOVED from interface.json
                                          698   # !!! Better use vReset as generic entry point for soft reset
                                          699
                                          700   # ROM type (see also Docs/GT1-files.txt)
                                          701   romTypeValue = symbol('romTypeValue_ROMv6')
                                          702
                                          703   label('SYS_Reset_88')
                                          704   assert pc()>>8 == 0
                                          705   assert (romTypeValue & 7) == 0
SYS_Reset_88: 005f 0048  ld   $48         706   ld(romTypeValue)                #15 Set ROM type/version and clear channel mask
              0060 c221  st   [$21]       707   st([romType])                   #16
              0061 0000  ld   $00         708   ld(0)                           #17
              0062 c21c  st   [$1c]       709   st([vSP])                       #18 vSP
              0063 1401  ld   $01,y       710   ld(hi('videoTop_v5'),Y)         #19
              0064 caf9  st   [y,$f9]     711   st([Y,lo('videoTop_v5')])       #20 Show all 120 pixel lines
              0065 caf6  st   [y,$f6]     712   st([Y,vIRQ_v5])                 #21 Disable vIRQ dispatch
              0066 caf7  st   [y,$f7]     713   st([Y,vIRQ_v5+1])               #22
              0067 c22c  st   [$2c]       714   st([soundTimer])                #23 soundTimer
                                          715   assert userCode&255 == 0
              0068 c21a  st   [$1a]       716   st([vLR])                       #24 vLR
              0069 0002  ld   $02         717   ld(userCode>>8)                 #25
              006a c21b  st   [$1b]       718   st([vLR+1])                     #26
              006b 00f6  ld   $f6         719   ld('nopixels')                  #27 Video mode 3 (fast)
              006c c20a  st   [$0a]       720   st([videoModeB])                #28
              006d c20b  st   [$0b]       721   st([videoModeC])                #29
              006e c20c  st   [$0c]       722   st([videoModeD])                #30
              006f 00ad  ld   $ad         723   ld('SYS_Exec_88')               #31 SYS_Exec_88
              0070 c222  st   [$22]       724   st([sysFn])                     #32 High byte (remains) 0
              0071 000e  ld   $0e         725   ld('Reset')                     #33 Reset.gt1 from EPROM
              0072 c224  st   [$24]       726   st([sysArgs+0])                 #34
              0073 0015  ld   $15         727   ld(hi('Reset'))                 #35
              0074 c225  st   [$25]       728   st([sysArgs+1])                 #36
              0075 0116  ld   [$16]       729   ld([vPC])                       #37 Force second SYS call
              0076 a002  suba $02         730   suba(2)                         #38
              0077 c216  st   [$16]       731   st([vPC])                       #39
                                          732   # Reset expansion board
              0078 c17f  rand $7f         733   ctrl(0b01111111)                #40 Reset signal (default state | 0x3)
              0079 c17c  rand $7c         734   ctrl(0b01111100)                #41 Default state.
              007a 011d  ld   [$1d]       735   ld([vTmp])                      #42 Always load after ctrl
                                          736   # Return to interpreter
              007b 1403  ld   $03,y       737   ld(hi('REENTER'),Y)             #43
              007c e0cb  jmp  y,$cb       738   jmp(Y,'REENTER')                #44
              007d 00e8  ld   $e8         739   ld(-48/2)                       #45
                                          740
                                          741   #-----------------------------------------------------------------------
                                          742   # Placeholders for future SYS functions. This works as a kind of jump
                                          743   # table. The indirection allows SYS implementations to be moved around
                                          744   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          745   # the function is not present it just acts as a NOP. Of course, when a
                                          746   # SYS function must be patched or extended it needs to have budget for
                                          747   # that in its declared maximum cycle count.
                                          748   #
                                          749   # Technically the same goal can be achieved by starting each function
                                          750   # with 2 nop's, or by overdeclaring their duration in the first place
                                          751   # (a bit is still wise to do). But this can result in fragmentation
                                          752   # of future ROM images. The indirection avoids that.
                                          753   #
                                          754   # An added advantage of having these in ROM page 0 is that it saves one
                                          755   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          756   #-----------------------------------------------------------------------
                                          757
              007e 0200  nop              758   align(0x80, size=0x80)
              007f 0200  nop
                                          759   assert pc() == 0x80
                                          760
              0080 1403  ld   $03,y       761   ld(hi('REENTER'),Y)             #15 slot 0x80
              0081 e0cb  jmp  y,$cb       762   jmp(Y,'REENTER')                #16
              0082 00f6  ld   $f6         763   ld(-20/2)                       #17
