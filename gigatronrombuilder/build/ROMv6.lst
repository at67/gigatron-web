                                          2049  # Instruction XORW: Word logical-XOR with zero page (vAC^=[D]+256*[D+1]), 26 cycles
                                          2050  label('XORW')
XORW:         03fc 1404  ld   $04,y       2051  ld(hi('xorw'),Y)                #10,12
              03fd e09c  jmp  y,$9c       2052  jmp(Y,'xorw')                   #11
              03fe c21d  st   [$1d]       2053  st([vTmp])                      #12
