                                          2717  #-----------------------------------------------------------------------
                                          2718  # Extension SYS_Read3_40
                                          2719  #-----------------------------------------------------------------------
                                          2720
                                          2721  # Read 3 consecutive bytes from ROM
                                          2722  #
                                          2723  # Note: This function a bit obsolete, as it has very limited use. It's
                                          2724  #       effectively an application-specific SYS function for the Pictures
                                          2725  #       application from ROM v1. It requires the ROM data be organized
                                          2726  #       with trampoline3a and trampoline3b fragments, and their address
                                          2727  #       in ROM to be known. Better avoid using this.
                                          2728  #
                                          2729  # Variables:
                                          2730  #       sysArgs[0:2]    Bytes (out)
                                          2731  #       sysArgs[6:7]    ROM pointer (in)
                                          2732
                                          2733  label('SYS_Read3_40')
SYS_Read3_40: 06b9 152b  ld   [$2b],y     2734  ld([sysArgs+7],Y)               #15,32
              06ba e079  jmp  y,$79       2735  jmp(Y,128-7)                    #16 trampoline3a
              06bb 012a  ld   [$2a]       2736  ld([sysArgs+6])                 #17
                                          2737  label('txReturn')
txReturn:     06bc c226  st   [$26]       2738  st([sysArgs+2])                 #34
              06bd 1403  ld   $03,y       2739  ld(hi('REENTER'),Y)             #35
              06be e0cb  jmp  y,$cb       2740  jmp(Y,'REENTER')                #36
              06bf 00ec  ld   $ec         2741  ld(-40/2)                       #37
                                          2742
                                          2743  def trampoline3a():
                                          2744    """Read 3 bytes from ROM page"""
                                          2745    while pc()&255 < 128-7:
                                          2746      nop()
                                          2747    bra(AC)                       #18
                                          2748    C('Trampoline for page $%02x00 reading (entry)' % (pc()>>8))
                                          2749    bra(123)                      #19
                                          2750    st([sysArgs+0])               #21
                                          2751    ld([sysArgs+6])               #22
                                          2752    adda(1)                       #23
                                          2753    bra(AC)                       #24
                                          2754    bra(250)                      #25 trampoline3b
                                          2755    align(1, size=0x80)
                                          2756
                                          2757  def trampoline3b():
                                          2758    """Read 3 bytes from ROM page (continue)"""
                                          2759    while pc()&255 < 256-6:
                                          2760      nop()
                                          2761    st([sysArgs+1])               #27
                                          2762    C('Trampoline for page $%02x00 reading (continue)' % (pc()>>8))
                                          2763    ld([sysArgs+6])               #28
                                          2764    adda(2)                       #29
                                          2765    ld(hi('txReturn'),Y)          #30
                                          2766    bra(AC)                       #31
                                          2767    jmp(Y,'txReturn')             #32
                                          2768    align(1, size=0x100)
                                          2769
