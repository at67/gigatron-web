                                          3905  #-----------------------------------------------------------------------
                                          3906  #       MOS 6502 emulator
                                          3907  #-----------------------------------------------------------------------
                                          3908
                                          3909  # Some quirks:
                                          3910  # - Stack in zero page instead of page 1
                                          3911  # - No interrupts
                                          3912  # - No decimal mode (may never be added). D flag is emulated but ignored.
                                          3913  # - BRK switches back to running 16-bits vCPU
                                          3914  # - Illegal opcodes map to BRK, but can read ghost operands before trapping
                                          3915  # - Illegal opcode $ff won't be trapped and cause havoc instead
                                          3916
                                          3917  # Big things TODO:
                                          3918  # XXX Tuning, put most frequent instructions in the primary page
                                          3919
