                                          2661  #-----------------------------------------------------------------------
                                          2662  # Extension SYS_Read3_40
                                          2663  #-----------------------------------------------------------------------
                                          2664
                                          2665  # Read 3 consecutive bytes from ROM
                                          2666  #
                                          2667  # Note: This function a bit obsolete, as it has very limited use. It's
                                          2668  #       effectively an application-specific SYS function for the Pictures
                                          2669  #       application from ROM v1. It requires the ROM data be organized
                                          2670  #       with trampoline3a and trampoline3b fragments, and their address
                                          2671  #       in ROM to be known. Better avoid using this.
                                          2672  #
                                          2673  # Variables:
                                          2674  #       sysArgs[0:2]    Bytes (out)
                                          2675  #       sysArgs[6:7]    ROM pointer (in)
                                          2676
                                          2677  label('SYS_Read3_40')
SYS_Read3_40: 06b9 152b  ld   [$2b],y     2678  ld([sysArgs+7],Y)               #15,32
              06ba e079  jmp  y,$79       2679  jmp(Y,128-7)                    #16 trampoline3a
              06bb 012a  ld   [$2a]       2680  ld([sysArgs+6])                 #17
                                          2681  label('txReturn')
txReturn:     06bc c226  st   [$26]       2682  st([sysArgs+2])                 #34
              06bd 1403  ld   $03,y       2683  ld(hi('REENTER'),Y)             #35
              06be e0cb  jmp  y,$cb       2684  jmp(Y,'REENTER')                #36
              06bf 00ec  ld   $ec         2685  ld(-40/2)                       #37
                                          2686
                                          2687  def trampoline3a():
                                          2688    """Read 3 bytes from ROM page"""
                                          2689    while pc()&255 < 128-7:
                                          2690      nop()
                                          2691    bra(AC)                       #18
                                          2692    C('Trampoline for page $%02x00 reading (entry)' % (pc()>>8))
                                          2693    bra(123)                      #19
                                          2694    st([sysArgs+0])               #21
                                          2695    ld([sysArgs+6])               #22
                                          2696    adda(1)                       #23
                                          2697    bra(AC)                       #24
                                          2698    bra(250)                      #25 trampoline3b
                                          2699    align(1, size=0x80)
                                          2700
                                          2701  def trampoline3b():
                                          2702    """Read 3 bytes from ROM page (continue)"""
                                          2703    while pc()&255 < 256-6:
                                          2704      nop()
                                          2705    st([sysArgs+1])               #27
                                          2706    C('Trampoline for page $%02x00 reading (continue)' % (pc()>>8))
                                          2707    ld([sysArgs+6])               #28
                                          2708    adda(2)                       #29
                                          2709    ld(hi('txReturn'),Y)          #30
                                          2710    bra(AC)                       #31
                                          2711    jmp(Y,'txReturn')             #32
                                          2712    align(1, size=0x100)
                                          2713
