; Lazy Constants

; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LDI                          0
                                  STW                          _x
                                  STW                          _y                           ; x = 0 : y = x

                                  LDNI                         1
                                  STW                          _curIndex
                                  MOVQW                        _newIndex, 0                 ; curIndex = -1 : newIndex = 0

                                  ANDBI                        miscFlags, 0xfd              ; tscroll off

                                  ANDBI                        miscFlags, 0xf7              ; tclip on

                                  MOVQB                        fgbgColour, 0
                                  MOVQW                        graphicsMode, 2
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, &h00 : mode 2 : cls

                                  MOVQW                        _i, 0                        ; for i = 0 to NUM_DECO - 1

_next_0x0000                      LDARRB                       _i, 0x7fa2
                                  ST                           fgbgColour + 1
                                  LDARRB                       _i, 0x7fa4
                                  ST                           cursorXY
                                  LDARRB                       _i, 0x7fa3
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  LDARRW                       _i, 0x7ff0
                                  PrintAcString                
                                  NewLine                                                   ; set FG_COLOUR, decoColors(i) : at decoX(i), decoY(i) : print decoText$(i)

                                  ForNextIncZero               _i _next_0x0000              ; next i

                                  MOVQW                        _i, 0                        ; for i = 0 to NUM_APPS - 1

_next_0x0001                      LDARRB                       _i, 0x7df4
                                  ST                           fgbgColour + 1
                                  LDARRB                       _i, 0x7eb4
                                  ST                           cursorXY
                                  LDARRB                       _i, 0x7ea8
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  LDARRW                       _i, 0x7ed8
                                  PrintAcString                
                                  NewLine                                                   ; set FG_COLOUR, textColors(i) : at menuX(i), menuY(i) : print menuText$(i)

                                  ForNextInc                   _i _next_0x0001 11           ; next i

                                  MOVQB                        waveType + 1, 3
                                  LDWI                         30112
                                  PlayMusic                                                 ; play music, &h75a0, 3

                                  CALLI                        _resetAudio                  ; gosub resetAudio

                                  CALLI                        _initStars                   ; call initStars

_repeat_0x0002                    LD                           giga_buttonState
                                  STW                          numericLabel
                                  MOVQW                        defaultLabel, 0
                                  GosubNumeric                                              ; gosub get("BUTTON_STATE")

                                  LDW                          _newIndex
                                  XORW                         _curIndex
                                  JEQ                          _endif_0x0003                ; if newIndex <> curIndex

                                  MOVWA                        _curIndex, 0xc4
                                  MOVQW                        0xc6, 0x00
                                  CALLI                        _drawCursor                  ; call drawCursor, curIndex, 0

                                  MOVWA                        _newIndex, 0xc4
                                  MOVQW                        0xc6, 0x01
                                  CALLI                        _drawCursor                  ; call drawCursor, newIndex, 1

                                  MOVWA                        _newIndex, _curIndex         ; curIndex = newIndex

_endif_0x0003                     CALLI                        _updateStars                 ; call updateStars

                                  CALLI                        _repeat_0x0002               ; forever

_initStars                        PUSH                                                      ; proc initStars

                                  MOVQW                        _initStars_i, 0              ; for i=0 to NUM_STARS-1

_next_0x0004                      MOVWA                        _initStars_i, 0xc4
                                  CALLI                        _newStar                     ; call newStar, i

                                  ForNextInc                   _initStars_i _next_0x0004 47 ; next i

                                  Return                                                    ; endproc

_newStar                          PUSH                                                      ; proc newStar, i

                                  STARRI                       _newStar_i, 0x7dc4, 0        ; star(i) = 0

                                  LDI                          0
                                  STARRW                       _newStar_i, 0x7ca0           ; xPos(i) = 0

                                  LDI                          0
                                  STARRW                       _newStar_i, 0x7ba0           ; yPos(i) = 0

_repeat_0x0005                    Rand                         
                                  CALLI                        _page_0x0300
_page_0x0300                      ANDWI                        0x07ff
                                  SUBWI                        1024
                                  STW                          _xv                          ; xv = (rnd(0) AND 2047) - 1024

                                  Rand                         
                                  ANDWI                        0x07ff
                                  SUBWI                        1024
                                  STW                          _yv                          ; yv = (rnd(0) AND 2047) - 1024

                                  LDW                          _xv
                                  ABSW                         
                                  SUBI                         200
                                  TGT                          0xe8
                                  LDW                          _yv
                                  ABSW                         
                                  SUBI                         200
                                  TGT                          giga_vAC
                                  ORW                          0xe8
                                  JumpFalse                    _repeat_0x0005               ; until abs(xv) > 200  OR  abs(yv) > 200

                                  LDW                          _xv
                                  STARRW                       _newStar_i, 0x7aa0
                                  MOVWA                        _xv, _xp                     ; xVel(i) = xv : xp = xv

                                  LDW                          _yv
                                  STARRW                       _newStar_i, 0x79a0
                                  MOVWA                        _yv, _yp                     ; yVel(i) = yv : yp = yv

                                  Return                                                    ; endproc

_updateStars                      PUSH                                                      ; proc updateStars

                                  MOVQW                        _updateStars_i, 0            ; for i=0 to NUM_STARS-1

_next_0x0006                      LDARRW                       _updateStars_i, 0x7ca0
                                  STW                          _xp
                                  LDARRW                       _updateStars_i, 0x7aa0
                                  STW                          _xv                          ; xp = xPos(i) : xv = xVel(i)

                                  LDARRW                       _updateStars_i, 0x7ba0
                                  STW                          _yp
                                  LDARRW                       _updateStars_i, 0x79a0
                                  STW                          _yv                          ; yp = yPos(i) : yv = yVel(i)

                                  ADDBI                        _xp + 1, _updateStars_pxy, 80                                                                                            ; pxy.lo = xp.hi + STARS_ORG_X

                                  ADDBI                        _yp + 1, _updateStars_pxy + 1, 68                                                                                        ; pxy.hi = yp.hi + STARS_ORG_Y

                                  PEEKV                        _updateStars_pxy
                                  ANDI                         0x80
                                  JumpFalse                    _endif_0x0007                ; if (peek(pxy) AND &h80)

                                  LD                           fgbgColour
                                  POKE                         _updateStars_pxy             ; poke pxy, get("BG_COLOUR")

_endif_0x0007                     ADDVW                        _xp, _xv, _xp                ; xp = xp + xv

                                  ADDVW                        _yp, _yv, _yp                ; yp = yp + yv

                                  LDW                          _yp
                                  ABSW                         
                                  SUBIW                        15104
                                  JGE                          _endif_0x0008                ; if abs(yp) > 59*256

                                  MOVWA                        _updateStars_i, 0xc4
                                  CALLI                        _newStar                     ; call newStar, i

_endif_0x0008                     LDW                          _xp
                                  ABSW                         
                                  SUBIW                        20224
                                  JGE                          _endif_0x0009                ; if abs(xp) > 79*256

                                  MOVWA                        _updateStars_i, 0xc4
                                  CALLI                        _newStar                     ; call newStar, i

_endif_0x0009                     LDARRB                       _updateStars_i, 0x7dc4
                                  STW                          _updateStars_ss              ; ss = star(i)

                                  ADDBI                        _xp + 1, _updateStars_pxy, 80                                                                                            ; pxy.lo = xp.hi + STARS_ORG_X

                                  ADDBI                        _yp + 1, _updateStars_pxy + 1, 68                                                                                        ; pxy.hi = yp.hi + STARS_ORG_Y

                                  PEEKV                        _updateStars_pxy
                                  STW                          0xe8
                                  LD                           fgbgColour
                                  XORW                         0xe8
                                  JNE                          _endif_0x000a                ; if peek(pxy) = get("BG_COLOUR")

                                  LDW                          _updateStars_ss
                                  SUBI                         7
                                  JLE                          _if_0x000b
                                  MOVWA                        _updateStars_ss, intSrcA
                                  LDI                          31
                                  IntMin                       
                                  STW                          memIndex0
                                  LDARRB                       memIndex0, 0x7da4
                                  POKE                         _updateStars_pxy             ; if ss > 7 then poke pxy, colour(min(ss, 31))

_if_0x000b                        LDW                          _updateStars_ss
                                  ADDI                         1
                                  STARRB                       _updateStars_i, 0x7dc4       ; star(i) = ss + 1

_endif_0x000a                     LDW                          _xp
                                  STARRW                       _updateStars_i, 0x7ca0
                                  LDW                          _yp
                                  STARRW                       _updateStars_i, 0x7ba0       ; xPos(i) = xp : yPos(i) = yp

                                  ForNextInc                   _updateStars_i _next_0x0006 47                                                                                           ; next i

                                  Return                                                    ; endproc

_execApp                          PUSH                         
                                  ClearVertBlinds                                           ; cls

                                  LD                           _curIndex
                                  ARRW                         0x7ec0
                                  DEEKA                        giga_sysArg0
                                  LDWI                         512
                                  RomExec                                                   ; exec symbols(curIndex.lo), &h0200

                                  CALLI                        _page_0x0400
_page_0x0400                      Return                                                    ; return

_127                              PUSH                         
                                  CALLI                        _beep                        ; gosub beep

                                  CALLI                        _execApp                     ; gosub execApp

                                  Return                                                    ; return

_254                              PUSH                         
                                  INC                          _x                           ; inc x.lo

                                  CMPI                         _x, 2
                                  JNE                          _if_0x000c
                                  MOVQW                        _x, 0                        ; if x = maxX then x = 0

_if_0x000c                        CALLI                        _beep                        ; gosub beep

                                  Return                                                    ; return

_253                              PUSH                         
                                  SUBVI                        _x, _x, 1                    ; x = x - 1

                                  LDW                          _x
                                  JGE                          _if_0x000d
                                  MOVQW                        _x, 1                        ; if x < 0 then x = maxX - 1

_if_0x000d                        CALLI                        _beep                        ; gosub beep

                                  Return                                                    ; return

_251                              PUSH                         
                                  INC                          _y                           ; inc y.lo

                                  CMPI                         _y, 6
                                  JNE                          _if_0x000e
                                  MOVQW                        _y, 0                        ; if y = maxY then y = 0

_if_0x000e                        CALLI                        _beep                        ; gosub beep

                                  Return                                                    ; return

_247                              PUSH                         
                                  SUBVI                        _y, _y, 1                    ; y = y - 1

                                  LDW                          _y
                                  JGE                          _if_0x000f
                                  MOVQW                        _y, 5                        ; if y < 0 then y = maxY - 1

_if_0x000f                        CALLI                        _beep                        ; gosub beep

                                  Return                                                    ; return

_drawCursor                       PUSH                                                      ; proc drawCursor, index, active

                                  LDNI                         1
                                  XORW                         _drawCursor_index
                                  BNE                          _if_0x0010
                                  Return                                                    ; if index &&= -1 then return

_if_0x0010                        LDARRB                       _drawCursor_index, 0x7eb4
                                  STW                          _drawCursor_x                ; x = menuX(index)

                                  LDARRB                       _drawCursor_index, 0x7ea8
                                  STW                          _drawCursor_y                ; y = menuY(index)

                                  LDARRW                       _drawCursor_index, 0x7ed8
                                  PEEK                         
                                  STW                          _drawCursor_w                ; w = peek(addr(menuText$(index)))

                                  LDW                          _drawCursor_w
                                  LSLW                         
                                  LSLW                         
                                  ADDW                         _drawCursor_w
                                  ADDW                         _drawCursor_w
                                  STW                          _drawCursor_w                ; w = (w LSL 2) + w + w

                                  LDW                          _drawCursor_active
                                  JumpFalse                    _else_0x0011                 ; if active

                                  MOVQB                        fgbgColour + 1, 127          ; set FG_COLOUR, &h3F OR &h40

                                  CALLI                        _endif_0x0012                ; else

_else_0x0011                      MOVB                         fgbgColour, fgbgColour + 1   ; set FG_COLOUR, get("BG_COLOUR")

_endif_0x0012                     SUBVI                        _drawCursor_x, drawLine_x1, 1
                                  SUBVI                        _drawCursor_y, drawLine_y1, 1
                                  ADDVW                        _drawCursor_x, _drawCursor_w, drawLine_x2
                                  SUBVI                        _drawCursor_y, drawLine_y2, 1
                                  DrawLine                                                  ; line x-1, y-1, x+w, y-1

                                  SUBVI                        _drawCursor_x, drawLine_x1, 1
                                  ADDVI                        _drawCursor_y, drawLine_y1, 8
                                  ADDVW                        _drawCursor_x, _drawCursor_w, drawLine_x2
                                  ADDVI                        _drawCursor_y, drawLine_y2, 8
                                  DrawLine                                                  ; line x-1, y+8, x+w, y+8

                                  SUBVI                        _drawCursor_x, drawLine_x1, 1
                                  SUBVI                        _drawCursor_y, drawLine_y1, 1
                                  SUBVI                        _drawCursor_x, drawLine_x2, 1
                                  ADDVI                        _drawCursor_y, drawLine_y2, 8
                                  DrawLine                                                  ; line x-1, y-1, x-1, y+8

                                  ADDVW                        _drawCursor_x, _drawCursor_w, drawLine_x1
                                  SUBVI                        _drawCursor_y, drawLine_y1, 1
                                  ADDVW                        _drawCursor_x, _drawCursor_w, drawLine_x2
                                  ADDVI                        _drawCursor_y, drawLine_y2, 8
                                  DrawLine                                                  ; line x+w, y-1, x+w, y+8

                                  Return                                                    ; endproc

_resetAudio                       PUSH                                                      ; asm

                                  LDI                          2                            ; LDI     2
                                  ST                           waveType+1                   ; ST      waveType + 1
                                  CALLI                        resetAudio                   ; CALLI   resetAudio

                                  Return                                                    ; return

_beep                             PUSH                         
                                  LDW                          _y
                                  LSLW                         
                                  ADDW                         _x
                                  STW                          _newIndex                    ; newIndex = y * maxX + x

                                  LDW                          _newIndex
                                  SUBI                         12
                                  JLT                          _if_0x0013
                                  MOVQW                        _newIndex, 11                ; if newIndex >= NUM_APPS then newIndex = NUM_APPS-1

_if_0x0013                        MOVQB                        sndChannel + 1, 1
                                  LDWI                         8200
                                  CALLI                        _page_0x0500
_page_0x0500                      STW                          sndFrequency
                                  SoundOn                                                   ; sound on, 1, 8200

                                  MOVQB                        giga_soundTimer, 2           ; set SOUND_TIMER, 2

                                  MOVQB                        giga_buttonState, 239        ; set BUTTON_STATE, &hEF

                                  Return                                                    ; return

                                  HALT                                                      ; END



