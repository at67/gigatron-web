MISC_ENABLE_SCROLL_BIT            EQU                          0x02
MISC_ON_BOTTOM_ROW_BIT            EQU                          0x04
MISC_DISABLE_CLIP_BIT             EQU                          0x08
MISC_ENABLE_FNT4X6_BIT            EQU                          0x10
MISC_WAIT_VBLANK_MSK              EQU                          0xfe
MISC_ENABLE_SCROLL_MSK            EQU                          0xfd
MISC_ON_BOTTOM_ROW_MSK            EQU                          0xfb
MISC_DISABLE_CLIP_MSK             EQU                          0xf7
MISC_ENABLE_FNT4X6_MSK            EQU                          0xef

; Internal Buffers
regsWorkArea                      EQU                          0x0000
textWorkArea                      EQU                          0x77a0

; Includes
%includePath                      "runtime"
%include                          util.i
%include                          gigatron.i
%include                          macros_ROMv5a.i

; Labels
_entryPoint_                      EQU                          0x0200
_repeat_0x0000                    EQU                          0x0236
_initStars                        EQU                          0x023c
_next_0x0001                      EQU                          0x0241
_newStar                          EQU                          0x0256
_repeat_0x0002                    EQU                          0x027c
_drawStars                        EQU                          0x02e0
_next_0x0003                      EQU                          0x02e5
_endif_0x0004                     EQU                          0x032e
_endif_0x0005                     EQU                          0x0350
_endif_0x0006                     EQU                          0x0366
_endif_0x0007                     EQU                          0x03a7
_page_0x0300                      EQU                          0x0300

; Constants
_NUM_STARS                        EQU                          0x0030
_STARS_ORG_X                      EQU                          0x0050
_STARS_ORG_Y                      EQU                          0x0044

; Global Variables
_xv                               EQU                          0x0030
_yv                               EQU                          0x0032
_xp                               EQU                          0x0034
_yp                               EQU                          0x0036

; Local Variables
_initStars_i                      EQU                          0x00c4
_newStar_i                        EQU                          0x00c4
_drawStars_i                      EQU                          0x00c4
_drawStars_ss                     EQU                          0x00c6
_drawStars_pxy                    EQU                          0x00c8

; Arrays
_xPos                             EQU                          0x7fa0
_xPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_yPos                             EQU                          0x7ea0
_yPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_xVel                             EQU                          0x7da0
_xVel                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_yVel                             EQU                          0x7ca0
_yVel                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_star                             EQU                          0x7bd0
_star                             DB                           0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 
_colour                           EQU                          0x7bb0
_colour                           DB                           0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x95 0x95 0x95 0x95 0x95 0x95 0x95 0x95 0xaa 0xaa 0xaa 0xaa 0xaa 0xaa 0xaa 0xaa 0xbf 0xbf 0xbf 0xbf 0xbf 0xbf 0xbf 

; Strings

; Constant Strings

; Data

; Time

; Define Bytes

; Define Words

; Define Images

; Define Loader Image Chunks

; Define Midis

; Define Blits

; Define Fonts

; Define Sprites

; Define Patterns

; Lookup Tables

; Lazy Constants

; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LD                           miscFlags
                                  ANDI                         0xfd
                                  ST                           miscFlags                    ; tscroll off

                                  LDI                          0
                                  ST                           fgbgColour
                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, 0 : mode 2 : cls

                                  LDWI                         3072
                                  STW                          fgbgColour                   ; set FGBG_COLOUR, &h0C00

                                  CALLI                        _initStars                   ; call initStars

_repeat_0x0000                    CALLI                        _drawStars                   ; call drawStars

                                  CALLI                        _repeat_0x0000               ; forever

_initStars                        PUSH                                                      ; proc initStars

                                  LDI                          0
                                  STW                          _initStars_i                 ; for i=0 to NUM_STARS-1

_next_0x0001                      LDW                          _initStars_i
                                  STW                          0xc4
                                  CALLI                        _newStar                     ; call newStar, i

                                  ForNextFarInc                _initStars_i _next_0x0001 47 ; next i

                                  Return                                                    ; endproc

_newStar                          PUSH                                                      ; proc newStar, i

                                  LDWI                         0x7bd0
                                  ADDW                         _newStar_i
                                  STW                          memAddr
                                  LDI                          0
                                  POKE                         memAddr                      ; star(i) = 0

                                  LDWI                         0x7fa0
                                  ADDW                         _newStar_i
                                  ADDW                         _newStar_i
                                  STW                          memAddr
                                  LDI                          0
                                  DOKE                         memAddr                      ; xPos(i) = 0

                                  LDWI                         0x7ea0
                                  ADDW                         _newStar_i
                                  ADDW                         _newStar_i
                                  STW                          memAddr
                                  LDI                          0
                                  DOKE                         memAddr                      ; yPos(i) = 0

_repeat_0x0002                    Rand                         
                                  STW                          0xe8
                                  LDWI                         0x07ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         -1024
                                  ADDW                         0xe8
                                  STW                          _xv                          ; xv = (rnd(0) AND 2047) - 1024

                                  Rand                         
                                  STW                          0xe8
                                  LDWI                         0x07ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         -1024
                                  ADDW                         0xe8
                                  STW                          _yv                          ; yv = (rnd(0) AND 2047) - 1024

                                  LDW                          _xv
                                  Absolute                     
                                  SUBI                         200
                                  CALLI                        convertGtOp
                                  STW                          0xe8
                                  LDW                          _yv
                                  Absolute                     
                                  SUBI                         200
                                  CALLI                        convertGtOp
                                  ORW                          0xe8
                                  JumpFalse                    _repeat_0x0002 0             ; until abs(xv) > 200  OR  abs(yv) > 200

                                  LDWI                         0x7da0
                                  ADDW                         _newStar_i
                                  ADDW                         _newStar_i
                                  STW                          memAddr
                                  LDW                          _xv
                                  DOKE                         memAddr
                                  STW                          _xp                          ; xVel(i) = xv : xp = xv

                                  LDWI                         0x7ca0
                                  ADDW                         _newStar_i
                                  ADDW                         _newStar_i
                                  STW                          memAddr
                                  LDW                          _yv
                                  DOKE                         memAddr
                                  STW                          _yp                          ; yVel(i) = yv : yp = yv

                                  Return                                                    ; endproc

_drawStars                        PUSH                                                      ; proc drawStars

                                  LDI                          0
                                  STW                          _drawStars_i                 ; for i=0 to NUM_STARS-1

_next_0x0003                      LDWI                         0x7fa0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  DEEK                         
                                  STW                          _xp
                                  LDWI                         0x7da0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  DEEK                         
                                  CALLI                        _page_0x0300
_page_0x0300                      STW                          _xv                          ; xp = xPos(i) : xv = xVel(i)

                                  LDWI                         0x7ea0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  DEEK                         
                                  STW                          _yp
                                  LDWI                         0x7ca0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  DEEK                         
                                  STW                          _yv                          ; yp = yPos(i) : yv = yVel(i)

                                  LD                           _xp + 1
                                  ADDI                         80
                                  ST                           _drawStars_pxy               ; pxy.lo = xp.hi + STARS_ORG_X

                                  LD                           _yp + 1
                                  ADDI                         68
                                  ST                           _drawStars_pxy + 1           ; pxy.hi = yp.hi + STARS_ORG_Y

                                  LDW                          _drawStars_pxy
                                  PEEK                         
                                  ANDI                         0x80
                                  BEQ                          _endif_0x0004                ; if &(peek(pxy) AND &h80)

                                  LDI                          0
                                  POKE                         _drawStars_pxy               ; poke pxy, 0

_endif_0x0004                     LDW                          _xp
                                  ADDW                         _xv
                                  STW                          _xp                          ; xp = xp + xv

                                  LDW                          _yp
                                  ADDW                         _yv
                                  STW                          _yp                          ; yp = yp + yv

                                  LDW                          _yp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         15104
                                  SUBW                         0xe8
                                  BGE                          _endif_0x0005                ; if abs(yp) &&> 59*256

                                  LDW                          _drawStars_i
                                  STW                          0xc4
                                  CALLI                        _newStar                     ; call newStar, i

_endif_0x0005                     LDW                          _xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         20224
                                  SUBW                         0xe8
                                  BGE                          _endif_0x0006                ; if abs(xp) &&> 79*256

                                  LDW                          _drawStars_i
                                  STW                          0xc4
                                  CALLI                        _newStar                     ; call newStar, i

_endif_0x0006                     LDWI                         0x7bd0
                                  ADDW                         _drawStars_i
                                  PEEK                         
                                  STW                          _drawStars_ss                ; ss = star(i)

                                  LD                           _xp + 1
                                  ADDI                         80
                                  ST                           _drawStars_pxy               ; pxy.lo = xp.hi + STARS_ORG_X

                                  LD                           _yp + 1
                                  ADDI                         68
                                  ST                           _drawStars_pxy + 1           ; pxy.hi = yp.hi + STARS_ORG_Y

                                  LDW                          _drawStars_pxy
                                  PEEK                         
                                  CALLI                        convertEqOp
                                  BEQ                          _endif_0x0007                ; if &(peek(pxy) = 0)

                                  LDW                          _drawStars_ss
                                  STW                          intSrcA
                                  LDI                          31
                                  IntMin                       
                                  STW                          memIndex0
                                  LDWI                         0x7bb0
                                  ADDW                         memIndex0
                                  PEEK                         
                                  POKE                         _drawStars_pxy               ; poke pxy, colour(min(ss, 31))

                                  LDW                          _drawStars_ss
                                  ADDI                         1
                                  STW                          memValue
                                  LDWI                         0x7bd0
                                  ADDW                         _drawStars_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  POKE                         memAddr                      ; star(i) = ss + 1

_endif_0x0007                     LDWI                         0x7fa0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  STW                          memAddr
                                  LDW                          _xp
                                  DOKE                         memAddr
                                  LDWI                         0x7ea0
                                  ADDW                         _drawStars_i
                                  ADDW                         _drawStars_i
                                  STW                          memAddr
                                  LDW                          _yp
                                  DOKE                         memAddr                      ; xPos(i) = xp : yPos(i) = yp

                                  ForNextFarInc                _drawStars_i _next_0x0003 47 ; next i

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



