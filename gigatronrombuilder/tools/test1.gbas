_runtimePath_ "runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMv5a

const NUM_FIREWORKS = 60
const FIREWORKS_ORG_X = 80
const FIREWORKS_ORG_Y = 60 + 8
const GRAVITY = 40

dim xPos(NUM_FIREWORKS-1) = 0
dim yPos(NUM_FIREWORKS-1) = 0
dim xVel(NUM_FIREWORKS-1) = 0
dim yVel(NUM_FIREWORKS-1) = 0
dim life%(NUM_FIREWORKS-1) = 0
dim colour%(NUM_FIREWORKS-1) = 0

set FGBG_COLOUR, &h3C11
mode 2 : cls
t = 0

call initFireworks

repeat
    call updateFireworks
forever

proc updateFireworks
    local i, lf, xp, yp, pxy
    
    for i=0 to NUM_FIREWORKS-1
		lf = life(i)
        if lf &> 0
            xp = xPos(i) : xr = xp : xv = xVel(i)
            yp = yPos(i) : yr = yp : yv = yVel(i)
            
            ' Apply physics
            yv = yv + GRAVITY
            xp = xp + xv
            yp = yp + yv

			' If particle goes off top, dont kill
			if yp &&< -59*256
				if yr &&>= -59*256 then gosub clearParticle
				goto nextParticle
			endif

            ' Check if particle goes off screen
            if yp &&> 59*256
				lf = 0
				gosub clearParticle
                goto skipParticle
            endif
            if abs(xp) &&> 79*256
				lf = 0
				gosub clearParticle
                goto skipParticle
            endif
            
            ' Clear old position
			gosub clearParticle
            
            ' Draw new position
            pxy.lo = xp.hi + FIREWORKS_ORG_X
            pxy.hi = yp.hi + FIREWORKS_ORG_Y
            if peek(pxy) &= get("BG_COLOUR")
                poke pxy, colour(i)
            endif

nextParticle:
            ' Age particle
            lf = lf - 1
			if lf &&= 0
			    if &(peek(pxy) AND &h80)
					poke pxy, get("BG_COLOUR")
				endif
			endif

            xPos(i) = xp : yPos(i) = yp
            yVel(i) = yv
        endif
        
skipParticle:
	life(i) = lf
    next i

    inc t.lo
    if t &&> 20
        t = 0
        centerX = (rnd(0) AND 127) - 64
        centerY = (rnd(0) AND 63) - 48
		call createFirework, centerX, centerY
    endif
endproc

clearParticle:
	pxy.lo = xr.hi + FIREWORKS_ORG_X
	pxy.hi = yr.hi + FIREWORKS_ORG_Y
	if &(peek(pxy) AND &h80)
		poke pxy, get("BG_COLOUR")
	endif
return

proc createFirework, centerX, centerY
    local i, c, count
    
    ' Find dead particles and spawn new firework burst    
    count = 0
	c = (rnd(0) AND &h3f) OR &h80
    for i=0 to NUM_FIREWORKS-1
        if life(i) &= 0
            ' Create particle
            xv = (rnd(0) AND 1023) - 512
            yv = (rnd(0) AND 1023) - 768
            
            xPos(i).hi = centerX
            yPos(i).hi = centerY
            xVel(i) = xv
            yVel(i) = yv
            life(i) = 64 + (rnd(0) AND 31)
            colour(i) = c
            
            inc count.lo
            if count &&= 20 then return
        endif
    next i
endproc

proc initFireworks
    local i
    
    ' Initialize all particles as dead
    for i=0 &to NUM_FIREWORKS-1
        life(i) = 0
    next i
endproc