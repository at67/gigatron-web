; Lookup Tables
_lut_numericLabs                  EQU                          0x7fe8
_lut_numericLabs                  DW                           127 0x0000
_lut_numericAddrs                 EQU                          0x7fe6
_lut_numericAddrs                 DW                           0x027e 

; Lazy Constants

; Code
_entryPoint_                      InitialiseOff                                                                         ; INIT

                                  LD                           miscFlags
                                  ANDI                         0xfd
                                  ST                           miscFlags                                                ; tscroll off

                                  LDI                          0
                                  ST                           fgbgColour
                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  LDWI                         giga_vram
                                  STW                          clsAddress
                                  ClearScreen                                                                           ; set BG_COLOUR, 0 : mode 2 : cls

                                  LDWI                         3072
                                  STW                          fgbgColour                                               ; set FGBG_COLOUR, &h0C00

                                  LDI                          18
                                  ST                           cursorXY
                                  LDI                          34
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _apps$_0x7ff7
                                  NewLine                                                                               ; at LIST_X, LIST_Y : print apps$(0)

                                  LDI                          10
                                  STW                          _x
                                  LDI                          34
                                  STW                          _y                                                       ; x = CURS_X : y = CURS_Y

                                  LDI                          0
                                  STW                          _index                                                   ; index = 0

_repeat_0x0000                    LD                           giga_buttonState
                                  STW                          numericLabel
                                  LDI                          0
                                  STW                          defaultLabel
                                  GosubNumeric                                                                          ; gosub get("BUTTON_STATE")

                                  LDI                          63
                                  ST                           fgbgColour + 1                                           ; set FG_COLOUR, &h3F

                                  LDW                          _x
                                  ST                           cursorXY
                                  LDW                          _y
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  LDI                          62
                                  PrintAcChr                                                                            ; at x, y : put 62

                                  CALLI                        _repeat_0x0000                                           ; forever

_execApp                          PUSH                         
                                  LDWI                         giga_vram
                                  STW                          clsAddress
                                  ClearScreen                                                                           ; cls

                                  LDWI                         0x7fec
                                  ADDW                         _index
                                  ADDW                         _index
                                  DEEK                         
                                  STW                          giga_sysArg0
                                  LDWI                         0x0200
                                  RomExec                                                                               ; exec execs(index), &h0200

                                  Return                                                                                ; return

_127                              PUSH                         
                                  CALLI                        _execApp                                                 ; gosub execApp

                                  Return                                                                                ; return

                                  HALT                                                                                  ; END



