convertEqOp                       EQU     0x7ac8
convertLeOp                       EQU     0x7abf
convertLtOp                       EQU     0x7ab6
convertGtOp                       EQU     0x7aad
absolute                          EQU     0x7ba3
rand16bit                         EQU     0x7aa5
scanlineMode                      EQU     0x7ad1
resetVideoFlags                   EQU     0x7da1
initClearFuncs                    EQU     0x7adb
clearVertBlinds                   EQU     0x7ccd
clearCursorRow                    EQU     0x7ca1
printInit                         EQU     0x7bad
printText                         EQU     0x7aea
printChar                         EQU     0x7ea3
printClip                         EQU     0x7bc3
newLineScroll                     EQU     0x7dac
atTextCursor                      EQU     0x7bdb


                    
convertEqOp         BEQ     convertEq_1
                    LDI     0
                    RET
convertEq_1         LDI     1
                    RET


                    
convertLeOp         BLE     convertLe_1
                    LDI     0
                    RET
convertLe_1         LDI     1
                    RET


                    
convertLtOp         BLT     convertLt_1
                    LDI     0
                    RET
convertLt_1         LDI     1
                    RET


                    
convertGtOp         BGT     convertGt_1
                    LDI     0
                    RET
convertGt_1         LDI     1
                    RET



mathX               EQU     register8
mathY               EQU     register9
mathSum             EQU     register12
mathRem             EQU     register12
mathMask            EQU     register13
mathSign            EQU     register14
mathQuot            EQU     register15
mathShift           EQU     register15
mathBase            EQU     register10
mathPow             EQU     register11
mathResult          EQU     register14


absolute            BGE     abs_exit
                    STW     mathX
                    LDI     0
                    SUBW    mathX
abs_exit            RET


rand16bit           LDWI    SYS_Random_34
                    STW     giga_sysFn
                    SYS     34
                    RET



