; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LD                           miscFlags
                                  ANDI                         0xfd
                                  ST                           miscFlags                    ; tscroll off

                                  LDI                          0
                                  ST                           fgbgColour
                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, 0 : mode 2 : cls

                                  LDWI                         3072
                                  STW                          fgbgColour                   ; set FGBG_COLOUR, &h0C00

                                  LDI                          21
                                  ST                           fgbgColour + 1               ; set FG_COLOUR, &h15

                                  LDI                          5
                                  ST                           cursorXY
                                  LDI                          65
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7eef
                                  NewLine                                                   ; at 5, 65 : print "==============="

                                  LDI                          25
                                  ST                           cursorXY
                                  LDI                          75
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fa4
                                  NewLine                                                   ; at 25, 75 : print "=========="

                                  LDI                          0
                                  STW                          _oscillatorCounter           ; oscillatorCounter = 0

                                  LDI                          0
                                  STW                          _spawnX                      ; spawnX = 0

                                  CALLI                        _initSand                    ; call initSand

_repeat_0x0000                    CALLI                        _updateSand                  ; call updateSand

                                  INC                          _oscillatorCounter           ; inc oscillatorCounter.lo

                                  CALLI                        _repeat_0x0000               ; forever

_initSand                         PUSH                                                      ; proc initSand

                                  LDI                          0
                                  STW                          _initSand_i                  ; for i=0 to NUM_SAND_PARTICLES-1

_next_0x0001                      LDW                          _initSand_i
                                  STW                          0xc4
                                  CALLI                        _respawnSandParticle         ; call respawnSandParticle, i

                                  ForNextFarInc                _initSand_i _next_0x0001 79  ; next i

                                  Return                                                    ; endproc

_updateSand                       PUSH                                                      ; proc updateSand

                                  LDW                          _oscillatorCounter
                                  ANDI                         0x01
                                  JumpFalse                    _endif_0x0002 0              ; if oscillatorCounter AND 1

                                  LDW                          _oscillatorCounter
                                  ANDI                         0x40
                                  JumpFalse                    _else_0x0003 3               ; if oscillatorCounter AND 64

                                  LDW                          _spawnX
                                  ADDI                         1
                                  STW                          _spawnX                      ; spawnX = spawnX + 1

                                  LDW                          _spawnX
                                  SUBI                         30
                                  CALLI                        convertGtOp
                                  JumpFalse                    _if_0x0004 2
                                  LDI                          30
                                  STW                          _spawnX                      ; if spawnX > 30 then spawnX = 30

_if_0x0004                        CALLI                        _endif_0x0005                ; else

_else_0x0003                      LDW                          _spawnX
                                  SUBI                         1
                                  STW                          _spawnX                      ; spawnX = spawnX - 1

                                  LDWI                         -30
                                  SUBW                         _spawnX
                                  CALLI                        convertGtOp
                                  JumpFalse                    _if_0x0006 4
                                  LDWI                         -30
                                  STW                          _spawnX                      ; if spawnX < -30 then spawnX = -30

_endif_0x0002                     LDI                          0
                                  STW                          _updateSand_i                ; for i=0 to NUM_SAND_PARTICLES-1

_next_0x0007                      LDWI                         0x0660
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  DEEK                         
                                  STW                          _updateSand_xp               ; xp = xPos(i)

                                  LDWI                         0x05c0
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  DEEK                         
                                  STW                          _updateSand_yp               ; yp = yPos(i)

                                  LDWI                         0x0520
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  DEEK                         
                                  STW                          _updateSand_xv               ; xv = xVel(i)

                                  CALLI                        _page_0x0300
_page_0x0300                      LDWI                         0x045a
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  DEEK                         
                                  STW                          _updateSand_yv               ; yv = yVel(i)

                                  LDWI                         0x7fb0
                                  ADDW                         _updateSand_i
                                  PEEK                         
                                  STW                          _updateSand_col              ; col = color(i)

                                  LD                           _updateSand_xp + 1
                                  ADDI                         80
                                  ST                           _updateSand_rxy              ; rxy.lo = xp.hi + SAND_ORG_X

                                  LD                           _updateSand_yp + 1
                                  ADDI                         68
                                  ST                           _updateSand_rxy + 1          ; rxy.hi = yp.hi + SAND_ORG_Y

                                  LDW                          _updateSand_rxy
                                  PEEK                         
                                  ANDI                         0x80
                                  JumpFalse                    _endif_0x0008 5              ; if peek(rxy) AND &h80

                                  LDI                          0
                                  POKE                         _updateSand_rxy              ; poke rxy, 0

_endif_0x0008                     LDW                          _updateSand_xp
                                  ADDW                         _updateSand_xv
                                  STW                          _updateSand_xp               ; xp = xp + xv

                                  LDW                          _updateSand_yp
                                  ADDW                         _updateSand_yv
                                  STW                          _updateSand_yp               ; yp = yp + yv

                                  LDW                          _updateSand_xv
                                  Absolute                     
                                  SUBI                         32
                                  CALLI                        convertGtOp
                                  JumpFalse                    _endif_0x0009 6              ; if abs(xv) > 32

                                  LDW                          _updateSand_xv
                                  CALLI                        convertGtOp
                                  JumpFalse                    _else_0x000a 8               ; if xv > 0

                                  LDW                          _updateSand_xv
                                  SUBI                         8
                                  STW                          _updateSand_xv               ; xv = xv - 8

                                  CALLI                        _endif_0x000b                ; else

_else_0x000a                      LDW                          _updateSand_xv
                                  ADDI                         8
                                  STW                          _updateSand_xv               ; xv = xv + 8

_endif_0x0009                     LD                           _updateSand_xp + 1
                                  ADDI                         80
                                  ST                           _updateSand_pxy              ; pxy.lo = xp.hi + SAND_ORG_X

                                  LD                           _updateSand_yp + 1
                                  ADDI                         68
                                  ST                           _updateSand_pxy + 1          ; pxy.hi = yp.hi + SAND_ORG_Y

                                  LDW                          _updateSand_pxy
                                  PEEK                         
                                  STW                          _updateSand_pixel            ; pixel = peek(pxy)

                                  LDW                          _updateSand_pixel
                                  CALLI                        convertGtOp
                                  JumpFalse                    _endif_0x000c 9              ; if pixel > 0

                                  LDW                          _updateSand_pixel
                                  ANDI                         0x80
                                  STW                          0xe8
                                  LDWI                         -1
                                  XORW                         0xe8
                                  JumpFalse                    _endif_0x000d 10             ; if NOT (pixel AND &h80)

                                  LDI                          6
                                  POKE                         _updateSand_pxy              ; poke pxy, &h06

                                  LDW                          _updateSand_i
                                  STW                          0xc4
                                  CALLI                        _respawnSandParticle         ; call respawnSandParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x000c                     LDWI                         15104
                                  SUBW                         _updateSand_yp
                                  CALLI                        convertLeOp
                                  JumpFalse                    _endif_0x000e 11             ; if yp >= GROUND_Y*256

                                  LDI                          6
                                  POKE                         _updateSand_pxy              ; poke pxy, &h06

                                  LDW                          _updateSand_i
                                  STW                          0xc4
                                  CALLI                        _respawnSandParticle         ; call respawnSandParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x000e                     LDW                          _updateSand_xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         20224
                                  SUBW                         0xe8
                                  CALLI                        convertLtOp
                                  JumpFalse                    _endif_0x000f 12             ; if abs(xp) > 79*256

                                  LDW                          _updateSand_i
                                  STW                          0xc4
                                  CALLI                        _respawnSandParticle         ; call respawnSandParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x000f                     LDW                          _updateSand_col
                                  CALLI                        convertEqOp
                                  JumpFalse                    _elseif_0x0010 14            ; if col = 0

                                  LDI                          129
                                  POKE                         _updateSand_pxy              ; poke pxy, &h01 OR &h80

                                  CALLI                        _endif_0x0012
_elseif_0x0010                    LDW                          _updateSand_col
                                  XORI                         1
                                  CALLI                        convertEqOp
                                  CALLI                        _page_0x0400
_page_0x0400                      JumpFalse                    _else_0x0011 16              ; elseif col = 1

                                  LDI                          133
                                  POKE                         _updateSand_pxy              ; poke pxy, &h05 OR &h80

                                  CALLI                        _endif_0x0012                ; else

_else_0x0011                      LDI                          134
                                  POKE                         _updateSand_pxy              ; poke pxy, &h06 OR &h80

_endif_0x0012                     LDWI                         0x0660
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  STW                          memAddr
                                  LDW                          _updateSand_xp
                                  DOKE                         memAddr
                                  LDWI                         0x05c0
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  STW                          memAddr
                                  LDW                          _updateSand_yp
                                  DOKE                         memAddr                      ; xPos(i) = xp : yPos(i) = yp

                                  LDWI                         0x0520
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  STW                          memAddr
                                  LDW                          _updateSand_xv
                                  DOKE                         memAddr
                                  LDWI                         0x045a
                                  ADDW                         _updateSand_i
                                  ADDW                         _updateSand_i
                                  STW                          memAddr
                                  LDW                          _updateSand_yv
                                  DOKE                         memAddr                      ; xVel(i) = xv : yVel(i) = yv

_nextParticle                     ForNextFarInc                _updateSand_i _next_0x0007 79                                                                                            ; next i

                                  Return                                                    ; endproc

_respawnSandParticle              PUSH                                                      ; proc respawnSandParticle, i

                                  Rand                         
                                  CALLI                        _page_0x0500
_page_0x0500                      ANDI                         0x07
                                  SUBI                         4
                                  ADDW                         _spawnX
                                  STW                          memValue
                                  LDW                          _respawnSandParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x0660
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; xPos(i).hi = spawnX + ((rnd(0) AND 7) - 4)

                                  CALLI                        _page_0x08a0
_page_0x08a0                      LDWI                         -59
                                  STW                          memValue
                                  LDW                          _respawnSandParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x05c0
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; yPos(i).hi = SPAWN_Y

                                  LDWI                         0x05c0
                                  ADDW                         _respawnSandParticle_i
                                  ADDW                         _respawnSandParticle_i
                                  STW                          memAddr
                                  LDI                          0
                                  POKE                         memAddr                      ; yPos(i).lo = 0

                                  Rand                         
                                  ANDI                         0x3f
                                  SUBI                         32
                                  STW                          memValue
                                  LDWI                         0x0520
                                  ADDW                         _respawnSandParticle_i
                                  ADDW                         _respawnSandParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; xVel(i) = (rnd(0) AND 63) - 32

                                  Rand                         
                                  ANDI                         0x7f
                                  STW                          0xe8
                                  LDWI                         300
                                  ADDW                         0xe8
                                  STW                          memValue
                                  LDWI                         0x045a
                                  ADDW                         _respawnSandParticle_i
                                  ADDW                         _respawnSandParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; yVel(i) = (rnd(0) AND 127) + 300

                                  Rand                         
                                  ANDI                         0x02
                                  STW                          memValue
                                  CALLI                        _page_0x09a0
_page_0x09a0                      LDWI                         0x7fb0
                                  ADDW                         _respawnSandParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  POKE                         memAddr                      ; color(i) = rnd(0) AND 2

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



