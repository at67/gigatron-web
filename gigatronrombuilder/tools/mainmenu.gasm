; Lazy Constants

; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  ANDBI                        miscFlags, 0xfd              ; tscroll off

                                  MOVQB                        fgbgColour, 0
                                  MOVQW                        graphicsMode, 2
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, 0 : mode 2 : cls

                                  LDWI                         3072
                                  STW                          fgbgColour                   ; set FGBG_COLOUR, &h0C00

                                  MOVQW                        _y, 34                       ; y = LIST_Y

                                  MOVQW                        _i, 0                        ; for i=0 to 4

_next_0x0000                      LDW                          _i
                                  SUBI                         12
                                  JGE                          _if_0x0001
                                  MOVQB                        cursorXY, 10
                                  MOVB                         _y, cursorXY + 1
                                  AtTextCursor                 
                                  LDARRW                       _i, 0x7de8
                                  STW                          textStr
                                  MOVQW                        textLen, 11
                                  PrintAcLeft                  
                                  NewLine                                                   ; if i < NUM_APPS   then at LIST_X0, y : print left$(apps$(i), 11)

_if_0x0001                        LDW                          _i
                                  SUBI                         7
                                  JGE                          _if_0x0002
                                  MOVQB                        cursorXY, 88
                                  MOVB                         _y, cursorXY + 1
                                  AtTextCursor                 
                                  LDW                          _i
                                  ADDI                         5
                                  ARRW                         0x7de8
                                  DEEKA                        textStr
                                  MOVQW                        textLen, 11
                                  PrintAcLeft                  
                                  NewLine                                                   ; if i < NUM_APPS-5 then at LIST_X1, y : print left$(apps$(i+5), 11)

_if_0x0002                        ADDVI                        _y, _y, 9                    ; y = y + LIST_DY

                                  ForNextInc                   _i _next_0x0000 4            ; next i

                                  MOVQW                        _x, 2
                                  MOVQW                        _y, 34                       ; x = CURS_X : y = CURS_Y

                                  MOVQW                        _index, 0                    ; index = 0

                                  MOVQB                        waveType + 1, 3
                                  LDWI                         30112
                                  PlayMusic                                                 ; play music, &h75a0, 3

                                  CALLI                        _resetAudio                  ; gosub resetAudio

                                  CALLI                        _initSnow                    ; call initSnow

_repeat_0x0003                    LD                           giga_buttonState
                                  STW                          numericLabel
                                  MOVQW                        defaultLabel, 0
                                  GosubNumeric                                              ; gosub get("BUTTON_STATE")

                                  MOVQB                        fgbgColour + 1, 63           ; set FG_COLOUR, &h3F

                                  PACKVW                       _x, _y, cursorXY
                                  AtTextCursor                 
                                  LDI                          62
                                  PrintAcChr                                                ; at x, y : put 62

                                  CALLI                        _updateSnow                  ; call updateSnow

                                  CALLI                        _repeat_0x0003               ; forever

_execApp                          PUSH                         
                                  ClearVertBlinds                                           ; cls

                                  LDARRW                       _index, 0x7dd0
                                  STW                          giga_sysArg0
                                  LDWI                         512
                                  RomExec                                                   ; exec execs(index), &h0200

                                  Return                                                    ; return

_127                              PUSH                         
                                  CALLI                        _beep                        ; gosub beep

                                  CALLI                        _execApp                     ; gosub execApp

                                  Return                                                    ; return

_254                              PUSH                         
                                  PACKVW                       _x, _y, cursorXY
                                  AtTextCursor                 
                                  LDI                          32
                                  PrintAcChr                                                ; at x, y : put 32

                                  CMPI                         _x, 80
                                  JNE                          _if_0x0004
                                  Return                                                    ; if x = (LIST_X1 - CURS_DX) then return

_if_0x0004                        MOVQW                        _x, 80                       ; x = (LIST_X1 - CURS_DX)

                                  CALLI                        _beep                        ; gosub beep

                                  CALLI                        _page_0x0300
_page_0x0300                      ADDVI                        _index, _index, 5            ; index = index + 5

                                  Return                                                    ; return

_253                              PUSH                         
                                  PACKVW                       _x, _y, cursorXY
                                  AtTextCursor                 
                                  LDI                          32
                                  PrintAcChr                                                ; at x, y : put 32

                                  CMPI                         _x, 2
                                  JNE                          _if_0x0005
                                  Return                                                    ; if x = (LIST_X0 - CURS_DX) then return

_if_0x0005                        MOVQW                        _x, 2                        ; x = (LIST_X0 - CURS_DX)

                                  CALLI                        _beep                        ; gosub beep

                                  SUBVI                        _index, _index, 5            ; index = index - 5

                                  Return                                                    ; return

_251                              PUSH                         
                                  PACKVW                       _x, _y, cursorXY
                                  AtTextCursor                 
                                  LDI                          32
                                  PrintAcChr                                                ; at x, y : put 32

                                  ADDVI                        _y, _y, 9                    ; y = y + LIST_DY

                                  LDW                          _y
                                  SUBI                         70
                                  JLE                          _endif_0x0006                ; if y > (LIST_Y + 4*LIST_DY)

                                  MOVQW                        _y, 70                       ; y = (LIST_Y + 4*LIST_DY)

                                  Return                                                    ; return

_endif_0x0006                     CALLI                        _beep                        ; gosub beep

                                  ADDVI                        _index, _index, 1            ; index = index + 1

                                  CMPI                         _x, 2
                                  TEQ                          0xe8
                                  LDW                          _index
                                  SUBI                         4
                                  TGT                          giga_vAC
                                  ANDW                         0xe8
                                  JumpFalse                    _if_0x0007
                                  MOVQW                        _index, 4                    ; if (x = LIST_X0 - CURS_DX) AND index > 4 then index = 4

_if_0x0007                        CMPI                         _x, 80
                                  TEQ                          0xe8
                                  LDW                          _index
                                  SUBI                         9
                                  TGT                          giga_vAC
                                  ANDW                         0xe8
                                  JumpFalse                    _if_0x0008
                                  MOVQW                        _index, 9                    ; if (x = LIST_X1 - CURS_DX) AND index > 9 then index = 9

_if_0x0008                        Return                                                    ; return

_247                              PUSH                         
                                  PACKVW                       _x, _y, cursorXY
                                  AtTextCursor                 
                                  LDI                          32
                                  PrintAcChr                                                ; at x, y : put 32

                                  SUBVI                        _y, _y, 9                    ; y = y - LIST_DY

                                  LDW                          _y
                                  SUBI                         34
                                  JGE                          _endif_0x0009                ; if y < LIST_Y

                                  MOVQW                        _y, 34                       ; y = LIST_Y

                                  Return                                                    ; return

_endif_0x0009                     CALLI                        _beep                        ; gosub beep

                                  SUBVI                        _index, _index, 1            ; index = index - 1

                                  CMPI                         _x, 2
                                  TEQ                          0xe8
                                  LDW                          _index
                                  TLT                          giga_vAC
                                  ANDW                         0xe8
                                  JumpFalse                    _if_0x000a
                                  MOVQW                        _index, 0                    ; if (x = LIST_X0 - CURS_DX) AND index < 0 then index = 0

_if_0x000a                        CMPI                         _x, 80
                                  TEQ                          0xe8
                                  LDW                          _index
                                  SUBI                         5
                                  TLT                          giga_vAC
                                  ANDW                         0xe8
                                  JumpFalse                    _if_0x000b
                                  MOVQW                        _index, 5                    ; if (x = LIST_X1 - CURS_DX) AND index < 5 then index = 5

_if_0x000b                        Return                                                    ; return

_resetAudio                       PUSH                                                      ; asm

                                  LDI                          2                            ; LDI     2
                                  ST                           waveType+1                   ; ST      waveType + 1
                                  CALLI                        resetAudio                   ; CALLI   resetAudio

                                  Return                                                    ; return

_beep                             PUSH                         
                                  MOVQB                        sndChannel + 1, 1
                                  LDWI                         8200
                                  STW                          sndFrequency
                                  SoundOn                                                   ; sound on, 1, 8200

                                  MOVQB                        giga_soundTimer, 2           ; set SOUND_TIMER, 2

                                  MOVQB                        giga_buttonState, 239        ; set BUTTON_STATE, &hEF

                                  Return                                                    ; return

_initSnow                         PUSH                                                      ; proc initSnow

                                  LDNI                         1
                                  STW                          _snowTimer                   ; snowTimer = -1

                                  MOVQW                        _initSnow_i, 0               ; for i=0 to NUM_SNOW_PARTICLES-1

_next_0x000c                      MOVWA                        _initSnow_i, 0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  ForNextInc                   _initSnow_i _next_0x000c 79  ; next i

                                  Return                                                    ; endproc

_updateSnow                       PUSH                                                      ; proc updateSnow

                                  MOVQW                        _updateSnow_i, 0             ; for i=0 to NUM_SNOW_PARTICLES-1

                                  CALLI                        _next_0x000d
_next_0x000d                      LDARRW                       _updateSnow_i, 0x0660
                                  STW                          _updateSnow_xp               ; xp = xPos(i)

                                  LDARRW                       _updateSnow_i, 0x05c0
                                  STW                          _updateSnow_yp               ; yp = yPos(i)

                                  LDARRW                       _updateSnow_i, 0x0520
                                  STW                          _updateSnow_yv               ; yv = yVel(i)

                                  ADDBI                        _updateSnow_xp + 1, _rxy, 80 ; rxy.lo = xp.hi + SNOW_ORG_X

                                  ADDBI                        _updateSnow_yp + 1, _rxy + 1, 68                                                                                         ; rxy.hi = yp.hi + SNOW_ORG_Y

                                  PEEKV                        _rxy
                                  ANDI                         0x80
                                  BEQ                          _endif_0x000e                ; if &(peek(rxy) AND &h80)

                                  LDW                          _rxy
                                  POKEI                        0                            ; poke rxy, 0

_endif_0x000e                     ADDVW                        _updateSnow_yp, _updateSnow_yv, _updateSnow_yp                                                                           ; yp = yp + yv

                                  LDWI                         15104
                                  SUBW                         _updateSnow_yp
                                  JumpLT                       _endif_0x000f                ; if yp &> 59*256

                                  CMPI                         _rxy + 1, 127
                                  BGE                          _if_0x0010
                                  LDW                          _rxy
                                  POKEI                        63                           ; if rxy.hi &&< 127 then poke rxy, &h3F

_if_0x0010                        MOVWA                        _updateSnow_i, 0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x000f                     ADDBI                        _updateSnow_yp + 1, _updateSnow_pxy + 1, 68                                                                              ; pxy.hi = yp.hi + SNOW_ORG_Y

                                  LD                           _updateSnow_pxy + 1
                                  SUBBA                        _rxy + 1
                                  JumpGT                       _endif_0x0011                ; if pxy.hi &> rxy.hi

                                  ANDBK                        _rxy + 1, 0x07
                                  ARRW                         0x7dc0
                                  DEEK                         
                                  ADDBA                        _updateSnow_xp + 1
                                  ST                           _updateSnow_xp + 1           ; xp.hi = xp.hi + jitterOffset(rxy.hi AND 7)

_endif_0x0011                     ADDBI                        _updateSnow_xp + 1, _updateSnow_pxy, 80                                                                                  ; pxy.lo = xp.hi + SNOW_ORG_X

                                  PEEKV                        _updateSnow_pxy
                                  STW                          _pixel                       ; pixel = peek(pxy)

                                  LDW                          _pixel
                                  JumpFalse                    _endif_0x0012                ; if (pixel)

                                  LDW                          _pixel
                                  NOTW                         giga_vAC
                                  ANDI                         0x80
                                  JumpFalse                    _endif_0x0013                ; if (NOT pixel AND &h80)

                                  LDW                          _rxy
                                  ADDWI                        256
                                  PEEK                         
                                  BEQ                          _else_0x0014                 ; if &(peek(rxy + &h0100))

                                  LDW                          _rxy
                                  POKEI                        63                           ; poke rxy, &h3F

                                  MOVWA                        _updateSnow_i, 0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

                                  CALLI                        _endif_0x0015                ; else

_else_0x0014                      ANDBK                        _rxy + 1, 0x07
                                  ARRW                         0x7dc0
                                  DEEKA                        0xea
                                  LD                           _updateSnow_xp + 1
                                  SUBW                         0xea
                                  ST                           _updateSnow_xp + 1           ; xp.hi = xp.hi - jitterOffset(rxy.hi AND 7)

                                  ADDBI                        _updateSnow_xp + 1, _updateSnow_pxy, 80                                                                                  ; pxy.lo = xp.hi + SNOW_ORG_X

_endif_0x0012                     LDW                          _updateSnow_xp
                                  ABSW                         
                                  SUBIW                        19968
                                  BGE                          _endif_0x0016                ; if abs(xp) &&> 78*256

                                  MOVWA                        _updateSnow_i, 0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0016                     LDARRB                       _updateSnow_i, 0x7cb0
                                  POKE                         _updateSnow_pxy              ; poke pxy, colour(i)

                                  LDW                          _updateSnow_xp
                                  STARRW                       _updateSnow_i, 0x0660
                                  LDW                          _updateSnow_yp
                                  STARRW                       _updateSnow_i, 0x05c0        ; xPos(i) = xp : yPos(i) = yp

                                  LDW                          _updateSnow_yv
                                  STARRW                       _updateSnow_i, 0x0520        ; yVel(i) = yv

_nextParticle                     ForNextInc                   _updateSnow_i _next_0x000d 79                                                                                            ; next i

                                  ADDVI                        _snowTimer, _snowTimer, 1    ; snowTimer = snowTimer + 1

                                  Return                                                    ; endproc

_respawnSnowParticle              PUSH                                                      ; proc respawnSnowParticle, i

                                  LDI                          0x90
                                  RandFastMod                  
                                  SUBI                         72
                                  STW                          memValue
                                  ARRVW                        _respawnSnowParticle_i, 0x0660
                                  ADDI                         1
                                  POKEA                        memValue                     ; xPos(i).hi = rnd(144) - 72

                                  LDNI                         1
                                  XORW                         _snowTimer
                                  JNE                          _else_0x0017                 ; if snowTimer = -1

                                  CALLI                        _page_0x0500
_page_0x0500                      LDI                          0x14
                                  RandFastMod                  
                                  NEGW                         giga_vAC
                                  SUBI                         39
                                  ST                           _respawnSnowParticle_y + 1   ; y.hi = -rnd(20) - 39

                                  CALLI                        _endif_0x0018                ; else

_else_0x0017                      LDNI                         59
                                  ST                           _respawnSnowParticle_y + 1   ; y.hi = -59

_endif_0x0018                     LDW                          _respawnSnowParticle_y
                                  STARRW                       _respawnSnowParticle_i, 0x05c0                                                                                           ; yPos(i) = y

                                  Rand                         
                                  CALLI                        _page_0x08a0
_page_0x08a0                      ANDI                         0x7f
                                  ADDI                         128
                                  STARRW                       _respawnSnowParticle_i, 0x0520                                                                                           ; yVel(i) = (rnd(0) AND 127) + 128

                                  Rand                         
                                  ANDI                         0x03
                                  STW                          memIndex0
                                  LDARRB                       memIndex0, 0x7fa5
                                  STARRB                       _respawnSnowParticle_i, 0x7cb0                                                                                           ; colour(i) = snowColour(rnd(0) AND 3)

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



