; Lazy Constants

; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LD                           miscFlags
                                  ANDI                         0xfd
                                  ST                           miscFlags                    ; tscroll off

                                  LDI                          17
                                  ST                           fgbgColour
                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, &h11 : mode 2 : cls

                                  CALLI                        _initFire                    ; call initFire

_repeat_0x0000                    CALLI                        _updateFire                  ; call updateFire

                                  CALLI                        _repeat_0x0000               ; forever

_initFire                         PUSH                                                      ; proc initFire

                                  LDI                          0
                                  STW                          _initFire_i                  ; for i=0 to NUM_FIRE_PARTICLES-1

_next_0x0001                      LDW                          _initFire_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  ForNextFarInc                _initFire_i _next_0x0001 63  ; next i

                                  Return                                                    ; endproc

_respawnParticle                  PUSH                                                      ; proc respawnParticle, i

                                  Rand                         
                                  ANDI                         0x3f
                                  SUBI                         32
                                  STW                          memValue
                                  LDW                          _respawnParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x0680
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; xPos(i).hi = (rnd(0) AND 63) - 32

                                  LDI                          59
                                  STW                          memValue
                                  LDW                          _respawnParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x0600
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; yPos(i).hi = 59

                                  LDWI                         0x0600
                                  ADDW                         _respawnParticle_i
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDI                          0
                                  POKE                         memAddr                      ; yPos(i).lo = 0

                                  Rand                         
                                  STW                          0xe8
                                  LDWI                         0x01ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         -256
                                  ADDW                         0xe8
                                  STW                          memValue
                                  LDWI                         0x0580
                                  ADDW                         _respawnParticle_i
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; xVel(i) = (rnd(0) AND 511) - 256

                                  Rand                         
                                  STW                          0xe8
                                  LDWI                         0x01ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         256
                                  ADDW                         0xe8
                                  STW                          0xe8
                                  LDI                          0
                                  SUBW                         0xe8
                                  STW                          memValue
                                  LDWI                         0x0500
                                  ADDW                         _respawnParticle_i
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; yVel(i) = -((rnd(0) AND 511) + 256)

                                  Rand                         
                                  ANDI                         0x1f
                                  ADDI                         40
                                  STW                          memValue
                                  LDWI                         0x7fc0
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  POKE                         memAddr                      ; life(i) = (rnd(0) AND 31) + 40

                                  Return                                                    ; endproc

_updateFire                       PUSH                                                      ; proc updateFire

                                  LDI                          0
                                  STW                          _updateFire_i                ; for i=0 to NUM_FIRE_PARTICLES-1

_next_0x0002                      LDWI                         0x7fc0
                                  CALLI                        _page_0x0300
_page_0x0300                      ADDW                         _updateFire_i
                                  PEEK                         
                                  STW                          _updateFire_lf               ; lf = life(i)

                                  LDW                          _updateFire_lf
                                  CALLI                        convertGtOp
                                  JumpFalse                    _endif_0x0003 0              ; if lf > 0

                                  LDWI                         0x0680
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  DEEK                         
                                  STW                          _updateFire_xp               ; xp = xPos(i)

                                  LDWI                         0x0600
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  DEEK                         
                                  STW                          _updateFire_yp               ; yp = yPos(i)

                                  LDWI                         0x0500
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  DEEK                         
                                  STW                          _updateFire_yv               ; yv = yVel(i)

                                  LD                           _updateFire_xp + 1
                                  ADDI                         80
                                  ST                           _updateFire_pxy              ; pxy.lo = xp.hi + FIRE_ORG_X

                                  LD                           _updateFire_yp + 1
                                  ADDI                         68
                                  ST                           _updateFire_pxy + 1          ; pxy.hi = yp.hi + FIRE_ORG_Y

                                  LDW                          _updateFire_pxy
                                  PEEK                         
                                  ANDI                         0x80
                                  JumpFalse                    _endif_0x0004 1              ; if peek(pxy) AND &h80

                                  LD                           fgbgColour
                                  POKE                         _updateFire_pxy              ; poke pxy, get("BG_COLOUR")

_endif_0x0004                     LDWI                         0x0580
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  DEEK                         
                                  ADDW                         _updateFire_xp
                                  STW                          _updateFire_xp               ; xp = xp + xVel(i)

                                  LDW                          _updateFire_yp
                                  ADDW                         _updateFire_yv
                                  STW                          _updateFire_yp               ; yp = yp + yv

                                  LDW                          _updateFire_yv
                                  ADDI                         8
                                  STW                          _updateFire_yv               ; yv = yv + 8

                                  LDW                          _updateFire_lf
                                  SUBI                         1
                                  STW                          _updateFire_lf               ; lf = lf - 1

                                  LDW                          _updateFire_lf
                                  CALLI                        convertEqOp
                                  JumpFalse                    _endif_0x0005 2              ; if lf = 0

                                  LDW                          _updateFire_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0005                     LDW                          _updateFire_yp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         15104
                                  SUBW                         0xe8
                                  CALLI                        convertLtOp
                                  JumpFalse                    _endif_0x0006 3              ; if abs(yp) > 59*256

                                  LDW                          _updateFire_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0006                     LDW                          _updateFire_xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         20224
                                  SUBW                         0xe8
                                  CALLI                        convertLtOp
                                  JumpFalse                    _endif_0x0007 4              ; if abs(xp) > 79*256

                                  LDW                          _updateFire_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0007                     LD                           _updateFire_xp + 1
                                  ADDI                         80
                                  ST                           _updateFire_pxy              ; pxy.lo = xp.hi + FIRE_ORG_X

                                  LD                           _updateFire_yp + 1
                                  ADDI                         68
                                  ST                           _updateFire_pxy + 1          ; pxy.hi = yp.hi + FIRE_ORG_Y

                                  LDW                          _updateFire_pxy
                                  PEEK                         
                                  STW                          0xe8
                                  LD                           fgbgColour
                                  XORW                         0xe8
                                  CALLI                        convertEqOp
                                  JumpFalse                    _endif_0x0008 5              ; if peek(pxy) = get("BG_COLOUR")

                                  LDW                          _updateFire_lf
                                  ANDI                         0x3f
                                  STW                          memIndex0
                                  LDWI                         0x7ec0
                                  ADDW                         memIndex0
                                  PEEK                         
                                  POKE                         _updateFire_pxy              ; poke pxy, colour(lf AND 63)

_endif_0x0008                     LDWI                         0x0680
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  STW                          memAddr
                                  LDW                          _updateFire_xp
                                  DOKE                         memAddr
                                  LDWI                         0x0600
                                  CALLI                        _page_0x0400
_page_0x0400                      ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  STW                          memAddr
                                  LDW                          _updateFire_yp
                                  DOKE                         memAddr                      ; xPos(i) = xp : yPos(i) = yp

                                  LDWI                         0x0500
                                  ADDW                         _updateFire_i
                                  ADDW                         _updateFire_i
                                  STW                          memAddr
                                  LDW                          _updateFire_yv
                                  DOKE                         memAddr                      ; yVel(i) = yv

                                  LDWI                         0x7fc0
                                  ADDW                         _updateFire_i
                                  STW                          memAddr
                                  LDW                          _updateFire_lf
                                  POKE                         memAddr                      ; life(i) = lf

_nextParticle                     ForNextFarInc                _updateFire_i _next_0x0002 63                                                                                            ; next i

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



