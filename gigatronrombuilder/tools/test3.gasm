_startAddress_                    EQU                          0x0200

; Internal Variables
serialRawPrev                     EQU                          0x0081
frameCountPrev                    EQU                          0x00d6
register0                         EQU                          0x0082
register1                         EQU                          register0 + 0x02
register2                         EQU                          register0 + 0x04
register3                         EQU                          register0 + 0x06
register4                         EQU                          register0 + 0x08
register5                         EQU                          register0 + 0x0A
register6                         EQU                          register0 + 0x0C
register7                         EQU                          register0 + 0x0E
register8                         EQU                          register0 + 0x10
register9                         EQU                          register0 + 0x12
register10                        EQU                          register0 + 0x14
register11                        EQU                          register0 + 0x16
register12                        EQU                          register0 + 0x18
register13                        EQU                          register0 + 0x1A
register14                        EQU                          register0 + 0x1C
register15                        EQU                          register0 + 0x1E
fgbgColour                        EQU                          register0 + 0x20
cursorXY                          EQU                          register0 + 0x22
midiStream                        EQU                          register0 + 0x24
midiDelay                         EQU                          register0 + 0x26
miscFlags                         EQU                          register0 + 0x28
register16                        EQU                          register0 + 0x2A
timerTick                         EQU                          register0 + 0x2C
timerJiff                         EQU                          register0 + 0x2E

; Internal Constants
MISC_WAIT_VBLANK_BIT              EQU                          0x01
MISC_ENABLE_SCROLL_BIT            EQU                          0x02
MISC_ON_BOTTOM_ROW_BIT            EQU                          0x04
MISC_DISABLE_CLIP_BIT             EQU                          0x08
MISC_ENABLE_FNT4X6_BIT            EQU                          0x10
MISC_WAIT_VBLANK_MSK              EQU                          0xfe
MISC_ENABLE_SCROLL_MSK            EQU                          0xfd
MISC_ON_BOTTOM_ROW_MSK            EQU                          0xfb
MISC_DISABLE_CLIP_MSK             EQU                          0xf7
MISC_ENABLE_FNT4X6_MSK            EQU                          0xef

; Internal Buffers
regsWorkArea                      EQU                          0x0000
textWorkArea                      EQU                          0x7da0

; Includes
%includePath                      "runtime"
%include                          util.i
%include                          gigatron.i
%include                          macros_ROMv5a.i

; Labels
_entryPoint_                      EQU                          0x0200
_nextParticle                     EQU                          0x031d
_skipParticle                     EQU                          0x0351
_clearParticle                    EQU                          0x035f
_repeat_0x0000                    EQU                          0x0234
_updateFountain                   EQU                          0x023a
_next_0x0001                      EQU                          0x023f
_if_0x0004                        EQU                          0x02a3
_endif_0x0003                     EQU                          0x02a6
_endif_0x0005                     EQU                          0x02bb
_endif_0x0006                     EQU                          0x02d7
_if_0x0008                        EQU                          0x0315
_endif_0x0007                     EQU                          0x031d
_endif_0x0002                     EQU                          0x0351
_endif_0x0009                     EQU                          0x0378
_respawnParticle                  EQU                          0x037a
_initFountain                     EQU                          0x0406
_next_0x000a                      EQU                          0x0413
_page_0x0300                      EQU                          0x0300
_page_0x0400                      EQU                          0x0400

; Constants
_NUM_PARTICLES                    EQU                          0x0028
_FOUNTAIN_ORG_X                   EQU                          0x0050
_FOUNTAIN_ORG_Y                   EQU                          0x0044
_GRAVITY                          EQU                          0x0040
_SPAWN_Y                          EQU                          0x003b

; Global Variables
_xr                               EQU                          0x0030
_xv                               EQU                          0x0032
_yr                               EQU                          0x0034
_yv                               EQU                          0x0036
_pxy                              EQU                          0x0038
_lf                               EQU                          0x003a

; Local Variables
_updateFountain_i                 EQU                          0x00c4
_updateFountain_xp                EQU                          0x00c6
_updateFountain_yp                EQU                          0x00c8
_updateFountain_life              EQU                          0x00ca
_respawnParticle_i                EQU                          0x00c4
_initFountain_i                   EQU                          0x00c4

; Arrays
_xPos                             EQU                          0x7fb0
_xPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_yPos                             EQU                          0x7cb0
_yPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_xVel                             EQU                          0x7bb0
_xVel                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_yVel                             EQU                          0x7ab0
_yVel                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_age                              EQU                          0x79d8
_age                              DB                           0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 
_colour                           EQU                          0x79b8
_colour                           DB                           0xb0 0xb0 0xb0 0xb0 0xb0 0xb0 0xb0 0xb0 0xb0 0xb0 0xb5 0xb5 0xb5 0xb5 0xb5 0xb5 0xb5 0xb5 0xb5 0xb5 0xba 0xba 0xba 0xba 0xba 0xba 0xba 0xba 0xba 0xba 0xbf 0xbf 

; Strings

; Constant Strings

; Data

; Time

; Define Bytes

; Define Words

; Define Images

; Define Loader Image Chunks

; Define Midis

; Define Blits

; Define Fonts

; Define Sprites

; Define Patterns

; Lookup Tables

; Lazy Constants

; Code
_entryPoint_                      LDI                          0x40
                                  STW                          romUser
                                  RomCheck                     
                                  InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LDI                          17
                                  ST                           fgbgColour                   ; set BG_COLOUR, &h11

                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; mode 2 : cls

                                  CALLI                        _initFountain                ; call initFountain

_repeat_0x0000                    CALLI                        _updateFountain              ; call updateFountain

                                  CALLI                        _repeat_0x0000               ; forever

_updateFountain                   PUSH                                                      ; proc updateFountain

                                  LDI                          0
                                  STW                          _updateFountain_i            ; for i=0 to NUM_PARTICLES-1

_next_0x0001                      LDWI                         0x79d8
                                  ADDW                         _updateFountain_i
                                  PEEK                         
                                  STW                          _updateFountain_life         ; life = age(i)

                                  LDW                          _updateFountain_life
                                  CALLI                        convertGtOp
                                  JumpFalse                    _endif_0x0002 0              ; if life > 0

                                  LDWI                         0x7fb0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  DEEK                         
                                  STW                          _updateFountain_xp
                                  STW                          _xr
                                  LDWI                         0x7bb0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  DEEK                         
                                  STW                          _xv                          ; xp = xPos(i) : xr = xp : xv = xVel(i)

                                  LDWI                         0x7cb0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  DEEK                         
                                  STW                          _updateFountain_yp
                                  STW                          _yr
                                  LDWI                         0x7ab0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  DEEK                         
                                  STW                          _yv                          ; yp = yPos(i) : yr = yp : yv = yVel(i)

                                  LDW                          _yv
                                  ADDI                         64
                                  STW                          _yv                          ; yv = yv + GRAVITY

                                  LDW                          _updateFountain_xp
                                  ADDW                         _xv
                                  STW                          _updateFountain_xp           ; xp = xp + xv

                                  LDW                          _updateFountain_yp
                                  ADDW                         _yv
                                  STW                          _updateFountain_yp           ; yp = yp + yv

                                  LDWI                         -15104
                                  SUBW                         _updateFountain_yp
                                  BLE                          _endif_0x0003                ; if yp &&< -59*256

                                  LDWI                         -15104
                                  SUBW                         _yr
                                  BGT                          _if_0x0004
                                  CALLI                        _clearParticle               ; if yr &&>= -59*256 then gosub clearParticle

_if_0x0004                        CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0003                     LDWI                         15104
                                  SUBW                         _updateFountain_yp
                                  BGE                          _endif_0x0005                ; if yp &&> 59*256

                                  CALLI                        _clearParticle               ; gosub clearParticle

                                  LDW                          _updateFountain_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  CALLI                        _skipParticle                ; goto skipParticle

_endif_0x0005                     LDW                          _updateFountain_xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         20224
                                  SUBW                         0xe8
                                  BGE                          _endif_0x0006                ; if abs(xp) &&> 79*256

                                  CALLI                        _clearParticle               ; gosub clearParticle

                                  LDW                          _updateFountain_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  CALLI                        _skipParticle                ; goto skipParticle

_endif_0x0006                     CALLI                        _clearParticle               ; gosub clearParticle

                                  LD                           _updateFountain_xp + 1
                                  ADDI                         80
                                  ST                           _pxy                         ; pxy.lo = xp.hi + FOUNTAIN_ORG_X

                                  LD                           _updateFountain_yp + 1
                                  ADDI                         68
                                  ST                           _pxy + 1                     ; pxy.hi = yp.hi + FOUNTAIN_ORG_Y

                                  LDW                          _pxy
                                  PEEK                         
                                  STW                          0xe8
                                  LD                           fgbgColour
                                  XORW                         0xe8
                                  CALLI                        convertEqOp
                                  CALLI                        _page_0x0300
_page_0x0300                      JumpFalse                    _endif_0x0007 5              ; if (peek(pxy) = get("BG_COLOUR"))

                                  LDW                          _updateFountain_life
                                  STW                          _lf                          ; lf = life

                                  LDW                          _lf
                                  SUBI                         31
                                  BLE                          _if_0x0008
                                  LDI                          31
                                  STW                          _lf                          ; if lf &&> 31 then lf = 31

_if_0x0008                        LDWI                         0x79b8
                                  ADDW                         _lf
                                  PEEK                         
                                  POKE                         _pxy                         ; poke pxy, colour(lf)

_nextParticle                     INC                          _updateFountain_life         ; inc life.lo

                                  LDWI                         0x79d8
                                  ADDW                         _updateFountain_i
                                  STW                          memAddr
                                  LDW                          _updateFountain_life
                                  POKE                         memAddr                      ; age(i) = life

                                  LDWI                         0x7fb0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  STW                          memAddr
                                  LDW                          _updateFountain_xp
                                  DOKE                         memAddr
                                  LDWI                         0x7cb0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  STW                          memAddr
                                  LDW                          _updateFountain_yp
                                  DOKE                         memAddr                      ; xPos(i) = xp : yPos(i) = yp

                                  LDWI                         0x7ab0
                                  ADDW                         _updateFountain_i
                                  ADDW                         _updateFountain_i
                                  STW                          memAddr
                                  LDW                          _yv
                                  DOKE                         memAddr                      ; yVel(i) = yv

_skipParticle                     ForNextFarInc                _updateFountain_i _next_0x0001 39                                                                                        ; next i

                                  Return                                                    ; endproc

_clearParticle                    PUSH                         
                                  LD                           _xr + 1
                                  ADDI                         80
                                  ST                           _pxy                         ; pxy.lo = xr.hi + FOUNTAIN_ORG_X

                                  LD                           _yr + 1
                                  ADDI                         68
                                  ST                           _pxy + 1                     ; pxy.hi = yr.hi + FOUNTAIN_ORG_Y

                                  LDW                          _pxy
                                  PEEK                         
                                  ANDI                         0x80
                                  BEQ                          _endif_0x0009                ; if &(peek(pxy) AND &h80)

                                  LD                           fgbgColour
                                  POKE                         _pxy                         ; poke pxy, get("BG_COLOUR")

_endif_0x0009                     Return                                                    ; return

_respawnParticle                  PUSH                                                      ; proc respawnParticle, i

                                  LDI                          0
                                  STW                          memValue
                                  LDW                          _respawnParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x7fb0
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; xPos(i).hi = 0

                                  LDI                          59
                                  STW                          memValue
                                  LDW                          _respawnParticle_i
                                  STW                          memIndex0
                                  LDWI                         0x7cb0
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; yPos(i).hi = SPAWN_Y

                                  Rand                         
                                  STW                          0xe8
                                  LDWI                         0x03ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         -500
                                  ADDW                         0xe8
                                  STW                          memValue
                                  LDWI                         0x7bb0
                                  ADDW                         _respawnParticle_i
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; xVel(i) = (rnd(0) AND 1023) - 500

                                  Rand                         
                                  STW                          0xe8
                                  LDWI                         0x03ff
                                  ANDW                         0xe8
                                  STW                          0xe8
                                  LDWI                         1000
                                  ADDW                         0xe8
                                  STW                          0xe8
                                  LDI                          0
                                  SUBW                         0xe8
                                  STW                          memValue
                                  LDWI                         0x7ab0
                                  ADDW                         _respawnParticle_i
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; yVel(i) = -((rnd(0) AND 1023) + 1000)

                                  LDWI                         0x79d8
                                  ADDW                         _respawnParticle_i
                                  STW                          memAddr
                                  CALLI                        _page_0x0400
_page_0x0400                      LDI                          1
                                  POKE                         memAddr                      ; age(i) = 1

                                  Return                                                    ; endproc

_initFountain                     PUSH                                                      ; proc initFountain

                                  LDI                          0
                                  STW                          _pxy
                                  STW                          _xr
                                  STW                          _yr                          ; pxy = 0 : xr = pxy : yr = xr

                                  LDI                          0
                                  STW                          _initFountain_i              ; for i=0 to NUM_PARTICLES-1

_next_0x000a                      LDW                          _initFountain_i
                                  STW                          0xc4
                                  CALLI                        _respawnParticle             ; call respawnParticle, i

                                  LDWI                         0x79d8
                                  ADDW                         _initFountain_i
                                  STW                          memAddr
                                  LDI                          1
                                  POKE                         memAddr                      ; age(i) = 1

                                  ForNextFarInc                _initFountain_i _next_0x000a 39                                                                                          ; next i

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



