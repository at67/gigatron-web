_startAddress_                    EQU                          0x0200

; Internal Variables
serialRawPrev                     EQU                          0x0081
frameCountPrev                    EQU                          0x00d6
register0                         EQU                          0x0082
register1                         EQU                          register0 + 0x02
register2                         EQU                          register0 + 0x04
register3                         EQU                          register0 + 0x06
register4                         EQU                          register0 + 0x08
register5                         EQU                          register0 + 0x0A
register6                         EQU                          register0 + 0x0C
register7                         EQU                          register0 + 0x0E
register8                         EQU                          register0 + 0x10
register9                         EQU                          register0 + 0x12
register10                        EQU                          register0 + 0x14
register11                        EQU                          register0 + 0x16
register12                        EQU                          register0 + 0x18
register13                        EQU                          register0 + 0x1A
register14                        EQU                          register0 + 0x1C
register15                        EQU                          register0 + 0x1E
fgbgColour                        EQU                          register0 + 0x20
cursorXY                          EQU                          register0 + 0x22
midiStream                        EQU                          register0 + 0x24
midiDelay                         EQU                          register0 + 0x26
miscFlags                         EQU                          register0 + 0x28
register16                        EQU                          register0 + 0x2A
timerTick                         EQU                          register0 + 0x2C
timerJiff                         EQU                          register0 + 0x2E

; Internal Constants
MISC_WAIT_VBLANK_BIT              EQU                          0x01
MISC_ENABLE_SCROLL_BIT            EQU                          0x02
MISC_ON_BOTTOM_ROW_BIT            EQU                          0x04
MISC_DISABLE_CLIP_BIT             EQU                          0x08
MISC_ENABLE_FNT4X6_BIT            EQU                          0x10
MISC_WAIT_VBLANK_MSK              EQU                          0xfe
MISC_ENABLE_SCROLL_MSK            EQU                          0xfd
MISC_ON_BOTTOM_ROW_MSK            EQU                          0xfb
MISC_DISABLE_CLIP_MSK             EQU                          0xf7
MISC_ENABLE_FNT4X6_MSK            EQU                          0xef

; Internal Buffers
regsWorkArea                      EQU                          0x0000
textWorkArea                      EQU                          0x7da0

; Includes
%includePath                      "runtime"
%include                          util.i
%include                          gigatron.i
%include                          macros_ROMv5a.i

; Labels
_entryPoint_                      EQU                          0x0200
_repeat_0x0000                    EQU                          0x0249
_updateStarfield                  EQU                          0x024f
_next_0x0001                      EQU                          0x0254
_endif_0x0002                     EQU                          0x0290
_endif_0x0003                     EQU                          0x02c2
_if_0x0004                        EQU                          0x02dc
_elseif_0x0005                    EQU                          0x0303
_else_0x0006                      EQU                          0x0311
_endif_0x0007                     EQU                          0x0315
_endif_0x0008                     EQU                          0x0336
_initStarfield                    EQU                          0x0344
_next_0x0009                      EQU                          0x0349
_elseif_0x000a                    EQU                          0x03a2
_elseif_0x000b                    EQU                          0x03bb
_else_0x000c                      EQU                          0x03d4
_endif_0x000d                     EQU                          0x03dd
_page_0x0300                      EQU                          0x0300
_page_0x0400                      EQU                          0x0400

; Constants
_NUM_STARS                        EQU                          0x0040
_STARFIELD_ORG_X                  EQU                          0x0050
_STARFIELD_ORG_Y                  EQU                          0x0044

; Global Variables
_layer                            EQU                          0x0030

; Local Variables
_updateStarfield_i                EQU                          0x00c4
_updateStarfield_xp               EQU                          0x00c6
_updateStarfield_yp               EQU                          0x00c8
_updateStarfield_spd              EQU                          0x00ca
_updateStarfield_twk              EQU                          0x00cc
_updateStarfield_pxy              EQU                          0x00ce
_updateStarfield_colour           EQU                          0x00d0
_initStarfield_i                  EQU                          0x00c4
_initStarfield_spd                EQU                          0x00c6

; Arrays
_xPos                             EQU                          0x0680
_xPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_yPos                             EQU                          0x0600
_yPos                             DW                           0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 
_speed                            EQU                          0x7fc0
_speed                            DB                           0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 
_twinkle                          EQU                          0x7cc0
_twinkle                          DB                           0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 

; Strings

; Constant Strings
_str_0x7faf                       EQU                          0x7faf
_str_0x7faf                       DB                           15 'TEST TEXT!!!!!!' 0

; Data

; Time

; Define Bytes

; Define Words

; Define Images

; Define Loader Image Chunks

; Define Midis

; Define Blits

; Define Fonts

; Define Sprites

; Define Patterns

; Lookup Tables

; Lazy Constants

; Code
_entryPoint_                      LDI                          0x40
                                  STW                          romUser
                                  RomCheck                     
                                  InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LDWI                         3089
                                  STW                          fgbgColour                   ; set FGBG_COLOUR, &h0C11

                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; mode 2 : cls

                                  LDI                          40
                                  ST                           cursorXY
                                  LDI                          50
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7faf
                                  NewLine                                                   ; at 40, 50 : print "TEST TEXT!!!!!!"

                                  CALLI                        _initStarfield               ; call initStarfield

_repeat_0x0000                    CALLI                        _updateStarfield             ; call updateStarfield

                                  CALLI                        _repeat_0x0000               ; forever

_updateStarfield                  PUSH                                                      ; proc updateStarfield

                                  LDI                          0
                                  STW                          _updateStarfield_i           ; for i=0 to NUM_STARS-1

_next_0x0001                      LDWI                         0x0680
                                  ADDW                         _updateStarfield_i
                                  ADDW                         _updateStarfield_i
                                  DEEK                         
                                  STW                          _updateStarfield_xp
                                  LDWI                         0x0600
                                  ADDW                         _updateStarfield_i
                                  ADDW                         _updateStarfield_i
                                  DEEK                         
                                  STW                          _updateStarfield_yp          ; xp = xPos(i) : yp = yPos(i)

                                  LDWI                         0x7fc0
                                  ADDW                         _updateStarfield_i
                                  PEEK                         
                                  STW                          _updateStarfield_spd         ; spd = speed(i)

                                  LDWI                         0x7cc0
                                  ADDW                         _updateStarfield_i
                                  PEEK                         
                                  STW                          _updateStarfield_twk         ; twk = twinkle(i)

                                  LD                           _updateStarfield_xp + 1
                                  ADDI                         80
                                  ST                           _updateStarfield_pxy         ; pxy.lo = xp.hi + STARFIELD_ORG_X

                                  LD                           _updateStarfield_yp + 1
                                  ADDI                         68
                                  ST                           _updateStarfield_pxy + 1     ; pxy.hi = yp.hi + STARFIELD_ORG_Y

                                  LDW                          _updateStarfield_pxy
                                  PEEK                         
                                  ANDI                         0x80
                                  BEQ                          _endif_0x0002                ; if &(peek(pxy) AND &h80)

                                  LD                           fgbgColour
                                  POKE                         _updateStarfield_pxy         ; poke pxy, get("BG_COLOUR")

_endif_0x0002                     LDW                          _updateStarfield_xp
                                  ADDW                         _updateStarfield_spd
                                  STW                          _updateStarfield_xp          ; xp = xp + spd

                                  LDW                          _updateStarfield_xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         20224
                                  SUBW                         0xe8
                                  BGE                          _endif_0x0003                ; if abs(xp) &&> 79*256

                                  LDWI                         -79
                                  ST                           _updateStarfield_xp + 1      ; xp.hi = -79

                                  LDI                          0x78
                                  RandMod                      
                                  SUBI                         60
                                  ST                           _updateStarfield_yp + 1      ; yp.hi = rnd(120) - 60

                                  LDWI                         0x0600
                                  ADDW                         _updateStarfield_i
                                  ADDW                         _updateStarfield_i
                                  STW                          memAddr
                                  LDW                          _updateStarfield_yp
                                  DOKE                         memAddr                      ; yPos(i) = yp

_endif_0x0003                     LDWI                         0x0680
                                  ADDW                         _updateStarfield_i
                                  ADDW                         _updateStarfield_i
                                  STW                          memAddr
                                  LDW                          _updateStarfield_xp
                                  DOKE                         memAddr                      ; xPos(i) = xp

                                  INC                          _updateStarfield_twk         ; inc twk.lo

                                  LDW                          _updateStarfield_twk
                                  SUBI                         63
                                  BLE                          _if_0x0004
                                  LDI                          0
                                  STW                          _updateStarfield_twk         ; if twk &&> 63 then twk = 0

_if_0x0004                        LDWI                         0x7cc0
                                  ADDW                         _updateStarfield_i
                                  STW                          memAddr
                                  LDW                          _updateStarfield_twk
                                  POKE                         memAddr                      ; twinkle(i) = twk

                                  LDW                          _updateStarfield_twk
                                  SUBI                         21
                                  JumpLT                       _elseif_0x0005 4             ; if twk &< 21

                                  LDI                          21
                                  STW                          _updateStarfield_colour      ; colour = &h15

                                  CALLI                        _page_0x0300
_page_0x0300                      CALLI                        _endif_0x0007
_elseif_0x0005                    LDW                          _updateStarfield_twk
                                  SUBI                         42
                                  BGE                          _else_0x0006                 ; elseif twk &&< 42

                                  LDI                          42
                                  STW                          _updateStarfield_colour      ; colour = &h2A

                                  CALLI                        _endif_0x0007                ; else

_else_0x0006                      LDI                          63
                                  STW                          _updateStarfield_colour      ; colour = &h3F

_endif_0x0007                     LD                           _updateStarfield_xp + 1
                                  ADDI                         80
                                  ST                           _updateStarfield_pxy         ; pxy.lo = xp.hi + STARFIELD_ORG_X

                                  LD                           _updateStarfield_yp + 1
                                  ADDI                         68
                                  ST                           _updateStarfield_pxy + 1     ; pxy.hi = yp.hi + STARFIELD_ORG_Y

                                  LDW                          _updateStarfield_pxy
                                  PEEK                         
                                  STW                          0xe8
                                  LD                           fgbgColour
                                  XORW                         0xe8
                                  CALLI                        convertEqOp
                                  BEQ                          _endif_0x0008                ; if &(peek(pxy) = get("BG_COLOUR"))

                                  LDW                          _updateStarfield_colour
                                  ORI                          0x80
                                  POKE                         _updateStarfield_pxy         ; poke pxy, colour OR &h80

_endif_0x0008                     ForNextFarInc                _updateStarfield_i _next_0x0001 63                                                                                       ; next i

                                  Return                                                    ; endproc

_initStarfield                    PUSH                                                      ; proc initStarfield

                                  LDI                          0
                                  STW                          _initStarfield_i             ; for i=0 to NUM_STARS-1

_next_0x0009                      LDI                          0xa0
                                  RandMod                      
                                  SUBI                         80
                                  STW                          memValue
                                  LDW                          _initStarfield_i
                                  STW                          memIndex0
                                  LDWI                         0x0680
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; xPos(i).hi = rnd(160) - 80

                                  LDI                          0x78
                                  RandMod                      
                                  SUBI                         60
                                  STW                          memValue
                                  LDW                          _initStarfield_i
                                  STW                          memIndex0
                                  LDWI                         0x0600
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  STW                          memAddr
                                  LDW                          memValue
                                  INC                          memAddr
                                  POKE                         memAddr                      ; yPos(i).hi = rnd(120) - 60

                                  LDW                          _initStarfield_i
                                  ANDI                         0x03
                                  STW                          _layer                       ; layer = i AND 3

                                  LDW                          _layer
                                  CALLI                        convertEqOp
                                  JumpFalse                    _elseif_0x000a 8             ; if layer = 0

                                  Rand                         
                                  ANDI                         0x0f
                                  ADDI                         48
                                  STW                          _initStarfield_spd           ; spd = (rnd(0) AND 15) + 48

                                  CALLI                        _endif_0x000d
_elseif_0x000a                    LDW                          _layer
                                  XORI                         1
                                  CALLI                        convertEqOp
                                  JumpFalse                    _elseif_0x000b 10            ; elseif layer = 1

                                  Rand                         
                                  ANDI                         0x1f
                                  ADDI                         64
                                  STW                          _initStarfield_spd           ; spd = (rnd(0) AND 31) + 64

                                  CALLI                        _endif_0x000d
_elseif_0x000b                    LDW                          _layer
                                  XORI                         2
                                  CALLI                        convertEqOp
                                  JumpFalse                    _else_0x000c 12              ; elseif layer = 2

                                  Rand                         
                                  ANDI                         0x3f
                                  ADDI                         128
                                  STW                          _initStarfield_spd           ; spd = (rnd(0) AND 63) + 128

                                  CALLI                        _endif_0x000d                ; else

_else_0x000c                      Rand                         
                                  ANDI                         0x3f
                                  ADDI                         192
                                  STW                          _initStarfield_spd           ; spd = (rnd(0) AND 63) + 192

_endif_0x000d                     LDWI                         0x7fc0
                                  ADDW                         _initStarfield_i
                                  STW                          memAddr
                                  LDW                          _initStarfield_spd
                                  POKE                         memAddr                      ; speed(i) = spd

                                  Rand                         
                                  ANDI                         0x3f
                                  STW                          memValue
                                  LDWI                         0x7cc0
                                  ADDW                         _initStarfield_i
                                  STW                          memAddr
                                  CALLI                        _page_0x0400
_page_0x0400                      LDW                          memValue
                                  POKE                         memAddr                      ; twinkle(i) = rnd(0) AND 63

                                  ForNextFarInc                _initStarfield_i _next_0x0009 63                                                                                         ; next i

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



