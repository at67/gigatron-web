; Code
_entryPoint_                      InitialiseOn                 
%define FONT_BOTH
%define TEXT_SCROLL                                                                         ; INIT

                                  LD                           miscFlags
                                  ANDI                         0xfd
                                  ST                           miscFlags                    ; tscroll off

                                  LDI                          17
                                  ST                           fgbgColour
                                  LDI                          2
                                  STW                          graphicsMode
                                  ScanlineMode                 
                                  ClearVertBlinds                                           ; set BG_COLOUR, &h11 : mode 2 : cls

                                  LDI                          12
                                  ST                           fgbgColour + 1               ; set FG_COLOUR, &h0C

                                  LDI                          12
                                  ST                           fgbgColour + 1               ; set FG_COLOUR, &h0C

                                  LDI                          10
                                  ST                           cursorXY
                                  LDI                          34
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fe5
                                  NewLine                                                   ; at 10, 34 : print "Racer"

                                  LDI                          10
                                  ST                           cursorXY
                                  LDI                          43
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fde
                                  NewLine                                                   ; at 10, 43 : print "Snake"

                                  LDI                          10
                                  ST                           cursorXY
                                  LDI                          52
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fd6
                                  NewLine                                                   ; at 10, 52 : print "Tetris"

                                  LDI                          10
                                  ST                           cursorXY
                                  LDI                          61
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fcd
                                  NewLine                                                   ; at 10, 61 : print "Frogger"

                                  LDI                          10
                                  ST                           cursorXY
                                  LDI                          70
                                  ST                           cursorXY + 1
                                  AtTextCursor                 
                                  PrintString                  _str_0x7fc2
                                  NewLine                                                   ; at 10, 70 : print "Centipede"

                                  LDWI                         -1
                                  STW                          _t                           ; t = -1

                                  CALLI                        _initSnow                    ; call initSnow

_repeat_0x0000                    CALLI                        _updateSnow                  ; call updateSnow

                                  LDW                          _t
                                  ADDI                         1
                                  STW                          _t                           ; t = t + 1

                                  CALLI                        _repeat_0x0000               ; forever

_initSnow                         PUSH                                                      ; proc initSnow

                                  LDI                          0
                                  STW                          _initSnow_i                  ; for i=0 to NUM_SNOW_PARTICLES-1

_next_0x0001                      LDW                          _initSnow_i
                                  STW                          0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  ForNextFarInc                _initSnow_i _next_0x0001 79  ; next i

                                  Return                                                    ; endproc

_updateSnow                       PUSH                                                      ; proc updateSnow

                                  LDI                          0
                                  STW                          _updateSnow_i                ; for i=0 to NUM_SNOW_PARTICLES-1

_next_0x0002                      LDWI                         0x0660
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  DEEK                         
                                  STW                          _updateSnow_xp               ; xp = xPos(i)

                                  LDWI                         0x05c0
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  DEEK                         
                                  STW                          _updateSnow_yp               ; yp = yPos(i)

                                  LDWI                         0x0520
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  DEEK                         
                                  STW                          _updateSnow_yv               ; yv = yVel(i)

                                  LD                           _updateSnow_xp + 1
                                  ADDI                         80
                                  ST                           _rxy                         ; rxy.lo = xp.hi + SNOW_ORG_X

                                  LD                           _updateSnow_yp + 1
                                  ADDI                         68
                                  ST                           _rxy + 1                     ; rxy.hi = yp.hi + SNOW_ORG_Y

                                  CALLI                        _page_0x0300
_page_0x0300                      LDW                          _rxy
                                  PEEK                         
                                  ANDI                         0x80
                                  BEQ                          _endif_0x0003                ; if &(peek(rxy) AND &h80)

                                  LD                           fgbgColour
                                  POKE                         _rxy                         ; poke rxy, get("BG_COLOUR")

_endif_0x0003                     LDW                          _updateSnow_yp
                                  ADDW                         _updateSnow_yv
                                  STW                          _updateSnow_yp               ; yp = yp + yv

                                  LDWI                         15104
                                  SUBW                         _updateSnow_yp
                                  BGE                          _endif_0x0004                ; if yp &&> 59*256

                                  LD                           _rxy + 1
                                  SUBI                         127
                                  BGE                          _if_0x0005
                                  LDI                          63
                                  POKE                         _rxy                         ; if rxy.hi &&< 127 then poke rxy, &h3F

_if_0x0005                        LDW                          _updateSnow_i
                                  STW                          0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x0004                     LD                           _updateSnow_yp + 1
                                  ADDI                         68
                                  ST                           _updateSnow_pxy + 1          ; pxy.hi = yp.hi + SNOW_ORG_Y

                                  LD                           _rxy + 1
                                  STW                          register15
                                  LD                           _updateSnow_pxy + 1
                                  SUBW                         register15
                                  BLE                          _endif_0x0006                ; if pxy.hi &&> rxy.hi

                                  LD                           _rxy + 1
                                  ANDI                         0x07
                                  STW                          memIndex0
                                  LDWI                         0x7fec
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  DEEK                         
                                  STW                          0xea
                                  LD                           _updateSnow_xp + 1
                                  ADDW                         0xea
                                  ST                           _updateSnow_xp + 1           ; xp.hi = xp.hi + jitterOffset(rxy.hi AND 7)

_endif_0x0006                     LD                           _updateSnow_xp + 1
                                  ADDI                         80
                                  ST                           _updateSnow_pxy              ; pxy.lo = xp.hi + SNOW_ORG_X

                                  LDW                          _updateSnow_pxy
                                  PEEK                         
                                  STW                          _pixel                       ; pixel = peek(pxy)

                                  LD                           fgbgColour
                                  XORW                         _pixel
                                  CALLI                        convertNeOp
                                  BEQ                          _endif_0x0007                ; if &(pixel <> get("BG_COLOUR"))

                                  LDWI                         -1
                                  XORW                         _pixel
                                  ANDI                         0x80
                                  BEQ                          _endif_0x0008                ; if &(NOT pixel AND &h80)

                                  LDWI                         256
                                  ADDW                         _rxy
                                  PEEK                         
                                  STW                          0xea
                                  LD                           fgbgColour
                                  XORW                         0xea
                                  CALLI                        convertNeOp
                                  BEQ                          _else_0x0009                 ; if &(peek(rxy + &h0100) <> get("BG_COLOUR"))

                                  LDI                          63
                                  POKE                         _rxy                         ; poke rxy, &h3F

                                  LDW                          _updateSnow_i
                                  STW                          0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

                                  CALLI                        _endif_0x000a                ; else

_else_0x0009                      LD                           _rxy + 1
                                  ANDI                         0x07
                                  STW                          memIndex0
                                  LDWI                         0x7fec
                                  ADDW                         memIndex0
                                  ADDW                         memIndex0
                                  DEEK                         
                                  STW                          0xea
                                  LD                           _updateSnow_xp + 1
                                  SUBW                         0xea
                                  ST                           _updateSnow_xp + 1           ; xp.hi = xp.hi - jitterOffset(rxy.hi AND 7)

                                  LD                           _updateSnow_xp + 1
                                  ADDI                         80
                                  ST                           _updateSnow_pxy              ; pxy.lo = xp.hi + SNOW_ORG_X

_endif_0x0007                     LDW                          _updateSnow_xp
                                  Absolute                     
                                  STW                          0xe8
                                  LDWI                         19968
                                  SUBW                         0xe8
                                  BGE                          _endif_0x000b                ; if abs(xp) &&> 78*256

                                  LDW                          _updateSnow_i
                                  STW                          0xc4
                                  CALLI                        _respawnSnowParticle         ; call respawnSnowParticle, i

                                  CALLI                        _nextParticle                ; goto nextParticle

_endif_0x000b                     LDWI                         0x7eb0
                                  ADDW                         _updateSnow_i
                                  PEEK                         
                                  POKE                         _updateSnow_pxy              ; poke pxy, colour(i)

                                  LDWI                         0x0660
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  STW                          memAddr
                                  LDW                          _updateSnow_xp
                                  DOKE                         memAddr
                                  LDWI                         0x05c0
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  STW                          memAddr
                                  LDW                          _updateSnow_yp
                                  DOKE                         memAddr                      ; xPos(i) = xp : yPos(i) = yp

                                  LDWI                         0x0520
                                  ADDW                         _updateSnow_i
                                  ADDW                         _updateSnow_i
                                  CALLI                        _page_0x0400
_page_0x0400                      STW                          memAddr
                                  LDW                          _updateSnow_yv
                                  DOKE                         memAddr                      ; yVel(i) = yv

_nextParticle                     ForNextFarInc                _updateSnow_i _next_0x0002 79                                                                                            ; next i

                                  Return                                                    ; endproc

_respawnSnowParticle              PUSH                                                      ; proc respawnSnowParticle, i

                                  LDI                          0x90
                                  RandMod                      
                                  SUBI                         72
                                  ST                           _respawnSnowParticle_x + 1   ; x.hi = rnd(144) - 72

                                  LDWI                         -1
                                  XORW                         _t
                                  CALLI                        convertEqOp
                                  JumpFalse                    _else_0x000c 9               ; if t = -1

                                  LDI                          0x14
                                  RandMod                      
                                  STW                          0xe8
                                  LDWI                         -39
                                  SUBW                         0xe8
                                  ST                           _respawnSnowParticle_y + 1   ; y.hi = -rnd(20) - 39

                                  CALLI                        _endif_0x000d                ; else

_else_0x000c                      LDWI                         -59
                                  ST                           _respawnSnowParticle_y + 1   ; y.hi = -59

_endif_0x000d                     LDWI                         0x0660
                                  ADDW                         _respawnSnowParticle_i
                                  ADDW                         _respawnSnowParticle_i
                                  STW                          memAddr
                                  LDW                          _respawnSnowParticle_x
                                  DOKE                         memAddr                      ; xPos(i) = x

                                  LDWI                         0x05c0
                                  ADDW                         _respawnSnowParticle_i
                                  ADDW                         _respawnSnowParticle_i
                                  STW                          memAddr
                                  LDW                          _respawnSnowParticle_y
                                  DOKE                         memAddr                      ; yPos(i) = y

                                  Rand                         
                                  ANDI                         0x7f
                                  ADDI                         128
                                  STW                          memValue
                                  LDWI                         0x0520
                                  ADDW                         _respawnSnowParticle_i
                                  ADDW                         _respawnSnowParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  DOKE                         memAddr                      ; yVel(i) = (rnd(0) AND 127) + 128

                                  Rand                         
                                  ANDI                         0x03
                                  STW                          memIndex0
                                  LDWI                         0x7ffc
                                  ADDW                         memIndex0
                                  PEEK                         
                                  STW                          memValue
                                  LDWI                         0x7eb0
                                  ADDW                         _respawnSnowParticle_i
                                  STW                          memAddr
                                  LDW                          memValue
                                  POKE                         memAddr                      ; colour(i) = snowColour(rnd(0) AND 3)

                                  Return                                                    ; endproc

                                  HALT                                                      ; END



;*************************************************************************************************************
;*************************************************************************************************************
;* Internal runtime, DO NOT MODIFY PAST THIS POINT, modifications must be made in the original include files *
;*************************************************************************************************************
;*************************************************************************************************************

convertEqOp                       EQU     0x79a7
convertNeOp                       EQU     0x78f6
absolute                          EQU     0x7fa0
divide16bit                       EQU     0x7dac
rand16bit                         EQU     0x78ee
randMod16bit                      EQU     0x7ba2
scanlineMode                      EQU     0x7ca2
resetVideoFlags                   EQU     0x7da1
initClearFuncs                    EQU     0x7ea1
clearVertBlinds                   EQU     0x7acd
clearCursorRow                    EQU     0x7aa1
printInit                         EQU     0x79c5
printText                         EQU     0x79b0
printChar                         EQU     0x7bb3
printClip                         EQU     0x7faa
newLineScroll                     EQU     0x7cac
atTextCursor                      EQU     0x79db


                    
convertEqOp         BEQ     convertEq_1
                    LDI     0
                    RET
convertEq_1         LDI     1
                    RET


                    
convertNeOp         BNE     convertNe_1
                    LDI     0
                    RET
convertNe_1         LDI     1
                    RET



mathX               EQU     register8
mathY               EQU     register9
mathSum             EQU     register12
mathRem             EQU     register12
mathMask            EQU     register13
mathSign            EQU     register14
mathQuot            EQU     register15
mathShift           EQU     register15
mathBase            EQU     register10
mathPow             EQU     register11
mathResult          EQU     register14


absolute            BGE     abs_exit
                    STW     mathX
                    LDI     0
                    SUBW    mathX
abs_exit            RET


rand16bit           LDWI    SYS_Random_34
                    STW     giga_sysFn
                    SYS     34
                    RET



                    
divide16bit         LDW     mathX
                    XORW    mathY
                    STW     mathSign
                    LDW     mathX
                    BGE     divide16_pos0
                    LDI     0
                    SUBW    mathX
                    STW     mathX
                    
divide16_pos0       LDW     mathY                     
                    BGE     divide16_pos1
                    LDI     0
                    SUBW    mathY
                    STW     mathY
                    
divide16_pos1       LDI     0
                    STW     mathRem
                    LDI     1
    
divide16_loop       STW     mathMask
                    LDW     mathRem
                    LSLW
                    STW     mathRem
                    LDW     mathX
                    BGE     divide16_incr
                    INC     mathRem
                    
divide16_incr       LDW     mathX
                    LSLW
                    STW     mathX
                    LDW     mathRem
                    SUBW    mathY
                    BLT     divide16_incx
                    STW     mathRem
                    INC     mathX
                    
divide16_incx       LDW     mathMask
                    LSLW
                    BNE     divide16_loop
                    LDW     mathSign
                    BGE     divide16_exit
                    LDI     0
                    SUBW    mathX
                    RET
                    
divide16_exit       LDW     mathX
                    RET


randMod16bit        PUSH
                    LDWI    SYS_Random_34
                    STW     giga_sysFn
                    SYS     34
                    STW     mathX
                    CALLI   divide16bit
                    LDW     mathRem
                    POP
                    RET



