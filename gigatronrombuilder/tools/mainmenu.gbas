_runtimePath_ "runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMv5a
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "../build/SymbolTable.m"
const NUM_APPS = 6
const LIST_X0  = 10
const LIST_X1  = 88
const LIST_Y   = 34
const LIST_DY  = 9
const CURS_DX  = 8
const CURS_X   = LIST_X0 - CURS_DX
const CURS_Y   = LIST_Y
const dim apps$(NUM_APPS-1) = "Invader", "PucMon_ROMv5a", "tetronis", "Craps", "VideoPoker", "bricks"
dim execs(NUM_APPS-1) = Invader, PucMon_ROMv5a, tetronis, Craps, VideoPoker, bricks
tscroll off
set BG_COLOUR, 0 : mode 2 : cls
set FGBG_COLOUR, &h0C00
y = LIST_Y
for i=0 to 4
    if i < NUM_APPS   then at LIST_X0, y : print left$(apps$(i), 11)
    if i < NUM_APPS-5 then at LIST_X1, y : print left$(apps$(i+5), 11)
    y = y + LIST_DY
next i
x = CURS_X : y = CURS_Y
index = 0
play music, &h75a0, 3
gosub resetAudio
call initSnow
repeat
    gosub get("BUTTON_STATE")
    set FG_COLOUR, &h3F
    at x, y : put 62
call updateSnow
forever
execApp:
    cls
    exec execs(index), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    at x, y : put 32
        if x = (LIST_X1 - CURS_DX) then return
        x = (LIST_X1 - CURS_DX)
        gosub beep
        index = index + 5
        return
'left
253:    at x, y : put 32
        if x = (LIST_X0 - CURS_DX) then return
        x = (LIST_X0 - CURS_DX)
        gosub beep
        index = index - 5
        return
'down
251:    at x, y : put 32
        y = y + LIST_DY
        if y > (LIST_Y + 4*LIST_DY)
            y = (LIST_Y + 4*LIST_DY)
            return
        endif
        gosub beep
        index = index + 1
        if (x = LIST_X0 - CURS_DX) AND index > 4 then index = 4
        if (x = LIST_X1 - CURS_DX) AND index > 9 then index = 9
        return
'up
247:    at x, y : put 32
        y = y - LIST_DY
        if y < LIST_Y
            y = LIST_Y
            return
        endif
        gosub beep
        index = index - 1
        if (x = LIST_X0 - CURS_DX) AND index < 0 then index = 0
        if (x = LIST_X1 - CURS_DX) AND index < 5 then index = 5
        return
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
const NUM_SNOW_PARTICLES = 80
const SNOW_ORG_X = 80
const SNOW_ORG_Y = 60 + 8
const GROUND_Y = 59
dim snowColour%(3) = &h95, &hAA, &hBF, &hBF
dim jitterOffset(7) = 0, 1, 0, -1, 0, -1, 0, 1
dim xPos(NUM_SNOW_PARTICLES-1) = 0
dim yPos(NUM_SNOW_PARTICLES-1) = 0
dim yVel(NUM_SNOW_PARTICLES-1) = 0
dim colour%(NUM_SNOW_PARTICLES-1) = 0
proc initSnow
    local i
    snowTimer = -1
    for i=0 to NUM_SNOW_PARTICLES-1
        call respawnSnowParticle, i
    next i
endproc
proc updateSnow
    local i, xp, yp, yv, col, pxy
    for i=0 to NUM_SNOW_PARTICLES-1
        xp = xPos(i)
        yp = yPos(i)
        yv = yVel(i)
        rxy.lo = xp.hi + SNOW_ORG_X
        rxy.hi = yp.hi + SNOW_ORG_Y
        if &(peek(rxy) AND &h80)
            poke rxy, 0
        endif
        yp = yp + yv
        if yp &> 59*256
            if rxy.hi &&< 127 then poke rxy, &h3F
            call respawnSnowParticle, i
            goto nextParticle
        endif
        pxy.hi = yp.hi + SNOW_ORG_Y
        if pxy.hi &> rxy.hi
            xp.hi = xp.hi + jitterOffset(rxy.hi AND 7)
        endif
        pxy.lo = xp.hi + SNOW_ORG_X
        pixel = peek(pxy)
        if (pixel)
            if (NOT pixel AND &h80)
                if &(peek(rxy + &h0100))
                    poke rxy, &h3F
                    call respawnSnowParticle, i
                    goto nextParticle
                else
                    xp.hi = xp.hi - jitterOffset(rxy.hi AND 7)
                    pxy.lo = xp.hi + SNOW_ORG_X
                endif
            endif
        endif
        if abs(xp) &&> 78*256
            call respawnSnowParticle, i
            goto nextParticle
        endif
        poke pxy, colour(i)
        xPos(i) = xp : yPos(i) = yp
        yVel(i) = yv
nextParticle:
    next i
    snowTimer = snowTimer + 1
endproc
proc respawnSnowParticle, i
    local y
    xPos(i).hi = rnd(144) - 72
    if snowTimer = -1
        y.hi = -rnd(20) - 39
    else
        y.hi = -59
    endif
    yPos(i) = y
    yVel(i) = (rnd(0) AND 127) + 128
    colour(i) = snowColour(rnd(0) AND 3)
endproc
