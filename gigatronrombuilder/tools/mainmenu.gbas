_runtimePath_ "runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMvX0
_enableRomCheck_ Off
_stringWorkArea_ &h77A0
module "../build/SymbolTable.m"
const NUM_APPS = 12
const LIST_X0  = 10
const LIST_X1  = 88
const LIST_Y   = 34
const LIST_DY  = 9
const CURS_DX  = 8
const CURS_X   = LIST_X0 - CURS_DX
const CURS_Y   = LIST_Y
const dim apps$(NUM_APPS-1) = "SoundFx64k_ROMvX0", "Blit", "CirclesF_ROMvX0", "Fill_ROMvX0", "Flood_ROMv5a", "Flood_ROMvX0", "Lines_ROMvX0", "Pixels", "Pixels_ROMvX0", "Points", "Points_ROMvX0", "Polys"
dim execs(NUM_APPS-1) = SoundFx64k_ROMvX0, Blit, CirclesF_ROMvX0, Fill_ROMvX0, Flood_ROMv5a, Flood_ROMvX0, Lines_ROMvX0, Pixels, Pixels_ROMvX0, Points, Points_ROMvX0, Polys
tscroll off
set BG_COLOUR, 0 : mode 2 : cls
set FGBG_COLOUR, &h0C00
y = LIST_Y
for i=0 to 4
    if i < NUM_APPS   then at LIST_X0, y : print left$(apps$(i), 11)
    if i < NUM_APPS-5 then at LIST_X1, y : print left$(apps$(i+5), 11)
    y = y + LIST_DY
next i
x = CURS_X : y = CURS_Y
index = 0
play music, &h75a0, 3
gosub resetAudio
repeat
    gosub get("BUTTON_STATE")
    set FG_COLOUR, &h3F
    at x, y : put 62
forever
execApp:
    cls
    exec execs(index), &h0200
return
'button A
127:    gosub beep
        gosub execApp
        return
'right
254:    at x, y : put 32
        if x = (LIST_X1 - CURS_DX) then return
        x = (LIST_X1 - CURS_DX)
        gosub beep
        index = index + 5
        return
'left
253:    at x, y : put 32
        if x = (LIST_X0 - CURS_DX) then return
        x = (LIST_X0 - CURS_DX)
        gosub beep
        index = index - 5
        return
'down
251:    at x, y : put 32
        y = y + LIST_DY
        if y > (LIST_Y + 4*LIST_DY)
            y = (LIST_Y + 4*LIST_DY)
            return
        endif
        gosub beep
        index = index + 1
        if (x = LIST_X0 - CURS_DX) AND index > 4 then index = 4
        if (x = LIST_X1 - CURS_DX) AND index > 9 then index = 9
        return
'up
247:    at x, y : put 32
        y = y - LIST_DY
        if y < LIST_Y
            y = LIST_Y
            return
        endif
        gosub beep
        index = index - 1
        if (x = LIST_X0 - CURS_DX) AND index < 0 then index = 0
        if (x = LIST_X1 - CURS_DX) AND index < 5 then index = 5
        return
def byte(&h75a0) = &h90, &h3c, &h91, &h40, &h92, &h43, &h93, &h48, &h0c, &h80, &h81, &h82, &h83, &h01, &h90, &h3c,
def byte         = &h91, &h40, &h92, &h43, &h93, &h48, &h24, &h80, &h81, &h82, &h83, &hd0, &h00, &h00
resetAudio:
    asm
        LDI     2
        ST      waveType + 1
        CALLI   resetAudio
    endasm
return
beep:
    sound on, 1, 8200
    set SOUND_TIMER, 2
    set BUTTON_STATE, &hEF
return
