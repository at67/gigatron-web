_runtimePath_ "runtime"
_runtimeStart_ &h7FFE
_codeRomType_ ROMv5a

const NUM_STARS = 64
const STARFIELD_ORG_X = 80
const STARFIELD_ORG_Y = 60 + 8

dim xPos(NUM_STARS-1) = 0
dim yPos(NUM_STARS-1) = 0
dim speed%(NUM_STARS-1) = 0
dim twinkle%(NUM_STARS-1) = 0

set FGBG_COLOUR, &h0C11
mode 2 : cls
at 40, 50 : print "TEST TEXT!!!!!!"

call initStarfield

repeat
    call updateStarfield
forever

proc updateStarfield
    local i, xp, yp, spd, twk, pxy, colour
    
    for i=0 to NUM_STARS-1
        xp = xPos(i) : yp = yPos(i)
        spd = speed(i)
		twk = twinkle(i)
        
        ' Clear old position
        pxy.lo = xp.hi + STARFIELD_ORG_X
        pxy.hi = yp.hi + STARFIELD_ORG_Y
        if &(peek(pxy) AND &h80)
            poke pxy, get("BG_COLOUR")
        endif
        
        ' Move star horizontally
        xp = xp + spd
        
        ' Wrap around within screen bounds
        if abs(xp) &&> 79*256
            xp.hi = -79
            yp.hi = rnd(120) - 60
			yPos(i) = yp
        endif
        
        xPos(i) = xp
        
        ' Update twinkling
        inc twk.lo
        if twk &&> 63 then twk = 0
        twinkle(i) = twk
        
        ' Calculate brightness
        if twk &< 21
            colour = &h15  ' dim white
        elseif twk &&< 42
            colour = &h2A  ' medium white
        else
            colour = &h3F  ' bright white
        endif
        
        ' Draw new position
        pxy.lo = xp.hi + STARFIELD_ORG_X
        pxy.hi = yp.hi + STARFIELD_ORG_Y
        if &(peek(pxy) = get("BG_COLOUR"))
            poke pxy, colour OR &h80
        endif
    next i
endproc

proc initStarfield
    local i, spd
    
    for i=0 to NUM_STARS-1
        ' Random position relative to center
        xPos(i).hi = rnd(160) - 80
        yPos(i).hi = rnd(120) - 60
        
        ' Assign to one of 4 layers
        layer = i AND 3
        if layer = 0
            spd = (rnd(0) AND 15) + 48
        elseif layer = 1
            spd = (rnd(0) AND 31) + 64
        elseif layer = 2
            spd = (rnd(0) AND 63) + 128
        else
            spd = (rnd(0) AND 63) + 192
        endif
        speed(i) = spd

        ' Random twinkle phase
        twinkle(i) = rnd(0) AND 63
    next i
endproc